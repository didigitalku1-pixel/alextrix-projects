der-t border-l border-[#1a1a1a]/40\"></div>\n                            <div class=\"absolute top-2 right-2 w-2 h-2 border-t border-r border-[#1a1a1a]/40\"></div>\n                            <div class=\"absolute bottom-2 left-2 w-2 h-2 border-b border-l border-[#1a1a1a]/40\"></div>\n                            <div class=\"absolute bottom-2 right-2 w-2 h-2 border-b border-r border-[#1a1a1a]/40\"></div>\n\n                            <!-- SVG Graphic (Concentric/Orbit) -->\n                            <svg class=\"w-40 h-40 text-[#1a1a1a] relative z-10\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\">\n                                <g class=\"transform-gpu origin-center animate-[spin_20s_linear_infinite_reverse]\">\n                                    <circle cx=\"50\" cy=\"50\" r=\"35\" stroke-dasharray=\"4 4\" class=\"group-hover:stroke-opacity-50 transition-opacity\" />\n                                    <circle cx=\"50\" cy=\"50\" r=\"25\" />\n                                    <circle cx=\"50\" cy=\"55\" r=\"15\" class=\"animate-[pulse_2s_ease-in-out_infinite]\" />\n                                    <circle cx=\"50\" cy=\"60\" r=\"5\" fill=\"currentColor\" fill-opacity=\"0.2\" />\n                                </g>\n                                <g class=\"transform-gpu origin-center animate-[spin_10s_linear_infinite]\">\n                                    <!-- Orbital satellite simulation -->\n                                    <circle cx=\"85\" cy=\"50\" r=\"2\" fill=\"currentColor\" />\n                                </g>\n                            </svg>\n                        </div>\n\n                        <div class=\"mt-auto pt-6 border-t border-[#1a1a1a]/10 relative\">\n                             <!-- Bottom diamonds for the text divider -->\n                             <div class=\"absolute top-0 left-0 w-3 h-3 bg-[#1a1a1a] rotate-45 transform -translate-x-1/2 -translate-y-1/2 z-20\"></div>\n                             <div class=\"hidden md:block absolute top-0 left-full w-3 h-3 bg-[#1a1a1a] rotate-45 transform -translate-x-1/2 -translate-y-1/2 z-20\"></div>\n\n                            <p class=\"text-sm text-[#1a1a1a]/70 leading-relaxed font-normal\">\n                                Instantly execute cross-platform commands and state mutations with guaranteed delivery protocols and automated fallback systems.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n\n            <!-- Bottom edge intersection diamonds for layout completeness -->\n            <div class=\"hidden md:block absolute bottom-0 left-0 w-3 h-3 bg-[#1a1a1a] rotate-45 transform -translate-x-1/2 translate-y-1/2 z-20\"></div>\n            <div class=\"hidden md:block absolute bottom-0 left-1/3 w-3 h-3 bg-[#1a1a1a] rotate-45 transform -translate-x-1/2 translate-y-1/2 z-20\"></div>\n            <div class=\"hidden md:block absolute bottom-0 left-2/3 w-3 h-3 bg-[#1a1a1a] rotate-45 transform -translate-x-1/2 translate-y-1/2 z-20\"></div>\n            <div class=\"hidden md:block absolute bottom-0 left-full w-3 h-3 bg-[#1a1a1a] rotate-45 transform -translate-x-1/2 translate-y-1/2 z-20\"></div>\n\n            <!-- Extra space to let the last borders render properly -->\n            <div class=\"h-16 w-full bg-[#ebe6df]\"></div>\n        </main>\n    </div>\n</body>\n</html>", "preview_file_name": "core-systems-landing-page-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/core-systems-landing-page-2.jpg", "source_name": "core-systems-landing-page-2-DESIGN.md", "views": 218, "forks": 8, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T17:31:15.495615+00:00"}