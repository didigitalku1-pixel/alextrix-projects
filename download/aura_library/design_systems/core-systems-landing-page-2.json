class=\"absolute inset-0 opacity-30\" style=\"background-image: repeating-linear-gradient(45deg, transparent, transparent 3px, #1a1a1a 3px, #1a1a1a 4px);\"></div>\n\n                            <!-- Corner markers -->\n                            <div class=\"absolute top-2 left-2 w-2 h-2 border-t border-l border-[#1a1a1a]/40\"></div>\n                            <div class=\"absolute top-2 right-2 w-2 h-2 border-t border-r border-[#1a1a1a]/40\"></div>\n                            <div class=\"absolute bottom-2 left-2 w-2 h-2 border-b border-l border-[#1a1a1a]/40\"></div>\n                            <div class=\"absolute bottom-2 right-2 w-2 h-2 border-b border-r border-[#1a1a1a]/40\"></div>\n\n                            <!-- SVG Graphic (Pyramid) -->\n                            <svg class=\"w-44 h-44 text-[#1a1a1a] relative z-10 animate-[pulse_6s_cubic-bezier(0.4,0,0.6,1)_infinite]\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\">\n                                <g class=\"transform-gpu origin-center transition-transform duration-1000 group-hover:rotate-180 group-hover:scale-90\">\n                                    <polygon points=\"50,15 15,80 85,80\" />\n                                    <polygon points=\"50,30 25,75 75,75\" stroke-opacity=\"0.6\" />\n                                    <polygon points=\"50,45 35,70 65,70\" stroke-opacity=\"0.3\" />\n                                    <!-- Inner structural lines -->\n                                    <line x1=\"50\" y1=\"15\" x2=\"50\" y2=\"80\" stroke-dasharray=\"1 2\" />\n                                    <line x1=\"15\" y1=\"80\" x2=\"50\" y2=\"45\" stroke-dasharray=\"1 2\" />\n                                    <line x1=\"85\" y1=\"80\" x2=\"50\" y2=\"45\" stroke-dasharray=\"1 2\" />\n                                </g>\n                            </svg>\n                        </div>\n\n                        <div class=\"mt-auto pt-6 border-t border-[#1a