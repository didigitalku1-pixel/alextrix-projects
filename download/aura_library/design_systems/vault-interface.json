        </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- CARD 5 (Initial Front) -->\n                <div class=\"stacked-card absolute w-[85%] rounded-[1.75rem] overflow-hidden bg-blue-900 border-[0.5px] border-white/30 flex flex-col justify-between p-6 sm:p-8 cursor-pointer select-none transform-gpu\">\n                    <div class=\"absolute inset-0 bg-cover bg-center scale-110\" style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/bfef5098-c30f-4cd9-b4ac-04b2673ab943_1600w.jpg'); filter: contrast(1.1) brightness(0.9);\"></div>\n                    <div class=\"absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-black/40 mix-blend-overlay\"></div>\n                    <div class=\"card-dimmer absolute inset-0 bg-black pointer-events-none\"></div>\n                    <div class=\"card-highlight absolute inset-x-0 top-0 h-4 bg-gradient-to-b from-white/20 to-transparent z-10 pointer-events-none\"></div>\n                    <div class=\"relative z-20 flex justify-between items-start\">\n                        <span class=\"text-white font-medium italic tracking-widest text-xl drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]\">AURA</span>\n                    </div>\n                    <div class=\"card-footer relative z-20 flex justify-between items-end mt-auto pb-4\">\n                        <span class=\"text-white text-2xl tracking-tight font-medium drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]\">Evelyn Vance</span>\n                        <div class=\"w-12 h-9 rounded-md border-[0.5px] border-zinc-900/50 relative overflow-hidden flex flex-col justify-center gap-[1px]\" style=\"background: linear-gradient(135deg, rgba(200,200,200,0.1), rgba(100,100,100,0.05)); box-shadow: inset 0 1px 2px rgba(0,0,0,0.6), 0 1px 1px rgba(255,255,255,0.2);\">\n                            <div class=\"flex justify-between px-1\"><div class=\"w-2.5 h-[1px] bg-zinc-900/40\"></div><div class=\"w-2.5 h-[1px] bg-zinc-900/40\"></div></div>\n                            <div class=\"flex justify-between px-1\"><div class=\"w-3.5 h-[1px] bg-zinc-900/40\"></div><div class=\"w-3.5 h-[1px] bg-zinc-900/40\"></div></div>\n                            <div class=\"flex justify-between px-1\"><div class=\"w-3.5 h-[1px] bg-zinc-900/40\"></div><div class=\"w-3.5 h-[1px] bg-zinc-900/40\"></div></div>\n                            <div class=\"flex justify-between px-1\"><div class=\"w-2.5 h-[1px] bg-zinc-900/40\"></div><div class=\"w-2.5 h-[1px] bg-zinc-900/40\"></div></div>\n                            <div class=\"absolute inset-0 flex justify-center items-center gap-[6px]\">\n                                <div class=\"h-full w-[1px] bg-zinc-900/30\"></div>\n                                <div class=\"h-full w-[1px] bg-zinc-900/30\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Bottom fade gradient to hide card clipping -->\n            <div class=\"absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-zinc-950 via-zinc-950/80 to-transparent z-30 pointer-events-none\"></div>\n        </div>\n    </main>\n\n    <script>\n        // --- GSAP ANIMATIONS & CARD LOGIC ---\n        document.addEventListener('DOMContentLoaded', () => {\n            const states = [\n                { top: \"2%\", scale: 0.85, zIndex: 1, boxShadow: \"0 -10px 20px rgba(0,0,0,0.5), inset 0 1px 1px rgba(255,255,255,0.4)\", borderColor: \"rgba(255,255,255,0.2)\", aspectRatio: 1.586, dimmer: 0.7 },\n                { top: \"10%\", scale: 0.88, zIndex: 2, boxShadow: \"0 -12px 25px rgba(0,0,0,0.6), inset 0 1px 1px rgba(255,255,255,0.4)\", borderColor: \"rgba(255,255,255,0.2)\", aspectRatio: 1.586, dimmer: 0.55 },\n                { top: \"20%\", scale: 0.91, zIndex: 3, boxShadow: \"0 -15px 30px rgba(0,0,0,0.7), inset 0 1px 1px rgba(255,255,255,0.5)\", borderColor: \"rgba(255,255,255,0.2)\", aspectRatio: 1.586, dimmer: 0.4 },\n                { top: \"32%\", scale: 0.94, zIndex: 4, boxShadow: \"0 -20px 40px rgba(0,0,0,0.8), inset 0 1px 1px rgba(255,255,255,0.5)\", borderColor: \"rgba(255,255,255,0.2)\", aspectRatio: 1.586, dimmer: 0.25 },\n                { top: \"48%\", scale: 1, zIndex: 5, boxShadow: \"0 -30px 60px rgba(0,0,0,0.9), 0 20px 40px rgba(0,0,0,0.5), inset 0 1px 2px rgba(255,255,255,0.6), inset 0 -1px 2px rgba(0,0,0,0.5)\", borderColor: \"rgba(255,255,255,0.3)\", aspectRatio: 0.7, dimmer: 0 }\n            ];\n\n            let currentCards = gsap.utils.toArray('.stacked-card');\n\n            function applyState(card, stateIndex, animate = true) {\n                const state = states[stateIndex];\n                const duration = animate ? 0.7 : 0;\n                const ease = \"power3.inOut\";\n\n                gsap.to(card, {\n                    top: state.top,\n                    scale: state.scale,\n                    zIndex: state.zIndex,\n                    boxShadow: state.boxShadow,\n                    borderColor: state.borderColor,\n                    aspectRatio: state.aspectRatio,\n                    duration: duration,\n                    ease: ease\n                });\n\n                gsap.to(card.querySelector('.card-dimmer'), {\n                    opacity: state.dimmer,\n                    duration: duration,\n                    ease: ease\n                });\n\n                gsap.to(card.querySelector('.card-footer'), {\n                    opacity: stateIndex === 4 ? 1 : 0,\n                    y: stateIndex === 4 ? 0 : 20,\n                    duration: duration,\n                    ease: ease\n                });\n\n                gsap.to(card.querySelector('.card-highlight'), {\n                    opacity: stateIndex === 4 ? 1 : 0,\n                    duration: duration,\n                    ease: ease\n                });\n            }\n\n            // Initialization Phase\n            currentCards.forEach((card, i) => {\n                applyState(card, i, false);\n                gsap.set(card, { y: 200, opacity: 0 }); // Hide pre-animation\n            });\n\n            // Entry Animation\n            const tl = gsap.timeline({ defaults: { ease: \"power3.out\" } });\n            gsap.set('.ui-element', { y: -20, opacity: 0 });\n            tl.to('.ui-element', { y: 0, opacity: 1, duration: 0.8, stagger: 0.1 }, 0.2);\n\n            currentCards.forEach((card, i) => {\n                tl.to(card, {\n                    y: 0,\n                    opacity: 1,\n                    duration: 1.2,\n                    ease: \"back.out(1.2)\"\n                }, 0.3 + (i * 0.15));\n            });\n\n            // Functional Interactions\n            currentCards.forEach((card) => {\n                card.addEventListener('click', () => {\n                    const currentIndex = currentCards.indexOf(card);\n\n                    if (currentIndex === 4) {\n                        // Move front card to back\n                        currentCards.unshift(currentCards.pop());\n                    } else {\n                        // Cycle clicked back card to the front\n                        const diff = 4 - currentIndex;\n                        for (let j = 0; j < diff; j++) {\n                            currentCards.push(currentCards.shift());\n                        }\n                    }\n\n                    // Apply newly ordered states\n                    currentCards.forEach((c, i) => applyState(c, i, true));\n                });\n            });\n        });\n\n        // --- WEBGL HELPER ---\n        const initWebGL = (canvasId, fSource) => {\n            const canvas = document.getElementById(canvasId);\n            const gl = canvas.getContext('webgl');\n            if (!gl) return null;\n\n            const resize = () => {\n                canvas.width = window.innerWidth;\n                canvas.height = window.innerHeight;\n                gl.viewport(0, 0, canvas.width, canvas.height);\n            };\n            window.addEventListener('resize', resize);\n            resize();\n\n            const vSource = `attribute vec2 position; void main() { gl_Position = vec4(position, 0.0, 1.0); }`;\n\n            const compile = (type, src) => {\n                const s = gl.createShader(type);\n                gl.shaderSource(s, src);\n                gl.compileShader(s);\n                return s;\n            };\n\n            const prog = gl.createProgram();\n            gl.attachShader(prog, compile(gl.VERTEX_SHADER, vSource));\n            gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fSource));\n            gl.linkProgram(prog);\n            gl.useProgram(prog);\n\n            const buffer = gl.createBuffer();\n            gl.bindBuffer(gl.ARRAY_BUFFER, buffer);\n            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);\n\n            const posAttr = gl.getAttribLocation(prog, 'position');\n            gl.enableVertexAttribArray(posAttr);\n            gl.vertexAttribPointer(posAttr, 2, gl.FLOAT, false, 0, 0);\n\n            const timeLoc = gl.getUniformLocation(prog, 'u_time');\n            const resLoc = gl.getUniformLocation(prog, 'u_resolution');\n\n            return { gl, prog, timeLoc, resLoc, canvas };\n        };\n\n        // --- DITHER BACKGROUND SHADER ---\n        const ditherSrc = `\n            precision mediump float;\n            uniform float u_time;\n            uniform vec2 u_resolution;\n\n            float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }\n            float noise(vec2 p) {\n                vec2 i = floor(p), f = fract(p);\n                vec2 u = f * f * (3.0 - 2.0 * f);\n                return mix(mix(hash(i + vec2(0.0,0.0)), hash(i + vec2(1.0,0.0)), u.x),\n                           mix(hash(i + vec2(0.0,1.0)), hash(i + vec2(1.0,1.0)), u.x), u.y);\n            }\n            float fbm(vec2 p) {\n                float v = 0.0, a = 0.5;\n                for(int i=0; i<4; i++) { v += a * noise(p); p *= 2.0; a *= 0.5; }\n                return v;\n            }\n\n            void main() {\n                vec2 uv = gl_FragCoord.xy / u_resolution.xy;\n                vec2 p = uv * 3.0 + vec2(u_time * 0.05, u_time * 0.02);\n                float n = fbm(p + fbm(p + u_time * 0.1));\n\n                float dist = length(uv - vec2(0.5, 0.3));\n                n *= smoothstep(1.2, 0.2, dist);\n\n                int x = int(mod(gl_FragCoord.x, 4.0));\n                int y = int(mod(gl_FragCoord.y, 4.0));\n                float bayer;\n                if(x==0&&y==0) bayer=0.0; else if(x==2&&y==0) bayer=8.0; else if(x==1&&y==2) bayer=2.0; else if(x==3&&y==2) bayer=10.0;\n                else if(x==0&&y==2) bayer=12.0; else if(x==2&&y==2) bayer=4.0; else if(x==1&&y==0) bayer=14.0; else if(x==3&&y==0) bayer=6.0;\n                else if(x==0&&y==1) bayer=3.0; else if(x==2&&y==1) bayer=11.0; else if(x==1&&y==3) bayer=1.0; else if(x==3&&y==3) bayer=9.0;\n                else if(x==0&&y==3) bayer=15.0; else if(x==2&&y==3) bayer=7.0; else if(x==1&&y==1) bayer=13.0; else bayer=5.0;\n                bayer = bayer / 16.0;\n\n                float bright = step(bayer, n * 1.5);\n                vec3 darkColor = vec3(0.04, 0.04, 0.05);\n                vec3 lightColor = vec3(0.12, 0.12, 0.15);\n\n                gl_FragColor = vec4(mix(darkColor, lightColor, bright), 1.0);\n            }\n        `;\n\n        // --- WEBGL LASER SHADER ---\n        const laserSrc = `\n            precision mediump float;\n            uniform float u_time;\n            uniform vec2 u_resolution;\n\n            float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }\n            float noise(vec2 p) {\n                vec2 i = floor(p), f = fract(p);\n                vec2 u = f * f * (3.0 - 2.0 * f);\n                return mix(mix(hash(i), hash(i + vec2(1.0,0.0)), u.x), mix(hash(i + vec2(0.0,1.0)), hash(i + vec2(1.0,1.0)), u.x), u.y);\n            }\n            float fbm(vec2 p) {\n                float v = 0.0, a = 0.5;\n                for(int i=0; i<3; i++) { v += a * noise(p); p *= 2.0; a *= 0.5; }\n                return v;\n            }\n\n            void main() {\n                vec2 uv = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / u_resolution.y;\n                float t = u_time * 0.4;\n                float drift = sin(t * 0.5) * 0.1;\n                float warp = (fbm(vec2(uv.y * 3.0, t)) - 0.5) * 0.15;\n                float d = abs(uv.x - drift - warp);\n\n                float core = 0.0008 / (d + 0.0001);\n                core = pow(core, 1.2);\n                float glow = 0.005 / (d + 0.01);\n\n                float smokeNoise = fbm(uv * 5.0 + vec2(0.0, -t * 1.5));\n                float smokeMask = smoothstep(0.4, 0.0, abs(uv.x - drift));\n                float smoke = smokeNoise * smokeMask * 0.6;\n\n                vec3 beamColor = vec3(0.0, 0.4, 1.0);\n                vec3 coreColor = vec3(0.8, 0.9, 1.0);\n                vec3 smokeColor = vec3(0.2, 0.1, 0.6);\n\n                vec3 color = core * coreColor + glow * beamColor + smoke * smokeColor;\n                color *= 0.8 + 0.2 * sin(t * 5.0);\n\n                gl_FragColor = vec4(color, 1.0);\n            }\n        `;\n\n        const ditherCtx = initWebGL('dither-canvas', ditherSrc);\n        const laserCtx = initWebGL('laser-canvas', laserSrc);\n\n        const render = (time) => {\n            time *= 0.001;\n            if (ditherCtx) {\n                ditherCtx.gl.uniform1f(ditherCtx.timeLoc, time);\n                ditherCtx.gl.uniform2f(ditherCtx.resLoc, ditherCtx.canvas.width, ditherCtx.canvas.canvas.height);\n                ditherCtx.gl.drawArrays(ditherCtx.gl.TRIANGLE_STRIP, 0, 4);\n            }\n            if (laserCtx) {\n                laserCtx.gl.uniform1f(laserCtx.timeLoc, time);\n                laserCtx.gl.uniform2f(laserCtx.resLoc, laserCtx.canvas.width, laserCtx.canvas.height);\n                laserCtx.gl.drawArrays(laserCtx.gl.TRIANGLE_STRIP, 0, 4);\n            }\n            requestAnimationFrame(render);\n        };\n        requestAnimationFrame(render);\n    </script>\n</body>\n</html>", "preview_file_name": "vault-interface-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/vault-interface.jpg", "source_name": "vault-interface-1-DESIGN.md", "views": 47, "forks": 1, "private": false, "featured": true, "created_by": "2e815afb-cac1-4c01-90e1-cf3810246e35", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-06-29T21:23:23.409517+00:00"}