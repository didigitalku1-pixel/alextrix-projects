t-[2px] z-10\" aria-hidden=\"true\"></div>\n            <div class=\"absolute w-1 h-1 bg-white/20 -bottom-[2px] left-1/4 -ml-[2px] hidden lg:block z-10\" aria-hidden=\"true\"></div>\n            <div class=\"absolute w-1 h-1 bg-white/20 -bottom-[2px] left-2/4 -ml-[2px] hidden lg:block z-10\" aria-hidden=\"true\"></div>\n            <div class=\"absolute w-1 h-1 bg-white/20 -bottom-[2px] left-3/4 -ml-[2px] hidden lg:block z-10\" aria-hidden=\"true\"></div>\n            <div class=\"absolute w-1 h-1 bg-accent/80 shadow-[0_0_8px_rgba(238,176,87,0.6)] -bottom-[2px] -right-[2px] z-10\" aria-hidden=\"true\"></div>\n\n            <div class=\"flex flex-col lg:flex-row items-stretch justify-between h-auto lg:h-16\">\n                <!-- Brand -->\n                <div class=\"w-full lg:w-1/4 flex items-center gap-3 p-4 lg:px-6 lg:border-r border-white/[0.04]\">\n                    <div class=\"w-5 h-5 flex items-center justify-center text-accent\">\n                        <iconify-icon icon=\"solar:record-circle-linear\" width=\"18\" stroke-width=\"1.5\"></iconify-icon>\n                    </div>\n                    <span class=\"font-medium tracking-tight text-sm text-neutral-100 uppercase tracking-widest\">Syntagma</span>\n                </div>\n\n                <!-- Navigation -->\n                <nav class=\"w-full lg:w-2/4 flex flex-wrap items-center justify-start lg:justify-center gap-8 p-4 lg:px-6 text-xs font-medium text-neutral-500 border-t lg:border-t-0 border-white/[0.02]\">\n                    <a href=\"#\" class=\"hover:text-neutral-200 transition-colors duration-500\">Workspace</a>\n                    <a href=\"#\" class=\"hover:text-neutral-200 transition-colors duration-500\">Nodes</a>\n                    <a href=\"#\" class=\"hover:text-neutral-200 transition-colors duration-500\">Reference</a>\n                    <a href=\"#\" class=\"hover:text-neutral-200 transition-colors duration-500\">Studio</a>\n                </nav>\n\n                <!-- Actions -->\n                <div class=\"w-full lg:w-1/4 flex items-center justify-start lg:justify-end gap-5 p-4 lg:px-6 lg:border-l border-white/[0.04] border-t lg:border-t-0 border-white/[0.02] bg-surface/30 lg:bg-transparent\">\n                    <a href=\"#\" class=\"text-xs font-medium text-neutral-500 hover:text-neutral-200 transition-colors duration-500\">Sign In</a>\n                    <a href=\"#\" class=\"px-4 py-2 text-xs font-medium text-accent border border-accent/20 rounded-full hover:bg-accent/[0.05] hover:border-accent/40 transition-all duration-500 flex items-center gap-2\">\n                        Initialize <iconify-icon icon=\"solar:alt-arrow-right-linear\" width=\"14\" stroke-width=\"1.5\"></iconify-icon>\n                    </a>\n                </div>\n            </div>\n        </header>\n\n        <!-- ================= HERO SECTION (01) ================= -->\n        <section class=\"relative border-b border-white/[0.06] z-40 bg-transparent\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-4 min-h-[75vh]\">\n\n                <!-- Left: Typography Stage -->\n                <div class=\"col-span-1 lg:col-span-3 p-8 lg:p-16 xl:p-24 border-b lg:border-b-0 lg:border-r border-white/[0.04] flex flex-col justify-center relative\">\n                    <!-- Workflow Indicator -->\n                    <div class=\"absolute top-0 left-0 w-full flex justify-between p-4 text-[10px] font-mono text-neutral-600 border-b border-white/[0.02] bg-stage/50 backdrop-blur-sm\">\n                        <span class=\"flex items-center gap-3 tracking-widest uppercase\">\n                            <span class=\"w-1 h-1 bg-accent/60 rounded-full inline-block shadow-[0_0_4px_rgba(238,176,87,0.5)]\"></span> SEQ. 01 / INGESTION\n                        </span>\n                        <span class=\"text-neutral-500\">REC 00:00:00:00</span>\n                    </div>\n\n                    <div class=\"mt-12 max-w-4xl relative z-10 pointer-events-none\">\n                        <h1 class=\"text-5xl lg:text-7xl xl:text-[5rem] font-light tracking-tighter leading-[1.02] text-neutral-50 js-reveal-text drop-shadow-2xl\">\n                            Compose order from <br><span class=\"text-neutral-500\">raw material.</span>\n                        </h1>\n                        <p class=\"mt-10 text-sm lg:text-base text-neutral-400 max-w-lg leading-relaxed font-light tracking-wide pointer-events-auto\">\n                            Route unformatted assets through cinematic reasoning models. Extract semantic layers from dense scripts, scattered frames, and chaotic text into timeline-ready architectures.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Right: Utility Overlay -->\n                <div class=\"col-span-1 flex flex-col justify-end relative bg-transparent\">\n                    <!-- Overlay Panel -->\n                    <div class=\"h-full flex flex-col justify-end p-8 lg:p-10 border-l border-white/[0.02] bg-gradient-to-t from-surface to-transparent backdrop-blur-md\">\n                        <div class=\"relative z-10 w-full\">\n                            <div class=\"mb-6 font-mono text-[10px] text-accent/70 uppercase tracking-[0.2em] border-b border-white/[0.06] pb-3 flex items-center justify-between\">\n                                Master Bus\n                                <iconify-icon icon=\"solar:tuning-square-2-linear\" width=\"14\"></iconify-icon>\n                            </div>\n\n                            <div class=\"flex flex-col gap-2\">\n                                <button class=\"w-full flex items-center justify-between px-5 py-3.5 text-xs font-medium bg-neutral-100 text-stage rounded-sm hover:bg-white transition-colors duration-300 group\">\n                                    <span>Mount Volume</span>\n                                    <iconify-icon icon=\"solar:arrow-right-up-linear\" width=\"16\" class=\"opacity-70 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\"></iconify-icon>\n                                </button>\n                                <button class=\"w-full flex items-center justify-between px-5 py-3.5 text-xs font-medium border border-white/[0.08] text-neutral-300 hover:bg-white/[0.02] hover:text-white rounded-sm transition-all duration-300\">\n                                    <span>Review Specs</span>\n                                    <iconify-icon icon=\"solar:folder-open-linear\" width=\"16\" class=\"text-neutral-500\"></iconify-icon>\n                                </button>\n                            </div>\n\n                            <!-- Telemetry -->\n                            <div class=\"mt-10 p-5 border border-white/[0.04] bg-panel/50 rounded-sm font-mono text-[10px] flex flex-col gap-3 backdrop-blur-sm\">\n                                <div class=\"flex items-center justify-between text-neutral-400\">\n                                    <span class=\"flex items-center gap-2\">\n                                        <span class=\"w-1.5 h-1.5 bg-accent rounded-full animate-pulse\"></span> Engine Live\n                                    </span>\n                                    <span>CH-1</span>\n                                </div>\n                                <div class=\"flex justify-between text-neutral-500\">\n                                    <span>Render Delay</span>\n                                    <span class=\"text-neutral-300\">12ms</span>\n                                </div>\n                                <div class=\"flex justify-between text-neutral-500\">\n                                    <span>Frame Drop</span>\n                                    <span class=\"text-neutral-300\">0.00%</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ================= LOGO MATRIX ================= -->\n        <section class=\"relative border-b border-white/[0.06] bg-surface/50 py-10 overflow-hidden backdrop-blur-sm\">\n            <div class=\"relative z-10 px-8 max-w-5xl mx-auto flex flex-col items-center\">\n                <p class=\"font-mono text-[10px] text-neutral-600 uppercase tracking-[0.2em] mb-8\">Integrated by Studios</p>\n                <div class=\"flex flex-wrap justify-center items-center gap-x-16 gap-y-8 opacity-40 grayscale\">\n                    <div class=\"flex items-center gap-2 text-lg font-medium tracking-tight text-white\"><iconify-icon icon=\"solar:video-frame-linear\" width=\"20\"></iconify-icon> A24</div>\n                    <div class=\"text-lg font-medium tracking-tight text-white\">Framestore</div>\n                    <div class=\"flex items-center gap-2 text-lg font-medium tracking-tight text-white\"><iconify-icon icon=\"solar:clapperboard-play-linear\" width=\"20\"></iconify-icon> ILM</div>\n                    <div class=\"text-lg font-medium tracking-widest uppercase text-white\">Weta</div>\n                    <div class=\"flex items-center gap-1 text-lg font-light text-white\"><iconify-icon icon=\"solar:aperture-linear\" width=\"20\"></iconify-icon> MPC</div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ================= VISUAL EXPLANATION (02) ================= -->\n        <section class=\"relative border-b border-white/[0.06] z-30 bg-stage\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-4\">\n\n                <!-- Left: Editorial Column -->\n                <div class=\"col-span-1 p-8 lg:p-12 border-b lg:border-b-0 lg:border-r border-white/[0.04] flex flex-col justify-between relative bg-gradient-to-br from-surface to-stage\">\n                    <div>\n                        <div class=\"font-mono text-[10px] text-neutral-600 mb-10 border-b border-white/[0.04] pb-3 flex items-center gap-3 uppercase tracking-widest\">\n                            <span class=\"w-1 h-1 bg-neutral-500 rounded-full inline-block\"></span> SEQ. 02 / PROCESSING\n                        </div>\n                        <h2 class=\"text-2xl font-light tracking-tight text-neutral-100 mb-5 leading-snug\">\n                            Frame-accurate <br>schematics.\n                        </h2>\n                        <p class=\"text-xs text-neutral-400 leading-relaxed font-light mb-8\">\n                            Configure your output schema parameters. The engine isolates signal from noise, standardizing heterogeneous assets into strict, predictable data arrays without subjective drift.\n                        </p>\n                    </div>\n\n                    <ul class=\"space-y-5 text-[11px] font-medium text-neutral-500 border-t border-white/[0.04] pt-8 uppercase tracking-wide\">\n                        <li class=\"flex items-center gap-3\">\n                            <iconify-icon icon=\"solar:target-linear\" width=\"16\" class=\"text-accent\"></iconify-icon> Spatial recognition\n                        </li>\n                        <li class=\"flex items-center gap-3\">\n                            <iconify-icon icon=\"solar:layers-minimalistic-linear\" width=\"16\" class=\"text-accent\"></iconify-icon> Multi-layer parsing\n                        </li>\n                        <li class=\"flex items-center gap-3\">\n                            <iconify-icon icon=\"solar:shield-check-linear\" width=\"16\" class=\"text-accent\"></iconify-icon> Drift mitigation\n                        </li>\n                    </ul>\n                </div>\n\n                <!-- Right: Timeline Visual -->\n                <div class=\"col-span-1 lg:col-span-3 p-8 lg:p-16 bg-surface flex items-center justify-center relative overflow-hidden\">\n                    <!-- Subtle grid lines for tension -->\n                    <div class=\"absolute inset-0 z-0 opacity-10 pointer-events-none\" style=\"background-image: repeating-linear-gradient(90deg, transparent, transparent 49px, #ffffff 49px, #ffffff 50px);\"></div>\n\n                    <div class=\"relative z-10 w-full max-w-4xl flex flex-col md:flex-row items-stretch gap-6 md:gap-10\">\n\n                        <!-- Input Monitor Mock -->\n                        <div class=\"flex-1 bg-stage border border-white/[0.08] p-1 shadow-2xl relative\">\n                            <div class=\"bg-panel h-full w-full p-5 flex flex-col gap-4 relative overflow-hidden\">\n                                <!-- Top bar -->\n                                <div class=\"flex justify-between items-center mb-2\">\n                                    <div class=\"bg-stage px-2 py-1 text-[9px] font-mono text-neutral-500 uppercase border border-white/[0.05]\">Source: Shot_04A.mov</div>\n                                    <div class=\"w-2 h-2 rounded-full border border-neutral-600\"></div>\n                                </div>\n\n                                <!-- Abstract Document content -->\n                                <div class=\"w-1/3 h-px bg-white/20 mb-4\"></div>\n                                <div class=\"w-full h-[2px] bg-white/5 mb-2\"></div>\n                                <div class=\"w-5/6 h-[2px] bg-white/5 mb-2\"></div>\n                                <div class=\"w-4/6 h-[2px] bg-white/5 mb-6\"></div>\n\n                                <div class=\"mt-auto border border-white/[0.05] p-3 flex justify-between items-center bg-stage/50 backdrop-blur-sm\">\n                                    <div class=\"flex flex-col gap-1.5\">\n                                        <div class=\"w-12 h-[2px] bg-white/20\"></div>\n                                        <div class=\"w-8 h-[2px] bg-white/10\"></div>\n                                    </div>\n                                    <div class=\"font-mono text-[10px] text-accent tracking-widest\">TC: 01:24:10</div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Scan Axis Indicator -->\n                        <div class=\"flex flex-col items-center justify-center py-4 md:py-0 relative\">\n                            <div class=\"hidden md:block w-px h-full bg-gradient-to-b from-transparent via-accent/30 to-transparent absolute left-1/2 -translate-x-1/2\"></div>\n                            <div class=\"bg-stage border border-accent/30 rounded-full p-2 text-accent relative z-10 shadow-[0_0_15px_rgba(238,176,87,0.2)]\">\n                                <iconify-icon icon=\"solar:scanner-linear\" width=\"18\" class=\"rotate-90 md:rotate-0\"></iconify-icon>\n                            </div>\n                        </div>\n\n                        <!-- Output Terminal Mock -->\n                        <div class=\"flex-1 bg-stage border border-white/[0.08] shadow-2xl relative flex flex-col\">\n                            <div class=\"absolute -top-3 left-4 bg-panel px-3 py-1 text-[9px] font-mono text-accent uppercase border border-accent/20 tracking-wider shadow-[0_0_10px_rgba(238,176,87,0.1)]\">Compiled Struct</div>\n                            <div class=\"p-6 pt-8 font-mono text-[11px] leading-[1.8] overflow-x-auto whitespace-pre text-neutral-400\">\n<span class=\"text-neutral-500\">{</span>\n  <span class=\"text-neutral-300\">\"asset_class\"</span>: <span class=\"text-accent/80\">\"vfx_plate\"</span>,\n  <span class=\"text-neutral-300\">\"metadata\"</span>: <span class=\"text-neutral-500\">{</span>\n    <span class=\"text-neutral-300\">\"camera\"</span>: <span class=\"text-accent/80\">\"ARRI Alexa 65\"</span>,\n    <span class=\"text-neutral-300\">\"lens_mm\"</span>: <span class=\"text-white\">35</span>,\n    <span class=\"text-neutral-300\">\"confidence\"</span>: <span class=\"text-white\">0.998</span>\n  <span class=\"text-neutral-500\">}</span>,\n  <span class=\"text-neutral-300\">\"track_points\"</span>: <span class=\"text-white\">1240</span>,\n  <span class=\"text-neutral-300\">\"markers\"</span>: <span class=\"text-neutral-500\">[...]</span>\n<span class=\"text-neutral-500\">}</span></div>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ================= BOTTOM CTA (03) ================= -->\n        <section class=\"relative flex-grow flex flex-col bg-stage\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-4 h-full\">\n\n                <!-- Left spacer/meta -->\n                <div class=\"hidden lg:flex col-span-1 border-r border-white/[0.04] p-8 flex-col justify-start bg-gradient-to-t from-stage to-surface/30\">\n                     <div class=\"font-mono text-[10px] text-neutral-600 border-b border-white/[0.04] pb-3 flex items-center gap-3 w-full uppercase tracking-widest\">\n                        <span class=\"w-1 h-1 bg-neutral-500 rounded-full inline-block\"></span> SEQ. 03 / EXPORT\n                    </div>\n                </div>\n\n                <!-- Main Action Content -->\n                <div class=\"col-span-1 lg:col-span-3 p-8 lg:p-16 xl:p-24 flex flex-col md:flex-row items-start md:items-center justify-between gap-16 relative\">\n\n                    <div class=\"max-w-lg relative z-10\">\n                        <h2 class=\"text-3xl lg:text-4xl font-light tracking-tight leading-[1.1] text-neutral-100 mb-6\">\n                            Initialize your production environment.\n                        </h2>\n                        <p class=\"text-xs text-neutral-400 mb-10 font-light leading-relaxed\">\n                            Provision an API key to access the parsing cluster. The first 10,000 passes are on the house for indie developers and boutique post houses.\n                        </p>\n\n                        <div class=\"flex items-center gap-4\">\n                            <a href=\"#\" class=\"px-6 py-3 text-xs font-medium bg-accent text-stage rounded-sm hover:bg-accent/90 transition-colors duration-300 flex items-center gap-2\">\n                                Generate Token <iconify-icon icon=\"solar:key-minimalistic-linear\" width=\"14\"></iconify-icon>\n                            </a>\n                            <a href=\"#\" class=\"px-6 py-3 text-xs font-medium border border-white/[0.1] text-neutral-300 rounded-sm hover:bg-white/[0.03] hover:text-white transition-colors duration-300\">\n                                License Tiers\n                            </a>\n                        </div>\n                    </div>\n\n                    <!-- Mini Spec Card -->\n                    <div class=\"w-full md:w-auto p-8 border border-white/[0.06] bg-panel/30 backdrop-blur-md rounded-sm flex flex-col gap-5 min-w-[300px] relative overflow-hidden group hover:border-white/[0.1] transition-colors duration-500\">\n                        <div class=\"absolute top-0 right-0 w-16 h-16 bg-accent/5 rounded-full blur-2xl -mr-8 -mt-8 group-hover:bg-accent/10 transition-colors duration-500\"></div>\n                        <div class=\"text-[9px] font-mono text-neutral-500 uppercase tracking-[0.2em] border-b border-white/[0.06] pb-3\">Boutique Instance</div>\n                        <ul class=\"space-y-4 text-[11px] text-neutral-300 font-medium\">\n                            <li class=\"flex items-center justify-between\">\n                                <span class=\"text-neutral-500\">Bandwidth</span>\n                                <span class=\"text-white\">10k frames/mo</span>\n                            </li>\n                            <li class=\"flex items-center justify-between\">\n                                <span class=\"text-neutral-500\">Nodes</span>\n                                <span class=\"text-white\">15 req/s limit</span>\n                            </li>\n                            <li class=\"flex items-center justify-between\">\n                                <span class=\"text-neutral-500\">Blueprints</span>\n                                <span class=\"text-white\">Infinite</span>\n                            </li>\n                            <li class=\"flex items-center justify-between border-t border-white/[0.04] pt-4 mt-2\">\n                                <span class=\"text-neutral-500 tracking-widest\">FEE</span>\n                                <span class=\"text-accent font-mono\">0.00 USD</span>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Bottom Grid Intersections -->\n            <div class=\"absolute w-1 h-1 bg-white/20 -top-[2px] -left-[2px] hidden lg:block z-10\" aria-hidden=\"true\"></div>\n            <div class=\"absolute w-1 h-1 bg-white/20 -top-[2px] left-1/4 -ml-[2px] hidden lg:block z-10\" aria-hidden=\"true\"></div>\n\n        </section>\n\n    </main>\n\n    <!-- Scripts -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n\n            // --- GSAP Text Reveal ---\n            const revealTextEl = document.querySelector('.js-reveal-text');\n            if (revealTextEl) {\n                // Get raw HTML to preserve breaks\n                const htmlContent = revealTextEl.innerHTML;\n                revealTextEl.innerHTML = '';\n\n                // Temporary div to parse nodes\n                const tempDiv = document.createElement('div');\n                tempDiv.innerHTML = htmlContent;\n\n                Array.from(tempDiv.childNodes).forEach(node => {\n                    if (node.nodeType === Node.TEXT_NODE) {\n                        const words = node.textContent.split(/(\\s+)/).filter(w => w.length > 0);\n                        words.forEach(word => {\n                            if (word.trim() === '') {\n                                revealTextEl.appendChild(document.createTextNode(word));\n                            } else {\n                                const wrapper = document.createElement('span');\n                                wrapper.style.display = 'inline-block';\n                                wrapper.style.overflow = 'hidden';\n                                wrapper.style.verticalAlign = 'top';\n                                wrapper.className = 'mr-[0.02em] pb-2';\n\n                                const inner = document.createElement('span');\n                                inner.className = 'js-reveal-word';\n                                inner.style.display = 'inline-block';\n                                inner.style.transform = 'translateY(110%)';\n                                inner.style.willChange = 'transform, opacity';\n                                inner.style.opacity = '0';\n                                inner.innerText = word;\n\n                                wrapper.appendChild(inner);\n                                revealTextEl.appendChild(wrapper);\n                            }\n                        });\n                    } else {\n                        // Keep tags like <br> or nested <span>\n                        if(node.tagName === 'BR') {\n                           revealTextEl.appendChild(node.cloneNode(true));\n                        } else if(node.tagName === 'SPAN') {\n                            // Process inner span words\n                             const words = node.textContent.split(/(\\s+)/).filter(w => w.length > 0);\n                             const spanWrapper = document.createElement('span');\n                             spanWrapper.className = node.className;\n\n                             words.forEach(word => {\n                                if (word.trim() === '') {\n                                    spanWrapper.appendChild(document.createTextNode(word));\n                                } else {\n                                    const wrapper = document.createElement('span');\n                                    wrapper.style.display = 'inline-block';\n                                    wrapper.style.overflow = 'hidden';\n                                    wrapper.style.verticalAlign = 'top';\n\n                                    const inner = document.createElement('span');\n                                    inner.className = 'js-reveal-word';\n                                    inner.style.display = 'inline-block';\n                                    inner.style.transform = 'translateY(110%)';\n                                    inner.style.willChange = 'transform, opacity';\n                                    inner.style.opacity = '0';\n                                    inner.innerText = word;\n\n                                    wrapper.appendChild(inner);\n                                    spanWrapper.appendChild(wrapper);\n                                }\n                             });\n                             revealTextEl.appendChild(spanWrapper);\n                        }\n                    }\n                });\n\n                if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {\n                    gsap.registerPlugin(ScrollTrigger);\n                    const revealWords = document.querySelectorAll('.js-reveal-word');\n\n                    gsap.to(revealWords, {\n                        y: \"0%\",\n                        opacity: 1,\n                        ease: \"power3.out\",\n                        duration: 1.4,\n                        stagger: 0.04,\n                        delay: 0.2,\n                        scrollTrigger: {\n                            trigger: revealTextEl,\n                            start: \"top 85%\",\n                        }\n                    });\n                } else {\n                    document.querySelectorAll('.js-reveal-word').forEach(el => {\n                        el.style.transform = 'translateY(0)';\n                        el.style.opacity = '1';\n                    });\n                }\n            }\n\n            // --- Three.js WebGL Object ---\n            if(typeof THREE !== 'undefined') {\n                const container = document.getElementById('webgl-container');\n                const scene = new THREE.Scene();\n\n                // Perspective Camera for depth\n                const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);\n                // Position camera to align with hero section left side\n                camera.position.set(0, 0, 35);\n\n                const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });\n                renderer.setSize(window.innerWidth, window.innerHeight);\n                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n                container.appendChild(renderer.domElement);\n\n                // Geometric Mesh (Faceted Shape)\n                // Icosahedron with low detail for distinct facets\n                const geometry = new THREE.IcosahedronGeometry(12, 1);\n\n                // Physically-based material\n                const material = new THREE.MeshStandardMaterial({\n                    color: 0x111111,\n                    roughness: 0.4,\n                    metalness: 0.9,\n                    flatShading: true, // Emphasizes facets\n                });\n\n                const globe = new THREE.Mesh(geometry, material);\n\n                // Position to sit behind the text\n                globe.position.set(-5, 5, -10);\n                scene.add(globe);\n\n                // Lighting\n                // Subtle ambient blue/white\n                const ambientLight = new THREE.AmbientLight(0x404050, 0.5);\n                scene.add(ambientLight);\n\n                // Directional light representing the 'gold' accent\n                const directionalLight = new THREE.DirectionalLight(0xeeb057, 2.5);\n                directionalLight.position.set(10, 20, 10);\n                scene.add(directionalLight);\n\n                // Second light for rim lighting\n                const rimLight = new THREE.DirectionalLight(0xffffff, 0.8);\n                rimLight.position.set(-20, -10, -10);\n                scene.add(rimLight);\n\n                // Add subtle inner glow/wireframe overlay for extra detail\n                const wireframeMaterial = new THREE.MeshBasicMaterial({\n                    color: 0xeeb057,\n                    wireframe: true,\n                    transparent: true,\n                    opacity: 0.05\n                });\n                const wireframe = new THREE.Mesh(geometry, wireframeMaterial);\n                globe.add(wireframe);\n\n                // Animation loop\n                const clock = new THREE.Clock();\n\n                function animate() {\n                    requestAnimationFrame(animate);\n\n                    const time = clock.getElapsedTime();\n\n                    // Slow, ambient rotation\n                    globe.rotation.y += 0.002;\n                    globe.rotation.x += 0.001;\n\n                    // Subtle floating motion\n                    globe.position.y = 5 + Math.sin(time * 0.5) * 0.8;\n\n                    renderer.render(scene, camera);\n                }\n\n                animate();\n\n                // Handle Resize\n                window.addEventListener('resize', () => {\n                    camera.aspect = window.innerWidth / window.innerHeight;\n                    camera.updateProjectionMatrix();\n                    renderer.setSize(window.innerWidth, window.innerHeight);\n                });\n            }\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "syntagma-cinematic-data-extraction.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/syntagma-cinematic-data-extraction.jpg", "source_name": "syntagma-cinematic-data-extraction-DESIGN.md", "views": 68, "forks": 5, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T17:32:53.579935+00:00"}