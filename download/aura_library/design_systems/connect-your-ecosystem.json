                 <div class=\"flex items-center justify-center gap-1.5 text-[10px] font-medium text-slate-500 uppercase tracking-wider\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]\"></div> Connected\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Snowflake (Far Right) -->\n                <div class=\"float-card absolute top-[45%] -right-[5%] z-30 group cursor-pointer\" style=\"animation-delay: -1.5s;\">\n                    <div class=\"bg-white/90 backdrop-blur-md rounded-[1.25rem] shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-slate-100 p-3.5 pr-5 flex flex-col gap-2 transition-all duration-300 group-hover:scale-105 group-hover:shadow-[0_12px_40px_rgb(0,0,0,0.1)] group-hover:bg-white relative\">\n                        <div class=\"w-10 h-10 rounded-full bg-white border border-slate-100 flex items-center justify-center absolute -top-6 left-1/2 -translate-x-1/2 shadow-sm\">\n                           <iconify-icon icon=\"simple-icons:snowflake\" class=\"text-[1.2rem] text-[#29B5E8]\"></iconify-icon>\n                        </div>\n                        <div class=\"pt-3 text-center\">\n                            <div class=\"text-[13px] font-semibold text-slate-800 leading-none mb-1\">Snowflake</div>\n                            <div class=\"flex items-center justify-center gap-1.5 text-[10px] font-medium text-slate-500 uppercase tracking-wider\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]\"></div> Connected\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Minor UI Ornaments (Small nodes on lines) -->\n                <div class=\"absolute top-[28%] left-[10%] w-6 h-6 rounded-lg bg-white/80 border border-slate-200 shadow-sm flex items-center justify-center backdrop-blur-sm z-20 float-card\" style=\"animation-delay: -0.2s;\">\n                    <iconify-icon icon=\"solar:folder-linear\" class=\"text-blue-500 text-xs\"></iconify-icon>\n                </div>\n                <div class=\"absolute top-[28%] left-[16%] w-6 h-6 rounded-lg bg-white/80 border border-slate-200 shadow-sm flex items-center justify-center backdrop-blur-sm z-20 float-card\" style=\"animation-delay: -1.2s;\">\n                    <iconify-icon icon=\"solar:chart-linear\" class=\"text-orange-400 text-xs\"></iconify-icon>\n                </div>\n\n                <div class=\"absolute top-[25%] right-[25%] w-5 h-5 rounded-full bg-blue-50 border border-blue-100 shadow-sm flex items-center justify-center z-20\">\n                    <iconify-icon icon=\"solar:camera-linear\" class=\"text-blue-500 text-[10px]\"></iconify-icon>\n                </div>\n\n                <div class=\"absolute bottom-[35%] left-[25%] w-5 h-5 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center z-20\">\n                    <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-indigo-500 text-[10px]\"></iconify-icon>\n                </div>\n\n                <div class=\"absolute top-[30%] -right-[5%] w-6 h-6 rounded-full bg-blue-50 border border-blue-200 shadow-sm flex items-center justify-center z-20\">\n                    <iconify-icon icon=\"solar:database-linear\" class=\"text-blue-600 text-xs\"></iconify-icon>\n                </div>\n\n                <div class=\"absolute bottom-[30%] right-[15%] w-5 h-5 rounded-full bg-indigo-500 shadow-md flex items-center justify-center z-20\">\n                    <iconify-icon icon=\"solar:rocket-linear\" class=\"text-white text-[10px]\"></iconify-icon>\n                </div>\n\n                <!-- Floating Dust Particles -->\n                <div class=\"absolute top-[20%] left-[5%] w-1 h-1 bg-blue-400 rounded-full blur-[1px]\"></div>\n                <div class=\"absolute top-[60%] left-[-5%] w-1.5 h-1.5 bg-indigo-400 rounded-full blur-[1px]\"></div>\n                <div class=\"absolute bottom-[10%] left-[40%] w-1 h-1 bg-blue-500 rounded-full blur-[1px]\"></div>\n                <div class=\"absolute top-[10%] right-[5%] w-1.5 h-1.5 bg-blue-300 rounded-full blur-[1px]\"></div>\n                <div class=\"absolute bottom-[20%] right-[-10%] w-1 h-1 bg-indigo-500 rounded-full blur-[1px]\"></div>\n            </div>\n        </div>\n\n        <!-- Bottom Feature Bar -->\n        <div class=\"relative z-10 mt-20 lg:mt-32 w-full bg-white/60 backdrop-blur-xl border border-white/80 shadow-[0_8px_30px_rgb(0,0,0,0.02)] rounded-2xl p-6 sm:p-8\">\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 divide-y sm:divide-y-0 sm:divide-x divide-slate-100\">\n\n                <!-- Feature 1 -->\n                <div class=\"flex items-start gap-4 lg:pr-8 pt-4 sm:pt-0 first:pt-0\">\n                    <div class=\"shrink-0 w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center\">\n                        <iconify-icon icon=\"solar:bolt-linear\" class=\"text-blue-600 text-xl\"></iconify-icon>\n                    </div>\n                    <div>\n                        <h3 class=\"text-sm font-semibold text-slate-900 mb-1\">Real-time sync</h3>\n                        <p class=\"text-xs text-slate-500 leading-relaxed\">Data flows instantly across all your connected tools.</p>\n                    </div>\n                </div>\n\n                <!-- Feature 2 -->\n                <div class=\"flex items-start gap-4 lg:px-8 pt-6 sm:pt-0\">\n                    <div class=\"shrink-0 w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center\">\n                        <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-blue-600 text-xl\"></iconify-icon>\n                    </div>\n                    <div>\n                        <h3 class=\"text-sm font-semibold text-slate-900 mb-1\">Enterprise secure</h3>\n                        <p class=\"text-xs text-slate-500 leading-relaxed\">SOC 2 compliant with end-to-end encryption & SSO.</p>\n                    </div>\n                </div>\n\n                <!-- Feature 3 -->\n                <div class=\"flex items-start gap-4 lg:px-8 pt-6 sm:pt-6 lg:pt-0\">\n                    <div class=\"shrink-0 w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center\">\n                        <iconify-icon icon=\"solar:graph-up-linear\" class=\"text-blue-600 text-xl\"></iconify-icon>\n                    </div>\n                    <div>\n                        <h3 class=\"text-sm font-semibold text-slate-900 mb-1\">Unified insights</h3>\n                        <p class=\"text-xs text-slate-500 leading-relaxed\">Bring all your data together for a single source of truth.</p>\n                    </div>\n                </div>\n\n                <!-- Feature 4 -->\n                <div class=\"flex items-start gap-4 lg:pl-8 pt-6 sm:pt-6 lg:pt-0\">\n                    <div class=\"shrink-0 w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center\">\n                        <iconify-icon icon=\"solar:users-group-two-rounded-linear\" class=\"text-blue-600 text-xl\"></iconify-icon>\n                    </div>\n                    <div>\n                        <h3 class=\"text-sm font-semibold text-slate-900 mb-1\">Built for teams</h3>\n                        <p class=\"text-xs text-slate-500 leading-relaxed\">Collaborate seamlessly across your organization.</p>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n    </main>\n\n    <!-- GSAP Animations -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // 1. Text Reveal Animation (Staggered Mask)\n            gsap.set(\".reveal-text\", { yPercent: 120, opacity: 0 });\n\n            gsap.to(\".reveal-text\", {\n                yPercent: 0,\n                opacity: 1,\n                duration: 1.2,\n                stagger: 0.15,\n                ease: \"power4.out\",\n                scrollTrigger: {\n                    trigger: \".hero-content\",\n                    start: \"top 80%\",\n                }\n            });\n\n            // 2. Floating Cards Animation\n            const cards = gsap.utils.toArray('.float-card');\n            cards.forEach((card, i) => {\n                // Randomize slightly for organic feel\n                const duration = 3 + Math.random() * 2;\n                const yOffset = -10 - Math.random() * 10;\n\n                gsap.to(card, {\n                    y: yOffset,\n                    duration: duration,\n                    yoyo: true,\n                    repeat: -1,\n                    ease: \"sine.inOut\",\n                    delay: -Math.random() * 2 // Start at different points\n                });\n            });\n\n            // 3. Subtle Globe Parallax on Mouse Move\n            const globeContainer = document.querySelector('.right-globe-container');\n            document.addEventListener('mousemove', (e) => {\n                if(!globeContainer) return;\n                const xAxis = (window.innerWidth / 2 - e.pageX) / 50;\n                const yAxis = (window.innerHeight / 2 - e.pageY) / 50;\n\n                gsap.to(globeContainer, {\n                    rotationY: xAxis,\n                    rotationX: yAxis,\n                    duration: 1,\n                    ease: \"power1.out\"\n                });\n            });\n\n            // 4. Slow Orbit Rotation\n            gsap.to(\".globe-rotate\", {\n                rotationZ: 360,\n                duration: 100,\n                repeat: -1,\n                ease: \"none\"\n            });\n\n            // 5. Core Pulse\n            gsap.to(\".pulse-core\", {\n                scale: 1.05,\n                boxShadow: \"0 0 20px rgba(255,255,255,0.8)\",\n                duration: 2,\n                yoyo: true,\n                repeat: -1,\n                ease: \"sine.inOut\"\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "connect-your-ecosystem.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/connect-your-ecosystem.jpg", "source_name": "connect-your-ecosystem-DESIGN.md", "views": 724, "forks": 15, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-03T18:14:32.027088+00:00"}