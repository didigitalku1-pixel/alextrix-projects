0 0) content-box, linear-gradient(#000 0 0);\n        -webkit-mask-composite: xor;\n        mask-composite: exclude;\"></div>\n\n        <div aria-hidden=\"true\" class=\"pointer-events-none absolute -left-16 top-0 h-full w-44 opacity-90 blur-2xl sm:w-56\" style=\"background:\n        radial-gradient(ellipse at top left, rgba(255,255,255,0.9), rgba(186,144,255,0.75) 28%, rgba(106,66,255,0.35) 54%, rgba(0,0,0,0) 74%);\"></div>\n        <div aria-hidden=\"true\" class=\"pointer-events-none absolute -right-16 top-0 h-full w-44 opacity-90 blur-2xl sm:w-56\" style=\"background:\n        radial-gradient(ellipse at top right, rgba(255,255,255,0.9), rgba(186,144,255,0.75) 28%, rgba(106,66,255,0.35) 54%, rgba(0,0,0,0) 74%);\"></div>\n\n        <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 rounded-[1.75rem]\" style=\"background:\n        linear-gradient(90deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 8%, rgba(255,255,255,0) 92%, rgba(255,255,255,0.02) 100%);\"></div>\n\n        <div class=\"relative z-20 border-b border-white/10\">\n          <div class=\"mx-auto flex w-full max-w-[84rem] items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8\">\n            <a href=\"#\" class=\"flex items-center gap-3\">\n              <div class=\"flex h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-white/5 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]\">\n                <div class=\"grid grid-cols-2 gap-[0.18rem]\">\n                  <span class=\"h-1.5 w-1.5 rounded-full bg-white\"></span>\n                  <span class=\"h-1.5 w-1.5 rounded-full bg-white/90\"></span>\n                  <span class=\"h-1.5 w-1.5 rounded-full bg-white/80\"></span>\n                  <span class=\"h-1.5 w-1.5 rounded-full bg-white/70\"></span>\n                </div>\n              </div>\n              <span class=\"text-sm font-normal tracking-[-0.02em] text-white/95\">NXGD</span>\n            </a>\n\n            <nav class=\"hidden items-center gap-6 md:flex\">\n              <a href=\"#\" class=\"text-xs font-light text-white/70 transition hover:text-white\">Architecture</a>\n              <a href=\"#\" class=\"text-xs font-light text-white/70 transition hover:text-white\">Framework</a>\n              <a href=\"#\" class=\"text-xs font-light text-white/70 transition hover:text-white\">Validation</a>\n              <a href=\"#\" class=\"text-xs font-light text-white/70 transition hover:text-white\">Whitepaper</a>\n              <a href=\"#\" class=\"text-xs font-light text-white/70 transition hover:text-white\">Network</a>\n              <a href=\"#\" class=\"text-xs font-light text-white/70 transition hover:text-white\">Exchange</a>\n            </nav>\n\n            <a href=\"#\" class=\"group inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-4 py-2 text-xs font-light text-white/90 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md transition hover:border-violet-300/30 hover:bg-white/[0.07]\">\n              <span>Initialize Node</span>\n              <iconify-icon icon=\"solar:arrow-right-up-linear\" width=\"16\" height=\"16\" style=\"color: rgba(255,255,255,0.85);\"></iconify-icon>\n            </a>\n          </div>\n        </div>\n\n        <div class=\"relative\">\n          <canvas id=\"webgl-lines\" class=\"absolute inset-0 h-full w-full mix-blend-screen opacity-90\"></canvas>\n\n          <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 opacity-80\" style=\"background:\n          radial-gradient(circle at center, rgba(92, 59, 255, 0.08), rgba(0,0,0,0) 32%),\n          radial-gradient(circle at center, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.02) 24%, rgba(0,0,0,0) 56%);\"></div>\n\n          <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-x-0 top-0 h-32\" style=\"background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0));\"></div>\n\n          <div class=\"relative z-10 flex min-h-[40rem] flex-col items-center justify-start px-4 pb-14 pt-10 sm:px-6 sm:pt-14 md:min-h-[44rem] lg:px-8 lg:pt-16\">\n\n            <div aria-hidden=\"true\" class=\"relative mb-8 flex h-[15rem] w-full max-w-4xl items-start justify-center sm:h-[18rem] md:h-[20rem]\">\n              <div class=\"absolute inset-x-0 top-[15%] mx-auto h-[60%] w-[88%] rounded-[999px] blur-3xl\" style=\"background: radial-gradient(circle, rgba(109,77,255,0.12), rgba(109,77,255,0.04) 32%, rgba(0,0,0,0) 70%);\"></div>\n              <div id=\"orb-wrap\" class=\"relative mt-2 h-44 w-44 sm:h-56 sm:w-56 md:h-64 md:w-64\">\n                <div class=\"absolute inset-0 rounded-full blur-2xl\" style=\"background: radial-gradient(circle, rgba(140,117,255,0.55), rgba(90,66,255,0.22) 42%, rgba(0,0,0,0) 70%);\"></div>\n                <div class=\"absolute inset-[2%] rounded-full border border-white/15\" style=\"background:\n                radial-gradient(circle at 32% 24%, rgba(255,255,255,0.42), rgba(255,255,255,0.08) 18%, rgba(0,0,0,0) 28%),\n                radial-gradient(circle at 50% 38%, rgba(110,93,255,0.85), rgba(58,41,171,0.72) 58%, rgba(13,9,60,0.96) 100%);\n                box-shadow: inset -0.4rem -0.8rem 2rem rgba(0,0,0,0.42), inset 0.4rem 0.6rem 1.4rem rgba(255,255,255,0.08), 0 0 2.5rem rgba(118,88,255,0.22);\"></div>\n                <div class=\"absolute inset-[3.2%] rounded-full opacity-60\" style=\"background:\n                radial-gradient(circle at 34% 24%, rgba(255,255,255,0.28), rgba(255,255,255,0) 22%),\n                radial-gradient(circle at 55% 55%, rgba(0,0,0,0), rgba(0,0,0,0.18) 60%, rgba(0,0,0,0.28) 100%);\"></div>\n                <div class=\"absolute inset-0 rounded-full border border-violet-200/40 opacity-90\" style=\"box-shadow: 0 0 1.2rem rgba(174,156,255,0.35), inset 0 0 1rem rgba(255,255,255,0.06);\"></div>\n              </div>\n            </div>\n\n            <div class=\"relative mx-auto flex w-full max-w-4xl flex-col items-center text-center\">\n              <div class=\"masked-reveal\">\n                <h1 class=\"reveal-text max-w-4xl text-balance text-4xl font-medium leading-none tracking-tight text-white sm:text-5xl md:text-6xl\">\n                  Distributed Neural Consensus Infrastructure\n                </h1>\n              </div>\n              <div class=\"masked-reveal mt-1\">\n                <h1 class=\"reveal-text max-w-4xl text-balance text-4xl font-medium leading-none tracking-tight text-[#cdbdff] sm:text-5xl md:text-6xl\">\n                  Throughout The Nexus Grid\n                </h1>\n              </div>\n\n              <div class=\"masked-reveal mt-6\">\n                <p class=\"reveal-text max-w-xl text-balance text-sm font-light leading-6 text-white/60 sm:text-base\">\n                  A unified intelligence orchestration framework built to process 3.8M+ inferences with cryptographically secure routing via an active node matrix.\n                </p>\n              </div>\n\n              <div class=\"masked-reveal mt-8 overflow-hidden\">\n                <div class=\"reveal-text\">\n                  <a href=\"#\" class=\"group inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-5 py-3 text-xs font-light text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.08),0_10px_30px_rgba(63,29,157,0.18)] backdrop-blur-md transition hover:border-violet-300/30 hover:bg-white/[0.08]\">\n                    <span>Deploy Framework</span>\n                    <iconify-icon icon=\"solar:arrow-right-linear\" width=\"16\" height=\"16\" style=\"color: rgba(255,255,255,0.9);\"></iconify-icon>\n                  </a>\n                </div>\n              </div>\n            </div>\n\n            <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\">\n              <div class=\"absolute inset-y-0 left-[14%] hidden w-px bg-white/[0.04] md:block\"></div>\n              <div class=\"absolute inset-y-0 left-[28%] hidden w-px bg-white/[0.04] md:block\"></div>\n              <div class=\"absolute inset-y-0 right-[28%] hidden w-px bg-white/[0.04] md:block\"></div>\n              <div class=\"absolute inset-y-0 right-[14%] hidden w-px bg-white/[0.04] md:block\"></div>\n            </div>\n          </div>\n        </div>\n      </section>\n    </main>\n  </div>\n\n  <script>\n    (function () {\n      // Dither Style WebGL Canvas\n      const canvas = document.getElementById('webgl-lines');\n      const gl = canvas.getContext('webgl', { antialias: false, alpha: true });\n      if (gl) {\n        const vs = gl.createShader(gl.VERTEX_SHADER);\n        gl.shaderSource(vs, `attribute vec2 p;void main(){gl_Position=vec4(p,0.0,1.0);}`);\n        gl.compileShader(vs);\n        const fs = gl.createShader(gl.FRAGMENT_SHADER);\n        gl.shaderSource(fs, `\n          precision highp float;\n          uniform vec2 r;\n          uniform float t;\n          float h(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);}\n          void main(){\n            vec2 uv = gl_FragCoord.xy / r;\n            vec2 p = uv - 0.5;\n            p.x *= r.x / r.y;\n            float d = length(p);\n            float g = smoothstep(0.85, 0.0, d + sin(t*0.6+uv.x*4.0)*0.15);\n            vec3 c = mix(vec3(0.02,0.01,0.05), vec3(0.4,0.15,0.9), g);\n            // Dither quantization\n            c = floor(c * 6.0 + h(gl_FragCoord.xy)*0.85) / 6.0;\n            gl_FragColor = vec4(c, g * 0.45);\n          }\n        `);\n        gl.compileShader(fs);\n        const prog = gl.createProgram();\n        gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);\n        gl.useProgram(prog);\n        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);\n        gl.enableVertexAttribArray(0);\n        gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);\n\n        const rLoc = gl.getUniformLocation(prog, 'r');\n        const tLoc = gl.getUniformLocation(prog, 't');\n\n        function resize() {\n          canvas.width = canvas.clientWidth;\n          canvas.height = canvas.clientHeight;\n          gl.viewport(0, 0, canvas.width, canvas.height);\n        }\n        window.addEventListener('resize', resize, { passive: true });\n        resize();\n\n        function draw(time) {\n          gl.uniform2f(rLoc, canvas.width, canvas.height);\n          gl.uniform1f(tLoc, time * 0.001);\n          gl.drawArrays(gl.TRIANGLES, 0, 3);\n          requestAnimationFrame(draw);\n        }\n        requestAnimationFrame(draw);\n      }\n\n      // GSAP Animations\n      gsap.registerPlugin(ScrollTrigger);\n\n      // Masked Staggered Word Reveal\n      document.querySelectorAll('.masked-reveal').forEach((el, i) => {\n        const textEl = el.querySelector('.reveal-text');\n        if(textEl && (textEl.tagName === 'H1' || textEl.tagName === 'P')) {\n          const words = textEl.textContent.trim().split(/\\s+/);\n          textEl.innerHTML = words.map(w => `<span class=\"inline-block overflow-hidden align-top\"><span class=\"reveal-word inline-block\">${w}</span></span>`).join(' ');\n        } else if(textEl) {\n          textEl.innerHTML = `<span class=\"inline-block overflow-hidden align-top\"><span class=\"reveal-word inline-block\">${textEl.innerHTML}</span></span>`;\n        }\n\n        gsap.fromTo(el.querySelectorAll('.reveal-word'),\n          { yPercent: 115, opacity: 0 },\n          { yPercent: 0, opacity: 1, duration: 1, ease: 'power3.out', stagger: 0.025, delay: i * 0.08,\n            scrollTrigger: { trigger: el, start: 'top 92%', once: true }\n          }\n        );\n      });\n\n      gsap.to('#orb-wrap', {\n        y: 12,\n        duration: 3.5,\n        repeat: -1,\n        yoyo: true,\n        ease: 'sine.inOut'\n      });\n\n      gsap.to('#orb-wrap', {\n        rotate: 4,\n        duration: 8,\n        repeat: -1,\n        yoyo: true,\n        ease: 'sine.inOut'\n      });\n    })();\n  </script>\n</body>\n</html>", "preview_file_name": "nexusgrid-protocol.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexusgrid-protocol.jpg", "source_name": "nexusgrid-protocol-DESIGN.md", "views": 120, "forks": 9, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-06-30T07:34:22.384315+00:00"}