r-1.5 opacity-80 mt-[1px] text-[#FF0B0B]\"></iconify-icon>\n                            <span>System Telemetry<br>Access v3.1 [Active]<br>Node Synchronization<br>T-808-00</span>\n                        </p>\n                    </div>\n\n                    <!-- Node 4 Blocks -->\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-white/10 border border-white/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: 0; --y: -2;\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-white/10 border border-white/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: 0; --y: -1;\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-white/10 border border-white/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: -2; --y: 0;\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-white/10 border border-white/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: -1; --y: 0;\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-[#FF0B0B] node-accent top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: 0; --y: 0; box-shadow: 0 0 10px rgba(255,11,11,0.4);\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-white/10 border border-white/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: 1; --y: 0;\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-white/10 border border-white/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: 2; --y: 0;\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-[#FF0B0B] node-accent top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: 0; --y: 1; box-shadow: 0 0 10px rgba(255,11,11,0.4);\"></div>\n                    <div class=\"node-block opacity-0 scale-50 absolute w-[14px] h-[14px] md:w-[18px] md:h-[18px] bg-white/10 border border-white/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-[calc(16px*var(--x))] mt-[calc(16px*var(--y))] md:ml-[calc(20px*var(--x))] md:mt-[calc(20px*var(--y))]\" style=\"--x: 0; --y: 2;\"></div>\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Masked Staggered Word Reveal\n            gsap.to('.reveal-word', {\n                y: 0,\n                duration: 1.2,\n                ease: \"power4.out\",\n                stagger: 0.04,\n                delay: 0.1\n            });\n\n            // Node Evolution Animation\n            gsap.to('.node-block', {\n                scale: 1,\n                opacity: 1,\n                duration: 0.6,\n                stagger: {\n                    amount: 1.8,\n                    from: \"start\"\n                },\n                ease: \"back.out(2)\",\n                delay: 0.4\n            });\n\n            // Technical pulsing for accent nodes\n            gsap.to('.node-accent', {\n                opacity: 0.4,\n                duration: 1.2,\n                yoyo: true,\n                repeat: -1,\n                ease: \"power1.inOut\",\n                delay: 2.5,\n                stagger: {\n                    amount: 0.8,\n                    from: \"random\"\n                }\n            });\n\n            // WebGL Background: Stepped Columns with Grainy Noise Perturbation\n            const canvas = document.getElementById('webgl-bg');\n            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });\n            renderer.setSize(canvas.clientWidth, canvas.clientHeight);\n\n            const scene = new THREE.Scene();\n            const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);\n            const geometry = new THREE.PlaneGeometry(2, 2);\n\n            const vertexShader = `\n                varying vec2 vUv;\n                void main() {\n                    vUv = uv;\n                    gl_Position = vec4(position, 1.0);\n                }\n            `;\n\n            const fragmentShader = `\n                uniform float u_time;\n                varying vec2 vUv;\n\n                // Simple pseudo-random function\n                float random(vec2 st) {\n                    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);\n                }\n\n                void main() {\n                    // Vertical stepped columns\n                    float steps = 40.0;\n                    float x = floor(vUv.x * steps) / steps;\n\n                    // Grainy noise\n                    float noise = random(vec2(x, vUv.y + u_time * 0.05)) * 0.15;\n                    float grain = random(vUv * u_time) * 0.06;\n\n                    // Column intensity modulation\n                    float colIntensity = sin(x * 15.0 - u_time * 0.5) * 0.5 + 0.5;\n\n                    // Dithered mapping thresholding\n                    float dither = step(0.65, colIntensity + noise) * 0.06;\n\n                    gl_FragColor = vec4(vec3(1.0), dither + grain);\n                }\n            `;\n\n            const material = new THREE.ShaderMaterial({\n                uniforms: {\n                    u_time: { value: 0 }\n                },\n                vertexShader,\n                fragmentShader,\n                transparent: true\n            });\n\n            const mesh = new THREE.Mesh(geometry, material);\n            scene.add(mesh);\n\n            let clock = new THREE.Clock();\n            function animate() {\n                requestAnimationFrame(animate);\n                material.uniforms.u_time.value = clock.getElapsedTime();\n                renderer.render(scene, camera);\n            }\n            animate();\n\n            // Handle Resize\n            window.addEventListener('resize', () => {\n                renderer.setSize(canvas.clientWidth, canvas.clientHeight);\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "cognitive-market-systems.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/cognitive-market-systems.jpg", "source_name": "cognitive-market-systems-DESIGN.md", "views": 426, "forks": 42, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T19:43:05.092982+00:00"}