    <div class=\"w-1 h-1 rounded-full bg-zinc-300\"></div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-6\">\n\n            <!-- Card 1 (Previously Card 3) -->\n            <div class=\"relative rounded-2xl bg-gradient-to-b from-white/10 to-transparent p-[1px] shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)]\">\n                <div class=\"flex h-full flex-col overflow-hidden rounded-[15px] bg-[#111111]\">\n                    <div class=\"relative h-64 w-full md:h-72 shrink-0\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/6b97b0cc-6b81-4451-aacc-6b928e7d0a69_3840w.jpg\" alt=\"Coastline landscape\" class=\"h-full w-full object-cover grayscale contrast-[1.2] brightness-75\">\n                        <div class=\"absolute inset-0 texture-overlay mix-blend-overlay\"></div>\n                        \n                        <!-- Overlay: UI Card -->\n                        <div class=\"absolute inset-0 flex items-center justify-center p-6\">\n                            <div class=\"w-full max-w-[260px] rounded-xl bg-white p-4 shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)] ring-1 ring-black/5\">\n                                <div class=\"flex items-center justify-between mb-4\">\n                                    <span class=\"text-sm font-medium tracking-tight text-zinc-900\">Product &amp; App</span>\n                                    <div class=\"flex gap-0.5 opacity-40\">\n                                        <div class=\"w-[3px] h-[3px] rounded-full bg-black\"></div>\n                                        <div class=\"w-[3px] h-[3px] rounded-full bg-black\"></div>\n                                        <div class=\"w-[3px] h-[3px] rounded-full bg-black\"></div>\n                                    </div>\n                                </div>\n                                \n                                <div class=\"mb-4 rounded-lg bg-zinc-100/80 p-3 ring-1 ring-black/5\">\n                                    <div class=\"flex items-center justify-between text-xs text-zinc-400 mb-2\">\n                                        <div class=\"flex items-center gap-1.5 font-normal\">\n                                            <iconify-icon icon=\"solar:clock-circle-linear\" class=\"text-sm\"></iconify-icon>\n                                            Project process\n                                        </div>\n                                        <span class=\"font-medium text-zinc-900\">92%</span>\n                                    </div>\n                                    <div class=\"h-1.5 w-full rounded-full bg-zinc-200 overflow-hidden\">\n                                        <div class=\"h-full w-[92%] bg-zinc-300 rounded-full\"></div>\n                                    </div>\n                                </div>\n                                \n                                <div class=\"flex flex-col gap-2 pt-1 text-xs\">\n                                    <div class=\"text-zinc-400 font-normal\">Updates</div>\n                                    <div class=\"flex justify-between items-center\">\n                                        <span class=\"text-zinc-400\">Last</span>\n                                        <span class=\"font-normal text-zinc-900\">Oct 04, 2025</span>\n                                    </div>\n                                    <div class=\"flex justify-between items-center\">\n                                        <span class=\"text-zinc-400\">Next</span>\n                                        <span class=\"font-normal text-zinc-900\">Oct 09, 2025</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-1 flex-col justify-between p-6 md:p-8\">\n                        <div>\n                            <div class=\"flex items-center gap-2\">\n                                <div class=\"h-2.5 w-[2px] bg-zinc-400\"></div>\n                                <span class=\"text-xs uppercase tracking-wider text-zinc-400 font-normal\">Research · Design · Build · Launch</span>\n                            </div>\n                            <h2 class=\"gs-reveal mt-5 text-xl md:text-2xl font-medium tracking-tight text-white leading-[1.15]\">\n                                Your product is your promise. Ensure it delivers on every interaction.\n                            </h2>\n                            <p class=\"mt-4 text-xs md:text-sm text-zinc-400 leading-relaxed font-light pr-4\">\n                                We engineer platforms that perform flawlessly when the stakes are highest.\n                            </p>\n                        </div>\n                        <div class=\"mt-8 text-xs text-zinc-600 font-normal\">lumina.studio</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 2 (Previously Card 1) -->\n            <div class=\"relative rounded-2xl bg-gradient-to-b from-white/10 to-transparent p-[1px] shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)]\">\n                <div class=\"flex h-full flex-col overflow-hidden rounded-[15px] bg-[#111111]\">\n                    <div class=\"relative h-64 w-full md:h-72 shrink-0\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/193e1472-0514-44eb-893a-1376091263f3_3840w.jpg\" alt=\"Rugged landscape\" class=\"h-full w-full object-cover grayscale contrast-[1.2] brightness-75\">\n                        <div class=\"absolute inset-0 texture-overlay mix-blend-overlay\"></div>\n                        \n                        <!-- Overlay: Avatars -->\n                        <div class=\"absolute inset-0 flex items-center justify-center\">\n                            <div class=\"flex -space-x-2 shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)] rounded-full p-1 bg-white/5 backdrop-blur-sm\">\n                                <img class=\"inline-block h-10 w-10 rounded-full ring-2 ring-[#111] grayscale object-cover\" src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/5180d964-2425-4134-8220-c1528af09124_800w.jpg\" alt=\"Avatar\">\n                                <img class=\"inline-block h-10 w-10 rounded-full ring-2 ring-[#111] grayscale object-cover\" src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/4f5668c5-fc4a-44e0-bc5e-a664189d3c31_1600w.jpg\" alt=\"Avatar\">\n                                <img class=\"inline-block h-10 w-10 rounded-full ring-2 ring-[#111] grayscale object-cover\" src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/fbddf75f-e2e3-4552-a710-55e2a5f4d6af_800w.jpg\" alt=\"Avatar\">\n                                <img class=\"inline-block h-10 w-10 rounded-full ring-2 ring-[#111] grayscale object-cover\" src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/16d38370-5873-45cf-bab1-60a7b923dc6e_800w.jpg\" alt=\"Avatar\">\n                                <div class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#e7e7e7] ring-2 ring-[#111] text-xs font-medium tracking-tight text-black\">40+</div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-1 flex-col justify-between p-6 md:p-8\">\n                        <div>\n                            <div class=\"flex items-center gap-2\">\n                                <div class=\"h-2.5 w-[2px] bg-zinc-400\"></div>\n                                <span class=\"text-xs uppercase tracking-wider text-zinc-400 font-normal\">Crafted with precision. Shipped with confidence.</span>\n                            </div>\n                            <h2 class=\"gs-reveal mt-5 text-xl md:text-2xl font-medium tracking-tight text-white leading-[1.15]\">\n                                Chosen by visionaries who demand excellence in every pixel.\n                            </h2>\n                            <p class=\"mt-4 text-xs md:text-sm text-zinc-400 leading-relaxed font-light pr-4\">\n                                Brilliant idea. Execution that falls short. We bridge that gap and ensure it stays closed.\n                            </p>\n                        </div>\n                        <div class=\"mt-8 text-xs text-zinc-600 font-normal\">lumina.studio</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 3 (Previously Card 2) -->\n            <div class=\"relative rounded-2xl bg-gradient-to-b from-white/10 to-transparent p-[1px] shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)]\">\n                <div class=\"flex h-full flex-col overflow-hidden rounded-[15px] bg-[#111111]\">\n                    <div class=\"relative h-64 w-full md:h-72 shrink-0\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/8e802a98-b83c-4c5d-99d1-e24406eb4ec9_3840w.jpg\" alt=\"Vast landscape\" class=\"h-full w-full object-cover grayscale contrast-[1.2] brightness-90\">\n                        <div class=\"absolute inset-0 texture-overlay mix-blend-overlay opacity-70\"></div>\n                    </div>\n                    <div class=\"flex flex-1 flex-col justify-between p-6 md:p-8\">\n                        <div class=\"mt-8\">\n                            <h2 class=\"gs-reveal text-xl md:text-2xl font-medium tracking-tight text-white leading-[1.15]\">\n                                The engine powering the experience.\n                            </h2>\n                            <p class=\"mt-4 text-xs md:text-sm text-zinc-400 leading-relaxed font-light pr-4\">\n                                Digital architecture, user experience, and visual systems built from the ground up. Unified and deliberate.\n                            </p>\n                        </div>\n                        <div class=\"mt-8 text-xs text-zinc-600 font-normal opacity-0 select-none\">lumina.studio</div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            const revealElements = document.querySelectorAll(\".gs-reveal\");\n\n            revealElements.forEach((elem) => {\n                const text = elem.innerText;\n                elem.innerHTML = \"\";\n                \n                // Split text by words\n                const words = text.split(\" \");\n                \n                words.forEach((word, index) => {\n                    // Create outer mask container\n                    const wordWrapper = document.createElement(\"span\");\n                    wordWrapper.style.display = \"inline-block\";\n                    wordWrapper.style.overflow = \"hidden\";\n                    wordWrapper.style.verticalAlign = \"top\";\n                    \n                    // Create inner animated span\n                    const wordSpan = document.createElement(\"span\");\n                    wordSpan.style.display = \"inline-block\";\n                    wordSpan.style.transform = \"translateY(100%)\";\n                    wordSpan.style.opacity = \"0\";\n                    wordSpan.innerHTML = word;\n                    \n                    wordWrapper.appendChild(wordSpan);\n                    elem.appendChild(wordWrapper);\n\n                    // Add space after word unless it's the last one\n                    if (index < words.length - 1) {\n                        const space = document.createTextNode(\" \");\n                        elem.appendChild(space);\n                    }\n                });\n\n                // Animate words\n                gsap.to(elem.querySelectorAll(\"span > span\"), {\n                    scrollTrigger: {\n                        trigger: elem,\n                        start: \"top 90%\",\n                    },\n                    y: \"0%\",\n                    opacity: 1,\n                    duration: 0.7,\n                    stagger: 0.02,\n                    ease: \"power3.out\"\n                });\n            });\n        });\n    </script>\n\n</body>\n</html>", "preview_file_name": "Landing-Page.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/landing-page.jpg", "source_name": "Landing-Page-DESIGN.md", "views": 112, "forks": 1, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-28T16:25:11.243824+00:00", "updated_at": "2026-07-03T14:28:14.570638+00:00"}