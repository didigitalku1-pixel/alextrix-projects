                </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Simulated Mouse Cursor indicating drag on Title Bar -->\n                <div class=\"absolute left-[50%] top-[-10px] z-30 pointer-events-none\" style=\"transform: translate(0px, 0px);\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M4 4 L4 19 L8 14.5 L12.5 20.5 L14.5 19 L10.5 13 L17 13 Z\" fill=\"white\" stroke=\"black\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n                    </svg>\n                </div>\n            </div>\n\n            <!-- Window 2: System Metrics -->\n            <div class=\"draggable-window absolute z-20 w-[240px] pointer-events-auto hidden md:block\" style=\"top: 30%; left: 60%;\">\n                <div class=\"p-[1px] rounded-[1rem] bg-gradient-to-br from-zinc-700/60 via-zinc-800/30 to-zinc-900/40 shadow-[0px_0px_0px_1px_rgba(0,0,0,0.06),0px_1px_1px_-0.5px_rgba(0,0,0,0.06),0px_3px_3px_-1.5px_rgba(0,0,0,0.06),_0px_6px_6px_-3px_rgba(0,0,0,0.06),0px_12px_12px_-6px_rgba(0,0,0,0.06),0px_24px_24px_-12px_rgba(0,0,0,0.06)]\">\n                    <div class=\"bg-zinc-900/20 rounded-[calc(1rem-1px)] flex flex-col backdrop-blur-xl overflow-hidden\">\n\n                        <!-- Draggable Window Title Bar -->\n                        <div class=\"window-header cursor-grab active:cursor-grabbing w-full h-8 bg-zinc-800/20 border-b border-zinc-800/50 flex items-center justify-between px-3 hover:bg-zinc-800/40 transition-colors\">\n                            <div class=\"flex items-center gap-2\">\n                                <iconify-icon icon=\"solar:code-square-linear\" class=\"text-zinc-400 text-xs\"></iconify-icon>\n                                <span class=\"text-zinc-400 text-xs font-light tracking-wide\">