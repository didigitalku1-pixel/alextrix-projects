88%] bg-blue-500 rounded-full\"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Window 3: Assets Library -->\n            <div class=\"draggable-window absolute z-20 w-[200px] pointer-events-auto hidden md:block\" style=\"top: 55%; left: 25%;\">\n                <div class=\"p-[1px] rounded-[1rem] bg-gradient-to-br from-zinc-700/60 via-zinc-800/30 to-zinc-900/40 shadow-[0px_0px_0px_1px_rgba(0,0,0,0.06),0px_1px_1px_-0.5px_rgba(0,0,0,0.06),0px_3px_3px_-1.5px_rgba(0,0,0,0.06),_0px_6px_6px_-3px_rgba(0,0,0,0.06),0px_12px_12px_-6px_rgba(0,0,0,0.06),0px_24px_24px_-12px_rgba(0,0,0,0.06)]\">\n                    <div class=\"bg-zinc-900/20 rounded-[calc(1rem-1px)] flex flex-col backdrop-blur-xl overflow-hidden\">\n\n                        <!-- Draggable Window Title Bar -->\n                        <div class=\"window-header cursor-grab active:cursor-grabbing w-full h-8 bg-zinc-800/20 border-b border-zinc-800/50 flex items-center justify-between px-3 hover:bg-zinc-800/40 transition-colors\">\n                            <div class=\"flex items-center gap-2\">\n                                <iconify-icon icon=\"solar:gallery-linear\" class=\"text-zinc-400 text-xs\"></iconify-icon>\n                                <span class=\"text-zinc-400 text-xs font-light tracking-wide\">Component_Lib</span>\n                            </div>\n                            <div class=\"flex items-center gap-1.5\">\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-zinc-700 hover:bg-zinc-500 transition-colors\"></div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-zinc-700 hover:bg-zinc-500 transition-colors\"></div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-zinc-700 hover:bg-zinc-500 transition-colors\"></div>\n                            </div>\n                        </div>\n\n                        <!-- Content -->\n                        <div class=\"p-3 grid grid-cols-3 gap-2\">\n                            <div class=\"aspect-square bg-zinc-900/30 rounded-md border border-zinc-800/50 flex items-center justify-center hover:border-zinc-500/80 transition-colors cursor-pointer\">\n                                <iconify-icon icon=\"solar:figma-linear\" class=\"text-zinc-500 text-sm\"></iconify-icon>\n                            </div>\n                            <div class=\"aspect-square bg-zinc-900/30 rounded-md border border-zinc-800/50 flex items-center justify-center hover:border-zinc-500/80 transition-colors cursor-pointer\">\n                                <iconify-icon icon=\"solar:pen-linear\" class=\"text-zinc-500 text-sm\"></iconify-icon>\n                            </div>\n                            <div class=\"aspect-square bg-zinc-900/30 rounded-md border border-zinc-800/50 flex items-center justify-center hover:border-zinc-500/80 transition-colors cursor-pointer\">\n                                <iconify-icon icon=\"solar:layers-linear\" class=\"text-zinc-500 text-sm\"></iconify-icon>\n                            </div>\n                            <div class=\"aspect-square bg-zinc-900/30 rounded-md border border-zinc-800/50 flex items-center justify-center hover:border-zinc-500/80 transition-colors cursor-pointer\">\n                                <iconify-icon icon=\"solar:text-square-linear\" class=\"text-zinc-500 text-sm\"></iconify-icon>\n                            </div>\n                            <div class=\"aspect-square bg-zinc-900/30 rounded-md border border-zinc-800/50 flex items-center justify-center hover:border-zinc-500/80 transition-colors cursor-pointer\">\n                                <iconify-icon icon=\"solar:video-library-linear\" class=\"text-zinc-500 text-sm\"></iconify-icon>\n                            </div>\n                            <div class=\"aspect-square bg-zinc-900/30 rounded-md border border-zinc-800/50 flex items-center justify-center hover:border-zinc-500/80 transition-colors cursor-pointer\">\n                                <iconify-icon icon=\"solar:settings-linear\" class=\"text-zinc-500 text-sm\"></iconify-icon>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n    <!-- Masked Reveal Section -->\n    <section class=\"h-[80vh] w-full flex items-center justify-center relative z-10 bg-[#111111] border-t border-zinc-900/50 pb-20 mt-32 md:mt-0\">\n        <div class=\"max-w-4xl mx-auto px-8 w-full text-center flex flex-col items-center\">\n            <div class=\"overflow-hidden mb-2 py-2\">\n                <h2 class=\"text-5xl md:text-7xl font-light tracking-tight text-zinc-100 reveal-text\" style=\"transform: translateY(120%);\">Building</h2>\n            </div>\n            <div class=\"overflow-hidden mb-2 py-2\">\n                <h2 class=\"text-5xl md:text-7xl font-light tracking-tight text-zinc-600 reveal-text\" style=\"transform: translateY(120%);\">fluid environments</h2>\n            </div>\n            <div class=\"overflow-hidden py-2\">\n                <h2 class=\"text-5xl md:text-7xl font-light tracking-tight text-zinc-100 reveal-text\" style=\"transform: translateY(120%);\">with intent.</h2>\n            </div>\n        </div>\n    </section>\n\n    <!-- Canvas Animation Logic & Initializations -->\n    <script>\n        // 1. Procedural Dither Background Map (Animated, Small Dots)\n        const canvas = document.getElementById('digitalMap');\n        const ctx = canvas.getContext('2d');\n        let width, height;\n\n        function resize() {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n        }\n        window.addEventListener('resize', resize);\n        resize();\n\n        const pixelSize = 3; // Small dots setting\n        let time = 0;\n\n        // 4x4 Bayer Matrix for ordered dither pattern\n        const bayerMatrix = [\n            [ 0/16,  8/16,  2/16, 10/16],\n            [12/16,  4/16, 14/16,  6/16],\n            [ 3/16, 11/16,  1/16,  9/16],\n            [15/16,  7/16, 13/16,  5/16]\n        ];\n\n        function renderMap() {\n            ctx.clearRect(0, 0, width, height);\n\n            const cols = Math.ceil(width / pixelSize);\n            const rows = Math.ceil(height / pixelSize);\n            const cx = cols / 2;\n            const cy = rows / 2;\n\n            ctx.fillStyle = 'rgba(161, 161, 170, 0.25)'; // Soft charcoal/gray for active dither dots\n\n            for (let x = 0; x < cols; x++) {\n                for (let y = 0; y < rows; y++) {\n                    // Procedural organic waves\n                    const nx = x * 0.02;\n                    const ny = y * 0.02;\n\n                    // Slow drift animation\n                    const wave1 = Math.sin(nx + time * 0.5) * Math.cos(ny - time * 0.3);\n                    const wave2 = Math.sin(nx * 0.8 - ny * 0.5 + time * 0.4);\n\n                    let brightness = (wave1 + wave2) * 0.3 + 0.45;\n\n                    // Vignette radial falloff\n                    const dx = (x - cx) / cx;\n                    const dy = (y - cy) / cy;\n                    const dist = Math.sqrt(dx*dx + dy*dy);\n                    brightness -= dist * 0.6;\n\n                    // Quantize brightness via dither matrix\n                    const threshold = bayerMatrix[y % 4][x % 4];\n\n                    if (brightness > threshold) {\n                        ctx.fillRect(x * pixelSize, y * pixelSize, pixelSize, pixelSize);\n                    }\n                }\n            }\n            time += 0.025;\n            requestAnimationFrame(renderMap);\n        }\n        renderMap();\n\n        // 2. GSAP Masked Reveal\n        gsap.registerPlugin(ScrollTrigger);\n\n        gsap.to('.reveal-text', {\n            y: 0,\n            duration: 1.4,\n            stagger: 0.15,\n            ease: \"power4.out\",\n            scrollTrigger: {\n                trigger: \".reveal-text\",\n                start: \"top 85%\",\n            }\n        });\n\n        // 3. Draggable Windows Logic\n        function initDraggableWindows() {\n            const windows = document.querySelectorAll('.draggable-window');\n            let highestZIndex = 20;\n\n            windows.forEach(win => {\n                const header = win.querySelector('.window-header');\n                let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;\n\n                if (header) {\n                    header.onmousedown = dragMouseDown;\n                } else {\n                    win.onmousedown = dragMouseDown;\n                }\n\n                function dragMouseDown(e) {\n                    e.preventDefault();\n                    pos3 = e.clientX;\n                    pos4 = e.clientY;\n                    document.onmouseup = closeDragElement;\n                    document.onmousemove = elementDrag;\n\n                    // Bring window to front when interacted with\n                    highestZIndex++;\n                    win.style.zIndex = highestZIndex;\n                }\n\n                function elementDrag(e) {\n                    e.preventDefault();\n                    pos1 = pos3 - e.clientX;\n                    pos2 = pos4 - e.clientY;\n                    pos3 = e.clientX;\n                    pos4 = e.clientY;\n\n                    // Update coordinates using inline styles mapped to px\n                    win.style.top = (win.offsetTop - pos2) + \"px\";\n                    win.style.left = (win.offsetLeft - pos1) + \"px\";\n                }\n\n                function closeDragElement() {\n                    document.onmouseup = null;\n                    document.onmousemove = null;\n                }\n            });\n        }\n        initDraggableWindows();\n    </script>\n</body>\n</html>", "preview_file_name": "vertex-digital-infrastructure.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/vertex-digital-infrastructure.jpg", "source_name": "vertex-digital-infrastructure-DESIGN.md", "views": 118, "forks": 3, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T05:39:17.472508+00:00"}