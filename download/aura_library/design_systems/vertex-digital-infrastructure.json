"1.5\"></iconify-icon>\n                                </div>\n                                <div>\n                                    <h3 class=\"text-zinc-100 text-xs font-light tracking-wide mb-1.5 uppercase\">NOVA</h3>\n                                    <p class=\"text-zinc-500 text-xs leading-[1.3]\">Brand<br>Systems<br>Web</p>\n                                </div>\n                            </div>\n\n                            <!-- Right Interaction & Thumbnail -->\n                            <div class=\"flex flex-col items-end gap-2\">\n                                <div class=\"flex items-center gap-1\">\n                                    <button class=\"bg-zinc-800/40 hover:bg-zinc-700/60 text-zinc-300 text-xs px-3 py-1.5 rounded-md flex items-center gap-1.5 transition-colors border border-zinc-700/50\">\n                                        Read case <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-xs\"></iconify-icon>\n                                    </button>\n                                    <button class=\"w-[26px] h-[26px] bg-zinc-800/40 hover:bg-zinc-700/60 rounded-md flex items-center justify-center border border-zinc-700/50 transition-colors text-zinc-300\">\n                                        <iconify-icon icon=\"solar:global-linear\" class=\"text-xs\"></iconify-icon>\n                                    </button>\n                                </div>\n\n                                <!-- Abstract Device Thumbnail -->\n                                <div class=\"w-28 h-20 bg-[#e5e5e5]/90 rounded-[10px] mt-1 overflow-hidden relative border border-zinc-300 shadow-inner flex items-center justify-center\">\n                                    <div class=\"w-3 h-0.5 bg-blue-500 rounded-full absolute top-2 right-2\"></div>\n\n                                    <!-- Windows Desktop OS Simulation -->\n                                    <div class=\"w-[78px] h-[52px] bg-[#1a1a1a] rounded-[4px] shadow-[0