rder: 1px solid transparent; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\">\n                    <div class=\"px-6 py-5 flex justify-between items-center border-b border-white/5\">\n                        <h2 class=\"text-lg font-medium tracking-tight text-zinc-100 word-anim\">Quick Entry</h2>\n                        <iconify-icon icon=\"solar:pen-linear\" class=\"text-zinc-500\" width=\"1.2em\"></iconify-icon>\n                    </div>\n                    <div class=\"p-6\">\n                        <div class=\"flex gap-4 items-start\">\n                            <img src=\"https://i.pravatar.cc/150?img=60\" class=\"w-10 h-10 rounded-full object-cover shadow-sm\" alt=\"My Avatar\">\n                            <div class=\"flex-1\">\n                                <textarea class=\"w-full bg-transparent border-none outline-none text-sm text-zinc-200 placeholder:text-zinc-600 resize-none h-20\" placeholder=\"Draft your new objective...\"></textarea>\n                                <div class=\"flex items-center justify-between mt-4\">\n                                    <div class=\"flex items-center gap-3 text-zinc-500\">\n                                        <button class=\"hover:text-zinc-300 transition-colors\"><iconify-icon icon=\"solar:paperclip-linear\" width=\"1.2em\"></iconify-icon></button>\n                                        <button class=\"hover:text-zinc-300 transition-colors\"><iconify-icon icon=\"solar:gallery-linear\" width=\"1.2em\"></iconify-icon></button>\n                                        <button class=\"hover:text-zinc-300 transition-colors\"><iconify-icon icon=\"solar:map-point-linear\" width=\"1.2em\"></iconify-icon></button>\n                                    </div>\n                                    <button class=\"px-4 py-2 bg-zinc-100 hover:bg-white text-black text-xs font-medium rounded-lg transition-colors shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0