v>\n                            <div class=\"flex-1\">\n                                <p class=\"text-sm font-medium text-zinc-200\">Design Sync</p>\n                                <div class=\"flex items-center gap-2 mt-1.5\">\n                                    <img src=\"https://i.pravatar.cc/150?img=5\" class=\"w-5 h-5 rounded-full object-cover\" alt=\"Guest\">\n                                    <img src=\"https://i.pravatar.cc/150?img=6\" class=\"w-5 h-5 rounded-full object-cover -ml-3 border border-zinc-900\" alt=\"Guest\">\n                                    <span class=\"text-xs text-zinc-500 ml-1\">Product Team</span>\n                                </div>\n                            </div>\n                        </div>\n                        <!-- Event -->\n                        <div class=\"py-4 flex items-start gap-4\">\n                            <div class=\"flex flex-col items-center min-w-[40px] mt-0.5\">\n                                <span class=\"text-xs text-zinc-500 font-medium\">02:30</span>\n                                <span class=\"text-[10px] text-zinc-600\">PM</span>\n                            </div>\n                            <div class=\"w-px h-10 bg-white/5 mx-1\"></div>\n                            <div class=\"flex-1\">\n                                <p class=\"text-sm font-medium text-zinc-200\">Client Review</p>\n                                <div class=\"flex items-center gap-2 mt-1.5\">\n                                    <img src=\"https://i.pravatar.cc/150?img=44\" class=\"w-5 h-5 rounded-full object-cover\" alt=\"Client\">\n                                    <span class=\"text-xs text-zinc-500\">External</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Roster -->\n                <div class=\"flashlight-card reveal opacity-0 translate-y-8 blur-sm transition-all duration-1000 ease-out rounded-2xl flex flex-col shadow-[0px_0px_0px_1px_rgba(0,0,0,0.06),0px_1px_1px_-0.5px_rgba(0,0,0,0.06),0px_3px_3px_-1.5px_rgba(0,0,0,0.06),_0px_6px_6px_-3px_rgba(0,0,0,0.06),0px_12px_12px_-6px_rgba(0,0,0,0.06),0px_24px_24px_-12px_rgba(0,0,0,0.06)]\" style=\"--x: 50%; --y: -250px; background: linear-gradient(rgba(12,12,14,0.65), rgba(12,12,14,0.65)) padding-box, radial-gradient(350px circle at var(--x) var(--y), rgba(255,255,255,0.4), rgba(255,255,255,0.02) 40%) border-box; border: 1px solid transparent; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\">\n                    <div class=\"px-6 py-5 flex justify-between items-center border-b border-white/5\">\n                        <h2 class=\"text-lg font-medium tracking-tight text-zinc-100 word-anim\">Active Roster</h2>\n                        <button class=\"w-6 h-6 rounded-full bg-zinc-800 border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white transition-colors\">\n                            <iconify-icon icon=\"solar:add-linear\" width=\"1em\"></iconify-icon>\n                        </button>\n                    </div>\n                    <div class=\"flex flex-col px-6\">\n                        <!-- Member -->\n                        <div class=\"py-4 border-b border-white/5 flex items-center justify-between\">\n                            <div class=\"flex items-center gap-3\">\n                                <img src=\"https://i.pravatar.cc/150?img=17\" class=\"w-9 h-9 rounded-full object-cover border border-white/10\" alt=\"Avatar\">\n                                <div>\n                                    <p class=\"text-sm font-medium text-zinc-200\">Riley Davis</p>\n                                    <p class=\"text-xs font-normal text-zinc-500\">Core Engineering</p>\n                                </div>\n                            </div>\n                            <div class=\"w-2 h-2 rounded-full bg-zinc-300\"></div>\n                        </div>\n                        <!-- Member -->\n                        <div class=\"py-4 border-b border-white/5 flex items-center justify-between\">\n                            <div class=\"flex items-center gap-3\">\n                                <img src=\"https://i.pravatar.cc/150?img=59\" class=\"w-9 h-9 rounded-full object-cover border border-white/10 opacity-70\" alt=\"Avatar\">\n                                <div>\n                                    <p class=\"text-sm font-medium text-zinc-400\">Marcus Chen</p>\n                                    <p class=\"text-xs font-normal text-zinc-600\">Product Design</p>\n                                </div>\n                            </div>\n                            <div class=\"w-2 h-2 rounded-full bg-zinc-800 border border-zinc-600\"></div>\n                        </div>\n                        <!-- Member -->\n                        <div class=\"py-4 flex items-center justify-between\">\n                            <div class=\"flex items-center gap-3\">\n                                <img src=\"https://i.pravatar.cc/150?img=69\" class=\"w-9 h-9 rounded-full object-cover border border-white/10\" alt=\"Avatar\">\n                                <div>\n                                    <p class=\"text-sm font-medium text-zinc-200\">Elena Rostova</p>\n                                    <p class=\"text-xs font-normal text-zinc-500\">Marketing Lead</p>\n                                </div>\n                            </div>\n                            <div class=\"w-2 h-2 rounded-full bg-zinc-300\"></div>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n\n        </div>\n    </main>\n\n    <script>\n        // --- Animation Observer ---\n        document.addEventListener('DOMContentLoaded', () => {\n            const observerOptions = { threshold: 0.1 };\n            const observer = new IntersectionObserver((entries, obs) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        const target = entry.target;\n                        \n                        // Handle generic reveals\n                        if (target.classList.contains('reveal')) {\n                            target.classList.remove('opacity-0', 'translate-y-8', 'blur-sm');\n                            target.classList.add('opacity-100', 'translate-y-0', 'blur-none');\n                            \n                            // Remove transition-all after animation completes to prevent lagging on hover events\n                            setTimeout(() => {\n                                target.classList.remove('transition-all', 'duration-1000', 'ease-out');\n                            }, 1000);\n                        }\n                        \n                        // Handle word-by-word text anims\n                        if (target.classList.contains('word-anim')) {\n                            target.querySelectorAll('span').forEach(span => {\n                                span.classList.remove('opacity-0', 'translate-y-2', 'blur-sm');\n                                span.classList.add('opacity-100', 'translate-y-0', 'blur-none');\n                            });\n                        }\n                        obs.unobserve(target);\n                    }\n                });\n            }, observerOptions);\n\n            // Prepare word-anim elements\n            document.querySelectorAll('.word-anim').forEach(el => {\n                const text = el.innerText;\n                el.innerText = '';\n                text.split(' ').forEach((word, index) => {\n                    const span = document.createElement('span');\n                    span.innerHTML = word + '&nbsp;';\n                    span.className = 'opacity-0 translate-y-2 blur-sm inline-block transition-all duration-700 ease-out';\n                    span.style.transitionDelay = `${index * 120}ms`;\n                    el.appendChild(span);\n                });\n                observer.observe(el);\n            });\n\n            // Observe main cards with staggered delay\n            document.querySelectorAll('.reveal').forEach((el, index) => {\n                el.style.transitionDelay = `${index * 150}ms`;\n                observer.observe(el);\n            });\n\n            // --- Border Gradient Flashlight Effect ---\n            document.querySelectorAll('.flashlight-card').forEach(card => {\n                card.addEventListener('mousemove', e => {\n                    const rect = card.getBoundingClientRect();\n                    const x = e.clientX - rect.left;\n                    const y = e.clientY - rect.top;\n                    card.style.setProperty('--x', `${x}px`);\n                    card.style.setProperty('--y', `${y}px`);\n                });\n                card.addEventListener('mouseleave', () => {\n                    card.style.setProperty('--x', `50%`);\n                    card.style.setProperty('--y', `-250px`);\n                });\n            });\n        });\n\n        // --- 3D Network Canvas ---\n        const canvas = document.getElementById('ethereal-canvas');\n        const ctx = canvas.getContext('2d');\n        let width, height;\n        const nodes = [];\n        const numNodes = 120;\n        let time = 0;\n        let driftY = 0;\n\n        function initGlobe() {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n            nodes.length = 0;\n            \n            for(let i = 0; i < numNodes; i++) {\n                let phi = Math.acos(-1 + (2 * i) / numNodes);\n                let theta = Math.sqrt(numNodes * Math.PI) * phi;\n                nodes.push({\n                    x: Math.cos(theta) * Math.sin(phi),\n                    y: Math.sin(theta) * Math.sin(phi),\n                    z: Math.cos(phi),\n                    pulseOffset: Math.random() * Math.PI * 2\n                });\n            }\n        }\n\n        function drawGlobe() {\n            ctx.clearRect(0, 0, width, height);\n            \n            // Minimalist deep space gradient\n            const bgGrad = ctx.createRadialGradient(width/2, height/2, 0, width/2, height/2, Math.max(width, height));\n            bgGrad.addColorStop(0, '#0f0f12'); \n            bgGrad.addColorStop(1, '#000000');\n            ctx.fillStyle = bgGrad;\n            ctx.fillRect(0, 0, width, height);\n\n            const R = Math.min(width, height) * 0.4; \n            const centerX = width / 2;\n            const centerY = height / 2 + Math.sin(driftY) * 15;\n\n            const angleY = time * 0.0003;\n\n            const projectedNodes = nodes.map(n => {\n                let xProj = n.x * Math.cos(angleY) + n.z * Math.sin(angleY);\n                let zProj = -n.x * Math.sin(angleY) + n.z * Math.cos(angleY);\n                return { \n                    ...n, \n                    xProj, \n                    zProj, \n                    screenX: centerX + xProj * R, \n                    screenY: centerY + n.y * R \n                };\n            }).sort((a, b) => a.zProj - b.zProj);\n\n            ctx.lineWidth = 0.5;\n            for (let i = 0; i < projectedNodes.length; i++) {\n                for (let j = i + 1; j < projectedNodes.length; j++) {\n                    const p1 = projectedNodes[i];\n                    const p2 = projectedNodes[j];\n                    const dist = Math.hypot(p1.xProj - p2.xProj, p1.y - p2.y, p1.zProj - p2.zProj);\n                    \n                    if (dist < 0.35) {\n                        const avgZ = (p1.zProj + p2.zProj) / 2;\n                        if(avgZ > -0.6) {\n                            // Subtler line rendering for minimalism\n                            const alpha = Math.max(0, (1 - dist / 0.35)) * ((avgZ + 1) / 2) * 0.12;\n                            ctx.strokeStyle = `rgba(255, 255, 255, ${alpha})`;\n                            ctx.beginPath();\n                            ctx.moveTo(p1.screenX, p1.screenY);\n                            ctx.lineTo(p2.screenX, p2.screenY);\n                            ctx.stroke();\n                        }\n                    }\n                }\n            }\n\n            projectedNodes.forEach(n => {\n                if(n.zProj > -0.8) {\n                    const alpha = Math.min(1, (n.zProj + 0.8) * 1.5);\n                    const pulse = Math.sin(time * 0.02 + n.pulseOffset) * 0.5 + 0.5;\n                    const size = 0.8 + pulse * 0.6;\n                    \n                    ctx.fillStyle = `rgba(255, 255, 255, ${alpha * (0.15 + pulse * 0.3)})`;\n                    ctx.beginPath();\n                    ctx.arc(n.screenX, n.screenY, size, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n            });\n\n            time++;\n            driftY += 0.003;\n            requestAnimationFrame(drawGlobe);\n        }\n\n        window.addEventListener('resize', initGlobe);\n        initGlobe();\n        drawGlobe();\n    </script>\n</body>\n</html>", "preview_file_name": "ethereal-minimal-system-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/ethereal-minimal-system-1.jpg", "source_name": "ethereal-minimal-system-1-DESIGN.md", "views": 139, "forks": 3, "private": false, "featured": true, "created_by": "f78092cf-e149-48ff-99e9-efabe9a28d39", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-03T09:29:57.078821+00:00"}