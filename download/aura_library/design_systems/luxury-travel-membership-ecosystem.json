full group-hover:translate-y-0 transition-transform duration-[800ms] ease-[cubic-bezier(0.25,1,0.5,1)] z-0\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/d9270f34-bc6f-4346-a413-6750bb26204c_3840w.webp\" alt=\"Luxury Villa\" class=\"w-full h-full object-cover\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#151210]/95 via-[#151210]/60 to-[#151210]/20\"></div>\n                    </div>\n\n                    <!-- Content -->\n                    <div class=\"relative z-10 flex flex-col h-full justify-between transition-colors duration-500 group-hover:text-[#f0ece1]\">\n                        <div class=\"flex justify-between items-start gap-4\">\n                            <h3 class=\"text-3xl lg:text-4xl font-medium tracking-tight leading-tight\" style=\"font-family: 'Cormorant Garamond', serif;\">Private Villas</h3>\n                            <iconify-icon icon=\"solar:arrow-right-up-linear\" style=\"stroke-width: 1.0; background: linear-gradient(to right, #d9b87a, #cba358); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\" class=\"text-3xl shrink-0 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1\"></iconify-icon>\n                        </div>\n                        <p class=\"text-sm lg:text-base leading-relaxed mt-12 opacity-80 transition-opacity duration-500 group-hover:opacity-100\">\n                            Uncover a portfolio of architectural masterpieces and secluded estates, reserved solely for our members in the world's most coveted destinations.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Card 2: Cultural Access -->\n                <div class=\"bg-[#f0ece1] text-[#151210] p-8 lg:p-12 flex flex-col justify-between min-h-[320px] lg:min-h-[420px] group cursor-pointer relative overflow-hidden\">\n                    <!-- Hover Reveal Image -->\n                    <div class=\"absolute inset-0 translate-y-full group-hover:translate-y-0 transition-transform duration-[800ms] ease-[cubic-bezier(0.25,1,0.5,1)] z-0\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/18ae237d-6c3d-4f61-aaaa-d00113ae5b20_3840w.webp\" alt=\"Cultural Museum\" class=\"w-full h-full object-cover\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#151210]/95 via-[#151210]/60 to-[#151210]/20\"></div>\n                    </div>\n\n                    <!-- Content -->\n                    <div class=\"relative z-10 flex flex-col h-full justify-between transition-colors duration-500 group-hover:text-[#f0ece1]\">\n                        <div class=\"flex justify-between items-start gap-4\">\n                            <h3 class=\"text-3xl lg:text-4xl font-medium tracking-tight leading-tight\" style=\"font-family: 'Cormorant Garamond', serif;\">Cultural Access</h3>\n                            <iconify-icon icon=\"solar:arrow-right-up-linear\" style=\"stroke-width: 1.0; background: linear-gradient(to right, #d9b87a, #cba358); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\" class=\"text-3xl shrink-0 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1\"></iconify-icon>\n                        </div>\n                        <p class=\"text-sm lg:text-base leading-relaxed mt-12 opacity-80 transition-opacity duration-500 group-hover:opacity-100\">\n                            Step behind the velvet rope. Experience private viewings, heritage tours, and intimate encounters with global artisans and historical landmarks.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Card 3: Wellness Retreats -->\n                <div class=\"bg-[#f0ece1] text-[#151210] p-8 lg:p-12 flex flex-col justify-between min-h-[320px] lg:min-h-[420px] group cursor-pointer relative overflow-hidden\">\n                    <!-- Hover Reveal Image -->\n                    <div class=\"absolute inset-0 translate-y-full group-hover:translate-y-0 transition-transform duration-[800ms] ease-[cubic-bezier(0.25,1,0.5,1)] z-0\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/fd4fb2ab-9fda-4359-8e0c-03da1b71a134_3840w.jpg\" alt=\"Wellness Spa\" class=\"w-full h-full object-cover\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#151210]/95 via-[#151210]/60 to-[#151210]/20\"></div>\n                    </div>\n\n                    <!-- Content -->\n                    <div class=\"relative z-10 flex flex-col h-full justify-between transition-colors duration-500 group-hover:text-[#f0ece1]\">\n                        <div class=\"flex justify-between items-start gap-4\">\n                            <h3 class=\"text-3xl lg:text-4xl font-medium tracking-tight leading-tight\" style=\"font-family: 'Cormorant Garamond', serif;\">Wellness Retreats</h3>\n                            <iconify-icon icon=\"solar:arrow-right-up-linear\" style=\"stroke-width: 1.0; background: linear-gradient(to right, #d9b87a, #cba358); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\" class=\"text-3xl shrink-0 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1\"></iconify-icon>\n                        </div>\n                        <p class=\"text-sm lg:text-base leading-relaxed mt-12 opacity-80 transition-opacity duration-500 group-hover:opacity-100\">\n                            Sanctuary for the senses. Bespoke recovery and rejuvenation programs set within serene, untouched landscapes to restore mind and body.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Card 4: Concierge Planning -->\n                <div class=\"bg-[#f0ece1] text-[#151210] p-8 lg:p-12 flex flex-col justify-between min-h-[320px] lg:min-h-[420px] group cursor-pointer relative overflow-hidden\">\n                    <!-- Hover Reveal Image -->\n                    <div class=\"absolute inset-0 translate-y-full group-hover:translate-y-0 transition-transform duration-[800ms] ease-[cubic-bezier(0.25,1,0.5,1)] z-0\">\n                        <img src=\"https://images.unsplash.com/photo-1554774853-719586f82d77?q=80&amp;w=1000&amp;auto=format&amp;fit=crop\" alt=\"Concierge Details\" class=\"w-full h-full object-cover\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#151210]/95 via-[#151210]/60 to-[#151210]/20\"></div>\n                    </div>\n\n                    <!-- Content -->\n                    <div class=\"relative z-10 flex flex-col h-full justify-between transition-colors duration-500 group-hover:text-[#f0ece1]\">\n                        <div class=\"flex justify-between items-start gap-4\">\n                            <h3 class=\"text-3xl lg:text-4xl font-medium tracking-tight leading-tight\" style=\"font-family: 'Cormorant Garamond', serif;\">Concierge<br>Planning</h3>\n                            <iconify-icon icon=\"solar:arrow-right-up-linear\" style=\"stroke-width: 1.0; background: linear-gradient(to right, #d9b87a, #cba358); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\" class=\"text-3xl shrink-0 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1\"></iconify-icon>\n                        </div>\n                        <p class=\"text-sm lg:text-base leading-relaxed mt-12 opacity-80 transition-opacity duration-500 group-hover:opacity-100\">\n                            Your dedicated lifestyle architect. We anticipate every preference, weaving complex itineraries into seamless, deeply personal narratives.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Card 5: Member Events -->\n                <div class=\"bg-[#f0ece1] text-[#151210] p-8 lg:p-12 flex flex-col justify-between min-h-[320px] lg:min-h-[420px] group cursor-pointer relative overflow-hidden\">\n                    <!-- Hover Reveal Image -->\n                    <div class=\"absolute inset-0 translate-y-full group-hover:translate-y-0 transition-transform duration-[800ms] ease-[cubic-bezier(0.25,1,0.5,1)] z-0\">\n                        <img src=\"https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&amp;w=1000&amp;auto=format&amp;fit=crop\" alt=\"Exclusive Event\" class=\"w-full h-full object-cover\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#151210]/95 via-[#151210]/60 to-[#151210]/20\"></div>\n                    </div>\n\n                    <!-- Content -->\n                    <div class=\"relative z-10 flex flex-col h-full justify-between transition-colors duration-500 group-hover:text-[#f0ece1]\">\n                        <div class=\"flex justify-between items-start gap-4\">\n                            <h3 class=\"text-3xl lg:text-4xl font-medium tracking-tight leading-tight\" style=\"font-family: 'Cormorant Garamond', serif;\">Member Events</h3>\n                            <iconify-icon icon=\"solar:arrow-right-up-linear\" style=\"stroke-width: 1.0; background: linear-gradient(to right, #d9b87a, #cba358); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\" class=\"text-3xl shrink-0 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1\"></iconify-icon>\n                        </div>\n                        <p class=\"text-sm lg:text-base leading-relaxed mt-12 opacity-80 transition-opacity duration-500 group-hover:opacity-100\">\n                            Join an inner circle of global visionaries. Gain entry to invitation-only gatherings, private galas, and curated symposiums worldwide.\n                        </p>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            const textContainer = document.getElementById('animated-text');\n            const words = textContainer.innerText.trim().split(' ');\n            textContainer.innerHTML = '';\n\n            words.forEach(word => {\n                const wrapper = document.createElement('span');\n                wrapper.className = 'inline-block overflow-hidden align-top mr-[0.25em] pb-1';\n\n                const inner = document.createElement('span');\n                inner.className = 'reveal-word inline-block translate-y-full';\n                inner.innerText = word;\n\n                wrapper.appendChild(inner);\n                textContainer.appendChild(wrapper);\n            });\n\n            gsap.to('.reveal-word', {\n                y: '0%',\n                duration: 0.9,\n                ease: 'power3.out',\n                stagger: 0.015,\n                scrollTrigger: {\n                    trigger: textContainer,\n                    start: 'top 85%',\n                }\n            });\n        });\n    </script>\n\n</body></html>", "preview_file_name": "luxury-travel-membership-ecosystem.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/luxury-travel-membership-ecosystem.jpg", "source_name": "luxury-travel-membership-ecosystem-DESIGN.md", "views": 154, "forks": 5, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T03:49:35.371565+00:00"}