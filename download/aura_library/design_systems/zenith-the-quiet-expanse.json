ometric Additions: Lines & Square -->\n                    <div class=\"absolute inset-x-0 top-1/2 h-px bg-white/10 z-10 pointer-events-none transition-transform duration-1000 origin-left scale-x-0 reveal-line\"></div>\n                    <div class=\"absolute inset-y-0 left-1/2 w-px bg-white/10 z-10 pointer-events-none transition-transform duration-1000 origin-top scale-y-0 reveal-line\"></div>\n                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 md:w-48 md:h-48 aspect-square border border-white/10 bg-gradient-to-br from-white/30 via-white/5 to-transparent backdrop-blur-sm z-20 flex items-center justify-center reveal-item\" style=\"box-shadow: inset 0px 0px 10px 0px rgba(255, 255, 255, 0.05);\">\n                        <div class=\"w-1.5 h-1.5 bg-[#F2EAD3]/50\"></div>\n                    </div>\n\n                    <div class=\"absolute top-4 md:top-6 right-4 md:right-6 text-xs md:text-sm font-normal tracking-wide opacity-80 z-30 reveal-item text-white/50\">02-B.</div>\n\n                    <div class=\"reveal-text absolute bottom-4 md:bottom-8 left-4 md:left-8 text-sm md:text-base font-normal leading-relaxed md:leading-relaxed opacity-90 max-w-[85%] z-30 text-[#F2EAD3]\">\n                        Transforming intricate<br>\n                        flows into serene<br>\n                        scalable forms.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Panel 3 -->\n            <div class=\"h-full rounded-[24px] p-[1px] relative group\" style=\"background: linear-gradient(to right bottom, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.05), rgba(0, 0, 0, 0)); box-shadow: rgba(0, 0, 0, 0.25) 0px 25px 50px -12px;\">\n                <div class=\"relative overflow-hidden h-full rounded-[23px] bg-[#171717]\" style=\"box-shadow: rgba(255, 255, 255, 0.02) 0px 0px 40px 0px inset;\">\n                    <div class=\"absolute inset-0 bg-cover bg-center transition-transform duration-[15000ms] ease-out group-hover:scale-110 opacity-[0.15]\"\n                         style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/75134536-4198-40bf-9944-315511fe8c0b_3840w.jpg');\n                                filter: grayscale(1) contrast(1.2) brightness(0.8); background-position: 80% center;\">\n                    </div>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#171717]/95 via-[#171717]/80 to-transparent pointer-events-none\"></div>\n\n                    <!-- Geometric Additions: Lines & Diamond -->\n                    <div class=\"absolute inset-x-0 top-1/2 h-px bg-white/10 z-10 pointer-events-none transition-transform duration-1000 origin-left scale-x-0 reveal-line\"></div>\n                    <div class=\"absolute inset-y-0 left-1/2 w-px bg-white/10 z-10 pointer-events-none transition-transform duration-1000 origin-top scale-y-0 reveal-line\"></div>\n                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 h-28 md:w-36 md:h-36 aspect-square rotate-45 border border-white/10 bg-gradient-to-br from-white/30 via-white/5 to-transparent backdrop-blur-sm z-20 flex items-center justify-center reveal-item\" style=\"box-shadow: inset 0px 0px 10px 0px rgba(255, 255, 255, 0.05);\">\n                        <div class=\"w-1.5 h-1.5 bg-[#F2EAD3]/50 rotate-[-45deg]\"></div>\n                    </div>\n\n                    <div class=\"absolute top-4 md:top-6 right-4 md:right-6 text-xs md:text-sm font-normal tracking-wide opacity-80 z-30 reveal-item text-white/50\">03-C.</div>\n\n                    <div class=\"absolute top-[35%] left-4 md:left-8 text-xs md:text-sm font-normal tracking-wide opacity-80 z-30 whitespace-nowrap reveal-item text-white/50\">\n                        PURE PRECISION // 8K+\n                    </div>\n\n                    <div class=\"absolute top-[60%] right-4 md:right-6 text-xs md:text-sm font-normal tracking-wide opacity-80 z-30 whitespace-nowrap reveal-item text-white/50\">\n                        // 42 ELEMENTS\n                    </div>\n\n                    <!-- Primary Action Button -->\n                    <button class=\"absolute bottom-20 md:bottom-24 left-4 md:left-8 px-8 py-3.5 bg-[#F2EAD3] text-[#000000] text-sm font-normal rounded-full z-30 hover:bg-[#FEFDFB] transition-colors duration-300 reveal-item\">\n                        Initialize\n                    </button>\n\n                    <div class=\"reveal-text absolute bottom-4 md:bottom-8 left-4 md:left-8 text-xs sm:text-sm md:text-base lg:text-lg font-normal tracking-tight uppercase opacity-95 z-30 text-[#FFFFFF]\">\n                        THE QUIET EXPANSE\n                    </div>\n                </div>\n            </div>\n\n        </div>\n\n        <!-- Bottom Slanted Pattern Border -->\n        <div class=\"w-full h-3 md:h-4 opacity-30\" style=\"background-image: url(&quot;data:image/svg+xml,%3Csvg width='8' height='16' xmlns='http://www.w3.org/2000/svg'%3E%3Cline x1='0' y1='16' x2='8' y2='0' stroke='%23FFFFFF' stroke-width='1' opacity='0.2'/%3E%3C/svg%3E&quot;); background-repeat: repeat-x;\"></div>\n\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Setup masked text reveal structure for target paragraphs\n            document.querySelectorAll('.reveal-text').forEach(el => {\n                let html = '';\n                const lines = el.innerHTML.split(/<br\\s*\\/?>/i);\n\n                lines.forEach((line, i) => {\n                    const words = line.trim().split(/\\s+/).map(word => {\n                        if(!word) return '';\n                        return `<span class=\"inline-block overflow-hidden align-top\"><span class=\"reveal-word inline-block translate-y-[110%] will-change-transform\">${word}</span></span>`;\n                    });\n                    html += words.join(' ') + (i < lines.length - 1 ? '<br>' : '');\n                });\n                el.innerHTML = html;\n            });\n\n            // Master Timeline\n            const tl = gsap.timeline({\n                scrollTrigger: {\n                    trigger: \"main\",\n                    start: \"top center\",\n                }\n            });\n\n            // Animate grid lines\n            tl.to(\".reveal-line\", {\n                scaleX: 1,\n                scaleY: 1,\n                duration: 1.5,\n                ease: \"power3.inOut\",\n                stagger: 0.1\n            });\n\n            // Animate main title\n            tl.fromTo(\".reveal-title\",\n                { y: 50, opacity: 0 },\n                { y: 0, opacity: 1, duration: 1.2, ease: \"power4.out\", stagger: 0.1 },\n                \"-=1.0\"\n            );\n\n            // Animate floating items (including new shapes)\n            tl.fromTo(\".reveal-item\",\n                { opacity: 0, y: 15 },\n                { opacity: 1, y: 0, duration: 1.2, ease: \"power3.out\", stagger: 0.08 },\n                \"-=0.8\"\n            );\n\n            // Staggered word reveal\n            tl.to(\".reveal-word\", {\n                y: \"0%\",\n                duration: 0.8,\n                ease: \"power4.out\",\n                stagger: 0.02\n            }, \"-=0.6\");\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "zenith-the-quiet-expanse.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/zenith-the-quiet-expanse.jpg", "source_name": "zenith-the-quiet-expanse-DESIGN.md", "views": 528, "forks": 7, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T21:39:39.242231+00:00"}