Streamline processing pipelines as AI-driven filters sort incoming packets by structural context.</p>\n\n                <!-- Logic Flow Diagram -->\n                <div class=\"flex items-center justify-center font-['JetBrains_Mono',monospace] text-[10px] uppercase tracking-widest text-white/50 mb-10 w-full relative z-10\">\n                    <div class=\"flex flex-col gap-4 text-right\">\n                        <span>Filter</span>\n                        <span>Matrix</span>\n                    </div>\n                    <div class=\"relative flex items-center px-4 sm:px-6\">\n                        <div class=\"absolute left-0 top-1/2 -translate-y-1/2 w-3 h-12 border-l border-y border-white/10 rounded-l-sm border-r-0\"></div>\n                        <div class=\"bg-[#111] border border-white/10 rounded-sm px-3 py-1.5 z-10 text-white/80 transition-colors group-hover:border-[#f24e1e]/50\">\n                            SEGMENT\n                        </div>\n                        <div class=\"absolute right-0 top-1/2 -translate-y-1/2 w-3 h-12 border-r border-y border-white/10 rounded-r-sm border-l-0\"></div>\n                    </div>\n                    <div class=\"flex flex-col gap-4\">\n                        <span class=\"flex items-center gap-2\"><span class=\"w-1.5 h-1.5 rounded-full bg-[#f24e1e]\"></span> STRUCTURAL</span>\n                        <span class=\"flex items-center gap-2\"><span class=\"w-1.5 h-1.5 rounded-full bg-white/20\"></span> SPATIAL</span>\n                    </div>\n                </div>\n\n                <!-- Isometric Node Graph -->\n                <div class=\"relative w-full h-56 mt-auto perspective-[800px] overflow-hidden rounded-sm bg-[#050505] border border-white/[0.05]\">\n                    <div class=\"absolute inset-[-50%] flex items-center justify-center transition-transform duration-1000 group-hover:scale-105\" style=\"transform: rotateX(60deg) rotateZ(-45deg);\">\n                        <!-- Grid Background -->\n                        <div class=\"absolute inset-0\" style=\"background-image: linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 30px 30px;\"></div>\n\n                        <!-- Connecting Lines -->\n                        <div class=\"absolute w-32 h-[1px] bg-gradient-to-r from-white/20 to-transparent top-[45%] left-[30%] origin-left\" style=\"transform: rotate(20deg);\"></div>\n                        <div class=\"absolute w-24 h-[1px] bg-gradient-to-r from-white/20 to-transparent top-[45%] left-[30%] origin-left\" style=\"transform: rotate(-30deg);\"></div>\n                        <div class=\"absolute w-28 h-[1px] bg-gradient-to-r from-white/20 to-transparent top-[55%] left-[45%] origin-left\" style=\"transform: rotate(45deg);\"></div>\n                        <div class=\"absolute w-20 h-[1px] bg-gradient-to-r from-[#f24e1e]/40 to-transparent top-[35%] left-[50%] origin-left\" style=\"transform: rotate(15deg);\"></div>\n\n                        <!-- Nodes -->\n                        <div class=\"absolute top-[40%] left-[25%] bg-[#0a0a0a] border border-[#f24e1e]/80 rounded-sm px-3 py-1 font-['JetBrains_Mono',monospace] text-[9px] uppercase tracking-wider text-[#f24e1e] whitespace-nowrap z-10\">Inbound</div>\n\n                        <div class=\"absolute top-[25%] left-[45%] bg-[#0a0a0a] border border-white/10 rounded-sm px-2.5 py-1 font-['JetBrains_Mono',monospace] text-[9px] uppercase tracking-wider text-white/60 whitespace-nowrap\">V_01</div>\n\n                        <div class=\"absolute top-[60%] left-[15%] bg-[#0a0a0a] border border-white/10 rounded-sm px-2.5 py-1 font-['JetBrains_Mono',monospace] text-[9px] uppercase tracking-wider text-white/60 whitespace-nowrap\">V_02</div>\n\n                        <div class=\"absolute top-[45%] left-[55%] bg-[#0a0a0a] border border-white/10 rounded-sm px-2.5 py-1 font-['JetBrains_Mono',monospace] text-[9px] uppercase tracking-wider text-white/60 whitespace-nowrap\">V_03</div>\n\n                        <div class=\"absolute top-[35%] left-[70%] bg-[#0a0a0a] border border-white/10 rounded-sm px-2.5 py-1 font-['JetBrains_Mono',monospace] text-[9px] uppercase tracking-wider text-white/60 whitespace-nowrap\">V_04</div>\n\n                        <div class=\"absolute top-[65%] left-[40%] bg-[#0a0a0a] border border-white/10 rounded-sm px-2.5 py-1 font-['JetBrains_Mono',monospace] text-[9px] uppercase tracking-wider text-white/60 whitespace-nowrap\">V_05</div>\n                    </div>\n                </div>\n            </section>\n        </div>\n\n    </main>\n\n    <!-- WebGL Particle Globe Script & GSAP Animations -->\n    <script>\n        // Init GSAP Masked Reveal\n        const initAnimations = () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            gsap.to(\".reveal-word\", {\n                y: 0,\n                opacity: 1,\n                duration: 1.2,\n                stagger: 0.04,\n                ease: \"power4.out\",\n                scrollTrigger: {\n                    trigger: \"#hero-headline\",\n                    start: \"top 85%\",\n                }\n            });\n        };\n\n        // Init Restrained Three.js Particle System with Adapted Colors\n        const initGlobe = () => {\n            const container = document.getElementById('webgl-container');\n            const scene = new THREE.Scene();\n            const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n            const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });\n\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n            container.appendChild(renderer.domElement);\n\n            const geometry = new THREE.BufferGeometry();\n            const particlesCount = 2000;\n            const posArray = new Float32Array(particlesCount * 3);\n            const colorArray = new Float32Array(particlesCount * 3);\n\n            // Adapted Theme Colors\n            const colorOrange = new THREE.Color(0xf24e1e);\n            const colorWhite = new THREE.Color(0xffffff);\n            const colorGray = new THREE.Color(0x555555);\n\n            for(let i = 0; i < particlesCount * 3; i+=3) {\n                const r = 3;\n                const theta = 2 * Math.PI * Math.random();\n                const phi = Math.acos(2 * Math.random() - 1);\n\n                posArray[i] = r * Math.sin(phi) * Math.cos(theta);\n                posArray[i+1] = r * Math.sin(phi) * Math.sin(theta);\n                posArray[i+2] = r * Math.cos(phi);\n\n                // Mix colors randomly based on the palette\n                const mix = Math.random();\n                let selectedColor = colorOrange;\n                if (mix > 0.8) selectedColor = colorWhite;\n                else if (mix > 0.4) selectedColor = colorGray;\n\n                colorArray[i] = selectedColor.r;\n                colorArray[i+1] = selectedColor.g;\n                colorArray[i+2] = selectedColor.b;\n            }\n\n            geometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n            geometry.setAttribute('color', new THREE.BufferAttribute(colorArray, 3));\n\n            // Axiom Adapted styling using Vertex Colors\n            const material = new THREE.PointsMaterial({\n                size: 0.012,\n                vertexColors: true,\n                transparent: true,\n                opacity: 0.6,\n                blending: THREE.AdditiveBlending\n            });\n\n            const particlesMesh = new THREE.Points(geometry, material);\n            scene.add(particlesMesh);\n\n            camera.position.z = 6;\n            camera.position.x = 2;\n            camera.position.y = -1;\n\n            const animate = () => {\n                requestAnimationFrame(animate);\n                // Slowed down motion for disciplined ambient drift\n                particlesMesh.rotation.y += 0.0005;\n                particlesMesh.rotation.x += 0.0002;\n                renderer.render(scene, camera);\n            };\n\n            animate();\n\n            window.addEventListener('resize', () => {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            });\n        };\n\n        window.onload = () => {\n            initGlobe();\n            initAnimations();\n        };\n    </script>\n</body>\n</html>", "preview_file_name": "autonomous-traffic-vectors-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/autonomous-traffic-vectors-1.jpg", "source_name": "autonomous-traffic-vectors-1-DESIGN.md", "views": 56, "forks": 2, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T13:56:53.452731+00:00"}