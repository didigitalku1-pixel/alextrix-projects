]/70 mt-1\">Data Engineer</p>\n                                </div>\n                                <div class=\"flex justify-between items-end\">\n                                    <div class=\"flex flex-col gap-0.5\">\n                                        <p class=\"text-xs font-light text-[#1a5bfa]/80\">99 Cloud Way, NY</p>\n                                        <p class=\"text-xs font-light text-[#1a5bfa]/80\">omar@velocity.dev</p>\n                                    </div>\n                                    <div class=\"w-6 h-6 relative\">\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(45deg);\"><div class=\"w-full h-[2px] bg-[#1a5bfa]\"></div></div>\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(-45deg);\"><div class=\"w-full h-[2px] bg-[#1a5bfa]\"></div></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Card 4 (Glass Blur, 180deg) -->\n                    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" style=\"transform: rotate(180deg) translateZ(40px);\">\n                        <div class=\"pointer-events-auto relative w-[320px] h-[200px] bg-white/5 backdrop-blur-xl border border-white/20 shadow-2xl overflow-hidden rounded-2xl transition-transform duration-500 hover:scale-105\" style=\"transform: translateY(-240px);\">\n                            <div class=\"absolute inset-0 flex flex-col justify-center gap-6\" style=\"transform: scale(2) rotate(45deg);\">\n                                <div class=\"w-full h-12 bg-white/5\"></div>\n                                <div class=\"w-full h-12 bg-white/5\"></div>\n                                <div class=\"w-full h-12 bg-white/5\"></div>\n                            </div>\n                            <div class=\"absolute inset-0 p-6 flex flex-col justify-between z-10 text-white\">\n                                <div>\n                                    <h3 class=\"text-sm font-normal tracking-tight\">Clara Rhys</h3>\n                                    <p class=\"text-xs font-light text-white/70 mt-1\">Security Ops</p>\n                                </div>\n                                <div class=\"flex justify-between items-end\">\n                                    <div class=\"flex flex-col gap-0.5\">\n                                        <p class=\"text-xs font-light text-white/80\">99 Cloud Way, NY</p>\n                                        <p class=\"text-xs font-light text-white/80\">clara@velocity.dev</p>\n                                    </div>\n                                    <div class=\"w-6 h-6 relative\">\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(45deg);\"><div class=\"w-full h-[2px] bg-white\"></div></div>\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(-45deg);\"><div class=\"w-full h-[2px] bg-white\"></div></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Card 5 (Solid, 240deg) -->\n                    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" style=\"transform: rotate(240deg) translateZ(50px);\">\n                        <div class=\"pointer-events-auto relative w-[320px] h-[200px] bg-white shadow-2xl overflow-hidden rounded-2xl transition-transform duration-500 hover:scale-105\" style=\"transform: translateY(-240px);\">\n                            <div class=\"absolute inset-0 flex flex-col justify-center gap-6\" style=\"transform: scale(2) rotate(45deg);\">\n                                <div class=\"w-full h-12 bg-[#1a5bfa]/5\"></div>\n                                <div class=\"w-full h-12 bg-[#1a5bfa]/5\"></div>\n                                <div class=\"w-full h-12 bg-[#1a5bfa]/5\"></div>\n                            </div>\n                            <div class=\"absolute inset-0 p-6 flex flex-col justify-between z-10 text-[#1a5bfa]\">\n                                <div>\n                                    <h3 class=\"text-sm font-normal tracking-tight\">Evan Wright</h3>\n                                    <p class=\"text-xs font-light text-[#1a5bfa]/70 mt-1\">Systems Admin</p>\n                                </div>\n                                <div class=\"flex justify-between items-end\">\n                                    <div class=\"flex flex-col gap-0.5\">\n                                        <p class=\"text-xs font-light text-[#1a5bfa]/80\">99 Cloud Way, NY</p>\n                                        <p class=\"text-xs font-light text-[#1a5bfa]/80\">evan@velocity.dev</p>\n                                    </div>\n                                    <div class=\"w-6 h-6 relative\">\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(45deg);\"><div class=\"w-full h-[2px] bg-[#1a5bfa]\"></div></div>\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(-45deg);\"><div class=\"w-full h-[2px] bg-[#1a5bfa]\"></div></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Card 6 (Glass Blur, 300deg) -->\n                    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" style=\"transform: rotate(300deg) translateZ(60px);\">\n                        <div class=\"pointer-events-auto relative w-[320px] h-[200px] bg-white/5 backdrop-blur-xl border border-white/20 shadow-2xl overflow-hidden rounded-2xl transition-transform duration-500 hover:scale-105\" style=\"transform: translateY(-240px);\">\n                            <div class=\"absolute inset-0 flex flex-col justify-center gap-6\" style=\"transform: scale(2) rotate(45deg);\">\n                                <div class=\"w-full h-12 bg-white/5\"></div>\n                                <div class=\"w-full h-12 bg-white/5\"></div>\n                                <div class=\"w-full h-12 bg-white/5\"></div>\n                            </div>\n                            <div class=\"absolute inset-0 p-6 flex flex-col justify-between z-10 text-white\">\n                                <div>\n                                    <h3 class=\"text-sm font-normal tracking-tight\">Maya Patel</h3>\n                                    <p class=\"text-xs font-light text-white/70 mt-1\">UX Director</p>\n                                </div>\n                                <div class=\"flex justify-between items-end\">\n                                    <div class=\"flex flex-col gap-0.5\">\n                                        <p class=\"text-xs font-light text-white/80\">99 Cloud Way, NY</p>\n                                        <p class=\"text-xs font-light text-white/80\">maya@velocity.dev</p>\n                                    </div>\n                                    <div class=\"w-6 h-6 relative\">\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(45deg);\"><div class=\"w-full h-[2px] bg-white\"></div></div>\n                                        <div class=\"absolute inset-0 flex items-center justify-center\" style=\"transform: rotate(-45deg);\"><div class=\"w-full h-[2px] bg-white\"></div></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </section>\n\n        <!-- Footer / Links Section -->\n        <footer class=\"pt-32 pb-8 mt-auto w-full z-20\">\n            <div class=\"flex flex-col lg:flex-row gap-16 lg:gap-8 justify-between mb-24 text-sm w-full\">\n\n                <!-- Brand Info & Badges -->\n                <div class=\"flex flex-col gap-8 max-w-sm text-white/90\">\n                    <div>\n                        <div class=\"flex items-center gap-2 font-medium text-base tracking-tight text-white mb-4\">\n                            <iconify-icon icon=\"solar:layers-minimalistic-linear\" width=\"24\" stroke-width=\"1.5\"></iconify-icon>\n                            Velocity\n                        </div>\n                        <p class=\"leading-relaxed font-light text-white/80\">\n                            Infrastructure designed for massive scale. Systems that empower your engineering teams to deploy faster and safer.\n                        </p>\n                    </div>\n\n                    <div class=\"flex items-center gap-5\">\n                        <a href=\"#\" class=\"text-white/60 hover:text-white transition-colors\"><iconify-icon icon=\"solar:twitter-linear\" width=\"22\" stroke-width=\"1.5\"></iconify-icon></a>\n                        <a href=\"#\" class=\"text-white/60 hover:text-white transition-colors\"><iconify-icon icon=\"solar:github-linear\" width=\"22\" stroke-width=\"1.5\"></iconify-icon></a>\n                        <a href=\"#\" class=\"text-white/60 hover:text-white transition-colors\"><iconify-icon icon=\"solar:discord-linear\" width=\"22\" stroke-width=\"1.5\"></iconify-icon></a>\n                    </div>\n\n                    <!-- Trust Badges with Border Gradients -->\n                    <div class=\"flex items-center gap-4 mt-2\">\n                        <div style=\"background: linear-gradient(135deg, #10b981 0%, rgba(255,255,255,0.1) 100%); padding: 1px; border-radius: 50%;\">\n                            <div class=\"bg-[#154ee0] w-16 h-16 rounded-full flex flex-col items-center justify-center text-center shadow-inner\">\n                                <span class=\"font-normal text-xs tracking-tight\">SOC 2</span>\n                                <span class=\"text-[9px] text-white/60 mt-0.5\">Type II</span>\n                            </div>\n                        </div>\n                        <div style=\"background: linear-gradient(135deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.05) 100%); padding: 1px; border-radius: 50%;\">\n                            <div class=\"bg-[#154ee0] w-16 h-16 rounded-full flex flex-col items-center justify-center text-center shadow-inner\">\n                                <iconify-icon icon=\"solar:shield-check-linear\" width=\"16\" stroke-width=\"1.5\" class=\"mb-0.5 text-white/90\"></iconify-icon>\n                                <span class=\"font-normal text-xs tracking-tight\">ISO</span>\n                                <span class=\"text-[9px] text-white/60\">Certified</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Navigation Columns -->\n                <div class=\"grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12 flex-1 lg:max-w-3xl lg:justify-end\">\n                    <div class=\"text-white/90\">\n                        <h3 class=\"font-medium mb-5 uppercase tracking-wider text-xs text-white/50\">Solutions</h3>\n                        <ul class=\"space-y-3 font-light\">\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Compute</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Storage</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Networking</a></li>\n                        </ul>\n                    </div>\n\n                    <div class=\"text-white/90\">\n                        <h3 class=\"font-medium mb-5 uppercase tracking-wider text-xs text-white/50\">Enterprise</h3>\n                        <ul class=\"space-y-3 font-light\">\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Customers</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Compliance</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Pricing</a></li>\n                        </ul>\n                    </div>\n\n                    <div class=\"text-white/90\">\n                        <h3 class=\"font-medium mb-5 uppercase tracking-wider text-xs text-white/50\">About Us</h3>\n                        <ul class=\"space-y-3 font-light\">\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Our Story</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Blog</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Careers</a></li>\n                        </ul>\n                    </div>\n\n                    <div class=\"text-white/90\">\n                        <h3 class=\"font-medium mb-5 uppercase tracking-wider text-xs text-white/50\">Developers</h3>\n                        <ul class=\"space-y-3 font-light\">\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">API Docs</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">Status</a></li>\n                            <li><a href=\"#\" class=\"hover:text-white transition-colors\">GitHub</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Bottom Bar -->\n            <div class=\"flex flex-col md:flex-row justify-between items-center gap-6 text-xs font-light border-t border-white/10 pt-8\" style=\"color: #cbd5e1;\">\n                <div>\n                    &copy; 2024 Velocity Systems. All rights reserved.\n                </div>\n                <div class=\"flex flex-wrap justify-center gap-x-8 gap-y-2\">\n                    <a href=\"#\" class=\"hover:text-white transition-colors\">Terms of Service</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\">Privacy Policy</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\">Cookie Settings</a>\n                </div>\n            </div>\n        </footer>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // GSAP Masked Staggered Word Reveal\n            const titleElement = document.getElementById('hero-title');\n            const lines = [\n                \"Architect your next breakthrough.\",\n                \"Deploy with Velocity.\",\n                \"Grow beyond boundaries.\"\n            ];\n\n            lines.forEach((line) => {\n                const lineDiv = document.createElement('div');\n                const words = line.split(' ');\n\n                words.forEach(word => {\n                    const wrapper = document.createElement('span');\n                    wrapper.style.overflow = 'hidden';\n                    wrapper.style.display = 'inline-block';\n                    wrapper.style.marginRight = '0.25em';\n                    wrapper.style.verticalAlign = 'top';\n\n                    const inner = document.createElement('span');\n                    inner.textContent = word;\n                    inner.style.display = 'inline-block';\n                    inner.classList.add('reveal-word');\n\n                    wrapper.appendChild(inner);\n                    lineDiv.appendChild(wrapper);\n                });\n                titleElement.appendChild(lineDiv);\n            });\n\n            gsap.fromTo('.reveal-word',\n                { y: '110%', opacity: 0 },\n                {\n                    y: '0%',\n                    opacity: 1,\n                    duration: 1.2,\n                    ease: 'power4.out',\n                    stagger: 0.05,\n                    scrollTrigger: {\n                        trigger: '#hero-title',\n                        start: 'top 85%',\n                    }\n                }\n            );\n\n            // WebGL-like Interaction (Mouse Tilt & Auto Spin)\n            const spinWrapper = document.getElementById('spin-wrapper');\n\n            // Continuous slow rotation\n            gsap.to(spinWrapper, {\n                rotationZ: 360,\n                duration: 70,\n                repeat: -1,\n                ease: \"none\"\n            });\n\n            // Smooth mouse tilt parallax\n            let mouseX = 0;\n            let mouseY = 0;\n            const windowHalfX = window.innerWidth / 2;\n            const windowHalfY = window.innerHeight / 2;\n\n            document.addEventListener('mousemove', (e) => {\n                mouseX = (e.clientX - windowHalfX) * 0.025;\n                mouseY = (e.clientY - windowHalfY) * 0.025;\n            });\n\n            const xTo = gsap.quickTo(\"#tilt-wrapper\", \"rotateY\", {duration: 0.8, ease: \"power3.out\"});\n            const yTo = gsap.quickTo(\"#tilt-wrapper\", \"rotateX\", {duration: 0.8, ease: \"power3.out\"});\n\n            gsap.ticker.add(() => {\n                xTo(mouseX);\n                yTo(-mouseY);\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "velocity-infrastructure-for-scale.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/velocity-infrastructure-for-scale.jpg", "source_name": "velocity-infrastructure-for-scale-DESIGN.md", "views": 197, "forks": 2, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T19:17:41.822916+00:00"}