0 w-full h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent z-40 opacity-60\"></div>\n\n    <!-- Main Content -->\n    <main class=\"relative z-10 flex flex-col items-center justify-center min-h-screen pt-32 pb-20 px-4 md:px-8 max-w-6xl mx-auto text-center\">\n\n        <!-- Badge -->\n        <div class=\"animate-item opacity-0 translate-y-8 blur-sm transition-all duration-1000 ease-out delay-100 inline-flex items-center justify-center p-[1px] rounded-full bg-gradient-to-r from-gray-300 via-gray-400 to-gray-300 mb-10 shadow-sm\">\n            <div class=\"bg-white/80 backdrop-blur-md rounded-full px-3 py-1.5 flex items-center gap-3\">\n                <span class=\"bg-black text-white text-xs px-2.5 py-0.5 rounded-full font-medium tracking-wide font-jetbrains-mono\">New</span>\n                <span class=\"text-sm font-light text-gray-700 pr-2 font-jetbrains-mono\">The synchronization layer, redefined.</span>\n            </div>\n        </div>\n\n        <!-- Hero Title (GSAP Masked Reveal) -->\n        <h1 class=\"font-serif-custom text-5xl md:text-7xl lg:text-7xl tracking-tighter text-black leading-[1.1] mb-6 max-w-4xl mx-auto flex flex-wrap justify-center gap-x-3 gap-y-2\">\n            <span class=\"overflow-hidden inline-block pt-1 pb-2 px-1\"><span class=\"gsap-word inline-block opacity-0 translate-y-full font-dotgothic16\">Deep</span></span>\n            <span class=\"overflow-hidden inline-block pt-1 pb-2 px-1\"><span class=\"gsap-word inline-block opacity-0 translate-y-full font-dotgothic16\">focus,</span></span>\n            <div class=\"w-full hidden md:block\"></div>\n            <span class=\"overflow-hidden inline-block pt-1 pb-2 px-1\"><span class=\"gsap-word inline-block opacity-0 translate-y-full font-dotgothic16\">unlocked.</span></span>\n        </h1>\n\n        <!-- Subtitle -->\n        <p class=\"animate-item opacity-0 translate-y-8 blur-sm transition-all duration-1000 ease-out delay-300 text-base md:text-lg text-gray-600 font-light max-w-2xl mx-auto mb-10 leading-relaxed font-jetbrains-mono\">\n            Nexus removes the invisible barriers holding your team back. The endless syncs, scattered docs, and broken processes. Solved.\n        </p>\n\n        <!-- CTA Group -->\n        <div class=\"animate-item opacity-0 translate-y-8 blur-sm transition-all duration-1000 ease-out delay-400 flex flex-col sm:flex-row items-center gap-6 justify-center w-full\">\n            <!-- Hero Button (Black with Beautiful Shadows) -->\n            <a href=\"#\" class=\"bg-black text-white px-7 py-3.5 rounded-lg text-sm font-medium shadow-[0_15px_35px_-5px_rgba(0,0,0,0.5),0_0_20px_rgba(0,0,0,0.15)] hover:-translate-y-1 hover:shadow-[0_25px_45px_-10px_rgba(0,0,0,0.6),0_0_30px_rgba(0,0,0,0.2)] transition-all duration-300 border border-gray-800 font-jetbrains-mono\">\n                Begin for free\n            </a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-500 flex items-center gap-1.5 hover:text-black transition-colors group font-jetbrains-mono\">\n                View documentation\n                <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-base group-hover:translate-x-1 transition-transform\" stroke-width=\"1.5\"></iconify-icon>\n            </a>\n        </div>\n\n        <!-- Section Divider -->\n        <div class=\"animate-item opacity-0 transition-all duration-1000 ease-out delay-500 w-full max-w-2xl h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent mt-20 mb-4 opacity-80\"></div>\n\n        <!-- App Mockup Container -->\n        <div class=\"animate-item opacity-0 translate-y-16 blur-lg transition-all duration-1000 ease-out delay-500 mt-8 w-full max-w-[800px] relative group perspective-1000\">\n\n            <!-- Soft Underglow -->\n            <div class=\"absolute -inset-4 bg-gradient-to-b from-transparent to-black/10 rounded-[2rem] blur-2xl opacity-60\"></div>\n\n            <!-- Gradient Border Wrapper -->\n            <div class=\"relative rounded-2xl p-[1px] bg-gradient-to-b from-gray-400 via-gray-600 to-gray-800 shadow-[0_30px_80px_-15px_rgba(0,0,0,0.2)]\">\n\n                <!-- Inner App Surface -->\n                <div class=\"bg-[#151515] rounded-2xl aspect-[21/9] sm:aspect-[24/8] flex flex-col justify-between p-6 md:p-8 relative overflow-hidden\">\n\n                    <!-- Top Text / Prompt Area -->\n                    <div class=\"text-gray-300 text-lg md:text-xl font-light text-left flex items-center pt-2 font-jetbrains-mono\">\n                        Welcome to Nexus - orchestrate my day.\n                        <span class=\"w-[2px] h-5 md:h-6 bg-gray-400 ml-1.5 animate-cursor\"></span>\n                    </div>\n\n                    <!-- Bottom Controls Bar -->\n                    <div class=\"flex justify-between items-end w-full pb-1\">\n\n                        <!-- Left Action Icons -->\n                        <div class=\"flex items-center gap-3 text-gray-500\">\n                            <button class=\"w-8 h-8 rounded-md bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all border border-white/5\">\n                                <iconify-icon icon=\"solar:add-square-linear\" class=\"text-lg\" stroke-width=\"1.5\"></iconify-icon>\n                            </button>\n                            <button class=\"w-8 h-8 rounded-md bg-white/5 flex items-center justify-center hover:bg-white/10 hover:text-white transition-all border border-white/5\">\n                                <iconify-icon icon=\"solar:widget-linear\" class=\"text-lg\" stroke-width=\"1.5\"></iconify-icon>\n                            </button>\n                        </div>\n\n                        <!-- Right Status & Submit -->\n                        <div class=\"flex items-center gap-4 text-xs font-light text-gray-400\">\n                            <div class=\"flex items-center gap-2 font-jetbrains-mono\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-green-400/80 shadow-[0_0_8px_rgba(74,222,128,0.4)]\"></div>\n                                4 sources connected\n                            </div>\n                            <button class=\"w-8 h-8 rounded-md bg-gray-200 text-black flex items-center justify-center hover:bg-white hover:scale-105 transition-all shadow-sm\">\n                                <iconify-icon icon=\"solar:arrow-left-down-linear\" class=\"text-lg\" stroke-width=\"1.5\"></iconify-icon>\n                            </button>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- Logic -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // --- Sequence Animations (Vanilla JS for structural elements) ---\n            const items = document.querySelectorAll('.animate-item');\n\n            // Staggered reveal for layout elements\n            items.forEach((item, index) => {\n                setTimeout(() => {\n                    item.classList.remove('opacity-0', '-translate-y-4', 'translate-y-8', 'translate-y-16', 'blur-sm', 'blur-lg');\n                    item.classList.add('opacity-100', 'translate-y-0', 'blur-0');\n                }, 100 + (index * 150));\n            });\n\n            // --- GSAP Masked Word Reveal ---\n            // Triggers shortly after page load to align with sequence\n            setTimeout(() => {\n                gsap.to(\".gsap-word\", {\n                    y: \"0%\",\n                    opacity: 1,\n                    duration: 1.2,\n                    ease: \"power4.out\",\n                    stagger: 0.15,\n                    scrollTrigger: {\n                        trigger: \"h1\",\n                        start: \"top 80%\"\n                    }\n                });\n            }, 300);\n        });\n    </script>\n\n\n<script data-neuform-video-controller=\"true\">\n(function () {\n  function playVideo(video) {\n    var promise = video.play();\n    if (promise && typeof promise.catch === \"function\") {\n      promise.catch(function () {});\n    }\n  }\n  function setupVideo(video) {\n    if (video.__neuformVideoReady === true) return;\n    video.__neuformVideoReady = true;\n    video.muted = true;\n    video.playsInline = true;\n    var preset = video.dataset.neuformVideoPreset || \"loop-in-view\";\n    if (preset === \"hover\") {\n      video.addEventListener(\"mouseenter\", function () { playVideo(video); });\n      video.addEventListener(\"mouseleave\", function () {\n        video.pause();\n        video.currentTime = 0;\n      });\n      return;\n    }\n    if (!(\"IntersectionObserver\" in window)) {\n      playVideo(video);\n      return;\n    }\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          if (preset === \"play-once\" && video.__neuformVideoPlayed === true) return;\n          playVideo(video);\n        } else {\n          video.pause();\n        }\n      });\n    }, { threshold: 0.35 });\n    if (preset === \"play-once\") {\n      video.addEventListener(\"ended\", function () {\n        video.__neuformVideoPlayed = true;\n      }, { once: true });\n    }\n    observer.observe(video);\n  }\n  function setupVideos() {\n    document.querySelectorAll(\"video[data-neuform-video-preset]\").forEach(setupVideo);\n  }\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", setupVideos);\n  } else {\n    setupVideos();\n  }\n})();</script></body></html>", "preview_file_name": "nexus-deep-focus-unlocked.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/nexus-deep-focus-unlocked.jpg", "source_name": "nexus-deep-focus-unlocked-DESIGN.md", "views":