ee.js, gradients, particles, or atmospheric effects, rebuild them as supporting layers behind the content. Keep effects performant, responsive, and secondary to the interface.\n\n## Guardrails\n- Do not flatten the source into a generic card grid.\n- Do not swap the color mode unless the source clearly supports it.\n- Preserve the first viewport signal, focal object, and visual density.\n- Keep buttons, cards, and badges aligned to the same radius and border language.", "preview_html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Futuristic Architectural Developments</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap\" rel=\"stylesheet\">\n</head>\n<body class=\"bg-[#050a12] text-white font-['Inter',sans-serif] antialiased overflow-x-hidden selection:bg-cyan-500/30 selection:text-white\">\n\n    <!-- Background Layer with Overlay -->\n    <div class=\"fixed inset-0 w-full h-full z-0 overflow-hidden\">\n        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/5ee0a38a-b5d3-4531-8793-98beed4af162_1600w.jpg\"\n             alt=\"Futuristic Architecture\"\n             class=\"bg-image absolute inset-0 w-full h-full object-cover object-center scale-110\">\n        <!-- Deep gradient to ensure text readability on the left -->\n        <div class=\"absolute inset-0 bg-gradient-to-r from-[#050a12] via-[#050a12]/80 to-transparent\"></div>\n        <div class=\"absolute inset-0 bg-gradient-to-t from-[#050a12] via-transparent to-transparent\"></div>\n    </div>\n\n    <!-- Header Navigation -->\n    <header class=\"fixed top-0 left-0 w-full px-6 py-8 md:px-12 flex justify-between items-center z-50 ui-element opacity-0\">\n        <div class=\"text-xl md:text-2xl tracking-[0.3em] font-medium uppercase\">\n            Hubtown\n        </div>\n        <div class=\"flex items-center gap-6 md:gap-8\">\n            <button class=\"text-xs font-medium tracking-widest uppercase text-gray-300 hover:text-cyan-400 transition-colors flex items-center gap-2\">\n                <iconify-icon icon=\"solar:user-linear\" width=\"18\" height=\"18\" stroke-width=\"1.5\"></iconify-icon>\n                <span class=\"hidden sm:inline\">Login</span>\n            </button>\n            <button class=\"bg-white text-[#050a12] text-xs font-medium tracking-widest uppercase px-6 py-3 md:px-8 md:py-4 flex items-center gap-2 hover:bg-gray-200 transition-colors rounded-sm\">\n                <iconify-icon icon=\"solar:hamburger-menu-linear\" width=\"18\" height=\"18\" stroke-width=\"1.5\"></iconify-icon>\n                Menu\n            </button>\n        </div>\n    </header>\n\n    <!-- Vertical Side Navigation Indicator -->\n    <nav class=\"fixed left-8 lg:left-12 top-1/2 -translate-y-1/2 z-40 hidden md:flex flex-col items-start gap-10 ui-element opacity-0\">\n        <div class=\"absolute w-[1px] bg-white/10 h-[80%] top-[10%] left-[3px] z-0\"></div>\n\n        <div class=\"relative z-10 flex items-center gap-6 group cursor-pointer\">\n            <div class=\"w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_12px_rgba(34,211,238,0.8)] relative before:absolute before:inset-[-4px] before:rounded-full before:border before:border-cyan-400/30\"></div>\n            <span class=\"text-xs tracking-widest uppercase text-white font-medium absolute left-8 opacity-100 transition-opacity whitespace-nowrap\">Future</span>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-6 group cursor-pointer\">\n            <div class=\"w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors\"></div>\n            <span class=\"text-xs tracking-widest uppercase text-white/50 font-medium absolute left-8 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap\">Innovation</span>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-6 group cursor-pointer\">\n            <div class=\"w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors\"></div>\n            <span class=\"text-xs tracking-widest uppercase text-white/50 font-medium absolute left-8 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap\">Collaboration</span>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-6 group cursor-pointer\">\n            <div class=\"w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors\"></div>\n            <span class=\"text-xs tracking-widest uppercase text-white/50 font-medium absolute left-8 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap\">Excellence</span>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-6 group cursor-pointer\">\n            <div class=\"w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors\"></div>\n            <span class=\"text-xs tracking-widest uppercase text-white/50 font-medium absolute left-8 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap\">Purpose</span>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-6 group cursor-pointer\">\n            <div class=\"w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors\"></div>\n            <span class=\"text-xs tracking-widest uppercase text-white/50 font-medium absolute left-8 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap\">Legacy</span>\n        </div>\n    </nav>\n\n    <!-- Main Content Area -->\n    <main class=\"relative z-10 min-h-screen flex flex-col justify-center px-6 pt-32 pb-40 md:px-32 lg:px-48 w-full max-w-[1920px] mx-auto\">\n        <div class=\"max-w-2xl lg:max-w-3xl\">\n            <!-- Overline -->\n            <div class=\"text-xs tracking-[0.2em] text-cyan-400 uppercase mb-6 md:mb-8 font-medium ui-element opacity-0\">\n                Shaping spaces. Changing lives.\n            </div>\n\n            <!-- Masked Staggered Word Reveal Headline -->\n            <h1 class=\"text-5xl md:text-7xl lg:text-8xl tracking-tight font-light leading-[1.05] mb-8 text-white uppercase flex flex-wrap gap-x-4 md:gap-x-6 gap-y-2\">\n                <span class=\"overflow-hidden inline-flex relative py-1\">\n                    <span class=\"reveal-word inline-block translate-y-[110%] will-change-transform\">We</span>\n                </span>\n                <span class=\"overflow-hidden inline-flex relative py-1\">\n                    <span class=\"reveal-word inline-block translate-y-[110%] will-change-transform\">Build</span>\n                </span>\n                <span class=\"overflow-hidden inline-flex relative py-1\">\n                    <span class=\"reveal-word inline-block translate-y-[110%] will-change-transform\">Tomorrow,</span>\n                </span>\n                <br class=\"hidden lg:block w-full\">\n                <span class=\"overflow-hidden inline-flex relative py-1\">\n                    <span class=\"reveal-word inline-block translate-y-[110%] text-cyan-400 will-change-transform drop-shadow-[0_0_15px_rgba(34,211,238,0.3)]\">Today.</span>\n                </span>\n            </h1>\n\n            <!-- Body Text -->\n            <p class=\"text-sm md:text-base text-gray-400 font-light leading-relaxed max-w-md lg:max-w-lg mb-12 ui-element opacity-0\">\n                For over 40 years, Hubtown has created some of India's most iconic real estate developments, across Residential, Commercial and Industrial projects. From the drawing board to reality, across all facets of society.\n            </p>\n\n            <!-- Tech Call-to-Action Button -->\n            <div class=\"ui-element opacity-0\">\n                <a href=\"#\" class=\"inline-flex items-center gap-4 border border-cyan-500/40 hover:border-cyan-400 bg-cyan-950/10 hover:bg-cyan-900/20 text-white text-xs font-medium tracking-widest uppercase px-8 py-4 transition-all duration-500 relative group backdrop-blur-sm\">\n                    <!-- Corner decorative elements -->\n                    <span class=\"absolute top-0 left-0 w-2 h-[1px] bg-cyan-400 group-hover:w-4 transition-all duration-300\"></span>\n                    <span class=\"absolute top-0 left-0 w-[1px] h-2 bg-cyan-400 group-hover:h-4 transition-all duration-300\"></span>\n                    <span class=\"absolute bottom-0 right-0 w-2 h-[1px] bg-cyan-400 group-hover:w-4 transition-all duration-300\"></span>\n                    <span class=\"absolute bottom-0 right-0 w-[1px] h-2 bg-cyan-400 group-hover:h-4 transition-all duration-300\"></span>\n\n                    Explore our projects\n                    <iconify-icon icon=\"solar:arrow-right-linear\" width=\"18\" height=\"18\" stroke-width=\"1.5\" class=\"group-hover:translate-x-1.5 transition-transform duration-300\"></iconify-icon>\n                </a>\n            </div>\n        </div>\n    </main>\n\n    <!-- Floating Statistics Glass Panel -->\n    <div class=\"absolute bottom-28 md:bottom-32 right-6 md:right-12 lg:right-24 z-30 ui-element opacity-0 hidden sm:block\">\n        <div class=\"backdrop-blur-xl bg-[#03060a]/50 border border-white/5 p-6 lg:p-8 flex items-center gap-8 lg:gap-12 rounded-sm relative overflow-hidden group shadow-2xl\">\n            <!-- Hover ambient glow -->\n            <div class=\"absolute inset-0 bg-gradient-to-tr from-cyan-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none\"></div>\n\n            <div class=\"flex flex-col relative z-10\">\n                <div class=\"text-3xl lg:text-4xl text-cyan-400 font-light tracking-tight mb-2 drop-shadow-[0_0_8px_rgba(34,211,238,0.2)]\">40+</div>\n                <div class=\"text-xs text-gray-400 uppercase tracking-widest font-medium\">Years of legacy</div>\n            </div>\n\n            <div class=\"w-[1px] h-12 bg-white/10 relative z-10\"></div>\n\n            <div class=\"flex flex-col relative z-10\">\n                <div class=\"text-3xl lg:text-4xl text-cyan-400 font-light tracking-tight mb-2 drop-shadow-[0_0_8px_rgba(34,211,238,0.2)]\">100+</div>\n                <div class=\"text-xs text-gray-400 uppercase tracking-widest font-medium\">Projects completed</div>\n            </div>\n\n            <div class=\"w-[1px] h-12 bg-white/10 relative z-10 hidden md:block\"></div>\n\n            <div class=\"flex flex-col relative z-10 hidden md:flex\">\n                <div class=\"text-3xl lg:text-4xl text-cyan-400 font-light tracking-tight mb-2 drop-shadow-[0_0_8px_rgba(34,211,238,0.2)]\">15+</div>\n                <div class=\"text-xs text-gray-400 uppercase tracking-widest font-medium\">Cities impacted</div>\n            </div>\n        </div>\n    </div>\n\n\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            const tl = gsap.timeline();\n\n            // Background subtle zoom effect\n            gsap.to(\".bg-image\", {\n                scale: 1,\n                duration: 6,\n                ease: \"power2.out\"\n            });\n\n            // UI Elements Fade In\n            tl.fromTo(\".ui-element\",\n                { y: 20, opacity: 0 },\n                { y: 0, opacity: 1, duration: 1.2, ease: \"power3.out\", stagger: 0.1 },\n                0.2\n            );\n\n            // Skill Directive: Masked Staggered Word Reveal\n            tl.to(\".reveal-word\", {\n                y: \"0%\",\n                duration: 1.2,\n                ease: \"power4.out\",\n                stagger: 0.15\n            }, 0.6); // Start slightly after UI elements begin appearing\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "futuristic-architectural-developments.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/futuristic-architectural-developments.jpg", "source_name": "futuristic-architectural-developments-DESIGN.md", "views": 317, "forks": 8, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-03T06:37:02.093563+00:00"}