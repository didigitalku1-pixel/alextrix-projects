            alpha = max(alpha, halo * clamp(uBloomOpacity, 0.0, 1.0));\n            fragColor = vec4(color, alpha);\n        }\n\n        void main(){\n            vec4 c;\n            mainImage(c, vUv * iResolution.xy);\n            gl_FragColor = c;\n        }\n        `;\n\n        function srgbColor(hex) {\n            return new THREE.Color(hex).convertSRGBToLinear();\n        }\n\n        // Tuned for Polar Command: cold blue scan, dark graphite grid, soft amber UI contrast\n        const uniforms = {\n            iResolution: { value: new THREE.Vector3(window.innerWidth, window.innerHeight, renderer.getPixelRatio()) },\n            iTime: { value: 0 },\n            uSkew: { value: new THREE.Vector2(0, 0) },\n            uTilt: { value: -0.08 },\n            uYaw: { value: 0.06 },\n            uLineThickness: { value: 0.65 },\n            uLinesColor: { value: srgbColor('#0B1724') }, // Dark polar graphite grid\n            uScanColor: { value: srgbColor('#38BDF8') }, // Arctic cyan scan\n            uGridScale: { value: 0.165 },\n            uLineStyle: { value: 1 }, // Dashed calibration lattice\n            uLineJitter: { value: 0.025 },\n            uScanOpacity: { value: 0.72 },\n            uNoise: { value: 0.008 },\n            uBloomOpacity: { value: 0.48 },\n            uScanGlow: { value: 0.22 }, // Wider, colder sweep core\n            uScanSoftness: { value: 2.1 },\n            uPhaseTaper: { value: 0.8 },\n            uScanDuration: { value: 4.8 }, // Slower calibration sweep\n            uScanDelay: { value: 0.45 },\n            uScanDirection: { value: 2 }, // ping-pong sweep\n            uScanStarts: { value: [0,0,0,0,0,0,0,0] },\n            uScanCount: { value: 0 }\n        };\n\n        const material = new THREE.ShaderMaterial({\n            uniforms: uniforms,\n            vertexShader: vert,\n            fragmentShader: frag,\n            transparent: true,\n            depthWrite: false,\n            depthTest: false\n        });\n\n        const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);\n        scene.add(quad);\n\n        // Post Processing Pipeline - Restrained bloom for precise framing\n        const composer = new EffectComposer(renderer);\n        composer.addPass(new RenderPass(scene, camera));\n\n        const bloom = new BloomEffect({\n            intensity: 0.95,\n            luminanceThreshold: 0.12,\n            luminanceSmoothing: 0.9\n        });\n        bloom.blendMode.opacity.value = 1.0;\n\n        const chroma = new ChromaticAberrationEffect({\n            offset: new THREE.Vector2(0.0009, 0.0012),\n            radialModulation: true,\n            modulationOffset: 0.12\n        });\n\n        const effectPass = new EffectPass(camera, bloom, chroma);\n        effectPass.renderToScreen = true;\n        composer.addPass(effectPass);\n\n        const bootInterface = () => {\n            startInterfaceAnimation();\n            gsap.fromTo(uniforms.uScanOpacity,\n                { value: 0.18 },\n                { value: 0.72, duration: 2.2, ease: \"power2.out\" }\n            );\n            gsap.fromTo(uniforms.uGridScale,\n                { value: 0.22 },\n                { value: 0.165, duration: 2.8, ease: \"expo.out\" }\n            );\n        };\n\n        if (document.readyState === \"loading\") {\n            document.addEventListener(\"DOMContentLoaded\", bootInterface);\n        } else {\n            bootInterface();\n        }\n\n        // Resize handler\n        window.addEventListener('resize', () => {\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            uniforms.iResolution.value.set(window.innerWidth, window.innerHeight, renderer.getPixelRatio());\n            composer.setSize(window.innerWidth, window.innerHeight);\n        });\n\n        // Mouse interaction for subtle pointer-reactive drift\n        let targetSkew = new THREE.Vector2(0, 0);\n        let currentSkew = new THREE.Vector2(0, 0);\n\n        document.addEventListener('mousemove', (e) => {\n            const nx = (e.clientX / window.innerWidth) * 2 - 1;\n            const ny = -(e.clientY / window.innerHeight) * 2 + 1;\n            targetSkew.set(nx * 0.03, ny * 0.05); // Restrained polar drift\n        });\n\n        // Render loop\n        let lastTime = performance.now();\n        function render() {\n            requestAnimationFrame(render);\n            const now = performance.now();\n            const dt = (now - lastTime) / 1000;\n            lastTime = now;\n\n            // Smoothly interpolate drift\n            currentSkew.lerp(targetSkew, 0.03);\n            uniforms.uSkew.value.copy(currentSkew);\n            uniforms.uYaw.value = 0.06 + currentSkew.x * 0.22;\n            uniforms.uTilt.value = -0.08 + Math.sin(uniforms.iTime.value * 0.18) * 0.018;\n            uniforms.uScanGlow.value = 0.2 + Math.sin(uniforms.iTime.value * 0.72) * 0.035;\n\n            uniforms.iTime.value += dt;\n\n            renderer.clear(true, true, true);\n            composer.render(dt);\n        }\n        render();\n\n    </script>\n</body>\n</html>", "preview_file_name": "vertex-command-surface.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/vertex-command-surface.jpg", "source_name": "vertex-command-surface-DESIGN.md", "views": 39, "forks": 0, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-06-21T11:39:54.279152+00:00", "updated_at": "2026-07-03T10:47:55.514069+00:00"}