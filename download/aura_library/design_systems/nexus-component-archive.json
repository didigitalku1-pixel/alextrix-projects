rgba(0,0,0,1) 100%); mask-image: linear-gradient(to bottom, rgba(0,0,0,0) 75%, rgba(0,0,0,1) 87.5%, rgba(0,0,0,1) 100%);\"></div>\n                    <div style=\"position: absolute; inset: 0; z-index: 8; backdrop-filter: blur(64px); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0) 87.5%, rgba(0,0,0,1) 100%); mask-image: linear-gradient(to bottom, rgba(0,0,0,0) 87.5%, rgba(0,0,0,1) 100%);\"></div>\n                </div>\n\n            </div>\n        </div>\n    </div>\n</body>\n</html>", "preview_file_name": "nexus-component-archive.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/nexus-component-archive.jpg", "source_name": "nexus-component-archive-DESIGN.md", "views": 93, "forks": 1, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-01T12:00:51.684318+00:00"}