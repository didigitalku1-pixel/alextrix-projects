ue 16s linear infinite;\n        }\n        .animate-spin-orange {\n            animation: spin-hand-orange 28s linear infinite;\n        }\n    </style>\n</head>\n<body class=\"bg-[#030303] text-gray-100 font-sans antialiased min-h-screen flex flex-col relative overflow-hidden selection:bg-orange-500/30 font-['Inter',sans-serif]\">\n\n    <!-- Background Cinematic Effects -->\n    <div class=\"fixed inset-0 pointer-events-none overflow-hidden z-0\">\n        <!-- Volumetric Fog / Ambient Haze -->\n        <div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.02)_0%,transparent_100%)]\"></div>\n\n        <!-- Diagonal Orange Light Beam -->\n        <div class=\"absolute top-[5%] -left-[10%] w-[120%] h-[30%] rotate-[-15deg] origin-left\">\n            <div class=\"absolute inset-0 bg-gradient-to-r from-orange-600/30 via-orange-500/5 to-transparent blur-[60px] mix-blend-screen\"></div>\n            <!-- Textured Beam Core -->\n            <div class=\"absolute inset-0 opacity-40 mix-blend-color-dodge blur-[2px]\" style=\"background-image: radial-gradient(rgba(249,115,22,0.6) 1px, transparent 1px); background-size: 4px 4px; mask-image: linear-gradient(to right, black 5%, transparent 40%); -webkit-mask-image: linear-gradient(to right, black 5%, transparent 40%);\"></div>\n        </div>\n\n        <!-- Diagonal Blue Light Beam -->\n        <div class=\"absolute bottom-[10%] -right-[10%] w-[120%] h-[30%] rotate-[-15deg] origin-right\">\n            <div class=\"absolute inset-0 bg-gradient-to-l from-blue-600/30 via-blue-500/5 to-transparent blur-[60px] mix-blend-screen\"></div>\n            <!-- Textured Beam Core -->\n            <div class=\"absolute inset-0 opacity-30 mix-blend-color-dodge blur-[2px]\" style=\"background-image: radial-gradient(rgba(37,99,235,0.6) 1px, transparent 1px); background-size: 4px 4px; mask-image: linear-gradient(to left, black 5%, transparent 40%); -webkit-mask-image: linear-gradient(to left, black 5%, transp