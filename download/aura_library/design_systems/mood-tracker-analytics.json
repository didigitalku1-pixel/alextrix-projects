x] p-6 flex flex-col\">\n                <div class=\"flex justify-between items-center text-[10px] text-gray-400 mb-12\">\n                    <span>9:41</span>\n                    <div class=\"flex gap-1.5 items-center\">\n                        <iconify-icon icon=\"solar:cellular-linear\" class=\"text-xs\"></iconify-icon>\n                        <iconify-icon icon=\"solar:wi-fi-linear\" class=\"text-xs\"></iconify-icon>\n                        <iconify-icon icon=\"solar:battery-charge-linear\" class=\"text-xs\"></iconify-icon>\n                    </div>\n                </div>\n\n                <h1 class=\"text-xl tracking-tight text-white mb-2 uppercase reveal-text\">What's your<br>current state?</h1>\n                <p class=\"text-xs text-gray-500 mb-10 reveal-text\">Logged today: 3</p>\n\n                <div class=\"flex flex-col gap-3 mt-4\">\n                    <button class=\"w-full bg-[#161616] hover:bg-[#1f1f1f] transition-all duration-300 rounded-2xl p-5 flex items-center justify-between group/btn border border-white/[0.02] hover:border-white/10\">\n                        <span class=\"text-sm text-gray-400 group-hover/btn:text-white transition-colors\">GREAT</span>\n                        <iconify-icon icon=\"solar:smile-circle-linear\" class=\"text-2xl text-gray-600 group-hover/btn:text-[#f97316] transition-colors\"></iconify-icon>\n                    </button>\n                    <button class=\"w-full bg-[#161616] hover:bg-[#1f1f1f] transition-all duration-300 rounded-2xl p-5 flex items-center justify-between group/btn border border-white/[0.02] hover:border-white/10\">\n                        <span class=\"text-sm text-gray-400 group-hover/btn:text-white transition-colors\">FAIR</span>\n                        <iconify-icon icon=\"solar:plain-2-linear\" class=\"text-2xl text-gray-600 group-hover/btn:text-white transition-colors\"></iconify-icon>\n                    </button>\n                    <button class=\"w-full bg-[#161616] hover:bg-[#1f1f1f] transition-all duration-300 rounded-2xl p-5 flex items-center justify-between group/btn border border-white/[0.02] hover:border-white/10\">\n                        <span class=\"text-sm text-gray-400 group-hover/btn:text-white transition-colors\">POOR</span>\n                        <iconify-icon icon=\"solar:sad-circle-linear\" class=\"text-2xl text-gray-600 group-hover/btn:text-[#525252] transition-colors\"></iconify-icon>\n                    </button>\n                </div>\n\n                <!-- Bottom Nav -->\n                <div class=\"absolute bottom-8 left-0 w-full flex justify-center gap-6 text-[11px] text-gray-500\">\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer text-gray-300\">\n                        <span>Log</span>\n                        <div class=\"w-1 h-1 bg-[#f97316] rounded-full\"></div>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer hover:text-gray-300 transition-colors\">\n                        <span>History</span>\n                        <div class=\"w-1 h-1 bg-transparent rounded-full\"></div>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer hover:text-gray-300 transition-colors\">\n                        <span>Stats</span>\n                        <div class=\"w-1 h-1 bg-transparent rounded-full\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Phone 2: Overview -->\n        <div class=\"relative p-[1px] rounded-[36px] overflow-hidden group/phone w-[300px] h-[640px] shadow-2xl shadow-black\">\n            <!-- Border Gradients & Flashlight -->\n            <div class=\"absolute inset-0 bg-gradient-to-b from-white/10 via-white/5 to-transparent opacity-70\"></div>\n            <div class=\"absolute inset-0 opacity-0 group-hover/phone:opacity-100 transition-opacity duration-500\" style=\"background: radial-gradient(400px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(249,115,22,0.6), transparent 40%);\"></div>\n\n            <div class=\"relative bg-[#0d0d0d] h-full w-full rounded-[35px] p-6 flex flex-col\">\n                <div class=\"flex justify-between items-center text-[10px] text-gray-400 mb-12\">\n                    <span>9:41</span>\n                    <div class=\"flex gap-1.5 items-center\">\n                        <iconify-icon icon=\"solar:cellular-linear\" class=\"text-xs\"></iconify-icon>\n                        <iconify-icon icon=\"solar:wi-fi-linear\" class=\"text-xs\"></iconify-icon>\n                        <iconify-icon icon=\"solar:battery-charge-linear\" class=\"text-xs\"></iconify-icon>\n                    </div>\n                </div>\n\n                <h2 class=\"text-xl tracking-tight text-white mb-2 uppercase reveal-text\">Recent Activity</h2>\n                <p class=\"text-xs text-gray-500 mb-10 reveal-text\">Tracked: 28 of 30 days</p>\n\n                <div id=\"calendar-grid\" class=\"grid grid-cols-7 gap-1.5 mt-2\">\n                    <!-- JS injected -->\n                </div>\n\n                <div class=\"mt-auto mb-20 flex justify-center gap-3 text-[10px] text-gray-500 reveal-text\">\n                    <div class=\"flex items-center gap-1\">GREAT: <span class=\"text-gray-300 border-b border-[#f97316] pb-0.5 ml-1\">8</span></div>\n                    <span class=\"text-gray-700\">•</span>\n                    <div class=\"flex items-center gap-1\">FAIR: <span class=\"text-gray-300 border-b border-white pb-0.5 ml-1\">12</span></div>\n                    <span class=\"text-gray-700\">•</span>\n                    <div class=\"flex items-center gap-1\">POOR: <span class=\"text-gray-300 border-b border-[#525252] pb-0.5 ml-1\">10</span></div>\n                </div>\n\n                <!-- Bottom Nav -->\n                <div class=\"absolute bottom-8 left-0 w-full flex justify-center gap-6 text-[11px] text-gray-500\">\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer hover:text-gray-300 transition-colors\">\n                        <span>Log</span>\n                        <div class=\"w-1 h-1 bg-transparent rounded-full\"></div>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer text-gray-300\">\n                        <span>History</span>\n                        <div class=\"w-1 h-1 bg-[#f97316] rounded-full\"></div>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer hover:text-gray-300 transition-colors\">\n                        <span>Stats</span>\n                        <div class=\"w-1 h-1 bg-transparent rounded-full\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Phone 3: Analytics -->\n        <div class=\"relative p-[1px] rounded-[36px] overflow-hidden group/phone w-[300px] h-[640px] shadow-2xl shadow-black\">\n            <!-- Border Gradients & Flashlight -->\n            <div class=\"absolute inset-0 bg-gradient-to-b from-white/10 via-white/5 to-transparent opacity-70\"></div>\n            <div class=\"absolute inset-0 opacity-0 group-hover/phone:opacity-100 transition-opacity duration-500\" style=\"background: radial-gradient(400px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(249,115,22,0.6), transparent 40%);\"></div>\n\n            <div class=\"relative bg-[#0d0d0d] h-full w-full rounded-[35px] p-6 flex flex-col\">\n                <div class=\"flex justify-between items-center text-[10px] text-gray-400 mb-12\">\n                    <span>9:41</span>\n                    <div class=\"flex gap-1.5 items-center\">\n                        <iconify-icon icon=\"solar:cellular-linear\" class=\"text-xs\"></iconify-icon>\n                        <iconify-icon icon=\"solar:wi-fi-linear\" class=\"text-xs\"></iconify-icon>\n                        <iconify-icon icon=\"solar:battery-charge-linear\" class=\"text-xs\"></iconify-icon>\n                    </div>\n                </div>\n\n                <h2 class=\"text-xl tracking-tight text-white mb-2 uppercase reveal-text\">Mood Analytics</h2>\n                <p class=\"text-xs text-gray-500 mb-10 reveal-text\">Past 30 days summary</p>\n\n                <div class=\"flex flex-col gap-8 mt-2\">\n                    <div class=\"group\">\n                        <div class=\"flex justify-between text-xs mb-3 reveal-text\">\n                            <span class=\"text-gray-400 flex items-center gap-1.5\"><iconify-icon icon=\"solar:smile-circle-linear\"></iconify-icon> Great</span>\n                            <span class=\"text-white\">40%</span>\n                        </div>\n                        <div class=\"h-1.5 w-full bg-[#161616] rounded-full overflow-hidden border border-white/[0.02]\">\n                            <div class=\"h-full bg-[#f97316] w-[40%] rounded-full shadow-[0_0_10px_rgba(249,115,22,0.4)]\"></div>\n                        </div>\n                    </div>\n\n                    <div class=\"group\">\n                        <div class=\"flex justify-between text-xs mb-3 reveal-text\">\n                            <span class=\"text-gray-400 flex items-center gap-1.5\"><iconify-icon icon=\"solar:plain-2-linear\"></iconify-icon> Fair</span>\n                            <span class=\"text-white\">35%</span>\n                        </div>\n                        <div class=\"h-1.5 w-full bg-[#161616] rounded-full overflow-hidden border border-white/[0.02]\">\n                            <div class=\"h-full bg-[#e5e5e5] w-[35%] rounded-full shadow-[0_0_10px_rgba(255,255,255,0.2)]\"></div>\n                        </div>\n                    </div>\n\n                    <div class=\"group\">\n                        <div class=\"flex justify-between text-xs mb-3 reveal-text\">\n                            <span class=\"text-gray-400 flex items-center gap-1.5\"><iconify-icon icon=\"solar:sad-circle-linear\"></iconify-icon> Poor</span>\n                            <span class=\"text-white\">25%</span>\n                        </div>\n                        <div class=\"h-1.5 w-full bg-[#161616] rounded-full overflow-hidden border border-white/[0.02]\">\n                            <div class=\"h-full bg-[#525252] w-[25%] rounded-full\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"mt-auto mb-20 p-4 rounded-2xl bg-[#161616] border border-white/[0.02] flex items-center gap-4 reveal-text\">\n                    <div class=\"p-2 rounded-xl bg-[#1f1f1f] text-[#f97316]\">\n                        <iconify-icon icon=\"solar:graph-up-linear\" class=\"text-xl\"></iconify-icon>\n                    </div>\n                    <div>\n                        <p class=\"text-[10px] text-gray-500\">Trending</p>\n                        <p class=\"text-xs text-gray-200 mt-0.5\">15% happier than last week</p>\n                    </div>\n                </div>\n\n                <!-- Bottom Nav -->\n                <div class=\"absolute bottom-8 left-0 w-full flex justify-center gap-6 text-[11px] text-gray-500\">\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer hover:text-gray-300 transition-colors\">\n                        <span>Log</span>\n                        <div class=\"w-1 h-1 bg-transparent rounded-full\"></div>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer hover:text-gray-300 transition-colors\">\n                        <span>History</span>\n                        <div class=\"w-1 h-1 bg-transparent rounded-full\"></div>\n                    </div>\n                    <div class=\"flex flex-col items-center gap-1.5 cursor-pointer text-gray-300\">\n                        <span>Stats</span>\n                        <div class=\"w-1 h-1 bg-[#f97316] rounded-full\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <script>\n        // Grid Generation\n        const gridData = [\n            2, 1, 2, 3, 1, 2, 2, 3, 3, 2, 2, 1, 3, 3,\n            1, 3, 1, 2, 2, 2, 3, 3, 3, 1, 3, 2, 1, 2,\n            2, 3, 0, 0, 0, 0, 0\n        ];\n\n        const gridContainer = document.getElementById('calendar-grid');\n        gridData.forEach((type, index) => {\n            let bgClass = 'bg-[#161616] border border-white/[0.02]', icon = '', iconColor = '';\n            if(type === 1) { bgClass = 'bg-[#f97316] shadow-[0_0_10px_rgba(249,115,22,0.2)]'; icon = 'smile-circle'; iconColor = 'text-black/60'; }\n            else if(type === 2) { bgClass = 'bg-[#e5e5e5] shadow-[0_0_10px_rgba(255,255,255,0.1)]'; icon = 'plain-2'; iconColor = 'text-black/60'; }\n            else if(type === 3) { bgClass = 'bg-[#404040]'; icon = 'sad-circle'; iconColor = 'text-white/60'; }\n\n            const delay = index * 0.02;\n            gridContainer.innerHTML += `\n                <div class=\"w-full aspect-square rounded-[6px] ${bgClass} flex items-center justify-center transition-transform hover:scale-110 cursor-pointer\" style=\"animation: fadeScale 0.5s ease-out ${delay}s both;\">\n                    ${icon ? `<iconify-icon icon=\"solar:${icon}-linear\" class=\"text-[14px] ${iconColor}\"></iconify-icon>` : ''}\n                </div>\n            `;\n        });\n\n        // Inject Styles for Keyframes\n        const style = document.createElement('style');\n        style.textContent = `\n            @keyframes fadeScale { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: scale(1); } }\n            @keyframes beamMove { 0% { transform: translateY(-150px); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(100vh); opacity: 0; } }\n            .beam-anim { animation: beamMove linear infinite; }\n        `;\n        document.head.appendChild(style);\n\n        // Flashlight Hover Effect\n        document.querySelectorAll('.group\\\\/phone').forEach(el => {\n            el.addEventListener('mousemove', e => {\n                const rect = el.getBoundingClientRect();\n                el.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);\n                el.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);\n            });\n        });\n\n        // GSAP Masked Reveal\n        gsap.registerPlugin(ScrollTrigger);\n        document.querySelectorAll('.reveal-text').forEach(el => {\n            const text = el.innerHTML;\n            const words = text.split(/(\\s+|<br>)/);\n            el.innerHTML = '';\n\n            words.forEach(word => {\n                if(word.match(/\\s+/)) el.appendChild(document.createTextNode(word));\n                else if (word === '<br>') el.appendChild(document.createElement('br'));\n                else if (word !== '') {\n                    const wrapper = document.createElement('span');\n                    wrapper.className = 'inline-block overflow-hidden align-bottom';\n                    const inner = document.createElement('span');\n                    inner.className = 'inline-block translate-y-full will-change-transform';\n                    inner.innerHTML = word;\n                    wrapper.appendChild(inner);\n                    el.appendChild(wrapper);\n                }\n            });\n\n            gsap.to(el.querySelectorAll('span > span'), {\n                y: '0%', ease: 'power4.out', duration: 0.8, stagger: 0.04,\n                scrollTrigger: { trigger: el, start: 'top 95%' }\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "mood-tracker-analytics.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/mood-tracker-analytics.jpg", "source_name": "mood-tracker-analytics-DESIGN.md", "views": 75, "forks": 4, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T13:40:00.436436+00:00"}