ext-white mb-2\">$142.85</h2>\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"text-sm text-white/70 tracking-tight\">+ $14.20</span>\n                            <span class=\"text-xs font-medium text-[#111] bg-brand-glow px-2 py-0.5 rounded-full flex items-center gap-1\">\n                                <iconify-icon icon=\"solar:alt-arrow-up-linear\" width=\"12\"></iconify-icon>\n                                11.04%\n                            </span>\n                        </div>\n                    </div>\n\n                    <!-- Tooltip Box (Simulated hover state) -->\n                    <div class=\"px-6 mt-8 relative z-10\">\n                        <div class=\"bg-white/5 backdrop-blur-md rounded-xl p-3 border border-white/10 w-max transform translate-x-32 opacity-0 animate-[fadeIn_2s_ease-out_1s_forwards]\">\n                            <div class=\"text-[10px] text-white/40 uppercase tracking-[0.05em] mb-1\">Apr 24, 14:00</div>\n                            <div class=\"text-sm font-medium tracking-tight text-white\">$138.50</div>\n                        </div>\n                    </div>\n\n                    <!-- Chart Area -->\n                    <div class=\"relative flex-grow mt-4 w-full px-2 z-10\">\n                        <!-- Chart Line -->\n                        <svg class=\"w-full h-full overflow-visible\" viewBox=\"0 0 300 200\" preserveAspectRatio=\"none\">\n                            <defs>\n                                <filter id=\"glow-chart\">\n                                    <feGaussianBlur stdDeviation=\"4\" result=\"coloredBlur\"/>\n                                    <feMerge>\n                                        <feMergeNode in=\"coloredBlur\"/>\n                                        <feMergeNode in=\"SourceGraphic\"/>\n                                    </feMerge>\n                                </filter>\n                                <linearGradient id=\"chart-grad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                                    <stop offset=\"0%\" stop-color=\"#9DFF3D\" stop-opacity=\"0.2\" />\n                                    <stop offset=\"100%\" stop-color=\"#9DFF3D\" stop-opacity=\"0\" />\n                                </linearGradient>\n                            </defs>\n                            <path d=\"M 0,150 Q 20,140 30,160 T 60,130 T 90,140 T 110,90 T 130,110 T 160,50 T 190,60 T 210,30 T 240,40 T 270,10 L 300,20 L 300,200 L 0,200 Z\" fill=\"url(#chart-grad)\" />\n                            <path class=\"chart-path\" d=\"M 0,150 Q 20,140 30,160 T 60,130 T 90,140 T 110,90 T 130,110 T 160,50 T 190,60 T 210,30 T 240,40 T 270,10 L 300,20\" fill=\"none\" stroke=\"#9DFF3D\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" filter=\"url(#glow-chart)\" />\n\n                            <!-- Dashed zero line -->\n                            <line x1=\"0\" y1=\"170\" x2=\"300\" y2=\"170\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"1\" stroke-dasharray=\"4 4\" />\n                        </svg>\n                    </div>\n\n                    <!-- Timeframe Selector -->\n                    <div class=\"px-6 py-4 flex justify-between items-center relative z-10\">\n                        <button class=\"text-xs text-white/40 hover:text-white transition-colors\">1D</button>\n                        <button class=\"text-xs text-white/40 hover:text-white transition-colors\">1W</button>\n                        <button class=\"text-xs text-white/40 hover:text-white transition-colors\">1M</button>\n                        <button class=\"text-xs font-medium bg-white text-black px-3 py-1.5 rounded-lg\">3M</button>\n                        <button class=\"text-xs text-white/40 hover:text-white transition-colors\">YTD</button>\n                    </div>\n\n                    <!-- Position Details -->\n                    <div class=\"px-6 py-6 border-t border