"mt-8 text-2xl font-semibold tracking-tight\">42 slow spins</h3>\n        <p class=\"mt-3 text-sm font-medium leading-6 text-[#74313a]/70\">Each cup is blended in a short cold cycle for a dense, satin finish.</p>\n      </article>\n\n      <article class=\"relative overflow-hidden rounded-[1.5rem] border border-[#a55259]/20 bg-white/45 p-6 text-[#74313a] shadow-xl shadow-[#b25c65]/10 backdrop-blur-xl\">\n        <div aria-hidden=\"true\" class=\"absolute left-4 top-4 h-8 w-8 border-l border-t border-[#9f4a52]/25\"></div>\n        <div class=\"flex items-center justify-between\">\n          <span class=\"text-xs font-semibold uppercase tracking-[0.24em] text-[#9f4a52]/70\">Fruit ratio</span>\n          <iconify-icon icon=\"solar:leaf-linear\" class=\"text-2xl text-[#b43b49]\" style=\"stroke-width:1.5;\"></iconify-icon>\n        </div>\n        <h3 class=\"mt-8 text-2xl font-semibold tracking-tight\">68% berry base</h3>\n        <p class=\"mt-3 text-sm font-medium leading-6 text-[#74313a]/70\">A bright berry body with a clean finish and no heavy syrup feel.</p>\n      </article>\n\n      <article class=\"relative overflow-hidden rounded-[1.5rem] border border-[#a55259]/20 bg-white/45 p-6 text-[#74313a] shadow-xl shadow-[#b25c65]/10 backdrop-blur-xl\">\n        <div aria-hidden=\"true\" class=\"absolute left-4 top-4 h-8 w-8 border-l border-t border-[#9f4a52]/25\"></div>\n        <div class=\"flex items-center justify-between\">\n          <span class=\"text-xs font-semibold uppercase tracking-[0.24em] text-[#9f4a52]/70\">Serving window</span>\n          <iconify-icon icon=\"solar:clock-circle-linear\" class=\"text-2xl text-[#b43b49]\" style=\"stroke-width:1.5;\"></iconify-icon>\n        </div>\n        <h3 class=\"mt-8 text-2xl font-semibold tracking-tight\">7 minute peak</h3>\n        <p class=\"mt-3 text-sm font-medium leading-6 text-[#74313a]/70\">Best enjoyed immediately while the foam is high and glass-cold.</p>\n      </article>\n    </section>\n  </main>\n\n  <script>\n    (function () {\n      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n      function initWebGL() {\n        const canvas = document.getElementById('webgl-canvas');\n        const fallback = document.getElementById('webgl-fallback');\n        if (!canvas || !window.THREE) {\n          if (canvas) canvas.style.display = 'none';\n          if (fallback) fallback.style.display = 'block';\n          return;\n        }\n\n        try {\n          const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });\n          const scene = new THREE.Scene();\n          const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);\n          const geometry = new THREE.PlaneBufferGeometry(2, 2);\n\n          const material = new THREE.ShaderMaterial({\n            transparent: true,\n            uniforms: {\n              uTime: { value: reducedMotion ? 1.8 : 0 },\n              uResolution: { value: new THREE.Vector2(1, 1) }\n            },\n            vertexShader: 'varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position, 1.0); }',\n            fragmentShader: [\n              'precision highp float;',\n              'uniform float uTime;',\n              'uniform vec2 uResolution;',\n              'varying vec2 vUv;',\n              'float wave(vec2 p, float speed, float scale){',\n              '  return sin((p.x * scale) + uTime * speed + sin(p.y * 5.0 + uTime * 0.5)) * 0.5 + 0.5;',\n              '}',\n              'void main(){',\n              '  vec2 uv = vUv;',\n              '  vec2 p = uv - 0.5;',\n              '  p.x *= uResolution.x / max(uResolution.y, 1.0);',\n              '  float r = length(p);',\n              '  float w1 = wave(uv + vec2(0.0, sin(uTime * 0.12) * 0.08), 0.55, 12.0);',\n              '  float w2 = wave(uv.yx + vec2(cos(uTime * 0.18) * 0.06, 0.0), -0.42, 9.0);',\n              '  float bloom = smoothstep(0.72, 0.05, r);',\n              '  vec3 pink = vec3(1.0, 0.47, 0.51);',\n              '  vec3 cream = vec3(1.0, 0.82, 0.75);',\n              '  vec3 wine = vec3(0.55, 0.11, 0.17);',\n              '  vec3 color = mix(wine, pink, w1 * 0.65 + 0.22);',\n              '  color = mix(color, cream, w2 * bloom * 0.34);',\n              '  float alpha = (0.20 + bloom * 0.32 + w1 * 0.08) * smoothstep(1.0, 0.05, r);',\n              '  gl_FragColor = vec4(color, alpha);',\n              '}'\n            ].join('')\n          });\n\n          const mesh = new THREE.Mesh(geometry, material);\n          scene.add(mesh);\n\n          function resize() {\n            const rect = canvas.getBoundingClientRect();\n            const width = Math.max(1, Math.floor(rect.width * Math.min(window.devicePixelRatio || 1, 2)));\n            const height = Math.max(1, Math.floor(rect.height * Math.min(window.devicePixelRatio || 1, 2)));\n            renderer.setSize(rect.width, rect.height, false);\n            material.uniforms.uResolution.value.set(width, height);\n          }\n\n          resize();\n          window.addEventListener('resize', resize, { passive: true });\n\n          if (fallback) fallback.style.display = 'none';\n\n          if (reducedMotion) {\n            renderer.render(scene, camera);\n            return;\n          }\n\n          const start = performance.now();\n          function render(now) {\n            material.uniforms.uTime.value = (now - start) * 0.001;\n            renderer.render(scene, camera);\n            requestAnimationFrame(render);\n          }\n          requestAnimationFrame(render);\n        } catch (error) {\n          canvas.style.display = 'none';\n          if (fallback) fallback.style.display = 'block';\n        }\n      }\n\n      function initMotion() {\n        if (!window.gsap) return;\n\n        gsap.registerPlugin(window.ScrollTrigger || {});\n\n        if (reducedMotion) {\n          gsap.set(['.motion-nav', '.title-word', '.motion-shake', '.berry', '.tag', '.motion-card', '.motion-ring', '.motion-arrows', '.motion-mobile-card', '.motion-side'], { clearProps: 'all', opacity: 1 });\n          return;\n        }\n\n        gsap.set('.motion-nav', { y: -28, opacity: 0 });\n        gsap.set('.title-word', { yPercent: 22, scale: 1.05, opacity: 0, filter: 'blur(10px)' });\n        gsap.set('.motion-shake', { yPercent: 18, scale: 0.82, opacity: 0, rotate: -2 });\n        gsap.set('.berry', { scale: 0, opacity: 0, rotate: -24 });\n        gsap.set('.tag', { x: 26, opacity: 0 });\n        gsap.set('.motion-card', { x: -42, y: 20, opacity: 0, scale: 0.96 });\n        gsap.set('.motion-mobile-card', { y: 26, opacity: 0, scale: 0.96 });\n        gsap.set('.motion-ring', { y: 20, opacity: 0, scale: 0.8 });\n        gsap.set('.motion-arrows', { x: 20, opacity: 0 });\n        gsap.set('.motion-side', { scale: 0.86, opacity: 0 });\n        gsap.set('.milk-splash', { scaleX: 0.65, opacity: 0, transformOrigin: '50% 50%' });\n        gsap.set('.splash-dot', { scale: 0, opacity: 0 });\n\n        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });\n\n        tl.to('.motion-nav', { y: 0, opacity: 1, duration: 0.9 }, 0.15)\n          .to('.title-word', { yPercent: 0, scale: 1, opacity: 1, filter: 'blur(0px)', duration: 1.25 }, 0.45)\n          .to('.milk-splash', { scaleX: 1, opacity: 0.72, duration: 1.15 }, 1.0)\n          .to('.motion-shake', { yPercent: 0, scale: 1, opacity: 1, rotate: 0, duration: 1.15 }, 1.2)\n          .to('.splash-dot', { scale: 1, opacity: 1, duration: 0.55, stagger: 0.08 }, 1.72)\n          .to('.berry', { scale: 1, opacity: 1, rotate: 0, duration: 0.72, stagger: 0.11, ease: 'back.out(1.7)' }, 2.0)\n          .to('.tag', { x: 0, opacity: 1, duration: 0.6, stagger: 0.09 }, 2.62)\n          .to('.motion-card', { x: 0, y: 0, opacity: 1, scale: 1, duration: 0.85 }, 3.08)\n          .to('.motion-mobile-card', { y: 0, opacity: 1, scale: 1, duration: 0.75 }, 3.08)\n          .to('.motion-ring', { y: 0, opacity: 1, scale: 1, duration: 0.78 }, 3.38)\n          .to('.motion-arrows', { x: 0, opacity: 1, duration: 0.62 }, 3.76)\n          .to('.motion-side', { scale: 1, opacity: 1, duration: 0.62, stagger: 0.08 }, 4.05)\n          .to('.title-word', { letterSpacing: '-0.045em', duration: 1.2, ease: 'sine.inOut' }, 4.5)\n          .to('.motion-shake', { y: -8, duration: 1.1, ease: 'sine.inOut' }, 5.2)\n          .to('.motion-shake', { y: 0, duration: 1.1, ease: 'sine.inOut' }, 6.3);\n\n        gsap.to('.berry-a', { y: -18, x: 8, rotate: -10, duration: 3.2, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 4.3 });\n        gsap.to('.berry-b', { y: 14, x: -10, rotate: 8, duration: 3.7, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 4.4 });\n        gsap.to('.berry-c', { y: -16, x: -8, rotate: -8, duration: 3.4, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 4.5 });\n        gsap.to('.berry-d', { y: 12, x: 10, rotate: 10, duration: 4.0, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 4.6 });\n        gsap.to('.berry-e', { y: -10, x: 10, rotate: 10, duration: 3.5, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 4.7 });\n        gsap.to('.motion-ring > div', { rotate: 360, duration: 18, repeat: -1, ease: 'none', delay: 4.2 });\n\n        if (window.ScrollTrigger) {\n          gsap.from('.scroll-section article', {\n            scrollTrigger: {\n              trigger: '.scroll-section',\n              start: 'top 85%',\n              once: true\n            },\n            y: 34,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.12,\n            ease: 'power3.out'\n          });\n        }\n      }\n\n      initWebGL();\n      initMotion();\n    })();\n  </script>\n</body>\n</html>", "preview_file_name": "frovia-berry-landing.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/frovia-berry-landing.jpg", "source_name": "frovia-berry-la