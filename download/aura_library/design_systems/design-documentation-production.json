pointer-events-none\"></div>\n                                <span class=\"text-white font-medium tracking-wide text-lg relative z-10 drop-shadow-md\">Create</span>\n                            </div>\n\n                            <div class=\"h-16 rounded-xl bg-[#1A1A1A] border-t border-white/10 border-b-[4px] border-[#0A0A0A] shadow-[0_4px_10px_rgba(0,0,0,0.5)] flex items-center justify-center cursor-pointer hover:bg-[#222] hover:border-b-[2px] hover:translate-y-[2px] transition-all\">\n                                <span class=\"text-white/50 font-medium text-sm\">Log</span>\n                            </div>\n\n                            <div class=\"h-16 rounded-xl bg-[#1A1A1A] border-t border-white/10 border-b-[4px] border-[#0A0A0A] shadow-[0_4px_10px_rgba(0,0,0,0.5)] flex items-center justify-center cursor-pointer hover:bg-[#222] hover:border-b-[2px] hover:translate-y-[2px] transition-all\">\n                                <span class=\"text-white/50 font-medium text-sm\">π</span>\n                            </div>\n                            <div class=\"h-16 rounded-xl bg-[#1A1A1A] border-t border-white/10 border-b-[4px] border-[#0A0A0A] shadow-[0_4px_10px_rgba(0,0,0,0.5)] flex items-center justify-center cursor-pointer hover:bg-[#222] hover:border-b-[2px] hover:translate-y-[2px] transition-all\">\n                                <span class=\"text-white/50 font-medium text-sm\">√x</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Text Content -->\n                <div class=\"p-8 lg:p-10 mt-auto relative z-30 max-w-md bg-surface/50 backdrop-blur-sm md:bg-transparent md:backdrop-blur-none rounded-xl\">\n                    <h2 class=\"text-[22px] leading-tight tracking-tight font-medium text-white mb-3\">Checking the numbers</h2>\n                    <p class=\"text-sm text-neutral-400 leading-relaxed reveal-text\">We validate designs with structural, mass, fit, and cost calculations to eliminate production risks before release</p>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <!-- Interactions Script -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            // Register GSAP ScrollTrigger\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Masked Reveal Animation for paragraphs\n            const textElements = document.querySelectorAll('.reveal-text');\n\n            textElements.forEach(el => {\n                const text = el.innerText;\n                el.innerHTML = ''; // Clear existing text\n\n                // Wrap each word in masking spans\n                const words = text.split(' ');\n                words.forEach((word, index) => {\n                    const wordContainer = document.createElement('span');\n                    // Style for masking: overflow hidden and inline-block\n                    wordContainer.className = 'inline-flex overflow-hidden align-top mr-[0.25em] py-0.5';\n\n                    const wordInner = document.createElement('span');\n                    // Initial state: translated down fully\n                    wordInner.className = 'inline-block translate-y-[110%] will-change-transform';\n                    wordInner.innerText = word;\n\n                    wordContainer.appendChild(wordInner);\n                    el.appendChild(wordContainer);\n                });\n\n                // GSAP Animation\n                gsap.to(el.querySelectorAll('span > span'), {\n                    y: '0%',\n                    duration: 0.7,\n                    stagger: 0.015,\n                    ease: 'power3.out',\n                    scrollTrigger: {\n                        trigger: el,\n                        start: 'top 95%',\n                        toggleActions: 'play none none reverse'\n                    }\n                });\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "design-documentation-production.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/design-documentation-production.jpg", "source_name": "design-documentation-production-DESIGN.md", "views": 151, "forks": 10, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T15:54:31.114655+00:00"}