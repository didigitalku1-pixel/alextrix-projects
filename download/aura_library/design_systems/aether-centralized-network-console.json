y-2.5 rounded-full text-xs font-light uppercase tracking-[0.2em] text-[#F4EFE5] transition-all shadow-sm flex items-center gap-2\"\n            style=\"\n              background: linear-gradient(180deg, #3A3D38 0%, #1A1F1E 100%);\n              box-shadow:\n                inset 0 1px 1px rgba(255,255,255,0.11),\n                0 2px 7px rgba(0,0,0,0.66);\n              text-shadow: 0 1px 2px rgba(0,0,0,0.82);\n            \"\n          >\n            Relay\n            <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"12\" class=\"opacity-60\"></iconify-icon>\n          </a>\n\n          <a\n            href=\"#\"\n            class=\"px-5 py-2.5 rounded-full text-xs font-light uppercase tracking-[0.2em] text-[#817B6E] transition-all hover:text-[#D8CBB6] active:scale-95\"\n            style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.82);\"\n          >\n            Orbit\n          </a>\n\n          <a\n            href=\"#\"\n            class=\"px-5 py-2.5 rounded-full text-xs font-light uppercase tracking-[0.2em] text-[#817B6E] transition-all hover:text-[#D8CBB6] active:scale-95\"\n            style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.82);\"\n          >\n            Telemetry\n          </a>\n        </nav>\n\n        <!-- Right Action Button -->\n        <div class=\"w-full md:w-1/3 flex justify-center md:justify-end\">\n          <a\n            href=\"#\"\n            class=\"px-6 py-2.5 rounded-full text-xs font-light uppercase tracking-[0.2em] text-[#D8CBB6] flex items-center gap-3 active:scale-95 transition-transform\"\n            style=\"\n              background: linear-gradient(180deg, #202722 0%, #0A0D0C 100%);\n              box-shadow:\n                inset 0 1px 1px rgba(255,255,255,0.08),\n                inset 0 -1px 2px rgba(0,0,0,0.42),\n                0 4px 10px rgba(0,0,0,0.64);\n              border: 1px solid rgba(216,168,95,0.20);\n              text-shadow: 0 1px 2px rgba(0,0,0,0.82);\n            \"\n          >\n            <div class=\"w-px h-3 bg-[#8A734B] shadow-[1px_0_0_rgba(0,0,0,0.8)]\"></div>\n            Authenticate\n          </a>\n        </div>\n      </header>\n\n      <!-- Main Interactive Area -->\n      <main class=\"flex-grow grid grid-cols-1 lg:grid-cols-12 gap-12 px-8 md:px-16 pb-16 relative z-10 items-center\">\n\n        <!-- Left Typographic & Control Column -->\n        <div class=\"lg:col-span-6 flex flex-col justify-center max-w-[42rem]\">\n\n          <!-- Engraved Meta Label -->\n          <div class=\"flex items-center gap-4 mb-8\">\n            <div\n              class=\"w-8 h-[2px] rounded-full\"\n              style=\"\n                background: #4B4A43;\n                box-shadow:\n                  inset 0 1px 1px rgba(0,0,0,0.68),\n                  0 1px 1px rgba(255,255,255,0.05);\n              \"\n            ></div>\n\n            <span\n              class=\"text-xs font-light uppercase tracking-[0.24em] text-[#A69C88]\"\n              style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.82); font-family: 'IBM Plex Mono', monospace;\"\n            >\n              Orbital Relay Spec v4.6\n            </span>\n          </div>\n\n          <!-- Headline -->\n          <h1\n            class=\"text-4xl md:text-5xl lg:text-6xl leading-[0.98] tracking-[-0.055em] font-light text-[#F4EFE5] mb-8\"\n            style=\"text-shadow: 0 2px 9px rgba(0,0,0,0.82), 0 1px 2px rgba(0,0,0,0.45);\"\n          >\n            Secure relay <br>\n            control for <br>\n            moving signals.\n          </h1>\n\n          <p\n            class=\"text-sm md:text-base text-[#A69C88] leading-relaxed font-light mb-12 max-w-[34rem]\"\n            style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.64);\"\n          >\n            Coordinate encrypted relay paths, orbital nodes, and distributed signal traffic from a single tactile command surface built for high-pressure infrastructure operations.\n          </p>\n\n          <!-- Tactical Action Group -->\n          <div class=\"flex flex-col sm:flex-row items-center gap-6 w-full\">\n\n            <!-- Primary Button -->\n            <div\n              class=\"p-[1px] rounded-full inline-block cursor-pointer active:scale-[0.97] transition-transform w-full sm:w-auto shadow-[0_8px_22px_rgba(0,0,0,0.62),0_2px_4px_rgba(0,0,0,0.42)]\"\n              style=\"background: linear-gradient(180deg, #B58A4B 0%, #251C12 100%);\"\n            >\n              <button\n                class=\"flex items-center justify-center gap-6 px-10 py-5 rounded-full w-full h-full relative overflow-hidden group\"\n                style=\"\n                  background:\n                    linear-gradient(180deg, rgba(244,207,128,0.18) 0%, rgba(82,57,29,0.24) 42%, rgba(9,11,10,0.98) 100%);\n                  box-shadow:\n                    inset 0 2px 3px rgba(255,255,255,0.12),\n                    inset 0 -3px 7px rgba(0,0,0,0.84);\n                \"\n              >\n                <span\n                  class=\"text-xs font-light uppercase tracking-[0.22em] text-[#F3C879] relative z-10\"\n                  style=\"text-shadow: 0 1px 2px rgba(0,0,0,0.82); font-family: 'IBM Plex Mono', monospace;\"\n                >\n                  Initialize Relay\n                </span>\n\n                <iconify-icon\n                  icon=\"solar:round-alt-arrow-right-linear\"\n                  width=\"20\"\n                  class=\"text-[#F3C879] relative z-10 group-hover:translate-x-1 transition-transform\"\n                  style=\"filter: drop-shadow(0 0 5px rgba(216,168,95,0.58));\"\n                ></iconify-icon>\n              </button>\n            </div>\n\n            <!-- Physical Tag -->\n            <div\n              class=\"px-5 py-3 rounded-xl flex items-center gap-3\"\n              style=\"\n                background: #070A09;\n                box-shadow:\n                  inset 0 2px 7px rgba(0,0,0,0.84),\n                  0 1px 1px rgba(255,255,255,0.05);\n              \"\n     