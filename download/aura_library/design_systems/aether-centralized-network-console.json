  border-top: 1px solid rgba(244,239,229,0.04);\n          box-shadow: inset 0 1px 0 rgba(0,0,0,0.82);\n        \"\n      >\n        <div\n          class=\"text-xs uppercase tracking-[0.22em] font-light text-[#817B6E]\"\n          style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.82); font-family: 'IBM Plex Mono', monospace;\"\n        >\n          Aether Relay © 2026\n        </div>\n\n        <!-- Recessed Link Array -->\n        <div\n          class=\"flex items-center gap-1 p-1.5 rounded-full\"\n          style=\"\n            background: #070A09;\n            box-shadow:\n              inset 0 2px 7px rgba(0,0,0,0.84),\n              0 1px 1px rgba(255,255,255,0.05);\n          \"\n        >\n          <a\n            href=\"#\"\n            class=\"px-5 py-2 rounded-full text-xs font-light uppercase tracking-[0.2em] text-[#817B6E] transition-all hover:bg-[#1A1F1E] hover:text-[#D8CBB6]\"\n            style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.82);\"\n          >\n            Documentation\n          </a>\n\n          <a\n            href=\"#\"\n            class=\"px-5 py-2 rounded-full text-xs font-light uppercase tracking-[0.2em] text-[#817B6E] transition-all hover:bg-[#1A1F1E] hover:text-[#D8CBB6]\"\n            style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.82);\"\n          >\n            Archive\n          </a>\n\n          <a\n            href=\"#\"\n            class=\"px-5 py-2 rounded-full text-xs font-light uppercase tracking-[0.2em] text-[#817B6E] transition-all hover:bg-[#1A1F1E] hover:text-[#D8CBB6]\"\n            style=\"text-shadow: 0 -1px 1px rgba(0,0,0,0.82);\"\n          >\n            Support\n          </a>\n        </div>\n      </footer>\n\n    </div>\n  </div>\n\n  <!-- Canvas Particle Field Script -->\n  <script>\n    const canvas = document.getElementById('particle-canvas');\n    const ctx = canvas.getContext('2d', { alpha: false });\n\n    let width;\n    let height;\n\n    const nodes = [];\n    const beams = [];\n    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789∆◇◆◌◎'.split('');\n    const mouse = { x: -1000, y: -1000 };\n\n    function initCanvas() {\n      width = window.innerWidth;\n      height = window.innerHeight;\n\n      const dpr = window.devicePixelRatio || 1;\n\n      canvas.width = width * dpr;\n      canvas.height = height * dpr;\n\n      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n\n      nodes.length = 0;\n      beams.length = 0;\n\n      const nodeCount = Math.min(Math.floor((width * height) / 15000), 100);\n\n      for (let i = 0; i < nodeCount; i++) {\n        nodes.push({\n          x: Math.random() * width,\n          y: Math.random() * height,\n          vy: 0.08 + Math.random() * 0.32,\n          char: chars[Math.floor(Math.random() * chars.length)]\n        });\n      }\n\n      const beamCount = Math.min(Math.floor((width * height) / 30000), 30);\n\n      for (let i = 0; i < beamCount; i++) {\n        beams.push({\n          x: Math.random() * width,\n          y: Math.random() * height,\n          length: 80 + Math.random() * 220,\n          speed: 2.4 + Math.random() * 5,\n          opacity: 0.08 + Math.random() * 0.32,\n          warm: Math.random() > 0.45\n        });\n      }\n    }\n\n    window.addEventListener('resize', initCanvas);\n\n    window.addEventListener('mousemove', (e) => {\n      mouse.x = e.clientX;\n      mouse.y = e.clientY;\n    });\n\n    window.addEventListener('mouseleave', () => {\n      mouse.x = -1000;\n      mouse.y = -1000;\n    });\n\n    initCanvas();\n\n    function draw() {\n      ctx.fillStyle = '#040607';\n      ctx.fillRect(0, 0, width, height);\n\n      // Draw upward relay beams\n      beams.forEach((beam) => {\n        beam.y -= beam.speed;\n\n        if (beam.y + beam.length < 0) {\n          beam.y = height + 100;\n          beam.x = Math.random() * width;\n          beam.warm = Math.random() > 0.45;\n        }\n\n        const gradient = ctx.createLinearGradient(beam.x, beam.y, beam.x, beam.y + beam.length);\n\n        if (beam.warm) {\n          gradient.addColorStop(0, `rgba(216, 168, 95, ${beam.opacity})`);\n          gradient.addColorStop(1, 'rgba(216, 168, 95, 0)');\n        } else {\n          gradient.addColorStop(0, `rgba(95, 203, 185, ${beam.opacity})`);\n          gradient.addColorStop(1, 'rgba(95, 203, 185, 0)');\n        }\n\n        ctx.strokeStyle = gradient;\n        ctx.lineWidth = 1.2;\n\n        ctx.beginPath();\n        ctx.moveTo(beam.x, beam.y);\n        ctx.lineTo(beam.x, beam.y + beam.length);\n        ctx.stroke();\n      });\n\n      // Draw ASCII relay nodes\n      ctx.font = \"12px 'IBM Plex Mono', monospace\";\n      ctx.textAlign = \"center\";\n      ctx.textBaseline = \"middle\";\n\n      nodes.forEach((node, i) => {\n        node.y += node.vy;\n\n        if (node.y > height + 20) {\n          node.y = -20;\n          node.x = Math.random() * width;\n        }\n\n        const distToMouse = Math.hypot(mouse.x - node.x, mouse.y - node.y);\n\n        if (distToMouse < 180 || Math.random() > 0.985) {\n          node.char = chars[Math.floor(Math.random() * chars.length)];\n        }\n\n        // Mouse connections\n        if (distToMouse < 180) {\n          ctx.strokeStyle = `rgba(216, 168, 95, ${(1 - distToMouse / 180) * 0.55})`;\n          ctx.lineWidth = 0.5;\n\n          ctx.beginPath();\n          ctx.moveTo(node.x, node.y);\n          ctx.lineTo(mouse.x, mouse.y);\n          ctx.stroke();\n        }\n\n        // Node connections\n        for (let j = i + 1; j < nodes.length; j++) {\n          const distToNode = Math.hypot(nodes[j].x - node.x, nodes[j].y - node.y);\n\n          if (distToNode < 120) {\n            ctx.strokeStyle = `rgba(166, 156, 136, ${(1 - distToNode / 120) * 0.18})`;\n            ctx.lineWidth = 0.5;\n\n            ctx.beginPath();\n            ctx.moveTo(node.x, node.y);\n            ctx.lineTo(nodes[j].x, nodes[j].y);\n            ctx.stroke();\n          }\n        }\n\n        ctx.fillStyle = distToMouse < 180 ? '#D8A85F' : 'rgba(166, 156, 136, 0.42)';\n        ctx.fillText(node.char, node.x, node.y);\n      });\n\n      requestAnimationFrame(draw);\n    }\n\n    draw();\n  </script>\n</body>\n</html>", "preview_file_name": "aether-centralized-network-console.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/aether-centralized-network-console.jpg", "source_name": "aether-centralized-network-console-DESIGN.md", "views": 147, "forks": 3, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-02T17:29:34.712752+00:00"}