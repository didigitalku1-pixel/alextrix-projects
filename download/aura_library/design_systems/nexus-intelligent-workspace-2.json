yle=\"stroke-width: 1.5;\"></iconify-icon> Team Directory\n                                </div>\n                            </div>\n\n                            <div class=\"mt-auto p-4 rounded-xl border border-white/5 bg-white/[0.02]\">\n                                <div class=\"flex items-center justify-between mb-2\">\n                                    <span class=\"text-xs text-neutral-400 font-medium\">Monthly Usage</span>\n                                    <span class=\"text-xs text-indigo-400 font-medium\">82%</span>\n                                </div>\n                                <div class=\"h-1.5 w-full bg-white/5 rounded-full overflow-hidden\">\n                                    <div class=\"h-full bg-gradient-to-r from-indigo-500 to-purple-500 w-[82%] rounded-full shadow-[0_0_10px_rgba(99,102,241,0.5)]\"></div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Content Area -->\n                        <div class=\"flex-1 p-8 overflow-y-auto\">\n                            <div class=\"flex items-end justify-between mb-8\">\n                                <div>\n                                    <h2 class=\"text-2xl font-semibold tracking-tight text-white mb-1\">Analytics Overview</h2>\n                                    <p class=\"text-sm text-neutral-400\">Real-time performance metrics across all active nodes.</p>\n                                </div>\n                                <div class=\"flex items-center gap-2\">\n                                    <span class=\"text-xs text-neutral-500 border border-white/10 rounded-md px-2 py-1\">Last 7 Days</span>\n                                </div>\n                            </div>\n\n                            <!-- Mock Chart Area -->\n                            <div class=\"w-full h-64 border border-white/5 rounded-xl bg-gradient-to-b from-white/[0.02] to-transparent flex items-end p-4 gap-2 relative overflow-hidden\">\n                                <!-- Grid Lines -->\n                                <div class=\"absolute inset-0 flex flex-col justify-between p-4 pointer-events-none\">\n                                    <div class=\"w-full border-b border-white/[0.03]\"></div>\n                                    <div class=\"w-full border-b border-white/[0.03]\"></div>\n                                    <div class=\"w-full border-b border-white/[0.03]\"></div>\n                                    <div class=\"w-full border-b border-white/[0.03]\"></div>\n                                </div>\n\n                                <!-- Bars (Inline styling for precise heights) -->\n                                <div class=\"flex-1 bg-indigo-500/20 rounded-t-sm border-t border-indigo-500/50 relative group\" style=\"height: 40%;\"></div>\n                                <div class=\"flex-1 bg-indigo-500/20 rounded-t-sm border-t border-indigo-500/50 relative group\" style=\"height: 65%;\"></div>\n                                <div class=\"flex-1 bg-indigo-500/20 rounded-t-sm border-t border-indigo-500/50 relative group\" style=\"height: 45%;\"></div>\n                                <div class=\"flex-1 bg-indigo-500/40 rounded-t-sm border-t border-indigo-400 relative group shadow-[0_0_15px_rgba(99,102,241,0.3)]\" style=\"height: 85%;\"></div>\n                                <div class=\"flex-1 bg-indigo-500/20 rounded-t-sm border-t border-indigo-500/50 relative group\" style=\"height: 55%;\"></div>\n                                <div class=\"flex-1 bg-indigo-500/20 rounded-t-sm border-t border-indigo-500/50 relative group\" style=\"height: 30%;\"></div>\n                                <div class=\"flex-1 bg-indigo-500/20 rounded-t-sm border-t border-indigo-500/50 relative group\" style=\"height: 70%;\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Features Bento Grid -->\n    <section id=\"features\" class=\"py-32 px-6 max-w-7xl mx-auto\">\n        <div class=\"mb-16\">\n            <span class=\"text-indigo-400 text-sm font-medium tracking-wide flex items-center gap-2 mb-4\">\n                <span class=\"w-4 h-[1px] bg-indigo-400\"></span> Capabilities\n            </span>\n            <h2 class=\"text-3xl md:text-5xl font-semibold tracking-tight text-white max-w-2xl leading-tight\">\n                <span class=\"gsap-reveal\">Everything you need, embedded in the architecture.</span>\n            </h2>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[280px]\">\n\n            <!-- Card 1 (Wide) -->\n            <div class=\"md:col-span-2 relative p-[1px] rounded-2xl bg-gradient-to-br from-white/10 to-transparent group hover:from-white/20 transition-colors duration-500 overflow-hidden\">\n                <div class=\"absolute inset-0 bg-gradient-to-br from-indigo-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500\"></div>\n                <div class=\"bg-[#101015] w-full h-full rounded-[calc(1rem-1px)] p-8 flex flex-col relative z-10\">\n                    <iconify-icon icon=\"solar:cpu-bolt-linear\" class=\"text-3xl text-indigo-400 mb-6\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                    <h3 class=\"text-xl font-semibold tracking-tight text-white mb-2\">Autonomous Agents</h3>\n                    <p class=\"text-sm text-neutral-400 max-w-md\">Define the outcome. Our agents autonomously sequence tasks, interface with your stack, and deliver execution-ready results.</p>\n\n                    <!-- Decorative terminal snippet -->\n                    <div class=\"mt-auto border-t border-white/5 pt-4 text-xs font-mono text-neutral-500\">\n                        <span class=\"text-indigo-400\">❯</span> deploy_agent --task \"Q3 reporting\" <br>\n                        <span class=\"text-green-400\">✓</span> Agent initialized. Analyzing 14 endpoints...\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 2 (Standard) -->\n            <div class=\"relative p-[1px] rounded-2xl bg-gradient-to-bl from-white/10 to-transparent group hover:from-white/20 transition-colors duration-500 overflow-hidden\">\n                <div class=\"bg-[#101015] w-full h-full rounded-[calc(1rem-1px)] p-8 flex flex-col relative z-10\">\n                    <iconify-icon icon=\"solar:layers-linear\" class=\"text-3xl text-purple-400 mb-6\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                    <h3 class=\"text-xl font-semibold tracking-tight text-white mb-2\">Unified Context</h3>\n                    <p class=\"text-sm text-neutral-400\">Information silos are obsolete. Nexus remembers every decision, document, and preference across your organization.</p>\n\n                    <div class=\"mt-auto flex -space-x-2\">\n                        <div class=\"w-8 h-8 rounded-full border-2 border-[#101015] bg-gradient-to-tr from-indigo-500 to-blue-500 flex items-center justify-center text-[10px] text-white font-medium\">AI</div>\n                        <div class=\"w-8 h-8 rounded-full border-2 border-[#101015] bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-[10px] text-white font-medium\">DB</div>\n                        <div class=\"w-8 h-8 rounded-full border-2 border-[#101015] bg-neutral-800 flex items-center justify-center text-[10px] text-white font-medium\">+4</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 3 (Standard) -->\n            <div class=\"relative p-[1px] rounded-2xl bg-gradient-to-tr from-white/10 to-transparent group hover:from-white/20 transition-colors duration-500 overflow-hidden\">\n                <div class=\"bg-[#101015] w-full h-full rounded-[calc(1rem-1px)] p-8 flex flex-col relative z-10\">\n                    <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-3xl text-emerald-400 mb-6\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                    <h3 class=\"text-xl font-semibold tracking-tight text-white mb-2\">Zero-Trust Security</h3>\n                    <p class=\"text-sm text-neutral-400\">Enterprise-grade encryption by default. Your proprietary data never trains our base models without explicit consent.</p>\n\n                    <div class=\"mt-auto flex items-center gap-2 text-xs font-medium text-emerald-500 bg-emerald-500/10 w-fit px-3 py-1.5 rounded-full border border-emerald-500/20\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span> Protected\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 4 (Wide) -->\n            <div class=\"md:col-span-2 relative p-[1px] rounded-2xl bg-gradient-to-tl from-white/10 to-transparent group hover:from-white/20 transition-colors duration-500 overflow-hidden\">\n                <div class=\"bg-[#101015] w-full h-full rounded-[calc(1rem-1px)] p-8 flex flex-col md:flex-row gap-8 relative z-10\">\n                    <div class=\"flex-1 flex flex-col\">\n                        <iconify-icon icon=\"solar:graph-up-linear\" class=\"text-3xl text-blue-400 mb-6\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                        <h3 class=\"text-xl font-semibold tracking-tight text-white mb-2\">Throughput Visibility</h3>\n                        <p class=\"text-sm text-neutral-400 max-w-sm mb-6\">Watch work clear in real-time. Identify bottlenecks before they impact delivery with predictive velocity tracking.</p>\n                        <a href=\"#\" class=\"mt-auto text-sm font-medium text-white flex items-center gap-1 hover:text-indigo-400 transition-colors w-fit\">\n                            Explore analytics <iconify-icon icon=\"solar:arrow-right-linear\"></iconify-icon>\n                        </a>\n                    </div>\n\n                    <!-- Decorative visualization -->\n                    <div class=\"flex-1 flex items-center justify-center p-6 border border-white/5 rounded-xl bg-black/50 relative overflow-hidden\">\n                        <div class=\"absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_70%)]\"></div>\n                        <div class=\"relative w-full h-full flex flex-col justify-end gap-2 px-4\">\n                            <div class=\"w-full bg-white/5 rounded-full h-1.5\"><div class=\"bg-blue-400 h-full rounded-full\" style=\"width: 40%\"></div></div>\n                            <div class=\"w-full bg-white/5 rounded-full h-1.5\"><div class=\"bg-indigo-400 h-full rounded-full\" style=\"width: 75%\"></div></div>\n                            <div class=\"w-full bg-white/5 rounded-full h-1.5\"><div class=\"bg-purple-400 h-full rounded-full\" style=\"width: 60%\"></div></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </section>\n\n    <!-- Footer CTA -->\n    <section class=\"py-32 px-6 relative border-t border-white/5 overflow-hidden\">\n        <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[1px] bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent\"></div>\n        <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-xl h-24 bg-indigo-500/20 blur-[50px] rounded-full pointer-events-none\"></div>\n\n        <div class=\"max-w-3xl mx-auto text-center relative z-10\">\n            <h2 class=\"text-4xl md:text-6xl font-semibold tracking-tight text-white mb-6\">\n                <span class=\"gsap-reveal\">Ready to accelerate?</span>\n            </h2>\n            <p class=\"text-lg text-neutral-400 mb-10 max-w-xl mx-auto\">\n                Join thousands of forward-thinking teams building the future on Nexus. Deploy your first intelligent workflow in minutes.\n            </p>\n            <button class=\"px-8 py-4 text-sm font-semibold text-black bg-white rounded-xl shadow-[0_0_40px_rgba(255,255,255,0.15)] hover:shadow-[0_0_60px_rgba(255,255,255,0.25)] hover:scale-[1.02] transition-all\">\n                Get Started for Free\n            </button>\n        </div>\n    </section>\n\n    <!-- Simple Footer -->\n    <footer class=\"border-t border-white/5 py-12 px-6\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6\">\n            <div class=\"flex items-center gap-2 text-white font-medium text-sm tracking-tight\">\n                <iconify-icon icon=\"solar:infinity-linear\" class=\"text-indigo-400 text-lg\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                Nexus Inc.\n            </div>\n\n            <div class=\"flex flex-wrap items-center justify-center gap-8 text-sm text-neutral-500 font-normal\">\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Platform</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Pricing</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Documentation</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Privacy</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\">Terms</a>\n            </div>\n\n            <div class=\"text-xs text-neutral-600\">\n                &copy; 2024 Nexus. All rights reserved.\n            </div>\n        </div>\n    </footer>\n\n    <!-- Scripts -->\n    <script>\n        // Ensure DOM is loaded\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // GSAP Masked Reveal Logic\n            const revealElements = document.querySelectorAll('.gsap-reveal');\n\n            revealElements.forEach(el => {\n                const text = el.innerText;\n                const words = text.split(' ');\n                el.innerHTML = '';\n\n                words.forEach(word => {\n                    // Outer wrapper for the mask\n                    const wrapper = document.createElement('span');\n                    wrapper.style.display = 'inline-block';\n                    wrapper.style.overflow = 'hidden';\n                    wrapper.style.verticalAlign = 'bottom';\n                    wrapper.style.marginRight = '0.25em'; // space between words\n                    wrapper.style.paddingBottom = '0.1em'; // prevent cutoff of descenders\n\n                    // Inner element that moves\n                    const inner = document.createElement('span');\n                    inner.style.display = 'inline-block';\n                    inner.style.transform = 'translateY(110%)'; // start below\n                    inner.className = 'reveal-inner';\n                    inner.innerText = word;\n\n                    wrapper.appendChild(inner);\n                    el.appendChild(wrapper);\n                });\n\n                // Animate\n                gsap.to(el.querySelectorAll('.reveal-inner'), {\n                    y: '0%',\n                    duration: 1.2,\n                    ease: \"power4.out\",\n                    stagger: 0.04,\n                    scrollTrigger: {\n                        trigger: el,\n                        start: \"top 85%\",\n                        toggleActions: \"play none none none\"\n                    }\n                });\n            });\n\n            // Interactive Rain Fall Effect\n            const canvas = document.createElement('canvas');\n            canvas.className = 'fixed inset-0 pointer-events-none z-[30]';\n            document.body.appendChild(canvas);\n            const ctx = canvas.getContext('2d');\n\n            let width, height;\n            function resize() {\n                width = canvas.width = window.innerWidth;\n                height = canvas.height = window.innerHeight;\n            }\n            window.addEventListener('resize', resize);\n            resize();\n\n            const drops = [];\n            const dropCount = 120;\n            // Target the specific dashboard surface to splash upon\n            const platformEl = document.querySelector('#platform .relative');\n\n            let mouseX = width / 2;\n            window.addEventListener('mousemove', (e) => {\n                mouseX = e.clientX;\n            });\n\n            for(let i = 0; i < dropCount; i++) {\n                drops.push({\n                    x: Math.random() * width,\n                    y: Math.random() * height,\n                    speed: 15 + Math.random() * 10,\n                    length: 25 + Math.random() * 30, // Slightly longer tails for dramatic effect\n                    splash: false,\n                    splashRadius: 0,\n                    maxSplash: 10 + Math.random() * 15\n                });\n            }\n\n            function draw() {\n                ctx.clearRect(0, 0, width, height);\n\n                let platformRect = platformEl ? platformEl.getBoundingClientRect() : null;\n                // Add slight wind interaction based on mouse position\n                let wind = (mouseX - width / 2) * 0.015;\n\n                drops.forEach(drop => {\n                    if (drop.splash) {\n                        ctx.beginPath();\n                        // Flatter, wider ellipse for a surface impact ripple\n                        ctx.ellipse(drop.x, drop.y, drop.splashRadius * 1.8, drop.splashRadius * 0.35, 0, 0, Math.PI * 2);\n                        ctx.strokeStyle = `rgba(168, 219, 255, ${1 - drop.splashRadius/drop.maxSplash})`;\n                        ctx.lineWidth = 1;\n                        ctx.stroke();\n\n                        drop.splashRadius += 0.8;\n                        if (drop.splashRadius > drop.maxSplash) {\n                            resetDrop(drop);\n                        }\n                    } else {\n                        // Update head position\n                        drop.x += wind;\n                        drop.y += drop.speed;\n\n                        // Collision check with top boundary of the dashboard platform\n                        // drop.y represents the 'head' (bottom) of the falling line\n                        if (platformRect &&\n                            drop.y >= platformRect.top && drop.y <= platformRect.top + 30 &&\n                            drop.x >= platformRect.left && drop.x <= platformRect.right) {\n                            drop.splash = true;\n                            drop.y = platformRect.top;\n                        } else if (drop.y > height) {\n                            resetDrop(drop);\n                        }\n\n                        // Horizontal wrap-around for drops blown off screen\n                        if (drop.x > width) drop.x = 0;\n                        if (drop.x < 0) drop.x = width;\n\n                        if (!drop.splash) {\n                            // Calculate tail position trailing behind the head\n                            let tailX = drop.x - (wind * (drop.length / drop.speed));\n                            let tailY = drop.y - drop.length;\n\n                            // Glowing gradient for the fading tail\n                            let grad = ctx.createLinearGradient(drop.x, drop.y, tailX, tailY);\n                            grad.addColorStop(0, 'rgba(168, 219, 255, 0.8)'); // Bright head\n                            grad.addColorStop(1, 'rgba(168, 219, 255, 0)');   // Transparent tail\n\n                            ctx.beginPath();\n                            ctx.moveTo(drop.x, drop.y);\n                            ctx.lineTo(tailX, tailY);\n                            ctx.strokeStyle = grad;\n                            ctx.lineWidth = 1.5;\n                            ctx.stroke();\n\n                            // Bright, slightly blurred leading tip\n                            ctx.beginPath();\n                            ctx.arc(drop.x, drop.y, 1.2, 0, Math.PI * 2);\n                            ctx.fillStyle = '#ffffff';\n                            ctx.shadowBlur = 6;\n                            ctx.shadowColor = 'rgba(168, 219, 255, 1)';\n                            ctx.fill();\n                            ctx.shadowBlur = 0; // reset shadow for next draws\n                        }\n                    }\n                });\n                requestAnimationFrame(draw);\n            }\n\n            function resetDrop(drop) {\n                drop.x = Math.random() * width;\n                drop.y = -50 - Math.random() * 100;\n                drop.splash = false;\n                drop.splashRadius = 0;\n            }\n\n            draw();\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "nexus-intelligent-workspace-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/nexus-intelligent-workspace-2.jpg", "source_name": "nexus-intelligent-workspace-2-DESIGN.md", "views": 16, "forks": 1, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-06-21T11:39:54.279152+00:00", "updated_at": "2026-07-01T17:25:28.981276+00:00"}