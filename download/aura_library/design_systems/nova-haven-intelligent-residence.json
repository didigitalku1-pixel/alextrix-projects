l bg-indigo-400\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-indigo-400 opacity-50\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                        </div>\n                        <span class=\"text-indigo-400 font-medium text-sm\">21°C</span>\n                    </div>\n\n                    <div class=\"w-full h-px bg-white/5 mb-6\"></div>\n\n                    <!-- Humidity Row -->\n                    <div class=\"flex items-start justify-between mb-6\">\n                        <div class=\"flex items-center gap-4\">\n                            <div class=\"text-white/60\">\n                                <iconify-icon icon=\"solar:waterdrops-linear\" width=\"24\"></iconify-icon>\n                            </div>\n                            <div>\n                                <h3 class=\"text-sm font-medium text-white\">Humidity</h3>\n                                <p class=\"text-xs text-white/40 mt-1\">Target: 35–45 %</p>\n                            </div>\n                        </div>\n                        <iconify-icon icon=\"solar:emoji-funny-circle-linear\" width=\"20\" class=\"text-white/30\"></iconify-icon>\n                    </div>\n                    <!-- Custom Slider representation -->\n                    <div class=\"flex items-center justify-between\">\n                        <div class=\"flex gap-1.5\">\n                            <div class=\"w-2 h-2 rounded-full bg-[var(--accent)]\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-[var(--accent)]\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-[var(--accent)]\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-[var(--accent)]\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-[var(--accent)] opacity-50\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                            <div class=\"w-2 h-2 rounded-full bg-white/10\"></div>\n                        </div>\n                        <span class=\"text-[var(--accent)] font-medium text-sm\">40<span class=\"text-xs\">%</span></span>\n                    </div>\n\n                    <!-- Decorative dot connecting to house -->\n                    <div class=\"absolute right-[-6px] top-1/2 w-3 h-3 bg-white rounded-full shadow-[0_0_10px_white] transform -translate-y-1/2\"></div>\n                </div>\n            </div>\n\n            <!-- Bottom Users Bar -->\n            <footer class=\"w-full h-28 pb-8 px-8 flex justify-between items-end z-20\">\n                <div class=\"flex gap-4\">\n                    <!-- User Pills -->\n                    <div class=\"user-pill glass-panel h-14 pr-6 pl-2 rounded-full flex items-center gap-3\">\n                        <div class=\"relative w-10 h-10 rounded-full overflow-hidden\">\n                            <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/c92852bb-a510-405a-85ab-ffa0fde136a4_1600w.jpg\" class=\"w-full h-full object-cover grayscale\">\n                            <div class=\"absolute top-0 right-0 w-3 h-3 bg-[var(--accent)] rounded-full border-2 border-[#1c1c1c]\"></div>\n                        </div>\n                        <div>\n                            <p class=\"tex