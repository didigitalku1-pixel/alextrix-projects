dth=\"24\"></iconify-icon>\n                    </div>\n                    <div>\n                        <h3 class=\"text-sm font-medium\">Cleaning Bot</h3>\n                        <div class=\"flex items-center gap-2 mt-1\">\n                            <iconify-icon icon=\"solar:battery-charge-linear\" width=\"14\" class=\"text-[var(--accent)]\"></iconify-icon>\n                            <span class=\"text-xs text-white/40\">98%</span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Custom Toggle (Inactive) -->\n                <div class=\"toggle-switch inactive w-12 h-6 rounded-full p-1 flex items-center cursor-pointer transition-colors duration-300\">\n                    <div class=\"toggle-knob w-4 h-4 rounded-full shadow-sm transition-transform duration-300\"></div>\n                </div>\n            </div>\n\n            <!-- Media System -->\n            <div class=\"widget-card glass-panel rounded-[32px] p-6 flex flex-col z-10 mt-auto relative overflow-hidden\">\n                <!-- Red ambient glow for music -->\n                <div class=\"absolute bottom-0 right-10 w-48 h-48 bg-purple-600/30 rounded-full blur-[60px] pointer-events-none\"></div>\n\n                <div class=\"flex items-center justify-between mb-6 relative z-10\">\n                    <div class=\"flex items-center gap-5\">\n                        <div class=\"w-12 h-12 rounded-full bg-white/5 flex items-center justify-center\">\n                            <iconify-icon icon=\"solar:vinyl-linear\" width=\"24\"></iconify-icon>\n                        </div>\n                        <div>\n                            <h3 class=\"text-sm font-medium\">Audio Matrix</h3>\n                            <p class=\"text-xs text-white/40 mt-1\">Bose Sound System</p>\n                        </div>\n                    </div>\n                    <div class=\"toggle-switch active w-12 h-6 rounded-full p-1 flex items-center cursor-pointer transition-colors duration-300\">\n                        <div class=\"toggle-knob w-4 h-4 rounded-full shadow-sm transition-transform duration-300\"></div>\n                    </div>\n                </div>\n\n                <div class=\"flex flex-col items-center relative z-10\">\n                    <!-- Album Art -->\n                    <div class=\"relative w-32 h-32 rounded-full overflow-hidden mb-6 shadow-[0_10px_30px_rgba(168,85,247,0.3)]\">\n                        <img src=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/6b63bdd8-c365-4ccf-9537-fafc57329c8c/2026-05-20/1779266351208-36132f5f-5305-4a77-9c7b-b1f3221d53d7.png\" alt=\"Album Cover\" class=\"w-full h-full object-cover\" data-element-src=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/6b63bdd8-c365-4ccf-9537-fafc57329c8c/2026-05-20/1779266351208-36132f5f-5305-4a77-9c7b-b1f3221d53d7.png\">\n                        <!-- Playhead hole visual -->\n                        <div class=\"absolute top-1/2 left-1/2 w-4 h-4 bg-black rounded-full transform -translate-x-1/2 -translate-y-1/2 border border-white/20\"></div>\n                    </div>\n\n                    <!-- Progress -->\n                    <div class=\"w-full flex justify-between text-[10px] text-white/40 mb-2 px-2\">\n                        <span>2:45</span>\n                        <span>5:30</span>\n                    </div>\n                    <div class=\"w-full h-1 bg-white/10 rounded-full mb-6\">\n                        <div class=\"w-1/2 h-full bg-[var(--accent)] rounded-full relative\">\n                            <div class=\"absolute right-0 top-1/2 w-2 h-2 bg-white rounded-full transform translate-x-1/2 -translate-y-1/2 shadow-sm\"></div>\n                        </div>\n                    </div>\n\n                    <!-- Controls & Info -->\n                    <div class=\"w-full flex justify-between items-center px-2\">\n                        <div>\n                            <h4 class=\"text-sm font-medium text-[var(--accent)]\">Midnight Echo</h4>\n                            <p class=\"text-xs text-white/50 mt-1\">Synthwave • Vol 1</p>\n                        </div>\n                        <div class=\"flex items-center gap-4\">\n                            <button class=\"text-white/50 hover:text-white transition-colors\">\n                                <iconify-icon icon=\"solar:skip-previous-linear\" width=\"20\"></iconify-icon>\n                            </button>\n                            <button class=\"w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:scale-105 transition-transform\">\n                                <iconify-icon icon=\"solar:pause-bold\" width=\"16\"></iconify-icon>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </aside>\n    </div>\n\n    <!-- Animation & WebGL Logic -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            // --- 1. WebGL Background Animation (Three.js) ---\n            // Creates a subtle, slow-moving particle/fluid field behind the app\n            const initWebGL = () => {\n                const canvas = document.getElementById('webgl-canvas');\n                const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });\n                renderer.setSize(window.innerWidth, window.innerHeight);\n                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n                const scene = new THREE.Scene();\n                const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);\n                camera.position.z = 5;\n\n                // Create a particle system for ambient \"dust\"\n                const particlesGeometry = new THREE.BufferGeometry();\n                const particlesCount = 700;\n                const posArray = new Float32Array(particlesCount * 3);\n\n                for(let i = 0; i < particlesCount * 3; i++) {\n                    posArray[i] = (Math.random() - 0.5) * 15;\n                }\n\n                particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n\n                // Shader material for custom coloring based on position to mimic gradients\n                const material = new THREE.PointsMaterial({\n                    size: 0.02,\n                    color: 0xa855f7, // Accent color\n                    transparent: true,\n                    opacity: 0.4,\n                    blending: THREE.AdditiveBlending\n                });\n\n                const particlesMesh = new THREE.Points(particlesGeometry, material);\n                scene.add(particlesMesh);\n\n                let mouseX = 0;\n                let mouseY = 0;\n\n                document.addEventListener('mousemove', (event) => {\n                    mouseX = (event.clientX / window.innerWidth) - 0.5;\n                    mouseY = (event.clientY / window.innerHeight) - 0.5;\n                });\n\n                const clock = new THREE.Clock();\n\n                const tick = () => {\n                    const elapsedTime = clock.getElapsedTime();\n\n                    // Slow rotation\n                    particlesMesh.rotation.y = elapsedTime * 0.05;\n                    particlesMesh.rotation.x = elapsedTime * 0.02;\n\n                    // Subtle mouse parallax\n                    camera.position.x += (mouseX * 0.5 - camera.position.x) * 0.05;\n                    camera.position.y += (-mouseY * 0.5 - camera.position.y) * 0.05;\n                    camera.lookAt(scene.position);\n\n                    renderer.render(scene, camera);\n                    window.requestAnimationFrame(tick);\n                };\n\n                tick();\n\n                window.addEventListener('resize', () => {\n                    camera.aspect = window.innerWidth / window.innerHeight;\n                    camera.updateProjectionMatrix();\n                    renderer.setSize(window.innerWidth, window.innerHeight);\n                });\n            };\n\n            // Initialize WebGL if supported, otherwise graceful fallback (canvas remains blank/transparent)\n            try { initWebGL(); } catch (e) { console.log(\"WebGL not supported, skipping background animation.\"); }\n\n            // --- 2. GSAP Motion Design Sequence ---\n            // Orchestrates the entrance of the dashboard elements\n\n            // Check for reduced motion preference\n            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n            if (!prefersReducedMotion) {\n                // Ensure elements are initially hidden for animation\n                gsap.set([\"#app-container\", \".nav-item\", \".header-item\", \".house-visual\", \".floating-widget\", \".user-pill\", \".widget-card\"], { opacity: 0 });\n                gsap.set(\"#app-container\", { scale: 0.9, y: 40, rotationX: 5 });\n\n                const tl = gsap.timeline({ defaults: { ease: \"expo.out\" } });\n\n                // Start sequence slightly after load\n                tl.to(\"#app-container\", {\n                    opacity: 1,\n                    scale: 1,\n                    y: 0,\n                    rotationX: 0,\n                    duration: 1.8,\n                    ease: \"power4.out\"\n                })\n                .to(\".nav-item\", {\n                    opacity: 1,\n                    x: 0,\n                    xFrom: -30,\n                    stagger: 0.08,\n                    duration: 1,\n                    ease: \"back.out(1.2)\"\n                }, \"-=1.2\")\n                .to(\".header-item\", {\n                    opacity: 1,\n                    y: 0,\n                    yFrom: -20,\n                    stagger: 0.1,\n                    duration: 1.2\n                }, \"-=1.0\")\n                .to(\".house-visual\", {\n                    opacity: 1,\n                    scale: 1,\n                    scaleFrom: 0.95,\n                    filter: \"blur(0px)\",\n                    filterFrom: \"blur(10px)\",\n                    duration: 2,\n                    ease: \"power3.out\"\n                }, \"-=1.0\")\n                .to(\".floating-widget\", {\n                    opacity: 1,\n                    y: 0,\n                    yFrom: 30,\n                    rotation: 0,\n                    rotationFrom: -2,\n                    duration: 1.2,\n                    ease: \"back.out(1.5)\"\n                }, \"-=1.2\")\n                .to(\".widget-card\", {\n                    opacity: (i, target) => target.classList.contains('opacity-70') ? 0.7 : 1,\n                    x: 0,\n                    xFrom: 40,\n                    stagger: 0.1,\n                    duration: 1.2\n                }, \"-=1.4\")\n                .to(\".user-pill\", {\n                    opacity: (i, target) => target.classList.contains('opacity-60') ? 0.6 : 1,\n                    y: 0,\n                    yFrom: 20,\n                    stagger: 0.05,\n                    duration: 0.8\n                }, \"-=1.0\");\n\n            } else {\n                // Fallback for reduced motion: just fade in the container\n                gsap.to(\"#app-container\", { opacity: 1, duration: 0.5 });\n            }\n\n            // --- 3. Interactive Toggles (Custom JS logic) ---\n            const toggles = document.querySelectorAll('.toggle-switch');\n            toggles.forEach(toggle => {\n                toggle.addEventListener('click', function() {\n                    this.classList.toggle('active');\n                    this.classList.toggle('inactive');\n                    // Add a tiny bump animation to the knob\n                    const knob = this.querySelector('.toggle-knob');\n                    gsap.fromTo(knob, { scale: 0.8 }, { scale: 1, duration: 0.3, ease: \"back.out(2)\" });\n                });\n            });\n        });\n    </script>\n\n<script data-neuform-video-controller=\"true\">\n(function () {\n  function playVideo(video) {\n    var promise = video.play();\n    if (promise && typeof promise.catch === \"function\") {\n      promise.catch(function () {});\n    }\n  }\n  function setupVideo(video) {\n    if (video.__neuformVideoReady === true) return;\n    video.__neuformVideoReady = true;\n    video.muted = true;\n    video.playsInline = true;\n    var preset = video.dataset.neuformVideoPreset || \"loop-in-view\";\n    if (preset === \"hover\") {\n      video.addEventListener(\"mouseenter\", function () { playVideo(video); });\n      video.addEventListener(\"mouseleave\", function () {\n        video.pause();\n        video.currentTime = 0;\n      });\n      return;\n    }\n    if (!(\"IntersectionObserver\" in window)) {\n      playVideo(video);\n      return;\n    }\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          if (preset === \"play-once\" && video.__neuformVideoPlayed === true) return;\n          playVideo(video);\n        } else {\n          video.pause();\n        }\n      });\n    }, { threshold: 0.35 });\n    if (preset === \"play-once\") {\n      video.addEventListener(\"ended\", function () {\n        video.__neuformVideoPlayed = true;\n      }, { once: true });\n    }\n    observer.observe(video);\n  }\n  function setupVideos() {\n    document.querySelectorAll(\"video[data-neuform-video-preset]\").forEach(setupVideo);\n  }\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", setupVideos);\n  } else {\n    setupVideos();\n  }\n})();</script></body></html>", "preview_file_name": "nova-haven-intelligent-residence.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwu