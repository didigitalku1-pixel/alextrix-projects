 \"%\";\n            glow.style.opacity = (0.25 + cc * 0.5).toFixed(3);\n            captionEl.textContent = (cc * 18).toFixed(1);\n        }\n\n        /* ---------- Sizing ---------- */\n        let dpr = 1;\n        function resize() {\n            dpr = Math.min(window.devicePixelRatio || 1, 2);\n            if (bg) {\n                bgCanvas.width  = Math.max(2, Math.floor(window.innerWidth  * 0.55));\n                bgCanvas.height = Math.max(2, Math.floor(window.innerHeight * 0.55));\n                bg.gl.viewport(0, 0, bgCanvas.width, bgCanvas.height);\n            }\n            if (lq) {\n                const r = track.getBoundingClientRect();\n                liqCanvas.width  = Math.max(2, Math.floor(r.width  * dpr));\n                liqCanvas.height = Math.max(2, Math.floor(r.height * dpr));\n                lq.gl.viewport(0, 0, liqCanvas.width, liqCanvas.height);\n                foamSvg.style.width = r.width + \"px\";\n            }\n        }\n\n        /* ---------- Render Loop ---------- */\n        let raf = 0, running = false, start = performance.now(), last = start;\n\n        function renderShaders(time, prog, slosh, amp) {\n            if (bg) {\n                if (bg.u.uRes)  bg.gl.uniform2f(bg.u.uRes, bgCanvas.width, bgCanvas.height);\n                if (bg.u.uTime) bg.gl.uniform1f(bg.u.uTime, time);\n                bg.draw();\n            }\n            if (lq) {\n                if (lq.u.uRes)      lq.gl.uniform2f(lq.u.uRes, liqCanvas.width, liqCanvas.height);\n                if (lq.u.uTime)     lq.gl.uniform1f(lq.u.uTime, time);\n                if (lq.u.uProgress) lq.gl.uniform1f(lq.u.uProgress, prog);\n                if (lq.u.uSlosh)    lq.gl.uniform1f(lq.u.uSlosh, slosh);\n                if (lq.u.uAmp)      lq.gl.uniform1f(lq.u.uAmp, amp);\n                lq.draw();\n            }\n        }\n\n        function frame(now) {\n            if (!running) return;\n            let dt = (now - last) / 1000; last = now;\n            if (dt > 0.05) dt = 0.05;\n\n            segT += dt;\n            const s = seq[segIdx];\n            if (segT >= s.dur + s.hold) nextSeg();\n\n            const k = 90, c = 12;\n            vel += (target - cur) * k * dt - vel * c * dt;\n            cur += vel * dt;\n            if (cur < 0)    { cur = 0;    vel *= -0.3; }\n            if (cur > 1.04) { cur = 1.04; vel *= -0.3; }\n\n            const av = Math.abs(vel);\n            ampEnv = Math.max(ampEnv * 0.94, Math.min(av * 2.2, 1.0));\n            const uAmp = Math.max(0.16, ampEnv);\n            const uSlosh = Math.max(-1, Math.min(1, vel * 1.1));\n\n            renderShaders((now - start) / 1000, Math.min(cur, 1.0), uSlosh, uAmp);\n            updateUI(cur);\n\n            raf = requestAnimationFrame(frame);\n        }\n\n        function play() {\n            if (running || prefersReduced) return;\n            running = true; last = performance.now();\n            raf = requestAnimationFrame(frame);\n        }\n\n        function pause() {\n            running = false;\n            if (raf) { cancelAnimationFrame(raf); raf = 0; }\n        }\n\n        function renderStatic() {\n            renderShaders(6.0, 0.72, 0.0, 0.16);\n            updateUI(0.72);\n        }\n\n        /* ---------- Events ---------- */\n        let rq = false;\n        window.addEventListener(\"resize\", () => {\n            if (rq) return; rq = true;\n            requestAnimationFrame(() => {\n                rq = false; resize();\n                if (prefersReduced || !running) renderStatic();\n            });\n        });\n\n        document.addEventListener(\"visibilitychange\", () => {\n            if (prefersReduced) return;\n            if (document.hidden) pause(); else play();\n        });\n\n        /* ---------- Boot ---------- */\n        resize();\n        if (prefersReduced) {\n            if (foamSvg.pauseAnimations) try { foamSvg.pauseAnimations(); } catch (e) {}\n            renderStatic();\n        } else {\n    