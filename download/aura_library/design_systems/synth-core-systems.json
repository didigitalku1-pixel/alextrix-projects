0%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); animation: spin 20s linear infinite;\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Description Section -->\n            <div class=\"flex gap-4 mt-2 relative z-10\">\n                <div class=\"flex-1 flex flex-col gap-2\">\n                    <div class=\"flex items-center gap-2 border-b border-[#111] pb-1\">\n                        <iconify-icon icon=\"solar:target-linear\" width=\"14\"></iconify-icon>\n                        <h2 class=\"text-xs font-mono uppercase font-semibold tracking-widest\">Parameters</h2>\n                    </div>\n                    <p class=\"text-[11px] leading-tight text-justify font-mono text-neutral-800\">\n                        Operational logic dictates absolute precision. We synthesize environments, structures, and algorithms that construct reality, rather than merely simulating it. From initial sequence to final deployment, every variable is calculated.\n                    </p>\n                </div>\n                <div class=\"w-24 flex flex-col border-l border-[#111] pl-4 justify-between\">\n                    <div>\n                        <span class=\"text-xs font-mono font-semibold uppercase tracking-widest block mb-2\">Auth</span>\n                        <!-- Fake Signature -->\n                        <div class=\"font-serif text-xl tracking-tighter italic opacity-80\" style=\"transform: rotate(-5deg);\">Eldon.</div>\n                    </div>\n                    <div class=\"text-[8px] font-mono uppercase tracking-widest\" style=\"writing-mode: vertical-rl; transform: rotate(180deg);\">\n                        Access / SYNTHCORE.IO\n                    </div>\n                </div>\n            </div>\n\n            <!-- Footer Lines -->\n            <div class=\"flex flex-col gap-[2px] mt-4 w-32 relative z-10\">\n                <div class=\"h-[1px] bg-[#111] w-full\"></div>\n                <div class=\"h-[