rational challenges.\n                </div>\n\n                <!-- Logos Row -->\n                <div class=\"flex flex-wrap items-center gap-x-6 gap-y-3 text-xs font-normal text-[#948f87]\">\n                    <div class=\"flex items-center gap-1.5\"><iconify-icon icon=\"solar:star-fall-linear\" class=\"text-lg\"></iconify-icon> Aura Base</div>\n                    <div class=\"flex items-center gap-1.5\"><iconify-icon icon=\"solar:planet-linear\" class=\"text-lg\"></iconify-icon> Nova Scope</div>\n                    <div class=\"flex items-center gap-1.5\"><iconify-icon icon=\"solar:code-circle-linear\" class=\"text-lg\"></iconify-icon> Zenith Core</div>\n                    <div class=\"flex items-center gap-1.5\"><iconify-icon icon=\"solar:heart-pulse-linear\" class=\"text-lg\"></iconify-icon> Apex</div>\n                    <div class=\"flex items-center gap-1.5\"><iconify-icon icon=\"solar:box-minimalistic-linear\" class=\"text-lg\"></iconify-icon> Weave</div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n    <script>\n        // --- GSAP Masked Text Reveal ---\n        gsap.registerPlugin(ScrollTrigger);\n\n        function splitTextToWords() {\n            const elements = document.querySelectorAll('.reveal-text');\n            elements.forEach(el => {\n                const text = el.innerText;\n                const words = text.split(' ');\n                el.innerHTML = '';\n                words.forEach(word => {\n                    const mask = document.createElement('span');\n                    mask.className = 'mr-1';\n                    mask.style.display = 'inline-block';\n                    mask.style.overflow = 'hidden';\n                    mask.style.verticalAlign = 'top';\n\n                    const inner = document.createElement('span');\n                    inner.className = 'word-inner';\n                    inner.style.display = 'inline-block';\n                    inner.style.transform = 'translateY(100%)';\n                    inner.innerText = word;\n\n                    mask.appendChild(inner);\n                    el.appendChild(mask);\n                });\n            });\n        }\n\n        splitTextToWords();\n\n        gsap.to('.word-inner', {\n            y: '0%',\n            duration: 0.8,\n            ease: 'power3.out',\n            stagger: 0.02,\n            scrollTrigger: {\n                trigger: '.reveal-text',\n                start: 'top 90%',\n            }\n        });\n\n        // --- Looping Image Marquee Animation ---\n        gsap.to('.marquee-track', {\n            x: \"-332px\", // Moves exactly one grid width (320px) + gap (12px) to loop perfectly\n            duration: 8,\n            ease: \"none\",\n            repeat: -1\n        });\n\n        // --- Looping Squares Animation (applied to each grid independently to maintain stagger order) ---\n        document.querySelectorAll('.marquee-grid').forEach(grid => {\n            gsap.to(grid.querySelectorAll('.aspect-square'), {\n                opacity: 0.4,\n                scale: 0.96,\n                duration: 1.5,\n                yoyo: true,\n                repeat: -1,\n                stagger: {\n                    each: 0.1,\n                    grid: [4, 4],\n                    from: \"center\"\n                },\n                ease: \"sine.inOut\"\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "platform-onboarding-6.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/platform-onboarding-6.jpg", "source_name": "platform-onboarding-6-DESIGN.md", "views": 199, "forks": 3, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T17:50:10.108379+00:00"}