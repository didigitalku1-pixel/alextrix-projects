otate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))}@media (min-width: 640px){.sm\\:block{display:block}}@media (min-width: 768px){.md\\:block{display:block}.md\\:flex{display:flex}}@media (min-width: 1024px){.lg\\:col-span-4{grid-column:span 4 / span 4}.lg\\:col-span-5{grid-column:span 5 / span 5}.lg\\:col-span-3{grid-column:span 3 / span 3}.lg\\:col-span-9{grid-column:span 9 / span 9}.lg\\:grid{display:grid}.lg\\:h-auto{height:auto}.lg\\:min-h-\\[80vh\\]{min-height:80vh}.lg\\:grid-cols-12{grid-template-columns:repeat(12, minmax(0, 1fr))}.lg\\:flex-row{flex-direction:row}.lg\\:overflow-visible{overflow:visible}.lg\\:p-16{padding:4rem}.lg\\:pt-20{padding-top:5rem}.lg\\:text-7xl{font-size:4.5rem;line-height:1}.lg\\:text-4xl{font-size:2.25rem;line-height:2.5rem}}</style></head>\n<body class=\"text-dark antialiased min-h-screen flex flex-col\">\n\n    <!-- Navigation -->\n    <nav class=\"w-full px-6 py-8 flex justify-between items-center z-50 relative max-w-[1400px] mx-auto\">\n        <div class=\"flex items-center gap-8\">\n            <div class=\"flex items-center gap-2 font-semibold text-lg tracking-tight\">\n                <iconify-icon icon=\"solar:buildings-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                <span>Lumina Arch</span>\n            </div>\n            <div class=\"h-4 w-px bg-gray-300 hidden md:block\"></div>\n            <button class=\"hidden md:flex items-center gap-1 text-sm font-medium text-gray-600 hover:text-black transition-colors\">\n                Services\n                <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"16\"></iconify-icon>\n            </button>\n        </div>\n        <div class=\"flex items-center gap-4\">\n            <span class=\"text-sm font-semibold tracking-tight hidden sm:block\">CONTACT US</span>\n            <button class=\"w-10 h-10 bg-dark text-white rounded-full flex items-center justify-center hover:scale-105 transition-transform\">\n                <iconify-icon icon=\"solar:letter-linear\" width=\"20\"></iconify-icon>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Main Grid Layout -->\n    <main class=\"flex-grow flex flex-col lg:grid lg:grid-cols-12 w-full max-w-[1400px] mx-auto relative\">\n\n        <!-- Left Column: Hero Text -->\n        <div class=\"lg:col-span-4 px-6 pt-10 lg:pt-20 pb-10 flex flex-col justify-center z-20\">\n            <h1 class=\"text-5xl lg:text-7xl font-medium uppercase leading-[0.9] tracking-tightest mb-10 animate-reveal\">\n                Shaping<br>\n                Future<br>\n                Living<br>\n                Spaces\n            </h1>\n\n            <button class=\"gradient-border w-fit px-8 py-4 text-white text-sm font-medium tracking-wide hover:bg-opacity-90 transition-all animate-reveal delay-200\">\n                START PROJECT\n            </button>\n        </div>\n\n        <!-- Center Column: Visuals & WebGL Simulation -->\n        <div class=\"lg:col-span-5 relative h-[500px] lg:h-auto overflow-hidden lg:overflow-visible\">\n            <!-- Grid Animation Canvas -->\n            <canvas id=\"gridCanvas\" class=\"absolute inset-0 w-full h-full z-0 opacity-40\" width=\"583\" height=\"975\"></canvas>\n\n            <!-- Oval Image -->\n            <div class=\"absolute inset-0 flex items-center justify-center z-10 animate-reveal delay-100\">\n                <div class=\"oval-mask w-[85%] h-[90%] relative overflow-hidden shadow-2xl\">\n                    <img src=\"https://images.unsplash.com/photo-1618176729090-253077a8f948?ixid=M3w3NTc5NzN8MHwxfHNlYXJjaHw3fHxkZXNpZ24tcmVhZHklMjB3ZWJzaXRlJTIwaW1hZ2V8ZW58MXwxfHx8MTc3MjQ1MjcyN3ww&amp;ixlib=rb-4.1.0&amp;w=1600&amp;fit=max&amp;auto=format&amp;q=80\" class=\"w-full h-full object-cover scale-110\" alt=\"Modern Architecture\" style=\"\">\n\n                    <!-- Decorative Lines inside image -->\n                    <div class=\"absolute top-0 right-0 w-full h-full border border-white/20 pointer-events-none grid grid-cols-4 grid-rows-4\">\n                        <div class=\"border-r border-white/10\"></div>\n                        <div class=\"border-r border-white/10\"></div>\n                        <div class=\"border-r border-white/10\"></div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Floating 3D Sphere -->\n            <div class=\"absolute bottom-20 left-4 w-24 h-24 sphere rounded-full z-20 animate-reveal delay-300 hidden md:block\"></div>\n\n            <!-- Decorative Plus -->\n            <div class=\"absolute top-1/3 right-10 text-dark z-20\">\n                <iconify-icon icon=\"solar:add-linear\" width=\"24\"></iconify-icon>\n            </div>\n            <div class=\"absolute bottom-1/4 left-1/4 text-dark z-20\">\n                <iconify-icon icon=\"solar:add-linear\" width=\"24\"></iconify-icon>\n            </div>\n        </div>\n\n        <!-- Right Column: Stats Sidebar -->\n        <div class=\"lg:col-span-3 bg-sidebar/50 h-full p-8 flex flex-col justify-center relative lg:min-h-[80vh]\">\n            <div class=\"mb-auto\"></div> <!-- Spacer -->\n\n            <div class=\"animate-reveal delay-200\">\n                <div class=\"text-6xl font-light text-gray-400 mb-8 tracking-tighter\">12K+</div>\n\n                <div class=\"flex items-center gap-4 mb-4\">\n                    <div class=\"relative\">\n                        <img src=\"https://images.unsplash.com/photo-1504376379689-8d54347b26c6?ixid=M3w3NTc5NzN8MHwxfHNlYXJjaHwxMnx8cG9ydHJhaXR8ZW58MXwyfHx8MTc3MjQyNTMwNnww&amp;ixlib=rb-4.1.0&amp;w=320&amp;fit=max&amp;auto=format&amp;q=80\" class=\"w-12 h-12 rounded-full object-cover border-2 border-white\" alt=\"Client\" style=\"\">\n                        <div class=\"absolute -bottom-1 -right-1 w-6 h-6 bg-brand rounded-full flex items-center justify-center text-white border-2 border-white\">\n                            <iconify-icon icon=\"solar:arrow-right-up-linear\" width=\"12\"></iconify-icon>\n                        </div>\n                    </div>\n                </div>\n\n                <p class=\"text-xs font-semibold uppercase tracking-wide text-gray-800 max-w-[140px] leading-relaxed\">\n                    Satisfied clients with dream home\n                </p>\n            </div>\n\n            <div class=\"mb-auto\"></div> <!-- Spacer -->\n        </div>\n\n    </main>\n\n    <!-- Bottom Section -->\n    <section class=\"w-full max-w-[1400px] mx-auto grid lg:grid-cols-12 bg-white min-h-[300px]\">\n        <!-- Text Content -->\n        <div class=\"lg:col-span-9 p-8 lg:p-16 flex flex-col lg:flex-row gap-12 items-start\">\n            <div class=\"flex-1 max-w-md\">\n                <p class=\"text-gray-600 text-sm leading-relaxed mb-8\">\n                    Our team of talented architects and designers are passionate about delivering innovative designs that <strong class=\"text-black font-semibold\">blend creativity, sustainability, and functionality.</strong>\n                </p>\n                <span class=\"inline-block bg-[#A0A09C] text-white text-xs font-semibold px-4 py-2 rounded-full tracking-wide\">\n                    #VISIONARIES\n                </span>\n            </div>\n\n            <div class=\"flex-1\">\n                <h2 class=\"text-3xl lg:text-4xl font-normal tracking-tight leading-tight\">\n                    Niche architect<br>\n                    bureau of<br>\n                    premium class!\n                </h2>\n            </div>\n        </div>\n\n        <!-- Corner Image -->\n        <div class=\"lg:col-span-3 h-64 lg:h-auto relative overflow-hidden group\">\n            <img src=\"https://images.unsplash.com/photo-1480350376518-4575ee35bf49?ixid=M3w3NTc5NzN8MHwxfHNlYXJjaHwzMHx8YXJjaGl0ZWN0dXJlfGVufDF8MHx8fDE3NzI0NzE0OTh8MA&amp;ixlib=rb-4.1.0&amp;w=800&amp;fit=max&amp;auto=format&amp;q=80\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" alt=\"Detail\" style=\"\">\n            <div class=\"absolute inset-0 bg-black/10\"></div>\n        </div>\n    </section>\n\n    <!-- WebGL-like Grid Animation Script -->\n    <script>\n        const canvas = document.getElementById('gridCanvas');\n        const ctx = canvas.getContext('2d');\n        let width, height;\n        let offset = 0;\n\n        function resize() {\n            width = canvas.width = canvas.parentElement.offsetWidth;\n            height = canvas.height = canvas.parentElement.offsetHeight;\n        }\n\n        function drawGrid() {\n            ctx.clearRect(0, 0, width, height);\n            ctx.strokeStyle = 'rgba(0,0,0,0.08)'; // Very subtle grid lines\n            ctx.lineWidth = 1;\n\n            const gridSize = 60;\n            const speed = 0.2;\n\n            offset = (offset + speed) % gridSize;\n\n            ctx.beginPath();\n            // Vertical lines\n            for (let x = offset; x < width; x += gridSize) {\n                ctx.moveTo(x, 0);\n                ctx.lineTo(x, height);\n            }\n            // Horizontal lines\n            for (let y = offset; y < height; y += gridSize) {\n                ctx.moveTo(0, y);\n                ctx.lineTo(width, y);\n            }\n            ctx.stroke();\n\n            // Draw a few animated \"nodes\" or points on intersections\n            ctx.fillStyle = 'rgba(0,0,0,0.3)';\n            const time = Date.now() * 0.001;\n            for(let i=0; i<5; i++) {\n                let x = (Math.floor(width/gridSize/2) + Math.sin(time + i)*2) * gridSize + offset;\n                let y = (Math.floor(height/gridSize/2) + Math.cos(time + i)*2) * gridSize + offset;\n\n                // Wrap around\n                x = (x % width + width) % width;\n                y = (y % height + height) % height;\n\n                ctx.beginPath();\n                ctx.arc(x, y, 3, 0, Math.PI * 2);\n                ctx.fill();\n            }\n\n            requestAnimationFrame(drawGrid);\n        }\n\n        window.addEventListener('resize', resize);\n        resize();\n        drawGrid();\n    </script>\n\n</body></html>", "preview_file_name": "premium-architecture-sidebar-component.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/premium-architecture-sidebar-component.jpg", "source_name": "premium-architecture-sidebar-component-DESIGN.md", "views": 188, "forks": 7, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T20:33:33.056191+00:00"}