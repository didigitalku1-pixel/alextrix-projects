pporting layers behind the content. Keep effects performant, responsive, and secondary to the interface.\n\n## Guardrails\n- Do not flatten the source into a generic card grid.\n- Do not swap the color mode unless the source clearly supports it.\n- Preserve the first viewport signal, focal object, and visual density.\n- Keep buttons, cards, and badges aligned to the same radius and border language.", "preview_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Vanguard - Secure Assets</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400&display=swap\" rel=\"stylesheet\">\n</head>\n<body class=\"min-h-screen relative flex items-center justify-center p-4 md:p-8 lg:p-12 text-white antialiased bg-[#030303]\" style=\"font-family: 'JetBrains Mono', monospace; margin: 0; overflow-x: hidden;\">\n\n    <!-- WebGL Background -->\n    <canvas id=\"webgl-canvas\" style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0.4;\"></canvas>\n\n    <!-- Main Application Frame w/ Flashlight Hover -->\n    <div id=\"app-frame\" class=\"relative w-full max-w-[1400px] h-[85vh] z-10 shadow-2xl shadow-black/80 rounded-sm group\" style=\"background: rgba(255,255,255,0.05);\">\n\n        <!-- Border Flashlight Effect -->\n        <div class=\"absolute inset-0 z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-sm\" style=\"background: radial-gradient(600px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(229,236,91,0.5), transparent 40%);\"></div>\n\n        <!-- Inner Container & Background Flashlight -->\n        <div class=\"absolute inset-[1px] z-10 bg-[#050505] rounded-[1px] overflow-hidden flex flex-col\">\n\n            <!-- Subtle Background Flashlight Layer -->\n            <div class=\"absolute inset-0 z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none mix-blend-screen\" style=\"background: radial-gradient(800px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(255,255,255,0.06), transparent 40%);\"></div>\n\n            <!-- Container Lines (Left/Right) -->\n            <div class=\"hidden md:block absolute top-0 bottom-0 left-8 z-20\" style=\"width: 1px; background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0) 100%);\">\n                <div class=\"absolute -top-1 -left-[1.5px]\" style=\"width: 4px; height: 4px; background-color: rgba(255,255,255,0.4);\"></div>\n                <div class=\"absolute -bottom-1 -left-[1.5px]\" style=\"width: 4px; height: 4px; background-color: rgba(255,255,255,0.4);\"></div>\n            </div>\n            <div class=\"hidden md:block absolute top-0 bottom-0 right-8 z-20\" style=\"width: 1px; background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0) 100%);\">\n                <div class=\"absolute -top-1 -left-[1.5px]\" style=\"width: 4px; height: 4px; background-color: rgba(255,255,255,0.4);\"></div>\n                <div class=\"absolute -bottom-1 -left-[1.5px]\" style=\"width: 4px; height: 4px; background-color: rgba(255,255,255,0.4);\"></div>\n            </div>\n\n            <!-- Header -->\n            <header class=\"w-full px-6 md:px-16 h-24 flex justify-between items-center relative z-20\">\n                <div class=\"absolute top-1/2 left-0 w-full h-[1px] bg-white/10 -translate-y-1/2 z-0 pointer-events-none\"></div>\n\n                <div class=\"flex items-center gap-2 group/logo cursor-pointer relative z-10 bg-[#050505] pr-4\">\n                    <div class=\"grid grid-cols-3 gap-[2px] w-5 h-5 opacity-80 group-hover/logo:opacity-100 transition-opacity\">\n                        <div class=\"bg-[#E5EC5B] col-start-2\"></div>\n                        <div class=\"bg-[#E5EC5B] col-start-3\"></div>\n                        <div class=\"bg-[#E5EC5B] col-start-1 row-start-2\"></div>\n                        <div class=\"bg-[#E5EC5B] col-start-2 row-start-2\"></div>\n                        <div class=\"bg-[#E5EC5B] col-start-1 row-start-3\"></div>\n                        <div class=\"bg-[#E5EC5B] col-start-2 row-start-3\"></div>\n                    </div>\n                    <span class=\"text-lg tracking-tight font-normal text-white/90\">vanguard</span>\n                </div>\n                <a href=\"#\" class=\"text-xs md:text-sm text-white/50 hover:text-white transition-colors duration-300 relative z-10 bg-[#050505] pl-4 flex items-center gap-2 font-light\">\n                    <iconify-icon icon=\"solar:shield-check-linear\" width=\"18\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                    vanguard.io\n                </a>\n            </header>\n\n            <!-- Main Content Area -->\n            <main class=\"flex-1 w-full px-6 md:px-16 flex flex-col md:flex-row relative z-20 pb-16\">\n                <div class=\"absolute top-1/2 left-0 w-full h-[1px] bg-white/10 -translate-y-1/2 z-0 pointer-events-none hidden md:block\"></div>\n\n                <!-- Left: Typography (Remixed to Left Side) -->\n                <div class=\"order-1 md:order-1 w-full md:w-1/2 flex flex-col justify-center items-center md:items-start text-center md:text-left z-30 bg-[#050505] md:bg-transparent px-4 mt-8 md:mt-0\">\n                    <!-- Hook -->\n                    <h1 class=\"text-5xl md:text-6xl lg:text-7xl font-normal tracking-tight leading-[1.1]\">\n                        <div style=\"overflow: hidden; display: inline-block; vertical-align: top;\">\n                            <span class=\"reveal-title text-white\" style=\"display: inline-block; transform: translateY(110%);\">SECURE</span>\n                        </div>\n                        <div style=\"overflow: hidden; display: inline-block; vertical-align: top;\">\n                            <span class=\"reveal-title text-white\" style=\"display: inline-block; transform: translateY(110%);\">ASSETS.</span>\n                        </div>\n                        <br>\n                        <div style=\"overflow: hidden; display: inline-block; vertical-align: top;\" class=\"mt-2\">\n                            <span class=\"reveal-title text-[#E5EC5B]\" style=\"display: inline-block; transform: translateY(110%);\">IMPENETRABLE.</span>\n                        </div>\n                    </h1>\n\n                    <!-- New Description -->\n                    <div id=\"desc-text\" class=\"mt-6 md:mt-8 max-w-md font-light text-sm md:text-base leading-relaxed\" data-text=\"Advanced algorithmic defense systems built for modern digital infrastructure. Protect your network with autonomous zero-trust architecture.\">\n                        <!-- Words injected here via JS for masked staggered reveal -->\n                    </div>\n                </div>\n\n                <!-- Right: Graphic Proxy -->\n                <div class=\"order-2 md:order-2 w-full md:w-1/2 absolute md:relative inset-0 md:inset-auto flex justify-center items-center opacity-20 md:opacity-100 pointer-events-none md:pointer-events-auto z-20 mt-32 md:mt-0\">\n                    <div class=\"floating-vault relative flex justify-center items-center\">\n                        <div class=\"absolute inset-0 bg-[#E5EC5B]/10 blur-3xl rounded-full scale-150\"></div>\n\n                        <div class=\"relative w-48 h-48 md:w-64 md:h-64 mt-8 mr-8\">\n                            <div class=\"absolute inset-0 -translate-x-8 -translate-y-8 border border-[#E5EC5B]/30 bg-black/60 z-0\"></div>\n                            <div class=\"absolute inset-0 -translate-x-4 -translate-y-4 border border-[#E5EC5B]/50 bg-black/40 z-10\"></div>\n                            <div class=\"absolute inset-0 border border-[#E5EC5B] bg-[#E5EC5B]/5 z-20 shadow-[0_0_50px_rgba(229,236,91,0.05)] backdrop-blur-sm overflow-hidden\">\n                                <div class=\"w-full h-px bg-[#E5EC5B]/20 absolute top-1/3 left-0\"></div>\n                                <div class=\"w-full h-px bg-[#E5EC5B]/20 absolute top-2/3 left-0\"></div>\n                                <div class=\"h-full w-px bg-[#E5EC5B]/20 absolute left-1/3 top-0\"></div>\n                                <div class=\"h-full w-px bg-[#E5EC5B]/20 absolute left-2/3 top-0\"></div>\n                            </div>\n\n                            <div class=\"absolute top-0 left-0 h-[1px] bg-[#E5EC5B]/50 z-30\" style=\"width: 45.25px; transform: rotate(225deg); transform-origin: 0 0;\"></div>\n                            <div class=\"absolute top-0 left-full h-[1px] bg-[#E5EC5B]/50 z-30\" style=\"width: 45.25px; transform: rotate(225deg); transform-origin: 0 0;\"></div>\n                            <div class=\"absolute top-full left-0 h-[1px] bg-[#E5EC5B]/50 z-30\" style=\"width: 45.25px; transform: rotate(225deg); transform-origin: 0 0;\"></div>\n                            <div class=\"absolute top-full left-full h-[1px] bg-[#E5EC5B]/50 z-30\" style=\"width: 45.25px; transform: rotate(225deg); transform-origin: 0 0;\"></div>\n                        </div>\n                    </div>\n                </div>\n\n            </main>\n\n            <!-- Bottom \"Pixel\" Skyline Pattern (Continuous Up/Down Animation) -->\n            <div class=\"bottom-blocks-container absolute bottom-0 left-0 w-full h-[15vh] flex items-end opacity-70 z-10 pointer-events-none\">\n                <div class=\"bottom-block bg-[#E5EC5B] h-4 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-8 w-[1%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-12 w-[3%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-4 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-8 w-[4%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-16 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-20 w-[5%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-6 w-[3%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-10 w-[6%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-24 w-[4%] border-l border-black\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-12 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-16 w-[7%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-4 w-[1%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-8 w-[5%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-28 w-[6%] border-l border-black\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-16 w-[3%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-12 w-[8%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-8 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-20 w-[5%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-10 w-[4%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-16 w-[6%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-4 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-24 w-[7%] border-l border-black\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-12 w-[1%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-8 w-[4%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-16 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-14 w-[5%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-transparent h-6 w-[2%]\" style=\"transform-origin: bottom center;\"></div>\n                <div class=\"bottom-block bg-[#E5EC5B] h-6 w-[3%]\" style=\"transform-origin: bottom center;\"></div>\n            </div>\n\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Flashlight Effect Tracking\n            const frame = document.getElementById('app-frame');\n            frame.addEventListener('mousemove', (e) => {\n                const rect = frame.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                frame.style.setProperty('--mouse-x', `${x}px`);\n                frame.style.setProperty('--mouse-y', `${y}px`);\n            });\n\n            // Masked Staggered Word Reveal setup for description\n            const descContainer = document.getElementById('desc-text');\n            const text = descContainer.getAttribute('data-text');\n            const words = text.split(' ');\n            words.forEach(word => {\n                const wrapper = document.createElement('div');\n                wrapper.style.overflow = 'hidden';\n                wrapper.style.display = 'inline-block';\n                wrapper.style.marginRight = '0.4rem';\n                wrapper.style.verticalAlign = 'top';\n\n                const span = document.createElement('span');\n                span.className = 'reveal-word text-white/60';\n                span.style.display = 'inline-block';\n                span.style.transform = 'translateY(110%)';\n                span.innerText = word;\n\n                wrapper.appendChild(span);\n                descContainer.appendChild(wrapper);\n            });\n\n            // GSAP Animations\n            // 1. Reveal Titles\n            gsap.to(\".reveal-title\", {\n                y: \"0%\",\n                duration: 1.2,\n                stagger: 0.15,\n                ease: \"power4.out\",\n                delay: 0.2,\n                scrollTrigger: { trigger: \"h1\", start: \"top 85%\" }\n            });\n\n            // 2. Reveal Description Words\n            gsap.to(\".reveal-word\", {\n                y: \"0%\",\n                duration: 1,\n                stagger: 0.03,\n                ease: \"power3.out\",\n                delay: 0.8,\n                scrollTrigger: { trigger: \"#desc-text\", start: \"top 90%\" }\n            });\n\n            // 3. Bottom Blocks - Continuous Up & Down Equalizer Animation\n            document.querySelectorAll('.bottom-block').forEach((block) => {\n                gsap.to(block, {\n                    scaleY: 0.1 + Math.random() * 1.8,\n                    duration: 0.8 + Math.random() * 1.2,\n                    yoyo: true,\n                    repeat: -1,\n                    ease: \"sine.inOut\",\n                    delay: Math.random() * 2\n                });\n            });\n\n            // 4. Floating Vault Loop\n            gsap.to(\".floating-vault\", {\n                y: -15,\n                rotation: -1,\n                duration: 4,\n                yoyo: true,\n                repeat: -1,\n                ease: \"sine.inOut\"\n            });\n        });\n\n        // Three.js WebGL Animated Lines Background\n        const initWebGL = () => {\n            const canvas = document.getElementById('webgl-canvas');\n            const scene = new THREE.Scene();\n\n            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n            camera.position.z = 30;\n            camera.position.y = 10;\n            camera.lookAt(0, 0, 0);\n\n            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            renderer.setPixelRatio(window.devicePixelRatio);\n\n            const material = new THREE.LineBasicMaterial({\n                color: 0x444444,\n                transparent: true,\n                opacity: 0.3\n            });\n\n            const lines = new THREE.Group();\n            const size = 100;\n            const divisions = 40;\n            const step = size / divisions;\n\n            for (let i = -size / 2; i <= size / 2; i += step) {\n                const geometry = new THREE.BufferGeometry().setFromPoints([\n                    new THREE.Vector3(-size / 2, 0, i),\n                    new THREE.Vector3(size / 2, 0, i)\n                ]);\n                lines.add(new THREE.Line(geometry, material));\n            }\n\n            for (let i = -size / 2; i <= size / 2; i += step) {\n                const geometry = new THREE.BufferGeometry().setFromPoints([\n                    new THREE.Vector3(i, 0, -size / 2),\n                    new THREE.Vector3(i, 0, size / 2)\n                ]);\n                lines.add(new THREE.Line(geometry, material));\n            }\n\n            scene.add(lines);\n\n            let time = 0;\n            const animate = function () {\n                requestAnimationFrame(animate);\n                time += 0.002;\n\n                lines.position.z = (time * 10) % step;\n                lines.rotation.y = Math.sin(time * 0.5) * 0.05;\n\n                renderer.render(scene, camera);\n            };\n\n            animate();\n\n            window.addEventListener('resize', () => {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            });\n        };\n\n        initWebGL();\n    </script>\n</body>\n</html>", "preview_file_name": "vanguard-secure-assets.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/vanguard-secure-assets.jpg", "source_name": "vanguard-secure-assets-DESIGN.md", "views": 70, "forks": 3, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T02:12:20.236855+00:00"}