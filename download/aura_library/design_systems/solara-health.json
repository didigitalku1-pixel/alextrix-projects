ountain3').style.opacity = '1';\n                document.getElementById('mountain3').style.transform = 'translateY(0)';\n\n                // Show stats\n                document.getElementById('stat1').style.opacity = '1';\n                document.getElementById('stat2').style.opacity = '1';\n            }, 100);\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "solara-health.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/solara-health.jpg", "source_name": "solara-health-DESIGN.md", "views": 257, "forks": 12, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-02T01:39:18.985972+00:00"}