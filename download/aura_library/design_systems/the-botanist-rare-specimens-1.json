0,0.05)] border-l border-black/5\" style=\"font-family: 'Cormorant Garamond', serif; writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); clip-path: polygon(100% 0, 100% 100%, 0 calc(100% - 8px), 0 8px);\">Herbarium</div>\n        </div>\n\n        <!-- Page Spread with Border Gradient and Beautiful md shadow -->\n        <div class=\"relative z-10 flex flex-col md:flex-row w-full h-full md:w-[calc(100%-20px)] md:h-[calc(100%-10px)] md:m-[5px_0_5px_5px] p-[1px] md:rounded-l-[2px] md:rounded-r-md bg-gradient-to-br from-white/80 via-black/5 to-black/15 shadow-[0px_0px_0px_1px_rgba(0,0,0,0.06),0px_1px_1px_-0.5px_rgba(0,0,0,0.06),0px_3px_3px_-1.5px_rgba(0,0,0,0.06),_0px_6px_6px_-3px_rgba(0,0,0,0.06),0px_12px_12px_-6px_rgba(0,0,0,0.06),0px_24px_24px_-12px_rgba(0,0,0,0.06)]\">\n\n            <div class=\"flex flex-col md:flex-row w-full h-full bg-[#FDFBF7] md:rounded-l-[1px] md:rounded-r-[5px] overflow-hidden relative\">\n\n                <!-- Gutter Shadow -->\n                <div class=\"absolute left-1/2 top-0 bottom-0 w-[40px] -translate-x-1/2 z-10 pointer-events-none hidden md:block\" style=\"background: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,0.02) 40%, rgba(0,0,0,0.06) 50%, rgba(0,0,0,0.02) 60%, rgba(0,0,0,0) 100%);\"></div>\n\n                <!-- Left Page -->\n                <div class=\"w-full md:flex-1 h-[45vh] md:h-full relative md:border-r border-b md:border-b-0 border-[#161615]/10 p-6 md:p-[3vw] flex flex-col\">\n\n                    <div class=\"text-sm tracking-[0.15em] uppercase mb-6 md:mb-8 flex justify-between items-center animate-fade\" style=\"font-family: 'Cormorant Garamond', serif;\">\n                        The Botanist\n                        <span class=\"text-xs tracking-[0.1em] text-[#5A5A58] font-light\" style=\"font-family: 'Manrope', sans-serif;\">Est. 1892</span>\n                    </div>\n\n                    <!-- Specimen Image with Beautiful sm shadow and gradient border padding -->\n                    <div class=\"flex-1 w-full relative bg-gradient-to-b from-black/5 to-transparent p-px flex flex-col animate-block shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)]\">\n                        <div class=\"w-full h-full relative overflow-hidden bg-[#EAE9E4]\">\n                            <img src=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/302e86e0-80d8-4ba5-82e8-004220675655/2026-05-22/1779431674426-841f76df-e8de-43b0-8d1b-7c8ff985bd0b.png\" alt=\"Botanical specimen\" class=\"w-full h-full object-cover filter contrast-[1.05] saturate-[0.85] hover:scale-105 transition-transform duration-[2s] ease-out\" data-element-src=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/302e86e0-80d8-4ba5-82e8-004220675655/2026-05-22/1779431674426-841f76df-e8de-43b0-8d1b-7c8ff985bd0b.png\">\n\n                            <div class=\"absolute bottom-0 left-0 w-full p-3 px-4 bg-[#FDFBF7]/90 backdrop-blur-md border-t border-[#161615]/10 text-xs uppercase tracking-[0.05em] flex justify-between items-center font-extralight text-[#161615]\" style=\"font-family: 'JetBrains Mono', monospace;\">\n                                <span class=\"truncate pr-4\">Plate IX. — The Orchidaceae</span>\n                                <span class=\"whitespace-nowrap opacity-70\">Silver &amp; Glass</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Right Page -->\n                <div class=\"w-full md:flex-1 h-[55vh] md:h-full relative p-8 md:p-[4vw_5vw_4vw_4vw] flex flex-col overflow-y-auto [&amp;::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\">\n\n                    <span class=\"text-xs uppercase tracking-[0.25em] text-[#5A5A58] mb-8 md:mb-12 block font-light animate-fade\">Seasonal Collection • Specimen N° 12</span>\n\n                    <h1 class=\"text-5xl md:text-6xl lg:text-7xl font-light leading-[0.85] uppercase mb-10 md:mb-12 tracking-tight animate-words\" style=\"font-family: 'Cormorant Garamond', serif;\">\n                        Where<br>\n                        <span class=\"italic font-extralight normal-case inline-block translate-y-1 pr-2\">Nature &amp;</span><br>\n                        Science Meet\n                    </h1>\n\n                    <div class=\"flex flex-col md:flex-row gap-8 md:gap-16 mb-12 md:mb-16 items-start\">\n                        <p class=\"flex-1 text-xs leading-[1.8] text-justify text-[#161615] font-light first-line:uppercase first-line:tracking-[0.05em] animate-words\">\n                            Explore a meticulously gathered array of rare botanical specimens and extraction tools designed for the patient art of study. In a world dominated by synthetic creations, the delicate structure of a pressed fern and the precise volume of a hand-blown beaker provide grounding. Every item in this herbarium has been carefully sourced for its purity, its origin, and its botanical significance. We hold that the elements we study inevitably cultivate the mind itself.\n                        </p>\n                        <div class=\"flex-none w-auto md:w-[120px] italic text-xl text-[#5A5A58] border-t md:border-t-0 md:border-l border-[#161615]/20 pt-4 md:pt-0 md:pl-6 animate-fade\" style=\"font-family: 'Cormorant Garamond', serif;\">\n                            Natura,<br>Veritas.\n                        </div>\n                    </div>\n\n                    <div class=\"w-full h-px bg-[#161615]/10 my-8 md:my-10 relative animate-fade\">\n                        <span class=\"absolute -top-6 left-0 text-xs tracking-[0.2em] text-[#5A5A58] uppercase font-light\">The Catalogue</span>\n                    </div>\n\n                    <div class=\"w-full flex flex-col\">\n                        <!-- Inventory Rows -->\n                        <div class=\"group grid grid-cols-[50px_1fr_60px] md:grid-cols-[60px_2fr_1.5fr_80px] py-3 border-b border-[#161615]/10 text-xs items-center transition-colors duration-300 cursor-pointer hover:bg-black/5 animate-row\">\n                            <span class=\"text-[#5A5A58] font-extralight\" style=\"font-family: 'JetBrains Mono', monospace;\">12.01</span>\n                            <span class=\"text-sm italic tracking-[0.02em] text-[#161615]\" style=\"font-family: 'Cormorant Garamond', serif;\">Pressed Monstera Leaf</span>\n                            <span class=\"hidden md:block uppercase tracking-[0.1em] text-[#5A5A58] text-xs\">120 days • Lima, PE</span>\n                            <span class=\"text-right text-xs uppercase flex justify-end items-center gap-1 text-[#161615]\" style=\"font-family: 'JetBrains Mono', monospace;\">\n                                Details\n                                <iconify-icon icon=\"solar:arrow-right-linear\" stroke-width=\"1.5\" class=\"opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300\"></iconify-icon>\n                            </span>\n                        </div>\n\n                        <div class=\"group grid grid-cols-[50px_1fr_60px] md:grid-cols-[60px_2fr_1.5fr_80px] py-3 border-b border-[#161615]/10 text-xs items-center transition-colors duration-300 cursor-pointer hover:bg-black/5 animate-row\">\n                            <span class=\"text-[#5A5A58] font-extralight\" style=\"font-family: 'JetBrains Mono', monospace;\">12.02</span>\n                            <span class=\"text-sm italic tracking-[0.02em] text-[#161615]\" style=\"font-family: 'Cormorant Garamond', serif;\">Glass Distillation Flask</span>\n                            <span class=\"hidden md:block uppercase tracking-[0.1em] text-[#5A5A58] text-xs\">500ml • Berlin, DE</span>\n                            <span class=\"text-right text-xs uppercase flex justify-end items-center gap-1 text-[#161615]\" style=\"font-family: 'JetBrains Mono', monospace;\">\n                                Details\n                                <iconify-icon icon=\"solar:arrow-right-linear\" stroke-width=\"1.5\" class=\"opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300\"></iconify-icon>\n                            </span>\n                        </div>\n\n                        <div class=\"group grid grid-cols-[50px_1fr_60px] md:grid-cols-[60px_2fr_1.5fr_80px] py-3 border-b border-[#161615]/10 text-xs items-center transition-colors duration-300 cursor-pointer hover:bg-black/5 animate-row\">\n                            <span class=\"text-[#5A5A58] font-extralight\" style=\"font-family: 'JetBrains Mono', monospace;\">12.03</span>\n                            <span class=\"text-sm italic tracking-[0.02em] text-[#161615]\" style=\"font-family: 'Cormorant Garamond', serif;\">Essential Oil Vial</span>\n                            <span class=\"hidden md:block uppercase tracking-[0.1em] text-[#5A5A58] text-xs\">Vetiver • Grasse, FR</span>\n                            <span class=\"text-right text-xs uppercase flex justify-end items-center gap-1 text-[#161615]\" style=\"font-family: 'JetBrains Mono', monospace;\">\n                                Details\n                                <iconify-icon icon=\"solar:arrow-right-linear\" stroke-width=\"1.5\" class=\"opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300\"></iconify-icon>\n                            </span>\n                        </div>\n\n                        <div class=\"group grid grid-cols-[50px_1fr_60px] md:grid-cols-[60px_2fr_1.5fr_80px] py-3 border-b border-[#161615]/10 text-xs items-center transition-colors duration-300 cursor-pointer hover:bg-black/5 animate-row\">\n                            <span class=\"text-[#5A5A58] font-extralight\" style=\"font-family: 'JetBrains Mono', monospace;\">12.04</span>\n                            <span class=\"text-sm italic tracking-[0.02em] text-[#161615]\" style=\"font-family: 'Cormorant Garamond', serif;\">Field Journal</span>\n                            <span class=\"hidden md:block uppercase tracking-[0.1em] text-[#5A5A58] text-xs\">80 Pages • Rome, IT</span>\n                            <span class=\"text-right text-xs uppercase flex justify-end items-center gap-1 text-[#161615]\" style=\"font-family: 'JetBrains Mono', monospace;\">\n                                Details\n                                <iconify-icon icon=\"solar:arrow-right-linear\" stroke-width=\"1.5\" class=\"opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300\"></iconify-icon>\n                            </span>\n                        </div>\n\n                        <div class=\"group grid grid-cols-[50px_1fr_60px] md:grid-cols-[60px_2fr_1.5fr_80px] py-3 border-b-0 border-[#161615]/10 text-xs items-center transition-colors duration-300 cursor-pointer hover:bg-black/5 animate-row\">\n                            <span class=\"text-[#5A5A58] font-extralight\" style=\"font-family: 'JetBrains Mono', monospace;\">12.05</span>\n                            <span class=\"text-sm italic tracking-[0.02em] text-[#161615]\" style=\"font-family: 'Cormorant Garamond', serif;\">Brass Pruning Shears</span>\n                            <span class=\"hidden md:block uppercase tracking-[0.1em] text-[#5A5A58] text-xs\">Carbon • Sheffield, UK</span>\n                            <span class=\"text-right text-xs uppercase flex justify-end items-center gap-1 text-[#161615]\" style=\"font-family: 'JetBrains Mono', monospace;\">\n                                Details\n                                <iconify-icon icon=\"solar:arrow-right-linear\" stroke-width=\"1.5\" class=\"opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300\"></iconify-icon>\n                            </span>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            // Setup Word-by-Word Animation Elements\n            const wrapWords = (element) => {\n                const childNodes = Array.from(element.childNodes);\n                element.innerHTML = '';\n                let wordCount = 0;\n\n                childNodes.forEach(node => {\n                    if (node.nodeType === Node.TEXT_NODE) {\n                        const words = node.textContent.split(/\\s+/);\n                        words.forEach(word => {\n                            if (word.trim() !== '') {\n                                const span = document.createElement('span');\n                                span.textContent = word;\n                                span.style.opacity = '0';\n                                span.style.filter = 'blur(4px)';\n                                span.style.transform = 'translateY(12px)';\n                                span.style.display = 'inline-block';\n                                span.style.transition = 'opacity 0.8s ease-out, filter 0.8s ease-out, transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1)';\n                                span.style.transitionDelay = `${wordCount * 40}ms`;\n                                span.dataset.word = 'true';\n                                element.appendChild(span);\n                                // Ensure a proper space is added between words\n                                element.appendChild(document.createTextNode(' '));\n                                wordCount++;\n                            }\n                        });\n                    } else if (node.nodeType === Node.ELEMENT_NODE) {\n                        if(node.tagName.toLowerCase() !== 'br') {\n                            node.style.opacity = '0';\n                            node.style.filter = 'blur(4px)';\n                            node.style.transform = 'translateY(12px)';\n                            node.style.display = 'inline-block';\n                            node.style.transition = 'opacity 0.8s ease-out, filter 0.8s ease-out, transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1)';\n                            node.style.transitionDelay = `${wordCount * 40}ms`;\n                            node.dataset.word = 'true';\n                            wordCount++;\n                        }\n                        element.appendChild(node);\n                    }\n                });\n            };\n\n            document.querySelectorAll('.animate-words').forEach(wrapWords);\n\n            // Setup Block Animation Elements\n            document.querySelectorAll('.animate-block, .animate-fade, .animate-row').forEach((el, i) => {\n                el.style.opacity = '0';\n                el.style.filter = 'blur(4px)';\n                el.style.transform = el.classList.contains('animate-row') ? 'translateX(-10px)' : 'translateY(15px)';\n                el.style.transition = 'all 0.9s cubic-bezier(0.2, 0.8, 0.2, 1)';\n                if(el.classList.contains('animate-row')) {\n                    el.style.transitionDelay = `${i * 100}ms`;\n                }\n            });\n\n            // Intersection Observer\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        if (entry.target.classList.contains('animate-words')) {\n                            const children = entry.target.querySelectorAll('[data-word=\"true\"]');\n                            children.forEach(child => {\n                                child.style.opacity = '1';\n                                child.style.filter = 'blur(0)';\n                                child.style.transform = 'translateY(0)';\n                            });\n                        } else {\n                            entry.target.style.opacity = '1';\n                            entry.target.style.filter = 'blur(0)';\n                            entry.target.style.transform = 'translate(0,0)';\n                        }\n                        observer.unobserve(entry.target);\n                    }\n                });\n            }, { threshold: 0.15, rootMargin: \"0px 0px -50px 0px\" });\n\n            document.querySelectorAll('.animate-words, .animate-block, .animate-fade, .animate-row').forEach(el => observer.observe(el));\n        });\n    </script>\n\n</body></html>", "preview_file_name": "the-botanist-rare-specimens-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/the-botanist-rare-specimens-1.jpg", "source_name": "the-botanist-rare-specimens-1-DESIGN.md", "views": 96, "forks": 4, "private": false, "featured": true, "created_by": "f78092cf-e149-48ff-99e9-efabe9a28d39", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-01T19:33:18.25716+00:00"}