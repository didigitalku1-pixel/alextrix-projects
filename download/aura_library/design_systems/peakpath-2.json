0.25)]\">\n                Book a demo\n                <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-base\" style=\"stroke-width:1.5;\"></iconify-icon>\n            </a>\n\n            <!-- Mobile Menu Toggle -->\n            <button class=\"md:hidden text-white/80 hover:text-white\">\n                <iconify-icon icon=\"solar:hamburger-menu-linear\" class=\"text-2xl\" style=\"stroke-width:1.5;\"></iconify-icon>\n            </button>\n        </header>\n\n        <!-- Main Hero -->\n        <main class=\"flex-1 flex items-center justify-center px-6 md:px-12 lg:px-20 w-full py-12 md:py-0\">\n            <section class=\"w-full max-w-[1060px] mx-auto text-center flex flex-col items-center\">\n\n                <div class=\"reveal-line inline-flex items-center gap-2 px-3 py-2 rounded-full metric-pill mb-7\">\n                    <span class=\"status-dot\"></span>\n                    <span class=\"font-mono text-[10px] uppercase tracking-[0.16em] text-white/62\">Executive performance coaching / wearable-guided</span>\n                </div>\n\n                <div class=\"glass-strong rounded-[2rem] px-5 py-6 md:px-10 md:py-10 lg:px-14 lg:py-12 max-w-[1040px] w-full\">\n                    <h1 class=\"text-5xl md:text-7xl lg:text-[104px] leading-[0.88] tracking-[-0.075em] mb-7 md:mb-8 text-[#F6F0DD] font-semibold\">\n                        <div class=\"flex flex-wrap justify-center items-baseline gap-x-4\">\n                            <div style=\"overflow:hidden; padding-bottom:0.1em;\">\n                                <div class=\"reveal-word inline-block\">Sleep</div>\n                            </div>\n                            <div style=\"overflow:hidden; padding-bottom:0.1em;\">\n                                <div class=\"reveal-word inline-block text-[#C9F46B] font-serif italic font-normal tracking-[-0.035em]\">better.</div>\n                            </div>\n                        </div>\n\n                        <div class=\"flex flex-wrap justify-center items-baseline gap-x-4\">\n                            <div style=\"overflow:hidden; padding-bottom:0.1em;\">\n                                <div class=\"reveal-word inline-block\">Stay</div>\n                            </div>\n                            <div style=\"overflow:hidden; padding-bottom:0.1em;\">\n                                <div class=\"reveal-word inline-block text-white/62 font-serif italic font-normal tracking-[-0.035em]\">focused.</div>\n                            </div>\n                        </div>\n\n                        <div class=\"flex flex-wrap justify-center items-baseline gap-x-4\">\n                            <div style=\"overflow:hidden; padding-bottom:0.1em;\">\n                                <div class=\"reveal-word inline-block\">Think</div>\n                            </div>\n                            <div style=\"overflow:hidden; padding-bottom:0.1em;\">\n                                <div class=\"reveal-word inline-block text-[#A7FFD0] font-serif italic font-normal tracking-[-0.035em]\">sharper.</div>\n                            </div>\n                        </div>\n                    </h1>\n\n                    <div style=\"overflow:hidden;\" class=\"mb-9 max-w-[680px] mx-auto\">\n                        <p class=\"reveal-line text-base md:text-lg text-white/64 leading-relaxed font-light\">\n                            PeakPath helps consultants, operators, and leadership teams improve sleep, focus, and mental performance with coaching, wearable insight, and practical habit design.\n                        </p>\n                    </div>\n\n                    <div class=\"flex flex-col sm:flex-row justify-center items-center gap-3 mb-8\">\n                        <div style=\"overflow:hidden;\">\n                            <a href=\"#\" class=\"reveal-line inline-flex items-center gap-2 bg-[#C9F46B] text-[#03110E] px-6 py-3.5 rounded-full text-sm md:text-base font-semibold hover:bg-[#DFFF8F] transition-colors w-max shadow-[0_0_28px_rgba(201,244,107,0.25)] hover:shadow-[0_0_42px_rgba(201,244,107,0.42)]\">\n                                Book a demo\n                                <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-xl\" style=\"stroke-width:1.5;\"></iconify-icon>\n                            </a>\n                        </div>\n\n                        <div style=\"overflow:hidden;\">\n                            <a href=\"#\" class=\"reveal-line inline-flex items-center gap-2 bg-white/[0.045] text-white/78 border border-white/[0.09] px-6 py-3.5 rounded-full text-sm md:text-base font-medium hover:bg-white/[0.075] transition-colors w-max backdrop-blur-md\">\n                                Explore method\n                            </a>\n                        </div>\n                    </div>\n\n                    <!-- Centered Metric Cards -->\n                    <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-2 max-w-[720px] mx-auto\">\n                        <div class=\"reveal-card metric-pill rounded-2xl px-4 py-3 text-left\">\n                            <p class=\"font-mono text-[10px] uppercase tracking-[0.14em] text-white/38 mb-1\">Sleep</p>\n                            <p class=\"text-xl tracking-[-0.05em] text-[#C9F46B]\">+34%</p>\n                            <p class=\"text-xs text-white/42 mt-1\">Consistency gain</p>\n                        </div>\n                        <div class=\"reveal-card metric-pill rounded-2xl px-4 py-3 text-left\">\n                            <p class=\"font-mono text-[10px] uppercase tracking-[0.14em] text-white/38 mb-1\">Focus</p>\n                            <p class=\"text-xl tracking-[-0.05em] text-[#F6F0DD]\">10m</p>\n                            <p class=\"text-xs text-white/42 mt-1\">Daily reset</p>\n                        </div>\n                        <div class=\"reveal-card metric-pill rounded-2xl px-4 py-3 text-left\">\n                            <p class=\"font-mono text-[10px] uppercase tracking-[0.14em] text-white/38 mb-1\">Output</p>\n                            <p class=\"text-xl tracking-[-0.05em] text-[#A7FFD0]\">+20%</p>\n                            <p class=\"text-xs text-white/42 mt-1\">Cognitive lift</p>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </main>\n\n        <!-- Footer Pills -->\n        <footer class=\"relative z-10 px-6 py-6 md:px-12 md:py-8 flex justify-center flex-nowrap gap-3 md:gap-4 overflow-x-auto w-full\" style=\"scrollbar-width:none; -ms-overflow-style:none;\">\n            <style>footer::-webkit-scrollbar { display: none; }</style>\n\n            <div class=\"reveal-pill flex items-center gap-3 metric-pill px-5 py-3 rounded-full w-max shrink-0\">\n                <div class=\"status-dot\"></div>\n                <span class=\"text-sm font-light text-white/78\">Better sleep architecture</span>\n            </div>\n\n            <div class=\"reveal-pill flex items-center gap-3 metric-pill px-5 py-3 rounded-full w-max shrink-0\">\n                <div class=\"w-1.5 h-1.5 rounded-full bg-white/38\"></div>\n                <span class=\"text-sm font-light text-white/78\">10-minute calm and focus protocols</span>\n            </div>\n\n            <div class=\"reveal-pill flex items-center gap-3 metric-pill px-5 py-3 rounded-full w-max shrink-0\">\n                <div class=\"w-1.5 h-1.5 rounded-full bg-[#A7FFD0] shadow-[0_0_8px_rgba(167,255,208,0.8)]\"></div>\n                <span class=\"text-sm font-light text-white/78\">Built for high-pressure teams</span>\n            </div>\n        </footer>\n    </div>\n\n    <!-- WebGL Shader Scripts -->\n    <script type=\"x-shader/x-vertex\" id=\"vertexShader\">\n        varying vec2 vUv;\n\n        void main() {\n            vUv = uv;\n            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n        }\n    </script>\n\n    <script type=\"x-shader/x-fragment\" id=\"fragmentShader\">\n        uniform float u_time;\n        uniform vec2 u_resolution;\n        varying vec2 vUv;\n\n        float diagonalBand(vec2 uv, float offset, float width) {\n            float d = uv.y - (1.05 - uv.x * 0.72 + offset);\n            return exp(-pow(d / width, 2.0));\n        }\n\n        void main() {\n            vec2 uv = gl_FragCoord.xy / u_resolution.xy;\n            uv.x *= u_resolution.x / u_resolution.y;\n\n            vec2 p = uv - vec2(0.5 * (u_resolution.x / u_resolution.y), 0.5);\n\n            vec3 forest = vec3(0.012, 0.066, 0.053);\n            vec3 deep = vec3(0.008, 0.030, 0.025);\n            vec3 moss = vec3(0.788, 0.957, 0.420);\n            vec3 mint = vec3(0.655, 1.000, 0.816);\n            vec3 amber = vec3(0.906, 0.718, 0.416);\n\n            float wave = sin((uv.x * 3.2 + uv.y * 5.4) + u_time * 0.32) * 0.5 + 0.5;\n            float b1 = diagonalBand(uv, -0.08 + sin(u_time * 0.18) * 0.025, 0.18);\n            float b2 = diagonalBand(uv, 0.14 + cos(u_time * 0.15) * 0.035, 0.12);\n            float b3 = diagonalBand(uv, -0.30, 0.26);\n\n            vec3 color = mix(deep, forest, smoothstep(0.0, 1.0, uv.y));\n            color += moss * b1 * 0.22;\n            color += mint * b2 * 0.18;\n            color += amber * b3 * 0.10;\n\n            float fineLines = sin((uv.x - uv.y * 0.78) * 900.0 + u_time * 0.35) * 0.5 + 0.5;\n            fineLines = pow(fineLines, 3.0);\n            color *= mix(0.92, 1.06, fineLines * 0.32);\n\n            float vignette = smoothstep(1.25, 0.14, length(p));\n            color *= 0.68 + vignette * 0.55;\n\n            color *= 0.96 + 0.04 * sin(u_time * 1.2);\n\n            gl_FragColor = vec4(color, 1.0);\n        }\n    </script>\n\n    <!-- Main Logic -->\n    <script>\n        const initWebGL = () => {\n            const canvas = document.getElementById('webgl-canvas');\n            const renderer = new THREE.WebGLRenderer({\n                canvas,\n                antialias: true,\n                alpha: false\n            });\n\n            let material;\n\n            const setSize = () => {\n                renderer.setSize(window.innerWidth, window.innerHeight);\n                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n                if (material) {\n                    material.uniforms.u_resolution.value.set(window.innerWidth, window.innerHeight);\n                }\n            };\n\n            const scene = new THREE.Scene();\n            const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);\n            const geometry = new THREE.PlaneGeometry(2, 2);\n\n            material = new THREE.ShaderMaterial({\n                vertexShader: document.getElementById('vertexShader').textContent,\n                fragmentShader: document.getElementById('fragmentShader').textContent,\n                uniforms: {\n                    u_time: { value: 0 },\n                    u_resolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) }\n                }\n            });\n\n            const mesh = new THREE.Mesh(geometry, material);\n            scene.add(mesh);\n\n            setSize();\n            window.addEventListener('resize', setSize);\n\n            let time = 0;\n\n            const animate = () => {\n                time += 0.01;\n                material.uniforms.u_time.value = time;\n                renderer.render(scene, camera);\n                requestAnimationFrame(animate);\n            };\n\n            animate();\n        };\n\n        const initAnimations = () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            gsap.fromTo(\n                \".reveal-word\",\n                {\n                    y: \"112%\",\n                    rotationZ: 1.5\n                },\n                {\n                    y: \"0%\",\n                    rotationZ: 0,\n                    duration: 1.3,\n                    stagger: 0.07,\n                    ease: \"power4.out\",\n                    scrollTrigger: {\n                        trigger: \"main\",\n                        start: \"top 80%\"\n                    }\n                }\n            );\n\n            gsap.fromTo(\n                \".reveal-line\",\n                {\n                    y: \"100%\",\n                    opacity: 0\n                },\n                {\n                    y: \"0%\",\n                    opacity: 1,\n                    duration: 1.1,\n                    stagger: 0.12,\n                    ease: \"power3.out\",\n                    delay: 0.42,\n                    scrollTrigger: {\n                        trigger: \"main\",\n                        start: \"top 80%\"\n                    }\n                }\n            );\n\n            gsap.fromTo(\n                \".reveal-card\",\n                {\n                    y: 26,\n                    opacity: 0,\n                    filter: \"blur(10px)\"\n                },\n                {\n                    y: 0,\n                    opacity: 1,\n                    filter: \"blur(0px)\",\n                    duration: 1.05,\n                    stagger: 0.08,\n                    ease: \"power3.out\",\n                    delay: 0.65,\n                    scrollTrigger: {\n                        trigger: \"main\",\n                        start: \"top 80%\"\n                    }\n                }\n            );\n\n            gsap.fromTo(\n                \".reveal-pill\",\n                {\n                    y: 20,\n                    opacity: 0,\n                    filter: \"blur(8px)\"\n                },\n                {\n                    y: 0,\n                    opacity: 1,\n                    filter: \"blur(0px)\",\n                    duration: 1.05,\n                    stagger: 0.08,\n                    ease: \"power3.out\",\n                    delay: 0.9,\n                    scrollTrigger: {\n                        trigger: \"footer\",\n                        start: \"top 100%\"\n                    }\n                }\n            );\n        };\n\n        window.addEventListener('DOMContentLoaded', () => {\n            initWebGL();\n            initAnimations();\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "peakpath-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/peakpath-2.jpg", "source_name": "peakpath-2-DESIGN.md", "views": 294, "forks": 8, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-03T13:32:48.557228+00:00"}