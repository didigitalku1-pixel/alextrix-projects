ard 2 (Middle) -->\n                            <div class=\"absolute bottom-[66px] group-hover:bottom-[96px] group-hover:ml-5 w-[92%] h-[80px] bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl z-20 shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)] px-5 py-3 border border-white/30 flex justify-between items-start gsap-float-slower\" style=\"transition: bottom 0.6s cubic-bezier(0.22, 1, 0.36, 1), margin 0.6s cubic-bezier(0.22, 1, 0.36, 1); animation-delay: -2s;\">\n                                <span class=\"font-light text-white tracking-tight text-sm drop-shadow-sm\">Ecommerce</span>\n                                <span class=\"text-xs font-light text-indigo-100/90 uppercase tracking-wider\">Syncing</span>\n                            </div>\n\n                            <!-- Card 1 (Front) -->\n                            <div class=\"absolute bottom-[44px] group-hover:bottom-[36px] w-[98%] h-[80px] bg-gradient-to-br from-blue-400 to-blue-500 rounded-xl z-30 shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)] px-5 py-3 border border-blue-300/50 flex justify-between items-start gsap-float-slower\" style=\"transition: bottom 0.6s cubic-bezier(0.22, 1, 0.36, 1); animation-delay: -4s;\">\n                                <span class=\"font-light text-white tracking-tight text-sm drop-shadow-sm\">Workspace</span>\n                                <span class=\"text-xs font-light text-blue-100 uppercase tracking-wider\">Live</span>\n                            </div>\n\n                            <!-- Wallet Front Body -->\n                            <div class=\"relative z-40 w-full drop-shadow-[0_15px_25px_rgba(0,0,0,0.1)] pointer-events-none\">\n                                <svg viewBox=\"0 0 280 130\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-auto\">\n                                    <path d=\"M0 24 C0 10.7 10.7 0 24 0 H80 C98 0 108 38 140 38 C172 38 182 0 200 0 H256 C269.3 0 280 10.7 280 24 V106 C280 119.3 269.3 130 256 130 H24 C10.7 130 0 119.3 0 106 V24 Z\"\n                                          fill=\"url(#leather-grad)\"\n                                          stroke=\"url(#leather-edge-grad)\" stroke-width=\"2\"/>\n\n                                    <path d=\"M2 24 C2 11.8 11.8 2 24 2 H79 C95 2 106 36 140 36 C174 36 185 2 201 2 H256 C268.2 2 278 11.8 278 24 V106 C278 118.2 268.2 128 256 128 H24 C11.8 128 2 118.2 2 106 V24 Z\"\n                                          stroke=\"white\" stroke-width=\"1.5\" stroke-opacity=\"0.4\" style=\"mix-blend-mode: overlay;\"/>\n\n                                    <path d=\"M8 26 C8 16 16 8 26 8 H78 C92 8 102 42 140 42 C178 42 188 8 202 8 H254 C264 8 272 16 272 26 V104 C272 114 264 122 254 122 H26 C16 122 8 114 8 104 V26 Z\"\n                                          stroke=\"#93C5FD\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\" opacity=\"0.8\"/>\n\n                                    <g transform=\"translate(126, 70) scale(0.65)\">\n                                        <path d=\"M22 0L44 22L22 44L0 22L22 0Z\" fill=\"#2563EB\" style=\"filter: drop-shadow(0px -1px 1px rgba(255,255,255,0.2)) drop-shadow(0px 1px 2px rgba(0,0,0,0.3));\"/>\n                                        <path d=\"M22 8L36 22L22 36L8 22L22 8Z\" fill=\"#1E3A8A\" />\n                                        <path d=\"M22 10L34 22L22 34L10 22L22 10Z\" fill=\"#3B82F6\" />\n                                    </g>\n\n                                    <path d=\"M0 24 C0 10.7 10.7 0 24 0 H80 C98 0 108 38 140 38 C172 38 182 0 200 0 H256 C269.3 0 280 10.7 280 24 V106 C280 119.3 269.3 130 256 130 H24 C10.7 130 0 119.3 0 106 V24 Z\"\n                                          fill=\"url(#vol-grad)\" style=\"mix-blend-mode: soft-light;\" opacity=\"0.8\"/>\n\n                                    <defs>\n                                       