                       <stop offset=\"1\" stop-color=\"black\" stop-opacity=\"0.8\"/>\n                                        </linearGradient>\n                                    </defs>\n                                </svg>\n                            </div>\n\n                            <!-- Drop Shadow on ground -->\n                            <div class=\"absolute -bottom-4 w-[90%] h-5 bg-black/[0.4] blur-xl rounded-[100%] z-0 pointer-events-none\"></div>\n                            <div class=\"absolute -bottom-1 w-[75%] h-2 bg-black/[0.6] blur-md rounded-[100%] z-0 pointer-events-none\"></div>\n                        </div>\n                    </div>\n\n                    <!-- Text Content with Masked Reveal -->\n                    <div class=\"mt-auto text-center flex flex-col items-center z-20 w-full pb-4 pointer-events-none\">\n                        <h2 class=\"text-xl sm:text-2xl font-medium text-white tracking-tight mb-3 reveal-wrapper overflow-hidden\">\n                            <span class=\"flex items-center gap-2 reveal-text\">\n                                <iconify-icon icon=\"solar:wallet-linear\" class=\"text-amber-500\"></iconify-icon>\n                                Track expenditures\n                            </span>\n                        </h2>\n                        <div class=\"reveal-wrapper overflow-hidden\">\n                            <p class=\"text-sm text-zinc-400 font-light leading-relaxed max-w-[280px] reveal-text\">\n                                Oversee your marketing investments and allocate resources efficiently across all active campaigns.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 2: Right UI -->\n            <div class=\"group relative rounded-[2.5rem] bg-gradient-to-b from-white via-white to-zinc-100 p-[1px] shadow-[0px_0px_0px_1px_rgba(0,0,0,0.06),0px_1px_1px_-0.5px_rgba(0,0,