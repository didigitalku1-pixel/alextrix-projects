, gradients, particles, or atmospheric effects, rebuild them as supporting layers behind the content. Keep effects performant, responsive, and secondary to the interface.\n\n## Guardrails\n- Do not flatten the source into a generic card grid.\n- Do not swap the color mode unless the source clearly supports it.\n- Preserve the first viewport signal, focal object, and visual density.\n- Keep buttons, cards, and badges aligned to the same radius and border language.", "preview_html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Solace Method - Longevity Studio</title>\n\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\"></script>\n\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link\n    href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Manrope:wght@300;400;500;600;700&display=swap\"\n    rel=\"stylesheet\">\n</head>\n\n<body style=\"\n    --canvas: #f5efe5;\n    --paper: #fffaf1;\n    --paper-strong: #fff7e9;\n    --ink: #211f1a;\n    --ink-soft: #4a4338;\n    --sage: #6f7f63;\n    --sage-dark: #4f5d47;\n    --moss: #354030;\n    --sand: #d9cdbd;\n    --mist: #ebe1d3;\n    --muted: #746e63;\n    font-family: 'Inter', sans-serif;\n  \" class=\"min-h-screen bg-[var(--ink)] text-[var(--ink)] antialiased selection:bg-[var(--sage)] selection:text-white\">\n\n  <!-- Persistent Framing HUD -->\n  <div\n    class=\"fixed inset-2 md:inset-4 pointer-events-none z-50 border border-[var(--sand)]/35 rounded-xl hidden md:block mix-blend-multiply\">\n    <div class=\"absolute -top-px -left-px w-5 h-5 border-t border-l border-[var(--sage)] rounded-tl-xl\"></div>\n    <div class=\"absolute -top-px -right-px w-5 h-5 border-t border-r border-[var(--sage)] rounded-tr-xl\"></div>\n    <div class=\"absolute -bottom-px -left-px w-5 h-5 border-b border-l border-[var(--sage)] rounded-bl-xl\"></div>\n    <div class=\"absolute -bottom-px -right-px w-5 h-5 border-b border-r border-[var(--sage)] rounded-br-xl\"></div>\n\n    <div class=\"absolute top-1/2 -left-px w-1.5 h-px bg-[var(--sage)]\"></div>\n    <div class=\"absolute top-1/2 -right-px w-1.5 h-px bg-[var(--sage)]\"></div>\n    <div class=\"absolute -top-px left-1/2 w-px h-1.5 bg-[var(--sage)]\"></div>\n    <div class=\"absolute -bottom-px left-1/2 w-px h-1.5 bg-[var(--sage)]\"></div>\n  </div>\n\n  <!-- Master Surface -->\n  <div\n    class=\"m-2 md:m-4 relative min-h-[calc(100vh-1rem)] md:min-h-[calc(100vh-2rem)] bg-[var(--canvas)] rounded-xl shadow-2xl overflow-hidden flex flex-col border border-white/30\">\n\n    <!-- Subtle Diagonal Texture -->\n    <div class=\"absolute inset-0 pointer-events-none mix-blend-multiply opacity-[0.28] z-0\"\n      style=\"background-image: repeating-linear-gradient(-45deg, var(--sand) 0, var(--sand) 1px, transparent 1px, transparent 11px);\">\n    </div>\n\n    <!-- Header Navigation -->\n    <header\n      class=\"sticky top-0 bg-[var(--canvas)]/95 backdrop-blur-md py-4 px-6 md:px-10 flex justify-between items-center relative z-40 border-b border-[var(--sand)]/55\">\n\n      <nav\n        class=\"hidden lg:flex items-center gap-8 text-xs font-medium uppercase tracking-[0.22em] text-[var(--muted)]\">\n        <a href=\"#\" class=\"text-[var(--ink)] border-b border-[var(--sage)] pb-1\">Studio</a>\n        <a href=\"#\"\n          class=\"hover:text-[var(--ink)] hover:border-[var(--sage)] border-b border-transparent transition pb-1\">Method</a>\n        <a href=\"#\"\n          class=\"hover:text-[var(--ink)] hover:border-[var(--sage)] border-b border-transparent transition pb-1\">Recovery</a>\n        <a href=\"#\"\n          class=\"hover:text-[var(--ink)] hover:border-[var(--sage)] border-b border-transparent transition pb-1\">Journal</a>\n      </nav>\n\n      <a href=\"#\"\n        class=\"flex items-center gap-3 text-xl md:text-2xl text-[var(--ink)] font-semibold tracking-tight absolute left-1/2 -translate-x-1/2 z-10\"\n        style=\"font-family: 'Manrope', sans-serif;\">\n        <div\n          class=\"relative w-9 h-9 flex items-center justify-center text-[var(--sage)] bg-[var(--paper)] border border-[var(--sage)] rounded-sm shadow-sm\">\n          <span class=\"text-base leading-none font-semibold\">S</span>\n          <div class=\"absolute -top-px -left-px w-1.5 h-1.5 border-t border-l border-[var(--sage)]\"></div>\n          <div class=\"absolute -bottom-px -right-px w-1.5 h-1.5 border-b border-r border-[var(--sage)]\"></div>\n        </div>\n        Solace Method\n      </a>\n\n      <div class=\"flex items-center gap-5 ml-auto lg:ml-0\">\n        <button\n          class=\"hidden md:block px-6 py-2.5 bg-[var(--ink)] text-white rounded-sm text-xs font-semibold uppercase tracking-[0.2em] hover:bg-[var(--moss)] transition shadow-sm border border-transparent\">\n          Book Session\n        </button>\n      </div>\n    </header>\n\n    <main class=\"w-full pb-20 relative z-10 flex-1\">\n\n      <!-- Hero Typography -->\n      <section class=\"text-center mt-24 mb-24 px-4\">\n        <h1\n          class=\"headline-container text-[clamp(3rem,6vw,7rem)] leading-[1.12] font-medium tracking-[-0.06em] flex flex-col items-center gap-1 md:gap-2\"\n          style=\"font-family: 'Manrope', sans-serif;\">\n\n          <div class=\"text-[var(--ink)] flex items-center justify-center flex-wrap gap-x-4 md:gap-x-6\">\n            <span class=\"overflow-hidden inline-flex pb-[0.12em] -mb-[0.12em]\">\n              <span class=\"reveal-target block\">Reset</span>\n            </span>\n\n            <span class=\"overflow-hidden inline-flex pb-[0.12em] -mb-[0.12em]\">\n              <span class=\"reveal-target block\">The</span>\n            </span>\n\n            <span class=\"overflow-hidden inline-flex pb-[0.12em] -mb-[0.12em]\">\n              <span class=\"reveal-target block\">Body</span>\n            </span>\n\n            <span\n              class=\"overflow-hidden inline-flex rounded-lg align-middle p-1.5 border border-[var(--sand)] bg-[var(--paper)] shadow-sm pb-[0.12em] -mb-[0.12em]\">\n              <span\n                class=\"reveal-target block w-20 h-10 md:w-44 md:h-[4.5rem] rounded-sm bg-cover bg-center\"\n                style=\"background-image: url('https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=1000&q=85');\">\n              </span>\n            </span>\n\n            <span class=\"overflow-hidden inline-flex pb-[0.12em] -mb-[0.12em]\">\n              <span class=\"reveal-target block\">Through</span>\n            </span>\n          </div>\n\n          <div class=\"text-[var(--sage)] flex items-center justify-center flex-wrap gap-x-4 md:gap-x-6\">\n            <span\n              class=\"overflow-hidden inline-flex rounded-lg align-middle p-1.5 border border-[var(--sand)] bg-[var(--paper)] shadow-sm pb-[0.12em] -mb-[0.12em]\">\n              <span\n                class=\"reveal-target block w-20 h-10 md:w-44 md:h-[4.5rem] rounded-sm bg-cover bg-center\"\n                style=\"background-image: url('https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1000&q=85');\">\n              </span>\n            </span>\n\n            <span class=\"overflow-hidden inline-flex pb-[0.12em] -mb-[0.12em]\">\n              <span class=\"reveal-target block\">Recovery</span>\n            </span>\n\n            <span class=\"overflow-hidden inline-flex pb-[0.12em] -mb-[0.12em]\">\n              <span class=\"reveal-target block\">And</span>\n            </span>\n\n            <span class=\"overflow-hidden inline-flex pb-[0.12em] -mb-[0.12em]\">\n              <span class=\"reveal-target block \">Breath</span>\n            </span>\n          </div>\n        </h1>\n      </section>\n\n      <!-- Main Image/Card Section -->\n      <section class=\"px-4 md:px-10 lg:px-12 max-w-[100rem] mx-auto\">\n        <div class=\"relative w-full h-[540px] bg-[var(--ink)] rounded-xl border border-[var(--sand)]/50 shadow-inner\"\n          style=\"\n            overflow: hidden;\n            isolation: isolate;\n            transform: translateZ(0);\n            background-image: url('https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=2200&q=85');\n            background-size: cover;\n            background-position: center;\n          \">\n\n          <!-- Image Overlay -->\n          <div class=\"absolute inset-0 bg-gradient-to-r from-[#171611]/72 via-[#171611]/38 to-transparent\"></div>\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[#171611]/35 via-transparent to-transparent\"></div>\n\n          <!-- Bottom Left Contrast Card -->\n          <div\n            class=\"absolute bottom-6 left-6 md:bottom-12 md:left-12 max-w-lg bg-[var(--paper-strong)] border border-white/80 p-6 md:p-8 rounded-lg shadow-2xl z-10 border-l-2 border-l-[var(--sage)]\">\n\n            <div\n              class=\"mb-4 inline-flex items-center gap-2 rounded-full bg-[var(--ink)] text-white px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.22em] shadow-sm\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--sage)]\"></span>\n              Guided Longevity Studio\n            </div>\n\n            <h2 class=\"text-3xl md:text-4xl leading-[1.08] text-[var(--ink)] font-medium mb-4 tracking-[-0.05em]\"\n              style=\"font-family: 'Manrope', sans-serif;\">\n              Recovery Rituals<br>For A Clearer State\n            </h2>\n\n            <p class=\"text-sm text-[var(--ink-soft)] leading-relaxed mb-8 max-w-[22rem] font-medium\">\n              A calm protocol space for breathwork, contrast therapy, mobility, and nervous system recovery — designed\n              to help you leave lighter than you arrived.\n            </p>\n\n            <button\n              class=\"w-10 h-10 rounded-sm border border-[var(--sage)] bg-[var(--paper)] flex items-center justify-center text-[var(--sage)] hover:bg-[var(--sage)] hover:text-white transition duration-300 shadow-sm\">\n              <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-xl\" stroke-width=\"1.5\"></iconify-icon>\n            </button>\n          </div>\n\n          <!-- Overlapping Tab Navigation -->\n          <div\n            class=\"hidden md:flex absolute right-0 bottom-0 z-20 bg-[var(--canvas)] p-4 rounded-tl-xl border-t border-l border-[var(--sand)]/60 gap-2 items-center\">\n\n            <button\n              class=\"flex items-center gap-2.5 px-5 py-2.5 rounded-md border border-[var(--sand)] bg-[var(--paper)] text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)] hover:border-[var(--sage)] hover:text-[var(--ink)] transition\">\n              <iconify-icon icon=\"solar:heart-pulse-linear\" class=\"text-lg\" stroke-width=\"1.5\"></iconify-icon>\n              Reset\n            </button>\n\n            <button\n              class=\"flex items-center gap-2.5 px-5 py-2.5 rounded-md bg-[var(--sage)] text-white text-xs font-semibold uppercase tracking-[0.18em] shadow-sm border border-transparent transition\">\n              <iconify-icon icon=\"solar:wind-linear\" class=\"text-lg\" stroke-width=\"1.5\"></iconify-icon>\n              Breathe\n            </button>\n\n            <button\n              class=\"flex items-center gap-2.5 px-5 py-2.5 rounded-md border border-[var(--sand)] bg-[var(--paper)] text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)] hover:border-[var(--sage)] hover:text-[var(--ink)] transition\">\n              <iconify-icon icon=\"solar:waterdrops-linear\" class=\"text-lg\" stroke-width=\"1.5\"></iconify-icon>\n              Restore\n            </button>\n\n            <button\n              class=\"flex items-center gap-2.5 px-5 py-2.5 rounded-md border border-[var(--sand)] bg-[var(--paper)] text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)] hover:border-[var(--sage)] hover:text-[var(--ink)] transition\">\n              <iconify-icon icon=\"solar:moon-sleep-linear\" class=\"text-lg\" stroke-width=\"1.5\"></iconify-icon>\n              Recover\n            </button>\n\n          </div>\n        </div>\n      </section>\n    </main>\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      gsap.registerPlugin(ScrollTrigger);\n\n      gsap.from(\".reveal-target\", {\n        yPercent: 120,\n        duration: 1.2,\n        ease: \"power4.out\",\n        stagger: 0.08,\n        scrollTrigger: {\n          trigger: \".headline-container\",\n          start: \"top 85%\",\n        }\n      });\n    });\n  </script>\n</body>\n\n</html>", "preview_file_name": "atelier-veda-spatial-mechanics.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/atelier-veda-spatial-mechanics.jpg", "source_name": "atelier-veda-spatial-mechanics-DESIGN.md", "views": 176, "forks": 8, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-02T11:46:34.44426+00:00"}