          </div>\n\n                <!-- Bottom Features -->\n                <div class=\"fade-in-up grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-4 mt-auto mb-8\" data-delay=\"300\" style=\"opacity: 0; transform: translateY(20px);\">\n                    <!-- Feature 1 -->\n                    <div class=\"bg-[#EAEAEA] rounded-2xl p-5 pr-8 relative min-h-[80px] flex items-center\">\n                        <p class=\"text-xs text-gray-600 leading-snug w-4/5\">Targeted visual content for your organization</p>\n                        <div class=\"absolute -right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-[#FF5A00] text-white flex items-center justify-center shadow-sm z-10 cursor-pointer hover:scale-110 transition-transform\">\n                            <iconify-icon icon=\"solar:corner-down-left-linear\" width=\"1em\" stroke-width=\"1.5\"></iconify-icon>\n                        </div>\n                    </div>\n                    <!-- Feature 2 -->\n                    <div class=\"bg-[#EAEAEA] rounded-2xl p-5 pr-8 relative min-h-[80px] flex items-center\">\n                        <p class=\"text-xs text-gray-600 leading-snug w-4/5\">Comprehensive post-production services</p>\n                        <div class=\"absolute -right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-[#FF5A00] text-white flex items-center justify-center shadow-sm z-10 cursor-pointer hover:scale-110 transition-transform\">\n                            <iconify-icon icon=\"solar:corner-down-left-linear\" width=\"1em\" stroke-width=\"1.5\"></iconify-icon>\n                        </div>\n                    </div>\n                    <!-- Feature 3 -->\n                    <div class=\"bg-[#EAEAEA] rounded-2xl p-5 pr-8 relative min-h-[80px] flex items-center\">\n                        <p class=\"text-xs text-gray-600 leading-snug w-4/5\">Flexible media systems for scaling brands</p>\n                        <div class=\"absolute -right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-[#FF5A00] text-white flex items-center justify-center shadow-sm z-10 cursor-pointer hover:scale-110 transition-transform\">\n                            <iconify-icon icon=\"solar:corner-down-left-linear\" width=\"1em\" stroke-width=\"1.5\"></iconify-icon>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Footer Info -->\n                <div class=\"flex justify-between items-center text-xs text-gray-400 uppercase tracking-widest mt-4\">\n                    <span>©2024</span>\n                    <span>DESIGN X NEXUS STUDIOS</span>\n                </div>\n            </div>\n\n            <!-- Right Column (Visuals) -->\n            <div class=\"lg:col-span-5 relative flex flex-col h-full min-h-[500px] lg:min-h-0\">\n\n                <!-- Top Right Text & Pagination -->\n                <div class=\"absolute top-0 right-0 w-48 text-right z-20 hidden md:block\">\n                    <div class=\"flex justify-end gap-1.5 mb-4\">\n                        <div class=\"w-1.5 h-1.5 bg-[#111111] rounded-[1px]\"></div>\n                        <div class=\"w-1.5 h-1.5 bg-gray-300 rounded-[1px]\"></div>\n                        <div class=\"w-1.5 h-1.5 bg-gray-300 rounded-[1px]\"></div>\n                    </div>\n                    <p class=\"text-xs text-gray-500 leading-relaxed font-extralight\">\n                        NEXUS Media is a forward-thinking studio applying contemporary approaches to craft and deliver digital narratives.\n                    </p>\n                </div>\n\n                <!-- Staggered Image Cards Container -->\n                <div class=\"flex items-end gap-3 h-full mt-12 lg:mt-24 relative z-10\">\n\n                    <!-- Card 1 (Left, Medium) -->\n                    <div class=\"fade-in-up w-1/3 h-[55%] rounded-3xl relative overflow-hidden group cursor-pointer mb-20\" data-delay=\"100\" style=\"opacity: 0; transform: translateY(20px);\">\n                        <div class=\"absolute inset-0 bg-[url('https://images.unsplash.com/photo-1601506521937-0121a7fc2a6b?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')] bg-cover bg-center transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105\"></div>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#111] via-[#111]/40 to-transparent\"></div>\n                        <div class=\"absolute inset-0 p-5 flex flex-col justify-end\">\n                            <h3 class=\"text-white text-base md:text-lg font-extralight tracking-tight mb-2\">Narrative Arc</h3>\n                            <iconify-icon icon=\"solar:double-alt-arrow-right-linear\" class=\"text-[#FF5A00] text-xl\"></iconify-icon>\n                        </div>\n                    </div>\n\n                    <!-- Card 2 (Center, Tallest) -->\n                    <div class=\"fade-in-up w-1/3 h-[90%] rounded-3xl relative overflow-hidden group cursor-pointer\" data-delay=\"200\" style=\"opacity: 0; transform: translateY(20px);\">\n                        <div class=\"absolute inset-0 bg-[url('https://images.unsplash.com/photo-1542282088-fe8426682b8f?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')] bg-cover bg-center transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105\"></div>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#111] via-[#111]/60 to-transparent\"></div>\n                        <div class=\"absolute inset-0 p-5 flex flex-col justify-end\">\n                            <h3 class=\"text-white text-lg md:text-xl font-extralight tracking-tight mb-3\">Brand Campaigns</h3>\n                            <p class=\"text-gray-300 text-xs leading-relaxed mb-6 font-extralight\">\n                                High-end product spots, company showcases, brand films, and client testimonials.\n                            </p>\n                            <button class=\"w-full bg-transparent border border-white rounded-full py-2 px-4 flex justify-between items-center text-white text-xs hover:bg-white hover:text-black transition-colors group/btn\">\n                                Initiate Project\n                                <iconify-icon icon=\"solar:corner-down-left-linear\" class=\"text-[#FF5A00] group-hover/btn:text-black\"></iconify-icon>\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Card 3 (Right, Smallest) -->\n                    <div class=\"fade-in-up w-1/3 h-[65%] rounded-3xl relative overflow-hidden group cursor-pointer mb-8\" data-delay=\"300\" style=\"opacity: 0; transform: translateY(20px);\">\n                        <div class=\"absolute inset-0 bg-[url('https://images.unsplash.com/photo-1598899134739-24c46f58b8c0?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')] bg-cover bg-center transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105\"></div>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#111] via-[#111]/50 to-transparent\"></div>\n                        <div class=\"absolute inset-0 p-5 flex flex-col justify-end\">\n                            <h3 class=\"text-white text-base md:text-lg font-extralight tracking-tight mb-2 leading-snug\">Visual Shorts</h3>\n                            <iconify-icon icon=\"solar:double-alt-arrow-right-linear\" class=\"text-[#FF5A00] text-xl\"></iconify-icon>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Animation and Interaction Scripts -->\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n\n            // 1. Sped up Body Background Gradient Shifting\n            document.body.animate([\n                { backgroundPosition: '0% 50%' },\n                { backgroundPosition: '100% 50%' },\n                { backgroundPosition: '0% 50%' }\n            ], {\n                duration: 8000,\n                iterations: Infinity,\n                easing: 'ease-in-out'\n            });\n\n            // 2. Animated Background Blobs\n            document.getElementById('bg-blob-1')?.animate([\n                { transform: 'translate(0px, 0px) scale(1)' },\n                { transform: 'translate(-40px, 60px) scale(1.15)' },\n                { transform: 'translate(0px, 0px) scale(1)' }\n            ], { duration: 9000, iterations: Infinity, easing: 'ease-in-out' });\n\n            document.getElementById('bg-blob-2')?.animate([\n                { transform: 'translate(0px, 0px) scale(1)' },\n                { transform: 'translate(50px, -40px) scale(1.1)' },\n                { transform: 'translate(0px, 0px) scale(1)' }\n            ], { duration: 12000, iterations: Infinity, easing: 'ease-in-out' });\n\n            // 3. Fade In Up Elements\n            document.querySelectorAll('.fade-in-up').forEach(el => {\n                let delay = 0;\n                if(el.dataset.delay) delay = parseInt(el.dataset.delay);\n\n                el.animate([\n                    { opacity: 0, transform: 'translateY(20px)' },\n                    { opacity: 1, transform: 'translateY(0)' }\n                ], {\n                    duration: 800,\n                    delay: delay,\n                    easing: 'cubic-bezier(0.16, 1, 0.3, 1)',\n                    fill: 'forwards'\n                });\n            });\n\n            // 4. Canvas Background Particles Script\n            const canvas = document.getElementById('bg-canvas');\n            const ctx = canvas.getContext('2d');\n\n            let width, height;\n            let particles = [];\n\n            function resize() {\n                width = canvas.width = window.innerWidth;\n                height = canvas.height = window.innerHeight;\n            }\n\n            window.addEventListener('resize', resize);\n            resize();\n\n            class Particle {\n                constructor() {\n                    this.x = Math.random() * width;\n                    this.y = Math.random() * height;\n                    this.size = Math.random() * 2 + 0.5;\n                    this.speedX = Math.random() * 1.5 - 0.75;\n                    this.speedY = Math.random() * 1.5 - 0.75;\n                    this.life = Math.random() * 100;\n                }\n\n                update() {\n                    this.x += this.speedX;\n                    this.y += this.speedY;\n                    this.life += 0.5;\n\n                    if (this.x > width || this.x < 0) this.speedX *= -1;\n                    if (this.y > height || this.y < 0) this.speedY *= -1;\n                }\n\n                draw() {\n                    ctx.beginPath();\n                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n                    ctx.fillStyle = `rgba(255, 255, 255, ${Math.sin(this.life * 0.05) * 0.15 + 0.05})`;\n                    ctx.fill();\n                }\n            }\n\n            function init() {\n                particles = [];\n                for (let i = 0; i < 50; i++) {\n                    particles.push(new Particle());\n                }\n            }\n\n            function animate() {\n                ctx.clearRect(0, 0, width, height);\n\n                particles.forEach(p => {\n                    p.update();\n                    p.draw();\n                });\n\n                requestAnimationFrame(animate);\n            }\n\n            init();\n            animate();\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "nexus-media-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexus-media-2.jpg", "source_name": "nexus-media-2-DESIGN.md", "views": 235, "forks": 13, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T13:29:23.726024+00:00"}