-center justify-center gap-2 text-xs uppercase tracking-widest font-medium text-white/80 w-full\">\n                            <iconify-icon icon=\"solar:star-fall-linear\" stroke-width=\"1.5\" class=\"text-lg\"></iconify-icon>\n                            <span>Creative Lab</span>\n                            <iconify-icon icon=\"solar:star-fall-linear\" stroke-width=\"1.5\" class=\"text-lg\"></iconify-icon>\n                        </div>\n\n                        <p class=\"text-sm md:text-base font-normal text-center text-white/80 leading-relaxed max-w-[280px] mx-auto\">\n                            From dynamic interfaces to immersive brand identities — we engineer digital products that captivate, without technical boundaries.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <!-- Lightweight Canvas Animation Script -->\n    <script>\n        const canvas = document.getElementById('bg-canvas');\n        const ctx = canvas.getContext('2d');\n        let width, height;\n        let particles = [];\n\n        function initCanvas() {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n            particles = [];\n            const particleCount = Math.floor(width / 30);\n\n            for(let i = 0; i < particleCount; i++) {\n                particles.push({\n                    x: Math.random() * width,\n                    y: Math.random() * height,\n                    length: Math.random() * 150 + 50,\n                    speed: Math.random() * 0.5 + 0.1,\n                    opacity: Math.random() * 0.15 + 0.05\n                });\n            }\n        }\n\n        function animate() {\n            ctx.clearRect(0, 0, width, height);\n\n            particles.forEach(p => {\n                p.y += p.speed;\n                if(p.y > height + p.length) p.y = -p.length;\n\n                const gradient = ctx.createLinearGradient(p.x, p.y - p.length, p.x, p.y);\n                gradient.addColorStop(0, `rgba(230, 225, 214, 0)`);\n                gradient.addColorStop(1, `rgba(230, 225, 214, ${p.opacity})`);\n\n                ctx.beginPath();\n                ctx.moveTo(p.x, p.y - p.length);\n                ctx.lineTo(p.x, p.y);\n                ctx.strokeStyle = gradient;\n                ctx.lineWidth = 1;\n                ctx.stroke();\n            });\n\n            requestAnimationFrame(animate);\n        }\n\n        window.addEventListener('resize', initCanvas);\n        initCanvas();\n        animate();\n    </script>\n\n</body></html>", "preview_file_name": "premium-studio-card-component.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/premium-studio-card-component.jpg", "source_name": "premium-studio-card-component-DESIGN.md", "views": 181, "forks": 11, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T22:57:11.802087+00:00"}