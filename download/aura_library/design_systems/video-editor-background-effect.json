))}.selection\\:text-dark *::selection{--tw-text-opacity:1;color:rgb(10 9 8 / var(--tw-text-opacity, 1))}.selection\\:bg-gold::selection{--tw-bg-opacity:1;background-color:rgb(238 176 87 / var(--tw-bg-opacity, 1))}.selection\\:text-dark::selection{--tw-text-opacity:1;color:rgb(10 9 8 / var(--tw-text-opacity, 1))}.hover\\:bg-white:hover{--tw-bg-opacity:1;background-color:rgb(255 255 255 / var(--tw-bg-opacity, 1))}.hover\\:text-white:hover{--tw-text-opacity:1;color:rgb(255 255 255 / var(--tw-text-opacity, 1))}.hover\\:opacity-90:hover{opacity:0.9}.group:hover .group-hover\\:scale-105{--tw-scale-x:1.05;--tw-scale-y:1.05;transform:translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))}@media (min-width: 768px){.md\\:mt-0{margin-top:0px}.md\\:flex-row{flex-direction:row}}</style></head>\n<body class=\"antialiased min-h-screen flex flex-col relative selection:bg-gold selection:text-dark\">\n\n    <!-- Background Grid -->\n    <div class=\"grid-lines\">\n        <div class=\"grid-line\"></div><div class=\"grid-line\"></div><div class=\"grid-line\"></div><div class=\"grid-line\"></div><div class=\"grid-line\"></div>\n    </div>\n\n    <!-- Dust Animation Canvas -->\n    <canvas id=\"dust-canvas\" width=\"1588\" height=\"1219\"></canvas>\n\n    <!-- Navigation -->\n    <nav class=\"relative z-50 w-full px-6 py-6 flex justify-between items-center max-w-7xl mx-auto\">\n        <div class=\"flex gap-8 text-sm font-light text-neutral-400\">\n            <a href=\"#\" class=\"hover:text-white transition-colors\">Workflow</a>\n            <a href=\"#\" class=\"hover:text-white transition-colors\">Masterclass</a>\n            <a href=\"#\" class=\"hover:text-white transition-colors\">Pricing</a>\n        </div>\n\n        <div class=\"absolute left-1/2 -translate-x-1/2 top-6\">\n            <div class=\"px-4 py-1 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm\">\n                <span class=\"text-sm font-medium tracking-tight text-white\">Lumina</span>\n            </div>\n        </div>\n\n        <div class=\"flex items-center gap-6 text-sm font-light\">\n            <a href=\"#\" class=\"text-neutral-400 hover:text-white transition-colors\">Sign In</a>\n            <button class=\"border-gradient px-5 py-2 text-white text-xs font-medium hover:opacity-90 transition-opacity\">\n                Get Started\n            </button>\n        </div>\n    </nav>\n\n    <!-- Main Content -->\n    <main class=\"flex-grow relative z-10 flex flex-col justify-center w-full max-w-[1400px] mx-auto px-6 mt-10\">\n\n        <!-- Hero Section -->\n        <div class=\"relative w-full h-[600px] flex items-center\">\n\n            <!-- Typography Left -->\n            <div class=\"absolute left-0 top-10 z-20 max-w-lg\">\n                <h1 class=\"text-[5.5rem] leading-[0.9] font-light tracking-tighter text-white drop-shadow-2xl\">\n                    Cinematic <br> <span class=\"text-neutral-500\">control.</span>\n                </h1>\n            </div>\n\n            <!-- Typography Right -->\n            <div class=\"absolute right-20 top-20 z-20 text-right\">\n                <p class=\"text-2xl font-light tracking-tight text-neutral-300 max-w-xs leading-snug\">\n                    Transform raw footage into <br> <span class=\"text-gold\">visual masterpieces</span> with AI.\n                </p>\n            </div>\n\n            <!-- Central Visual Strip -->\n            <div class=\"absolute left-0 right-0 top-1/2 -translate-y-1/2 h-[280px] overflow-hidden rounded-sm mx-10 border-y border-white/5 group\">\n                <div class=\"absolute inset-0 bg-gradient-to-r from-dark via-transparent to-dark z-10\"></div>\n                <!-- Image -->\n                <img src=\"https://images.unsplash.com/photo-1470115636492-6d2b56f9146d?ixid=M3w3NTc5NzN8MHwxfHNlYXJjaHwyNXx8bGFuZHNjYXBlfGVufDF8MHx8fDE3NzI0MjcxODB8MA&amp;ixlib=rb-4.1.0&amp;w=3840&amp;fit=max&amp;auto=format&amp;q=80\" alt=\"Landscape\" class=\"w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-[2s] ease-out grayscale-[30%]\" style=\"\">\n\n                <!-- Floating CTA on Image -->\n                <div class=\"absolute left-20 bottom-10 z-20\">\n                     <button class=\"bg-gold text-dark px-6 py-2.5 rounded-full text-sm font-semibold tracking-tight hover:bg-white transition-colors shadow-[0_0_20px_rgba(238,176,87,0.4)]\">\n                        Start Creating\n                     </button>\n                </div>\n            </div>\n\n            <!-- Vertical Playhead Line -->\n            <div class=\"scan-line\"></div>\n            <div class=\"scan-head\"></div>\n\n            <!-- Floating Video Preview (Right) -->\n            <div class=\"absolute right-[10%] top-[35%] w-48 aspect-video rounded-lg overflow-hidden border border-white/10 shadow-2xl animate-float z-30 bg-neutral-900\">\n                <img src=\"https://images.unsplash.com/photo-1485178575877-1a13bf489dfe?ixid=M3w3NTc5NzN8MHwxfHNlYXJjaHwxOHx8cG9ydHJhaXR8ZW58MXwwfHx8MTc3MjUxMzQ5NHww&amp;ixlib=rb-4.1.0&amp;w=800&amp;fit=max&amp;auto=format&amp;q=80\" class=\"w-full h-full object-cover opacity-80\" alt=\"Preview\" style=\"\">\n                <div class=\"absolute inset-0 flex items-center justify-center\">\n                    <div class=\"w-8 h-8 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center border border-white/20\">\n                        <iconify-icon icon=\"solar:play-linear\" class=\"text-white text-sm\"></iconify-icon>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Editor Steps Floating UI -->\n            <div class=\"absolute right-[10%] top-[55%] flex flex-col gap-2 z-30\">\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"w-8 h-8 rounded border border-white/10 flex items-center justify-center text-[10px] text-neutral-500\">01</div>\n                    <div class=\"text-xs text-neutral-400 font-light px-3 py-1 rounded-full border border-white/5 bg-black/40 backdrop-blur-md\">Auto-Cut</div>\n                </div>\n                <div class=\"flex items-center gap-3 translate-x-4\">\n                    <div class=\"w-8 h-8 rounded border border-gold/50 flex items-center justify-center text-[10px] text-gold\">02</div>\n                    <div class=\"text-xs text-white font-medium px-3 py-1 rounded-full border border-gold/30 bg-gold/10 backdrop-blur-md shadow-[0_0_15px_rgba(238,176,87,0.1)]\">Color Grade</div>\n                </div>\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"w-8 h-8 rounded border border-white/10 flex items-center justify-center text-[10px] text-neutral-500\">03</div>\n                    <div class=\"text-xs text-neutral-400 font-light px-3 py-1 rounded-full border border-white/5 bg-black/40 backdrop-blur-md\">Export</div>\n                </div>\n            </div>\n\n            <!-- Horizontal Timeline Numbers -->\n            <div class=\"absolute bottom-20 left-0 right-0 flex justify-between px-20 text-xs font-mono text-neutral-600 z-0\">\n                <span>01</span>\n                <span>02</span>\n                <span class=\"text-gold\">03</span>\n                <span>04</span>\n                <span>05</span>\n            </div>\n        </div>\n\n        <!-- Bottom Section -->\n        <div class=\"w-full flex flex-col md:flex-row justify-between items-end mt-12 pb-12 border-t border-white/5 pt-8 relative\">\n\n            <!-- Testimonial Card -->\n            <div class=\"bg-neutral-100 text-dark p-6 rounded-sm max-w-sm relative group overflow-hidden\">\n                <div class=\"absolute top-0 right-0 p-4 opacity-10\">\n                    <iconify-icon icon=\"solar:quote-up-linear\" width=\"40\"></iconify-icon>\n                </div>\n                <h3 class=\"text-lg font-normal tracking-tight mb-4\">Creator approved</h3>\n                <div class=\"flex items-center gap-3 mb-4\">\n                    <img src=\"https://images.unsplash.com/photo-1514960919797-5ff58c52e5ba?ixid=M3w3NTc5NzN8MHwxfHNlYXJjaHwxN3x8cG9ydHJhaXR8ZW58MXwyfHx8MTc3MjQyNTMwNnww&amp;ixlib=rb-4.1.0&amp;w=320&amp;fit=max&amp;auto=format&amp;q=80\" class=\"w-8 h-8 rounded-full grayscale border border-neutral-300\" alt=\"User\" style=\"\">\n                    <img src=\"https://images.unsplash.com/photo-1584016235603-290a5f94af4a?ixid=M3w3NTc5NzN8MHwxfHNlYXJjaHwyNXx8cG9ydHJhaXR8ZW58MXwyfHx8MTc3MjQyNTMwNnww&amp;ixlib=rb-4.1.0&amp;w=320&amp;fit=max&amp;auto=format&amp;q=80\" class=\"w-8 h-8 rounded-full grayscale border border-neutral-300 -ml-4\" alt=\"User\" style=\"\">\n                    <div class=\"text-xs font-medium ml-2\">4.9/5 Rating</div>\n                </div>\n                <p class=\"text-xs text-neutral-600 leading-relaxed\">\n                    \"Lumina completely changed my workflow. The AI suggestions are actually usable.\"\n                </p>\n            </div>\n\n            <!-- Bottom Right Text -->\n            <div class=\"mt-8 md:mt-0 text-right\">\n                <div class=\"flex items-center justify-end gap-2 text-gold mb-2 text-xs uppercase tracking-widest opacity-80\">\n                    <iconify-icon icon=\"solar:stars-minimalistic-linear\"></iconify-icon>\n                    <span>AI Integration</span>\n                </div>\n                <h2 class=\"text-4xl font-light tracking-tighter text-white\">\n                    The editing suite <br>\n                    <span class=\"text-neutral-500\">reimagined for speed.</span>\n                </h2>\n            </div>\n        </div>\n    </main>\n\n    <script>\n        // WebGL-style Canvas Animation for \"Dust\" and Lines\n        const canvas = document.getElementById('dust-canvas');\n        const ctx = canvas.getContext('2d');\n        let width, height;\n        let particles = [];\n\n        function resize() {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n        }\n        window.addEventListener('resize', resize);\n        resize();\n\n        class Particle {\n            constructor() {\n                this.x = Math.random() * width;\n                this.y = Math.random() * height;\n                this.vx = (Math.random() - 0.5) * 0.2;\n                this.vy = (Math.random() - 0.5) * 0.2;\n                this.size = Math.random() * 1.5;\n                this.alpha = Math.random() * 0.5;\n            }\n            update() {\n                this.x += this.vx;\n                this.y += this.vy;\n                if (this.x < 0) this.x = width;\n                if (this.x > width) this.x = 0;\n                if (this.y < 0) this.y = height;\n                if (this.y > height) this.y = 0;\n            }\n            draw() {\n                ctx.fillStyle = `rgba(238, 176, 87, ${this.alpha})`; // Gold color\n                ctx.beginPath();\n                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n                ctx.fill();\n            }\n        }\n\n        // Create particles\n        for (let i = 0; i < 150; i++) {\n            particles.push(new Particle());\n        }\n\n        function animate() {\n            ctx.clearRect(0, 0, width, height);\n\n            // Draw faint connecting lines near center\n            ctx.strokeStyle = 'rgba(238, 176, 87, 0.05)';\n            ctx.lineWidth = 0.5;\n\n            particles.forEach(p => {\n                p.update();\n                p.draw();\n                // Connect particles near the center vertical line\n                const centerX = width / 2;\n                const distToCenter = Math.abs(p.x - centerX);\n                if (distToCenter < 100) {\n                    ctx.beginPath();\n                    ctx.moveTo(p.x, p.y);\n                    ctx.lineTo(centerX, p.y + (Math.random() * 20 - 10)); // Jittery connection\n                    ctx.stroke();\n                }\n            });\n            requestAnimationFrame(animate);\n        }\n        animate();\n    </script>\n\n</body></html>", "preview_file_name": "video-editor-background-effect.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/video-editor-background-effect.jpg", "source_name": "video-editor-background-effect-DESIGN.md", "views": 141, "forks": 3, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T06:34:08.337934+00:00"}