-4\">\n                <svg width=\"100%\" viewBox=\"0 0 1200 280\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\" class=\"fill-slate-800 transition-all duration-1000 ease-out hover:fill-slate-700 hover:scale-[1.01]\">\n                    <defs>\n                        <pattern id=\"dotGrid\" x=\"0\" y=\"0\" width=\"14\" height=\"14\" patternUnits=\"userSpaceOnUse\">\n                            <circle cx=\"7\" cy=\"7\" r=\"5.5\"></circle>\n                        </pattern>\n                    </defs>\n                    <text x=\"50%\" y=\"55%\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"900\" font-size=\"280\" text-anchor=\"middle\" dominant-baseline=\"middle\" fill=\"url(#dotGrid)\" letter-spacing=\"4\" style=\"transform-origin: center; animation: float 6s ease-in-out infinite alternate;\">WOODNEST</text>\n                </svg>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Preserved Interactive Canvas Script -->\n    <script></script>\n\n</body></html>", "preview_file_name": "nature-s-hideaways.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nature-s-hideaways.jpg", "source_name": "nature-s-hideaways-DESIGN.md", "views": 409, "forks": 21, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T21:05:00.717787+00:00"}