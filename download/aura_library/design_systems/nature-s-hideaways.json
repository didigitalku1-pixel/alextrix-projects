fy-between mt-2\">\n                                <div class=\"flex items-baseline gap-1\">\n                                    <span class=\"text-2xl font-medium text-white\">$359</span>\n                                    <span class=\"text-xs text-slate-500\">/night</span>\n                                </div>\n                                <span class=\"text-xs text-slate-300 font-medium\">2–5 guests</span>\n                            </div>\n\n                            <button class=\"mt-2 w-full bg-white text-slate-900 py-3.5 rounded-xl text-sm font-semibold hover:bg-slate-100 transition-all active:scale-[0.98]\">\n                                Reserve\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Preserved Footer Structure, Adapted for Dark Theme -->\n        <section class=\"relative z-10 px-6 md:px-12 lg:px-24 py-16 md:py-24 max-w-[1400px] mx-auto w-full flex-grow border-t border-white/5\">\n            <div class=\"grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-6\">\n                <!-- Left Details -->\n                <div class=\"md:col-span-5 lg:col-span-6 flex flex-col justify-between space-y-12\">\n                    <div class=\"space-y-3\">\n                        <p class=\"text-sm text-slate-500 font-medium\">© 2024 WoodNest Inc. All rights reserved.</p>\n                        <p class=\"text-sm text-slate-500 font-medium\">Curated Wilderness Experiences • est. 2018</p>\n                    </div>\n                    <div class=\"flex items-center gap-8 text-sm font-medium text-slate-300\">\n                        <a href=\"#\" class=\"hover:text-white transition-colors\">Privacy Policy</a>\n                        <a href=\"#\" class=\"hover:text-white transition-colors\">Terms of Service</a>\n                    </div>\n                </div>\n\n                <!-- Right Navigation -->\n      