 function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; gl.viewport(0, 0, canvas.width, canvas.height); }\n        window.addEventListener('resize', resize); resize();\n        const vs = gl.createShader(gl.VERTEX_SHADER);\n        gl.shaderSource(vs, `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`);\n        gl.compileShader(vs);\n        const fs = gl.createShader(gl.FRAGMENT_SHADER);\n        gl.shaderSource(fs, `\n            precision mediump float;\n            uniform float t;\n            void main() {\n                vec2 uv = gl_FragCoord.xy;\n                float n = fract(sin(dot(uv, vec2(12.9898, 78.233)) + t) * 43758.5453);\n                gl_FragColor = vec4(vec3(n * 0.03), 1.0);\n            }\n        `);\n        gl.compileShader(fs);\n        const prog = gl.createProgram();\n        gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog); gl.useProgram(prog);\n        const buf = gl.createBuffer();\n        gl.bindBuffer(gl.ARRAY_BUFFER, buf);\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);\n        const pos = gl.getAttribLocation(prog, \"p\");\n        gl.enableVertexAttribArray(pos); gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);\n        const tLoc = gl.getUniformLocation(prog, \"t\");\n        function render(time) { gl.uniform1f(tLoc, time * 0.001); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); requestAnimationFrame(render); }\n        requestAnimationFrame(render);\n\n        // Capacity Matrix Bar Chart Animation\n        const b1 = document.getElementById('bar-1'), b2 = document.getElementById('bar-2'), b3 = document.getElementById('bar-3');\n        setInterval(() => {\n            b1.style.height = (25 + Math.random() * 30) + '%';\n            b2.style.height = (65 + Math.random() * 30) + '%';\n            b3.style.height = (20 + Math.random() * 40) + '%';\n        }, 2500);\n\n        // Pipeline Progress Animation\n        const tp = document.getElementById('task-progress');\n        const tpt = document.getElementById('task-progress-text');\n        setInterval(() => {\n            const val = Math.floor(60 + Math.random() * 35);\n            tp.style.width = val + '%';\n            tpt.innerText = val + '%';\n        }, 3000);\n\n        // Timeline Sync Animation\n        const upBlock = document.getElementById('uplink-block'), upScan = document.getElementById('uplink-scan');\n        let upToggle = false;\n        setInterval(() => {\n            upToggle = !upToggle;\n            if(upToggle) {\n                upBlock.style.left = '15%'; upBlock.style.right = '55%'; upScan.style.left = '100%';\n            } else {\n                upBlock.style.left = '20%'; upBlock.style.right = '45%'; upScan.style.left = '-30%';\n            }\n        }, 2800);\n\n        // System Events Interaction Loop\n        const lr = document.getElementById('log-row-1'), lc = document.getElementById('log-check-1'), ab = document.getElementById('action-bar');\n        async function runLogs() {\n            while(true) {\n                lr.style.opacity = '1'; lr.style.transform = 'scale(1)'; lr.style.pointerEvents = 'auto';\n                lr.classList.remove('bg-neutral-900/50', 'border-neutral-800/60');\n                lc.innerHTML = ''; lc.classList.remove('bg-blue-500', 'border-blue-400');\n                ab.style.opacity = '0'; ab.style.transform = 'translate(-50%, 15px)'; ab.style.pointerEvents = 'none';\n                await new Promise(r => setTimeout(r, 1500));\n\n                lr.classList.add('bg-neutral-900/50', 'border-neutral-800/60');\n                await new Promise(r => setTimeout(r, 400));\n\n                lc.classList.add('bg-blue-500', 'border-blue-400');\n                lc.innerHTML = '<iconify-icon icon=\"solar:check-read-linear\" class=\"text-white text-[10px]\"></iconify-icon>';\n                ab.style.opacity = '1'; ab.style.transform = 'translate(-50%, 0)'; ab.style.pointerEvents = 'auto';\n                await new Promise(r => setTimeout(r, 2500));\n\n                lr.style.transform = 'scale(0.98)'; lr.style.opacity = '0'; lr.style.pointerEvents = 'none';\n                ab.style.opacity = '0'; ab.style.transform = 'translate(-50%, 15px)';\n                await new Promise(r => setTimeout(r, 2000));\n            }\n        }\n        runLogs();\n    </script>\n</body>\n</html>", "preview_file_name": "mesh-operations-center.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/mesh-operations-center.jpg", "source_name": "mesh-operations-center-DESIGN.md", "views": 122, "forks": 8, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T18:50:27.952109+00:00"}