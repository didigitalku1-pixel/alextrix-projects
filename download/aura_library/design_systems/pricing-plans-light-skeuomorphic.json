 gap-6 opacity-0 translate-y-4 transition-all duration-500 delay-100 group-hover/card:opacity-100 group-hover/card:translate-y-0\">\n\n                                <div class=\"h-px w-full bg-gradient-to-r from-transparent via-slate-200 to-transparent\"></div>\n\n                                <ul class=\"flex flex-col gap-y-3 flex-grow\">\n                                    <li class=\"flex items-center gap-3 text-xs font-light text-slate-600\">\n                                        <iconify-icon icon=\"solar:check-circle-linear\" style=\"stroke-width: 1.5;\" class=\"text-blue-400 text-lg\"></iconify-icon>\n                                        Everything in Innovator\n                                    </li>\n                                    <li class=\"flex items-center gap-3 text-xs font-light text-slate-600\">\n                                        <iconify-icon icon=\"solar:check-circle-linear\" style=\"stroke-width: 1.5;\" class=\"text-blue-400 text-lg\"></iconify-icon>\n                                        Unlimited requests\n                                    </li>\n                                    <li class=\"flex items-center gap-3 text-xs font-light text-slate-600\">\n                                        <iconify-icon icon=\"solar:check-circle-linear\" style=\"stroke-width: 1.5;\" class=\"text-blue-400 text-lg\"></iconify-icon>\n                                        24/7 dedicated support\n                                    </li>\n                                    <li class=\"flex items-center gap-3 text-xs font-light text-slate-600\">\n                                        <iconify-icon icon=\"solar:check-circle-linear\" style=\"stroke-width: 1.5;\" class=\"text-blue-400 text-lg\"></iconify-icon>\n                                        Single Sign-On (SSO)\n                                    </li>\n                                    <li class=\"flex items-center gap-3 text-xs font-light text-slate-600\">\n                                        <iconify-icon icon=\"solar:check-circle-linear\" style=\"stroke-width: 1.5;\" class=\"text-blue-400 text-lg\"></iconify-icon>\n                                        Custom SLA agreements\n                                    </li>\n                                </ul>\n\n                                <button class=\"mt-2 w-full py-3 rounded-xl bg-gradient-to-b from-white to-slate-50 border border-slate-200 text-slate-700 font-normal text-xs shadow-[0_2px_4px_rgba(0,0,0,0.02),inset_0_1px_0_white] hover:from-slate-50 hover:to-slate-100 active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.05)] transition-all\">\n                                    Contact Sales\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <script>\n        function togglePricing() {\n            const isYearly = document.getElementById('toggle-checkbox').checked;\n            const pill = document.getElementById('toggle-pill');\n            const labelMo = document.getElementById('label-mo');\n            const labelYr = document.getElementById('label-yr');\n            const prices = document.querySelectorAll('.price-val');\n\n            if(isYearly) {\n                pill.style.transform = 'translateX(100%)';\n                labelMo.classList.replace('text-slate-800', 'text-slate-400');\n                labelYr.classList.replace('text-slate-400', 'text-slate-800');\n            } else {\n                pill.style.transform = 'translateX(0)';\n                labelMo.classList.replace('text-slate-400', 'text-slate-800');\n                labelYr.classList.replace('text-slate-800', 'text-slate-400');\n            }\n\n            prices.forEach(el => {\n                const targetPrice = isYearly ? el.dataset.yearly : el.dataset.monthly;\n                let start = parseInt(el.innerText);\n                const end = parseInt(targetPrice);\n                if (start === end) return;\n                const duration = 250;\n                const stepTime = Math.abs(Math.floor(duration / (end - start)));\n                const timer = setInterval(() => {\n                    start = start < end ? start + 1 : start - 1;\n                    el.innerText = start;\n                    if (start === end) clearInterval(timer);\n                }, stepTime);\n            });\n        }\n    </script>\n</body>\n</html>", "preview_file_name": "pricing-plans-light-skeuomorphic.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/pricing-plans-light-skeuomorphic.jpg", "source_name": "pricing-plans-light-skeuomorphic-DESIGN.md", "views": 279, "forks": 23, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T18:11:18.551328+00:00"}