ElementById('app-shell');\n\n            shell.addEventListener('mousemove', (e) => {\n                flashlight.classList.remove('opacity-0');\n                const rect = shell.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                flashlight.style.maskImage = `radial-gradient(circle 300px at ${x}px ${y}px, black, transparent)`;\n                flashlight.style.webkitMaskImage = `radial-gradient(circle 300px at ${x}px ${y}px, black, transparent)`;\n            });\n\n            shell.addEventListener('mouseleave', () => {\n                flashlight.classList.add('opacity-0');\n            });\n\n            // Card Border Highlight Effect\n            const cards = document.querySelectorAll('.card-wrapper');\n            cards.forEach(card => {\n                card.addEventListener('mousemove', e => {\n                    const rect = card.getBoundingClientRect();\n                    const x = e.clientX - rect.left;\n                    const y = e.clientY - rect.top;\n                    card.style.setProperty('--mouse-x', `${x}px`);\n                    card.style.setProperty('--mouse-y', `${y}px`);\n                });\n            });\n\n            // SVG Path Animation\n            const paths = document.querySelectorAll('.anim-line');\n            paths.forEach((path, index) => {\n                const length = path.getTotalLength();\n                path.style.strokeDasharray = length;\n                path.style.strokeDashoffset = length;\n                path.getBoundingClientRect(); // Reflow\n\n                path.style.transition = `stroke-dashoffset 2s cubic-bezier(0.25, 1, 0.5, 1) ${index * 0.15}s`;\n                path.style.strokeDashoffset = '0';\n\n                setTimeout(() => {\n                    path.style.transition = 'opacity 3s ease-in-out';\n                    let isDim = false;\n                    setInterval(() => {\n                        path.style.opacity = isDim ? '0.9' : '0.6';\n                        isDim = !isDim;\n                    }, 3000 + (index * 500));\n                }, 2500);\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "system-interface-skeuomorphic-clean.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/system-interface-skeuomorphic-clean.jpg", "source_name": "system-interface-skeuomorphic-clean-DESIGN.md", "views": 504, "forks": 19, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T15:54:47.96941+00:00"}