ents-none origin-top-left\" style=\"top: -11px; left: -11px;\">\n            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"#09090b\" stroke-width=\"1.2\" class=\"w-full h-full\">\n              <path d=\"M4.1 4.3c-.3-.1-.6.2-.5.5l6.8 15.8c.2.4.8.4.9-.1l1.7-6.5c.1-.5.5-.8 1-1l6.5-1.6c.5-.1.6-.8.1-1L4.1 4.3Z\"></path>\n            </svg>\n          </div>\n        </div>\n\n        <!-- GSAP Masked Staggered Word Reveal -->\n        <p class=\"canvas-subtitle mx-auto max-w-[650px] font-bold leading-[1.12] tracking-[0.02em] text-[clamp(28px,2.45vw,38px)] flex flex-wrap justify-center gap-x-[8px] gap-y-[4px]\" style=\"font-family: 'Patrick Hand', 'Inter', sans-serif;\">\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">Brainstorm,</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">design,</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">and</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">execute</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">ideas</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">inside</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">one</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom pb-2 -mb-2\"><span class=\"reveal-word inline-block translate-y-[100%] relative z-0\">limitless<span class=\"absolute -left-[4px] -right-[4px] bottom-[1px] -z-10 h-[5px] rounded-full bg-[#13a8ff] -rotate-2\"></span></span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">creative</span></span>\n          <span class=\"inline-block overflow-hidden align-bottom\"><span class=\"reveal-word inline-block translate-y-[100%]\">workspace.</span></span>\n        </p>\n\n        <div class=\"flex items-center justify-center gap-[34px] mt-[38px] max-[720px]:flex-col max-[720px]:gap-[14px]\">\n          <a href=\"#\" class=\"inline-flex items-center justify-center gap-[18px] rounded-[4px] font-bold tracking-[0.03em] uppercase bg-[#13a8ff] text-[#09090b] shadow-[0_4px_0_rgba(255,255,255,0.05)] h-[62px] min-w-[224px] text-[22px] max-[720px]:w-full max-[720px]:min-w-0\" style=\"font-family: 'Patrick Hand', 'Inter', sans-serif;\">\n            Start free\n            <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-[26px]\" style=\"stroke-width: 1.5;\"></iconify-icon>\n          </a>\n          <a href=\"#\" class=\"inline-flex items-center justify-center gap-[18px] rounded-[4px] font-bold tracking-[0.03em] uppercase border-2 border-[#f1f5f9] bg-transparent text-[#f1f5f9] h-[62px] min-w-[224px] text-[22px] max-[720px]:w-full max-[720px]:min-w-0\" style=\"font-family: 'Patrick Hand', 'Inter', sans-serif;\">View templates</a>\n        </div>\n      </section>\n    </main>\n  </section>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      gsap.registerPlugin(ScrollTrigger);\n\n      // 1. Masked Staggered Word Reveal\n      gsap.to(\".reveal-word\", {\n        y: \"0%\",\n        stagger: 0.05,\n        duration: 0.8,\n        ease: \"power3.out\",\n        scrollTrigger: {\n          trigger: \".canvas-subtitle\",\n          start: \"top 85%\"\n        }\n      });\n\n      // 2. Seamless Cursor Drawing Animation Loop\n      const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.6 });\n      const cOffset = -11; // Align cursor tip with border corners\n\n      // Initial state\n      gsap.set(\"#draw-cursor\", { left: cOffset, top: cOffset, scale: 1 });\n\n      // Draw Top Border\n      tl.to(\"#draw-cursor\", { left: `calc(100% + ${cOffset}px)`, duration: 0.8, ease: \"power1.inOut\" }, \"drawTop\")\n        .to(\".draw-border-top\", { width: \"100%\", duration: 0.8, ease: \"power1.inOut\" }, \"drawTop\");\n\n      // Draw Right Border\n      tl.to(\"#draw-cursor\", { top: `calc(100% + ${cOffset}px)`, duration: 0.8, ease: \"power1.inOut\" }, \"drawRight\")\n        .to(\".draw-border-right\", { height: \"100%\", duration: 0.8, ease: \"power1.inOut\" }, \"drawRight\");\n\n      // Draw Bottom Border\n      tl.to(\"#draw-cursor\", { left: cOffset, duration: 0.8, ease: \"power1.inOut\" }, \"drawBottom\")\n        .to(\".draw-border-bottom\", { width: \"100%\", duration: 0.8, ease: \"power1.inOut\" }, \"drawBottom\");\n\n      // Draw Left Border\n      tl.to(\"#draw-cursor\", { top: cOffset, duration: 0.8, ease: \"power1.inOut\" }, \"drawLeft\")\n        .to(\".draw-border-left\", { height: \"100%\", duration: 0.8, ease: \"power1.inOut\" }, \"drawLeft\");\n\n      // Pop in corner/side handles\n      tl.to(\".canvas-handle\", { scale: 1, opacity: 1, duration: 0.5, stagger: 0.04, ease: \"back.out(1.7)\" });\n\n      // Move cursor down to bottom-right handle\n      tl.to(\"#draw-cursor\", {\n        left: `calc(100% + ${cOffset}px)`,\n        top: `calc(100% + ${cOffset}px)`,\n        duration: 0.6,\n        ease: \"power2.inOut\"\n      });\n\n      // Click handle (cursor scale down)\n      tl.to(\"#draw-cursor\", { scale: 0.85, duration: 0.1 });\n\n      // Resize motion (scale the box slightly to simulate bounding box resizing)\n      tl.to(\".canvas-select-box\", {\n        scale: 1.03,\n        transformOrigin: \"top left\",\n        duration: 0.6,\n        ease: \"power2.out\"\n      }, \"resize\");\n\n      // Release click\n      tl.to(\"#draw-cursor\", { scale: 1, duration: 0.1 }, \"+=0.15\");\n\n      // Snap box back to original size\n      tl.to(\".canvas-select-box\", {\n        scale: 1,\n        duration: 0.5,\n        ease: \"power2.inOut\"\n      }, \"+=0.1\");\n\n      // Fade everything out and reset position for the next loop\n      tl.to(\".canvas-handle\", { scale: 0, opacity: 0, duration: 0.3 }, \"reset\")\n        .to(\".draw-border-top, .draw-border-bottom\", { width: 0, duration: 0.3 }, \"reset\")\n        .to(\".draw-border-right, .draw-border-left\", { height: 0, duration: 0.3 }, \"reset\")\n        .to(\"#draw-cursor\", { left: cOffset, top: cOffset, duration: 0.5, ease: \"power2.inOut\" }, \"reset\");\n    });\n  </script>\n</body>\n</html>", "preview_file_name": "space-visual-ideation-workspace.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/space-visual-ideation-workspace.jpg", "source_name": "space-visual-ideation-workspace-DESIGN.md", "views": 276, "forks": 7, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-03T10:18:05.352793+00:00"}