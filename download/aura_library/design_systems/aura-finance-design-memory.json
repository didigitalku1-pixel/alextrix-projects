\n                    delay: 1.2\n                });\n            }\n\n            // Proximity glow effect for all screens\n            const cards = document.querySelectorAll('.glow-card');\n            cards.forEach(card => {\n                card.addEventListener('mousemove', (e) => {\n                    const rect = card.getBoundingClientRect();\n                    const x = e.clientX - rect.left;\n                    const y = e.clientY - rect.top;\n                    card.style.setProperty('--mouse-x', `${x}px`);\n                    card.style.setProperty('--mouse-y', `${y}px`);\n                });\n\n                card.addEventListener('mouseleave', () => {\n                    card.style.setProperty('--mouse-x', `50%`);\n                    card.style.setProperty('--mouse-y', `-50%`);\n                });\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "aura-finance-design-memory.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/aura-finance-design-memory.jpg", "source_name": "aura-finance-design-memory-DESIGN.md", "views": 278, "forks": 12, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T02:23:05.049442+00:00"}