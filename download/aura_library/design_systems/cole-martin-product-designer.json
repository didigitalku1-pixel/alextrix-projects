     </p>\n                </div>\n\n                <!-- Feature 5 -->\n                <div class=\"flex items-center gap-4 w-full md:w-auto lg:w-1/5\">\n                    <div class=\"w-12 h-12 rounded-full flex items-center justify-center bg-[#F279A6]/10 text-[#F279A6]\">\n                         <iconify-icon icon=\"solar:heart-linear\" style=\"font-size: 24px; stroke-width: 1.5;\"></iconify-icon>\n                    </div>\n                    <p class=\"text-xs font-semibold text-gray-800 tracking-wide\" style=\"font-family: 'Space Mono', monospace;\">\n                        Built for Real<br>People\n                    </p>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n    <!-- Inline Script for Animations -->\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // 1. Masked Word Reveal on Scroll\n            // Selects explicitly marked elements to avoid breaking complex inner HTML\n            const revealElements = document.querySelectorAll('.gsap-mask-up');\n            \n            revealElements.forEach((elem, index) => {\n                gsap.to(elem, {\n                    y: '0%',\n                    duration: 1.2,\n                    ease: \"power4.out\",\n                    delay: index * 0.1, // Stagger effect based on DOM order\n                    scrollTrigger: {\n                        trigger: elem.parentElement, // Trigger on the hidden wrapper\n                        start: \"top 95%\",\n                        toggleActions: \"play none none none\"\n                    }\n                });\n            });\n\n            // 2. Continuous \"WebGL-style\" Floating Animations\n            gsap.to('.gsap-float', {\n                y: -15,\n                duration: 4,\n                ease: \"sine.inOut\",\n                yoyo: true,\n                repeat: -1\n            });\n\n            gsap.to('.gsap-float-delayed', {\n                y: -12,\n                duration: 3.5,\n                ease: \"sine.inOut\",\n                yoyo: true,\n                repeat: -1,\n                delay: 1.5\n            });\n\n            // 3. Continuous Rotations\n            gsap.to('.gsap-rotate-slow', {\n                rotation: 360,\n                duration: 20,\n                ease: \"none\",\n                repeat: -1\n            });\n            \n            gsap.to('.gsap-rotate-slow-reverse', {\n                rotation: -360,\n                duration: 25,\n                ease: \"none\",\n                repeat: -1\n            });\n\n            // 4. Little bounce for scroll arrow\n            gsap.to('.gsap-bounce-y', {\n                y: 5,\n                duration: 1,\n                ease: \"power1.inOut\",\n                yoyo: true,\n                repeat: -1\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "cole-martin-product-designer.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/cole-martin-product-designer.jpg", "source_name": "cole-martin-product-designer-DESIGN.md", "views": 112, "forks": 1, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-02T15:40:25.036515+00:00"}