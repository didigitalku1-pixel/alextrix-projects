t&fit=crop&q=80&w=800\" alt=\"Mobile\" class=\"w-full h-full object-cover rounded-[1.5rem]\" />\n                <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none z-20\">\n                    <span class=\"text-6xl font-semibold text-white/90 tracking-tighter rotate-[-90deg] mix-blend-overlay\">APP</span>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Bottom Typography Block -->\n    <div class=\"absolute bottom-24 md:bottom-20 left-6 md:left-[50%] w-full md:w-[50%] md:pl-12 z-30 pointer-events-none pr-6 md:pr-16 max-w-[1920px]\">\n        <h2 class=\"text-4xl md:text-5xl lg:text-[4rem] leading-[1.05] font-semibold tracking-tight text-white mb-4 md:mb-6 anim-element\" style=\"font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; opacity:0;\">\n            Crafting tomorrow.<br/>Building today.\n        </h2>\n        <p class=\"text-lg md:text-xl lg:text-2xl leading-snug text-neutral-400 font-medium anim-element max-w-lg\" style=\"opacity:0;\">\n            Beyond creators. Digital pioneers.<br class=\"hidden md:block\"/>Industry leaders.\n        </p>\n    </div>\n\n    <!-- Logos Marquee -->\n    <div class=\"fixed bottom-0 left-0 w-full overflow-hidden py-4 border-t border-neutral-800/60 bg-neutral-950/80 backdrop-blur-md z-40 pointer-events-none\">\n        <div id=\"marquee-track\" class=\"flex w-max items-center\">\n            <!-- Group 1 -->\n            <div class=\"flex items-center gap-12 md:gap-24 px-6 md:px-12\">\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:infinity-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Nexus</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:shield-network-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Secure</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:asteroid-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Astro</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:box-minimalistic-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Quantum</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:atom-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Synapse</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:cpu-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Core</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:radar-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Radar</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:database-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Vault</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:rocket-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Aero</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:bolt-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Volt</span></div>\n            </div>\n            <!-- Group 2 (Duplicate for seamless loop) -->\n            <div class=\"flex items-center gap-12 md:gap-24 px-6 md:px-12\">\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:infinity-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Nexus</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:shield-network-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Secure</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:asteroid-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Astro</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:box-minimalistic-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Quantum</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:atom-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Synapse</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:cpu-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Core</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:radar-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Radar</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:database-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Vault</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:rocket-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Aero</span></div>\n                <div class=\"flex items-center gap-3 opacity-50\"><iconify-icon icon=\"solar:bolt-linear\" class=\"text-2xl text-white\"></iconify-icon><span class=\"text-xs font-semibold tracking-[0.2em] text-white uppercase\">Volt</span></div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Initialization & Animation Script -->\n    <script>\n        // WebGL Background Effect (adapted for dark mode)\n        (function initWebGL(){\n            const cvs = document.createElement('canvas');\n            cvs.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none;opacity:0.4;';\n            document.body.insertBefore(cvs, document.body.firstChild);\n            const gl = cvs.getContext('webgl');\n            if(!gl) return;\n            const prog = gl.createProgram();\n            const createShader = (type, source) => {\n                const s = gl.createShader(type);\n                gl.shaderSource(s, source);\n                gl.compileShader(s);\n                gl.attachShader(prog, s);\n            };\n            createShader(gl.VERTEX_SHADER, 'attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}');\n            // Subtle animated grain/gradient shader shifted to dark baseline\n            createShader(gl.FRAGMENT_SHADER, 'precision lowp float;uniform float t;uniform vec2 r;void main(){vec2 u=gl_FragCoord.xy/r;float n=fract(sin(dot(u,vec2(12.9898,78.233)))*43758.5);vec3 c=vec3(0.04)+0.03*cos(t*0.3+u.xyx+vec3(0,2,4))+n*0.015;gl_FragColor=vec4(c,1);}');\n            gl.linkProgram(prog);\n            gl.useProgram(prog);\n            const buf = gl.createBuffer();\n            gl.bindBuffer(gl.ARRAY_BUFFER, buf);\n            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);\n            const attr = gl.getAttribLocation(prog, 'p');\n            gl.enableVertexAttribArray(attr);\n            gl.vertexAttribPointer(attr, 2, gl.FLOAT, false, 0, 0);\n            const timeLoc = gl.getUniformLocation(prog, 't');\n            const resLoc = gl.getUniformLocation(prog, 'r');\n            let start = performance.now();\n            const render = () => {\n                if(cvs.width !== window.innerWidth || cvs.height !== window.innerHeight) {\n                    cvs.width = window.innerWidth;\n                    cvs.height = window.innerHeight;\n                    gl.viewport(0, 0, cvs.width, cvs.height);\n                }\n                gl.uniform2f(resLoc, cvs.width, cvs.height);\n                gl.uniform1f(timeLoc, (performance.now() - start) * 0.001);\n                gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);\n                requestAnimationFrame(render);\n            };\n            render();\n        })();\n\n        // Sequence Animations & Marquee\n        document.addEventListener('DOMContentLoaded', () => {\n            // Sequence Reveal\n            const elements = document.querySelectorAll('.anim-element');\n            elements.forEach((el, index) => {\n                setTimeout(() => {\n                    el.animate([\n                        { opacity: 0, transform: 'translateY(40px) scale(0.98)' },\n                        { opacity: 1, transform: 'translateY(0) scale(1)' }\n                    ], {\n                        duration: 1200,\n                        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',\n                        fill: 'forwards'\n                    });\n                }, index * 100 + 150);\n            });\n\n            // Marquee Animation\n            const marqueeTrack = document.getElementById('marquee-track');\n            if(marqueeTrack) {\n                marqueeTrack.animate([\n                    { transform: 'translateX(0)' },\n                    { transform: 'translateX(-50%)' }\n                ], {\n                    duration: 35000,\n                    iterations: Infinity,\n                    easing: 'linear'\n                });\n            }\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "nexus-digital-pioneers-3.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexus-digital-pioneers-3.jpg", "source_name": "nexus-digital-pioneers-3-DESIGN.md", "views": 124, "forks": 4, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T19:15:53.298518+00:00"}