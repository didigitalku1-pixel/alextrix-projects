h-8 rounded-full bg-white/10 flex items-center justify-center text-xs font-normal text-white\">\n                                ETH\n                            </div>\n                        </div>\n                        <div>\n                            <div class=\"text-xs text-white/40 mb-1 font-normal\">Ethereum</div>\n                            <div class=\"text-sm font-normal text-white tracking-wide\">14.05</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Navigation Bar -->\n            <div class=\"absolute bottom-6 left-1/2 -translate-x-1/2 z-20\">\n                <div class=\"relative p-[1px] rounded-full bg-gradient-to-b from-white/10 to-transparent shadow-[0_10px_40px_rgba(0,0,0,0.5)]\">\n                    <div class=\"bg-[#0c0c0e]/90 backdrop-blur-xl rounded-full px-6 py-3 flex items-center gap-8 border border-white/5\">\n                        <button class=\"text-white/40 hover:text-white transition-colors\">\n                            <iconify-icon icon=\"solar:widget-linear\" width=\"22\"></iconify-icon>\n                        </button>\n                        <button class=\"w-10 h-10 flex items-center justify-center bg-[#a3e635] text-black rounded-full shadow-[0_0_20px_rgba(163,230,53,0.3)]\">\n                            <iconify-icon icon=\"solar:wallet-linear\" width=\"20\"></iconify-icon>\n                        </button>\n                        <button class=\"text-white/40 hover:text-white transition-colors\">\n                            <iconify-icon icon=\"solar:user-linear\" width=\"22\"></iconify-icon>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- SCREEN 2: Activity List (Moved to Center) -->\n        <div class=\"relative w-[340px] h-[740px] rounded-[40px] bg-white/[0.03] backdrop-blur-[12px] shadow-[0_4px_30px_rgba(0,0,0,0.5)] overflow-hidden flex flex-col shrink-0 border border-white/[0.05]\">\n            <!-- Gradient Border Overlay -->\n            <div class=\"absolute inset-0 pointer-events-none rounded-[40px] border border-transparent\" style=\"background: linear-gradient(180deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.01) 20%, transparent 100%) border-box; -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0); -webkit-mask-composite: destination-out; mask-composite: exclude;\"></div>\n\n            <!-- Header -->\n            <div class=\"flex items-center justify-between px-6 pt-12 pb-6 relative z-10\">\n                <button class=\"text-white/70 hover:text-white transition-colors\">\n                    <iconify-icon icon=\"solar:alt-arrow-left-linear\" width=\"24\" stroke-width=\"1.5\"></iconify-icon>\n                </button>\n                <span class=\"text-xs uppercase tracking-wider text-white/50 font-normal\">Activity Log</span>\n                <button class=\"text-white/70 hover:text-white transition-colors\">\n                    <iconify-icon icon=\"solar:magnifer-linear\" width=\"24\" stroke-width=\"1.5\"></iconify-icon>\n                </button>\n            </div>\n\n            <!-- Account Pill -->\n            <div class=\"flex justify-center mb-8 relative z-10\">\n                <button class=\"bg-white/[0.05] border border-white/[0.1] text-white/90 rounded-full px-5 py-2.5 flex items-center gap-3 hover:bg-white/[0.08] transition-colors\">\n                    <div class=\"w-2 h-2 rounded-full bg-[#a3e635] shadow-[0_0_8px_rgba(163,230,53,0.6)]\"></div>\n                    <span class=\"text-xs font-normal tracking-wide\">Main Wallet</span>\n                    <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"16\" class=\"text-white/40\"></iconify-icon>\n                </button>\n            </div>\n\n            <!-- Scrollable Log -->\n            <div class=\"flex-1 overflow-y-auto px-5 pb-8 relative z-10\" style=\"scrollbar-width: none; -ms-overflow-style: none;\">\n\n                <!-- Section: Today -->\n                <div class=\"text-xs uppercase tracking-wider text-white/30 font-normal mb-4 ml-2\">Today</div>\n\n                <div class=\"bg-white/[0.02] border border-white/[0.04] rounded-[20px] p-4 flex items-center justify-between mb-3 hover:bg-white/[0.04] transition-colors\">\n                    <div class=\"flex items-center gap-4\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/4f5668c5-fc4a-44e0-bc5e-a664189d3c31_800w.jpg\" alt=\"Elena\" class=\"w-10 h-10 rounded-full object-cover grayscale opacity-90 border border-white/10\">\n                        <div>\n                            <div class=\"text-sm font-normal text-white/90 tracking-wide\">Elena Rostova</div>\n                            <div class=\"text-xs text-white/40 flex items-center gap-1 mt-1 font-light\">\n                                Received <iconify-icon icon=\"solar:arrow-left-down-linear\" width=\"12\" class=\"text-[#a3e635]\"></iconify-icon>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"text-[#a3e635] text-sm font-normal tracking-wide\">+$4,250</div>\n                </div>\n\n                <div class=\"bg-white/[0.02] border border-white/[0.04] rounded-[20px] p-4 flex items-center justify-between mb-8 hover:bg-white/[0.04] transition-colors\">\n                    <div class=\"flex items-center gap-4\">\n                        <div class=\"w-10 h-10 rounded-full bg-white/[0.05] border border-white/[0.1] flex items-center justify-center text-white/70\">\n                            <iconify-icon icon=\"solar:buildings-linear\" width=\"18\"></iconify-icon>\n                        </div>\n                        <div>\n                            <div class=\"text-sm font-normal text-white/90 tracking-wide\">Kraken Exchange</div>\n        