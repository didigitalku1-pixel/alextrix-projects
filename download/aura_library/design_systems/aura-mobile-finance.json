roke-dasharray: 400; stroke-dashoffset: 400;\"/>\n                    </svg>\n                </div>\n            </div>\n\n            <!-- Quick Actions -->\n            <div class=\"flex justify-between px-8 mt-10 relative z-10\">\n                <button class=\"flex flex-col items-center group\">\n                    <div class=\"w-12 h-12 rounded-[16px] bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-white/80 group-hover:bg-[#a3e635] group-hover:text-black group-hover:border-[#a3e635] transition-all duration-300\">\n                        <iconify-icon icon=\"solar:arrow-right-up-linear\" width=\"20\"></iconify-icon>\n                    </div>\n                    <span class=\"text-xs font-normal text-white/50 mt-3 tracking-wide\">Send</span>\n                </button>\n                <button class=\"flex flex-col items-center group\">\n                    <div class=\"w-12 h-12 rounded-[16px] bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-white/80 group-hover:bg-[#a3e635] group-hover:text-black group-hover:border-[#a3e635] transition-all duration-300\">\n                        <iconify-icon icon=\"solar:card-transfer-linear\" width=\"20\"></iconify-icon>\n                    </div>\n                    <span class=\"text-xs font-normal text-white/50 mt-3 tracking-wide\">Swap</span>\n                </button>\n                <button class=\"flex flex-col items-center group\">\n                    <div class=\"w-12 h-12 rounded-[16px] bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-white/80 group-hover:bg-[#a3e635] group-hover:text-black group-hover:border-[#a3e635] transition-all duration-300\">\n                        <iconify-icon icon=\"solar:arrow-left-down-linear\" width=\"20\"></iconify-icon>\n                    </div>\n                    <span class=\"text-xs font-normal text-white/50 mt-3 tracking-wide\">Receive</span>\n                </button>