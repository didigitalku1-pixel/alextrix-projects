  <iconify-icon icon=\"solar:minus-linear\" width=\"22\" height=\"22\" class=\"group-active:scale-90 transition-transform\"></iconify-icon>\n                    </button>\n\n                    <!-- The Dial -->\n                    <div class=\"relative w-[340px] h-[340px] flex items-center justify-center rounded-full bg-[#FCFBF8] border-8 border-[#F5F3EC]\" style=\"box-shadow: inset 0 4px 16px rgba(180, 170, 160, 0.15), 0 16px 40px -10px rgba(180, 170, 160, 0.2);\">\n\n                        <!-- Outer Labels -->\n                        <span class=\"absolute left-[-30px] text-xs font-normal text-stone-400\">65°</span>\n                        <span class=\"absolute top-[-20px] text-xs font-medium text-orange-500\">72°</span>\n                        <span class=\"absolute right-[-30px] text-xs font-normal text-stone-400\">80°</span>\n\n                        <!-- SVG Track & Arc -->\n                        <svg class=\"absolute inset-0 w-full h-full -rotate-90 pointer-events-none\" viewBox=\"0 0 340 340\">\n                            <!-- Soft background circle -->\n                            <circle cx=\"170\" cy=\"170\" r=\"140\" fill=\"none\" stroke=\"#EBE8DF\" stroke-width=\"6\" stroke-linecap=\"round\" />\n\n                            <!-- Gradient Definition -->\n                            <defs>\n                                <linearGradient id=\"orangeGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                                    <stop offset=\"0%\" stop-color=\"#fb923c\" /> <!-- orange-400 -->\n                                    <stop offset=\"100%\" stop-color=\"#ea580c\" /> <!-- orange-600 -->\n                                </linearGradient>\n                                <filter id=\"glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n                                    <feGaussianBlur stdDeviation=\"8\" result=\"blur\" />\n                                    <feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\" />\n                                </filter>\n                            </defs>\n\n                            <!-- Colored Value Arc -->\n                            <path d=\"M 170 30 A 140 140 0 1 1 50 240\" fill=\"none\" stroke=\"url(#orangeGradient)\" stroke-width=\"6\" stroke-linecap=\"round\" />\n                        </svg>\n\n                        <!-- Thumb / Current Position Dot -->\n                        <div class=\"absolute top-[88px] -left-[8px] w-8 h-8 bg-white rounded-full flex items-center justify-center border border-stone-200 z-20 cursor-grab active:cursor-grabbing\" style=\"box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3);\">\n                            <div class=\"w-2.5 h-2.5 bg-orange-500 rounded-full\"></div>\n                        </div>\n\n                        <!-- Center Elevated Circle -->\n                        <div class=\"relative w-56 h-56 rounded-full bg-white flex flex-col items-center justify-center z-10 border border-stone-100\" style=\"box-shadow: 0 20px 40px -10px rgba(180, 170, 160, 0.3), inset 0 2px 4px rgba(255,255,255,1);\">\n                            <span class=\"text-xs font-normal text-stone-400 tracking-wider uppercase mb-1\">Set Point</span>\n                            <div class=\"flex items-start\">\n                                <span class=\"text-6xl font-normal tracking-tight text-stone-800\">72</span>\n                                <span class=\"text-2xl font-normal text-stone-400 mt-2 ml-1\">°F</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Plus Button -->\n                    <button class=\"w-14 h-14 rounded-full bg-white flex items-center justify-center text-stone-400 hover:text-orange-500 transition-colors z-10 group border border-stone-200/80 hover:border-orange-200 hover:bg-orange-50/50\" style=\"box-shadow: 0 8px 24px -6px rgba(180, 170, 160, 0.3);\">\n                        <iconify-icon icon=\"solar:add-linear\" width=\"22\" height=\"22\" class=\"group-active:scale-90 transition-transform\"></iconify-icon>\n                    </button>\n                </div>\n\n                <!-- Bottom Status -->\n                <div class=\"absolute bottom-2 flex flex-col items-center gap-3\">\n                    <div class=\"w-10 h-10 rounded-full bg-white flex items-center justify-center text-stone-400 shadow-sm border border-stone-200 cursor-pointer hover:bg-stone-50 transition-colors\" style=\"box-shadow: 0 4px 12px -2px rgba(180, 170, 160, 0.2);\">\n                        <iconify-icon icon=\"solar:pause-linear\" width=\"18\" height=\"18\"></iconify-icon>\n                    </div>\n                    <span class=\"text-xs font-normal text-stone-400\">Reaching target in 12m</span>\n                </div>\n            </div>\n\n            <!-- Bottom Chart -->\n            <div class=\"h-40 mt-auto w-full animate-item\">\n                <h3 class=\"text-xs tracking-wider text-stone-400 font-medium mb-6 uppercase\">Thermal History</h3>\n\n                <div class=\"flex items-end justify-between h-20 gap-3\">\n                    <!-- Chart Bars -->\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[20%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">19</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[35%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">20</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[45%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">21</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[30%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">22</span></div>\n\n                    <!-- Active Main Bar -->\n                    <div class=\"chart-bar w-full bg-orange-500 rounded-t-md h-[85%] relative cursor-pointer\" style=\"box-shadow: 0 8px 16px -4px rgba(249, 115, 22, 0.4);\">\n                        <span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-orange-600 font-medium\">23</span>\n                    </div>\n\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[60%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">24</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[40%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">25</span></div>\n\n                    <!-- Active Secondary Bar -->\n                    <div class=\"chart-bar w-full bg-orange-300 rounded-t-md h-[35%] relative cursor-pointer\" style=\"box-shadow: 0 8px 16px -4px rgba(253, 186, 116, 0.4);\">\n                        <span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-500 font-medium\">26</span>\n                    </div>\n\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[55%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">27</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[65%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">28</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[40%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">29</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[50%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\"><span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">30</span></div>\n                    <div class=\"chart-bar w-full bg-[#EAE6DB] rounded-t-md h-[30%] relative group cursor-pointer hover:bg-[#DFD9CE] transition-colors\">\n                        <div class=\"absolute -top-2.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-stone-300 rounded-full\"></div>\n                        <span class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-stone-400 font-normal\">31</span>\n                    </div>\n                </div>\n            </div>\n\n        </section>\n\n        <!-- Right Panel - Product Illustration Zone -->\n        <aside class=\"w-[380px] bg-[#F5F2EC] border-l border-stone-200/50 p-10 flex flex-col gap-10 shrink-0 relative z-10\">\n            <!-- Subtle gradient overlay for depth -->\n            <div class=\"absolute inset-0 bg-gradient-to-b from-white/40 to-transparent pointer-events-none\"></div>\n\n            <!-- Key Functions Cards -->\n            <div class=\"animate-item relative z-10\">\n                <div class=\"flex items-center justify-between mb-6 cursor-pointer group\">\n                    <h3 class=\"text-xs tracking-wider text-stone-400 font-medium uppercase group-hover:text-stone-600 transition-colors\">Key Functions</h3>\n                    <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"16\" height=\"16\" class=\"text-stone-400\"></iconify-icon>\n                </div>\n\n                <div class=\"flex flex-col gap-4 relative\">\n                    <!-- Floating Card 1 -->\n                    <div class=\"floating-card flex items-center gap-4 bg-white p-4 rounded-2xl cursor-pointer border border-stone-100 hover:border-orange-200 transition-colors\" style=\"box-shadow: 0 12px 32px -8px rgba(180, 170, 160, 0.4);\">\n                        <div class=\"w-12 h-12 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center border border-orange-100\">\n                            <iconify-icon icon=\"solar:thermometer-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                        </div>\n                        <div class=\"flex-1\">\n                            <h4 class=\"text-sm font-medium text-stone-800\">HVAC System</h4>\n                            <p class=\"text-xs text-stone-400 mt-0.5\">Actively maintaining 72°F</p>\n                        </div>\n                        <div class=\"w-2 h-2 rounded-full bg-orange-500 animate-pulse\"></div>\n                    </div>\n\n                    <!-- Floating Card 2 -->\n                    <div class=\"floating-card flex items-center gap-4 bg-white p-4 rounded-2xl cursor-pointer border border-stone-100 hover:border-stone-300 transition-colors\" style=\"box-shadow: 0 8px 24px -8px rgba(180, 170, 160, 0.2);\">\n                        <div class=\"w-12 h-12 rounded-xl bg-[#F4F2EC] text-stone-500 flex items-center justify-center border border-stone-200\">\n                            <iconify-icon icon=\"solar:wi-fi-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                        </div>\n                        <div>\n                            <h4 class=\"text-sm font-medium text-stone-800\">Router Status</h4>\n                            <p class=\"text-xs text-stone-400 mt-0.5\">Optimal connection</p>\n                        </div>\n                    </div>\n\n                    <!-- Floating Card 3 -->\n                    <div class=\"floating-card flex items-center gap-4 bg-white p-4 rounded-2xl cursor-pointer border border-stone-100 hover:border-stone-300 transition-colors\" style=\"box-shadow: 0 8px 24px -8px rgba(180, 170, 160, 0.2);\">\n                        <div class=\"w-12 h-12 rounded-xl bg-[#F4F2EC] text-stone-500 flex items-center justify-center border border-stone-200\">\n                            <iconify-icon icon=\"solar:lightbulb-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                        </div>\n                        <div>\n                            <h4 class=\"text-sm font-medium text-stone-800\">Lighting Array</h4>\n                            <p class=\"text-xs text-stone-400 mt-0.5\">4 units active in zone</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Connected Hardware Grid -->\n            <div class=\"animate-item relative z-10\">\n                <div class=\"flex items-center justify-between mb-6 cursor-pointer group\">\n                    <h3 class=\"text-xs tracking-wider text-stone-400 font-medium uppercase group-hover:text-stone-600 transition-colors\">Connected Hardware</h3>\n                    <iconify-icon icon=\"solar:alt-arrow-right-linear\" width=\"16\" height=\"16\" class=\"text-stone-400\"></iconify-icon>\n                </div>\n\n                <div class=\"grid grid-cols-4 gap-3\">\n                    <!-- Active Hardware -->\n                    <div class=\"aspect-square rounded-[18px] bg-white border border-orange-200 flex flex-col items-center justify-center text-orange-500 cursor-pointer hover:bg-orange-50 transition-colors relative\" style=\"box-shadow: 0 4px 12px rgba(249, 115, 22, 0.1);\">\n                        <iconify-icon icon=\"solar:washing-machine-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                        <div class=\"absolute top-2 right-2 w-1.5 h-1.5 bg-orange-500 rounded-full\"></div>\n                    </div>\n\n                    <!-- Hardware Items -->\n                    <div class=\"aspect-square rounded-[18px] bg-white border border-stone-200/60 flex flex-col items-center justify-center text-stone-400 cursor-pointer hover:border-stone-300 transition-colors relative shadow-sm\">\n                        <iconify-icon icon=\"solar:fridge-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                    </div>\n\n                    <div class=\"aspect-square rounded-[18px] bg-white border border-stone-200/60 flex flex-col items-center justify-center text-stone-400 cursor-pointer hover:border-stone-300 transition-colors relative shadow-sm\">\n                        <iconify-icon icon=\"solar:monitor-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                    </div>\n\n                    <div class=\"aspect-square rounded-[18px] bg-white border border-stone-200/60 flex flex-col items-center justify-center text-stone-400 cursor-pointer hover:border-stone-300 transition-colors relative shadow-sm\">\n                        <iconify-icon icon=\"solar:air-conditioner-linear\" width=\"24\" height=\"24\"></iconify-icon>\n                    </div>\n\n                    <!-- Add New -->\n                    <div class=\"aspect-square rounded-[18px] border-2 border-dashed border-stone-200 text-stone-400 flex items-center justify-center cursor-pointer hover:border-stone-300 hover:text-stone-500 transition-colors bg-transparent\">\n                        <iconify-icon icon=\"solar:add-linear\" width=\"20\" height=\"20\"></iconify-icon>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Bottom Action -->\n            <div class=\"mt-auto animate-item relative z-10\">\n                <button class=\"w-full py-4 rounded-xl bg-orange-500 text-white text-sm font-medium hover:bg-orange-600 transition-colors border border-orange-600/20\" style=\"box-shadow: 0 8px 24px -4px rgba(249, 115, 22, 0.3);\">\n                    Configure Property Zones\n                </button>\n            </div>\n\n        </aside>\n    </main>\n\n    <!-- Interactions & Motion -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            const tl = gsap.timeline({ defaults: { ease: \"power3.out\" } });\n\n            // Animate ambient background\n            gsap.to(\".ambient-blob\", {\n                x: \"random(-40, 40)\",\n                y: \"random(-40, 40)\",\n                duration: 8,\n                repeat: -1,\n                yoyo: true,\n                ease: \"sine.inOut\",\n                stagger: 2\n            });\n\n            // App shell entrance\n            tl.from(\".ui-container\", {\n                y: 30,\n                opacity: 0,\n                duration: 1.2,\n                clearProps: \"all\"\n            })\n            // Sidebar icons\n            .from(\".nav-item\", {\n                x: -15,\n                opacity: 0,\n                duration: 0.5,\n                stagger: 0.08\n            }, \"-=0.8\")\n            // Main content cascade\n            .from(\".animate-item\", {\n                y: 15,\n                opacity: 0,\n                duration: 0.7,\n                stagger: 0.1\n            }, \"-=0.6\")\n            // Chart bars reveal\n            .from(\".chart-bar\", {\n                height: 0,\n                duration: 0.8,\n                stagger: 0.04,\n                ease: \"back.out(1.1)\"\n            }, \"-=0.4\")\n            // Floating cards staggered entrance & continuous float\n            .from(\".floating-card\", {\n                y: 20,\n                opacity: 0,\n                duration: 0.8,\n                stagger: 0.1,\n                onComplete: () => {\n                    gsap.to(\".floating-card\", {\n                        y: -4,\n                        duration: 3,\n                        repeat: -1,\n                        yoyo: true,\n                        ease: \"sine.inOut\",\n                        stagger: 0.2\n                    });\n                }\n            }, \"-=0.6\");\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "environment-settings.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/environment-settings.jpg", "source_name": "environment-settings-DESIGN.md", "views": 327, "forks": 13, "private": false, "featured": true, "created_by": "2e815afb-cac1-4c01-90e1-cf3810246e35", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T19:06:18.287388+00:00"}