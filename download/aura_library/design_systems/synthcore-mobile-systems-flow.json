ative mt-8 rounded-[22px] overflow-visible\">\n                        <svg class=\"absolute inset-0 w-full h-full overflow-visible\" viewBox=\"0 0 100 40\" preserveAspectRatio=\"none\">\n                            <path d=\"M0,35 C15,30 25,35 40,20 C55,5 75,15 100,5 L100,40 L0,40 Z\" fill=\"url(#glow)\" opacity=\"0.08\" />\n                            <path d=\"M0,35 C15,30 25,35 40,20 C55,5 75,15 100,5\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1.15\" stroke-opacity=\"0.86\" stroke-linecap=\"round\" stroke-linejoin=\"round\" vector-effect=\"non-scaling-stroke\" />\n                            <defs>\n                                <linearGradient id=\"glow\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                                    <stop offset=\"0%\" stop-color=\"#ffffff\" stop-opacity=\"0.55\" />\n                                    <stop offset=\"100%\" stop-color=\"#ffffff\" stop-opacity=\"0\" />\n                                </linearGradient>\n                            </defs>\n                            <!-- Data Points -->\n                            <circle cx=\"100\" cy=\"5\" r=\"1.8\" fill=\"#050505\" stroke=\"#ffffff\" stroke-width=\"1.1\" stroke-opacity=\"0.9\" vector-effect=\"non-scaling-stroke\" />\n                            <circle cx=\"40\" cy=\"20\" r=\"2.2\" fill=\"#050505\" stroke=\"#ffffff\" stroke-width=\"1.15\" stroke-opacity=\"0.9\" vector-effect=\"non-scaling-stroke\" />\n                        </svg>\n\n                        <!-- Tooltip overlay -->\n                        <div class=\"absolute top-2 bottom-3 left-[40%] w-px bg-white/10 border-l border-dashed border-white/10\"></div>\n                        <div class=\"absolute top-[-18px] left-[40%] -translate-x-1/2 bg-[#121212]/95 text-white text-[11px] font-medium px-2 py-1 rounded-full border border-white/[0.08] shadow-[0_8px_20px_rgba(0,0,0,0.35)] backdrop-blur-md\">\n                            84.2%\n                        </div>\n                    </div>\n