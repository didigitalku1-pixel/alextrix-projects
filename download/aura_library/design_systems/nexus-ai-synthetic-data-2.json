              </div>\n\n                    </main>\n                </div>\n            </div>\n        </section>\n\n        <!-- Logo Cloud Section -->\n        <section class=\"relative border-b border-brand-border grid grid-cols-2 md:grid-cols-5\">\n            <!-- Bottom Border Intersection Nodes -->\n            <div class=\"absolute -bottom-[3px] -left-[3px] w-[5px] h-[5px] bg-brand-bg border border-brand-border z-20\"></div>\n            <div class=\"absolute -bottom-[3px] -right-[3px] w-[5px] h-[5px] bg-brand-bg border border-brand-border z-20\"></div>\n\n            <div class=\"py-8 flex justify-center items-center border-r border-b md:border-b-0 border-brand-border text-brand-muted hover:text-black transition-colors grayscale hover:grayscale-0 gap-2 font-mono text-sm font-medium\">\n                <iconify-icon icon=\"solar:box-minimalistic-broken\" class=\"text-2xl\"></iconify-icon> Voxel Labs\n            </div>\n            <div class=\"py-8 flex justify-center items-center border-r border-b md:border-b-0 border-brand-border text-brand-muted hover:text-black transition-colors grayscale hover:grayscale-0 gap-2 font-mono text-sm font-medium\">\n                <iconify-icon icon=\"solar:infinity-broken\" class=\"text-2xl\"></iconify-icon> Warpspeed\n            </div>\n            <div class=\"py-8 flex justify-center items-center border-r border-b md:border-b-0 border-brand-border text-brand-muted hover:text-black transition-colors grayscale hover:grayscale-0 gap-2 font-mono text-sm font-medium\">\n                <iconify-icon icon=\"solar:layers-broken\" class=\"text-2xl\"></iconify-icon> Mastermail\n            </div>\n            <div class=\"py-8 flex justify-center items-center border-r border-b md:border-b-0 border-brand-border text-brand-muted hover:text-black transition-colors grayscale hover:grayscale-0 gap-2 font-mono text-sm font-medium\">\n                <iconify-icon icon=\"solar:routing-2-broken\" class=\"text-2xl\"></iconify-icon> Leapyear\n            </div>\n            <div class=\"py-8 flex justify-center items-center text-brand-muted hover:text-black transition-colors grayscale hover:grayscale-0 gap-2 font-mono text-sm font-medium\">\n                <iconify-icon icon=\"solar:moon-broken\" class=\"text-2xl\"></iconify-icon> Lightspeed\n            </div>\n        </section>\n\n        <!-- Bottom Feature Section -->\n        <section class=\"relative py-32 px-6 flex flex-col items-center text-center\">\n            <h2 class=\"masked-reveal font-mono font-light text-3xl md:text-5xl tracking-tight leading-tight max-w-2xl text-black\">\n                Your Ultimate AI Training Partner Handles Everything\n            </h2>\n        </section>\n\n    </main>\n\n    <script>\n        // GSAP Masked Word Reveal\n        gsap.registerPlugin(ScrollTrigger);\n\n        const revealElements = document.querySelectorAll('.masked-reveal');\n\n        revealElements.forEach(element => {\n            // Store original HTML if needed, but here we process text content\n            // Need to handle <br> tags carefully.\n            const htmlContent = element.innerHTML;\n            element.innerHTML = '';\n\n            // Basic text splitting preserving <br> for simple layouts\n            const parts = htmlContent.split(/(<br\\s*\\/?>)/i);\n\n            parts.forEach(part => {\n                if (part.toLowerCase().includes('<br')) {\n                    element.appendChild(document.createElement('br'));\n                } else if (part.trim() !== '') {\n                    const words = part.split(' ');\n                    words.forEach(word => {\n                        if(word.trim() === '') {\n                            element.appendChild(document.createTextNode(' '));\n                            return;\n                        }\n\n                        // Create mask container\n                        const wrapper = document.createElement('span');\n                        wrapper.style.display = 'inline-flex';\n                        wrapper.style.overflow = 'hidden';\n                        wrapper.style.verticalAlign = 'top';\n                        wrapper.style.marginRight = '0.25em'; // standard space\n\n                        // Create inner animated element\n                        const inner = document.createElement('span');\n                        inner.style.display = 'inline-block';\n                        inner.innerHTML = word;\n\n                        wrapper.appendChild(inner);\n                        element.appendChild(wrapper);\n                    });\n                }\n            });\n\n            // Animate\n            const innerSpans = element.querySelectorAll('span > span');\n            gsap.fromTo(innerSpans,\n                { y: '120%' },\n                {\n                    y: '0%',\n                    stagger: 0.04,\n                    duration: 0.8,\n                    ease: 'power3.out',\n                    scrollTrigger: {\n                        trigger: element,\n                        start: 'top 85%',\n                        toggleActions: 'play none none reverse'\n                    }\n                }\n            );\n        });\n\n        // Lightweight Canvas Fluid Background (WebGL effect fallback)\n        const canvas = document.getElementById('mesh-gradient');\n        const ctx = canvas.getContext('2d');\n        let time = 0;\n\n        function resize() {\n            canvas.width = window.innerWidth;\n            canvas.height = window.innerHeight;\n        }\n        window.addEventListener('resize', resize);\n        resize();\n\n        function drawBlob(x, y, radius, color) {\n            ctx.beginPath();\n            ctx.arc(x, y, radius, 0, Math.PI * 2);\n            ctx.fillStyle = color;\n            ctx.fill();\n        }\n\n        function animate() {\n            time += 0.005;\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n            // Global composite operation to blend colors nicely\n            ctx.globalCompositeOperation = 'screen';\n            ctx.filter = 'blur(100px)';\n\n            const w = canvas.width;\n            const h = canvas.height;\n\n            // Moving colored blobs\n            drawBlob(\n                w * 0.3 + Math.sin(time) * w * 0.2,\n                h * 0.4 + Math.cos(time * 0.8) * h * 0.2,\n                w * 0.4,\n                'rgba(220, 220, 200, 0.8)' // Cream highlight\n            );\n\n            drawBlob(\n                w * 0.7 + Math.cos(time * 1.2) * w * 0.2,\n                h * 0.6 + Math.sin(time * 0.9) * h * 0.2,\n                w * 0.4,\n                'rgba(200, 210, 220, 0.6)' // Subtle blue/grey\n            );\n\n            requestAnimationFrame(animate);\n        }\n        animate();\n    </script>\n\n</body></html>", "preview_file_name": "nexus-ai-synthetic-data-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexus-ai-synthetic-data-2.jpg", "source_name": "nexus-ai-synthetic-data-2-DESIGN.md", "views": 185, "forks": 8, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T19:30:32.642241+00:00"}