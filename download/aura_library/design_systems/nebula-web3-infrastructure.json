xt-sm font-medium hover:bg-gray-100 hover:scale-105 transition-all duration-300 shadow-[0_0_20px_rgba(255,255,255,0.2)]\">\n                Start Building\n            </button>\n\n            <!-- Spacer to align bottom text visually under the background silver box -->\n            <div class=\"flex-grow min-h-[15vh] lg:min-h-[22vh]\"></div>\n\n            <!-- Secondary Detail Text (Positioned over lower black mask) -->\n            <div class=\"mb-24 lg:mb-32 flex flex-col items-center max-w-[260px] opacity-80 hover:opacity-100 transition-opacity duration-500\">\n                <p class=\"text-xs text-white/50 text-center leading-relaxed\">\n                    Unified platform for smart contract deployment and global network analytics.\n                </p>\n                <a href=\"#\" class=\"text-xs text-white/80 underline underline-offset-4 mt-3 hover:text-white transition-colors duration-200\">\n                    View Documentation\n                </a>\n            </div>\n\n        </main>\n\n        <!-- Integration Logos Footer -->\n        <footer class=\"w-full py-8 border-t border-white/5 flex flex-wrap justify-center lg:justify-between items-center gap-8 opacity-50 hover:opacity-100 transition-opacity duration-700 mt-auto\">\n\n            <div class=\"flex items-center gap-1.5 font-semibold text-lg tracking-tight hover:text-white transition-colors cursor-default\">\n                <iconify-icon icon=\"solar:branching-paths-up-linear\" class=\"text-xl\"></iconify-icon>\n                <span>git</span>\n            </div>\n\n            <div class=\"flex items-center gap-1.5 font-semibold text-xl tracking-widest lowercase hover:text-white transition-colors cursor-default\">\n                <iconify-icon icon=\"solar:box-minimalistic-linear\" class=\"text-lg\"></iconify-icon>\n                <span>npm</span>\n            </div>\n\n            <div class=\"flex items-center gap-1.5 font-medium text-sm hover:text-white transition-colors cursor-d