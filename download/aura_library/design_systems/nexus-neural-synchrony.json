                         <div class=\"absolute top-[1px] right-[1px] w-3 h-3 rounded-full bg-synapse shadow-[0_0_5px_rgba(168,85,247,0.8),inset_0_1px_1px_rgba(255,255,255,0.4)] transition-transform group-hover/toggle:scale-110\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </article>\n\n        <!-- Module 3: Primary Node (Center Main) -->\n        <article class=\"card-wrapper absolute top-1/2 left-1/2 pointer-events-auto opacity-0 z-30\" data-x=\"-40\" data-y=\"60\" data-r=\"-1\" data-depth=\"0.9\">\n            <div class=\"group relative transition-transform duration-700 ease-out hover:scale-[1.01]\">\n                <!-- High-Tier Border Shell -->\n                <div class=\"p-px rounded-[24px] bg-gradient-to-b from-synapse/40 via-white/10 to-transparent shadow-[0_30px_60px_-15px_rgba(0,0,0,0.9),0_0_40px_-10px_rgba(168,85,247,0.15)] relative\">\n                    <!-- Absolute glowing backdrop -->\n                    <div class=\"absolute inset-0 bg-synapse/20 blur-3xl -z-10 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-1000\"></div>\n\n                    <div class=\"w-80 p-6 rounded-[24px] bg-surface/95 backdrop-blur-3xl shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),inset_0_-2px_4px_rgba(0,0,0,0.9)] border border-white/[0.05] relative overflow-hidden flex flex-col gap-6\">\n                        <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(168,85,247,0.1),transparent_80%)] pointer-events-none\"></div>\n\n                        <!-- L-Bracket Etchings inside -->\n                        <div class=\"absolute top-4 left-4 w-2 h-2 border-t border-l border-white/20\"></div>\n                        <div class=\"absolute top-4 right-4 w-2 h-2 border-t border-r border-white/20\"></div>\n                        <div class=\"absolute bottom-4 left-4 w-2 h-2 border-b border-l border-white/20\"></div>\n                        <div class=\"absolute bottom-4 right-4 w-2 h-2 border-b border-r border-white/20\"></div>\n\n                        <!-- Top row -->\n                        <div class=\"flex justify-between items-start relative z-10 px-2\">\n                            <div class=\"flex items-center gap-3\">\n                                <div class=\"w-8 h-8 rounded-full bg-black shadow-[inset_0_1px_2px_rgba(255,255,255,0.1),0_0_10px_rgba(168,85,247,0.2)] flex items-center justify-center border border-white/10\">\n                                    <iconify-icon icon=\"solar:network-linear\" stroke-width=\"1.5\" class=\"text-synapse text-lg\"></iconify-icon>\n                                </div>\n                                <span class=\"font-mono text-xs text-synapse tracking-[0.2em]\">CORTEX_M9</span>\n                            </div>\n                            <div class=\"px-2 py-0.5 rounded border border-synapse/30 bg-synapse/10 text-xs font-mono text-white tracking-widest shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)]\">SYNCHED</div>\n                        </div>\n\n                        <!-- Hero Image Deep Inset -->\n                        <div class=\"w-full h-32 rounded-xl bg-black border border-white/10 shadow-[inset_0_5px_15px_rgba(0,0,0,0.9)] overflow-hidden relative z-10\">\n                            <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/724142aa-44a6-48d3-9cf3-761e00d05b78_800w.jpg\" alt=\"Structure\" class=\"w-full h-full object-cover mix-blend-screen opacity-70\" style=\"filter: grayscale(1) sepia(1) hue-rotate(240deg) saturate(3) brightness(0.9);\">\n                            <!-- Scanline overlay -->\n                            <div class=\"absolute inset-0 bg-[linear-gradient(transparent_50%,rgba(0,0,0,0.5)_50%)] bg-[length:100%_4px] pointer-events-none opacity-30\"></div>\n                        </div>\n\n                        <!-- Action -->\n                        <div class=\"relative z-10\">\n                            <button class=\"w-full py-2.5 rounded-lg bg-white/5 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_6px_-1px_rgba(0,0,0,0.5)] hover:bg-white/10 hover:shadow-[0_0_15px_rgba(255,255,255,0.1)] transition-all flex items-center justify-center gap-2\">\n                                <span class=\"font-sans font-medium text-sm text-white drop-shadow-md tracking-tight\">Initiate Sync</span>\n                                <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-neutral-400\"></iconify-icon>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </article>\n\n        <!-- Module 4: Architecture Log (Bottom Left) -->\n        <article class=\"card-wrapper absolute top-1/2 left-1/2 pointer-events-auto opacity-0\" data-x=\"-220\" data-y=\"240\" data-r=\"2\" data-depth=\"0.7\">\n            <div class=\"group relative transition-transform duration-700 ease-out hover:scale-[1.02]\">\n                <div class=\"p-px rounded-[16px] bg-gradient-to-b from-white/10 via-white/5 to-transparent shadow-[0_20px_40px_-10px_rgba(0,0,0,0.8)]\">\n                    <div class=\"w-60 p-4 rounded-[16px] bg-surface/90 backdrop-blur-xl shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),inset_0_-1px_2px_rgba(0,0,0,0.8)] border border-transparent relative\">\n                        <div class=\"flex justify-between items-start mb-3\">\n                            <iconify-icon icon=\"solar:history-linear\" stroke-width=\"1.5\" class=\"text-neutral-400 text-xl drop-shadow-[0_1px_1px_rgba(0,0,0,0.8)]\"></iconify-icon>\n                            <span class=\"font-mono text-xs text-neutral-500 uppercase\">Entry . 108</span>\n                        </div>\n                        <h4 class=\"text-sm font-medium text-white mb-1 drop-shadow-md tracking-tight\">Synaptic Topology</h4>\n                        <p class=\"text-xs font-light text-neutral-400 leading-relaxed mb-4\">Neural mesh stabilizing within nominal cognitive bounds across active sectors.</p>\n\n                        <!-- Checkbox custom -->\n                        <label class=\"flex items-center gap-3 cursor-pointer group/chk\">\n                            <div class=\"w-4 h-4 rounded border border-white/20 bg-black/60 shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)] flex items-center justify-center transition-colors group-hover/chk:border-synapse/50\">\n                                <div class=\"w-2 h-2 rounded-sm bg-synapse shadow-[0_0_5px_rgba(168,85,247,0.8)] transition-transform scale-100 group-active/chk:scale-90\"></div>\n                            </div>\n                            <span class=\"font-mono text-xs text-neutral-300\">VERIFY HASH</span>\n                        </label>\n                    </div>\n                </div>\n            </div>\n        </article>\n\n        <!-- Module 5: Graph Asset (Right Center) -->\n        <article class=\"card-wrapper absolute top-1/2 left-1/2 pointer-events-auto opacity-0\" data-x=\"180\" data-y=\"120\" data-r=\"-5\" data-depth=\"0.5\">\n            <div class=\"group relative transition-transform duration-700 ease-out hover:scale-[1.02]\">\n                <div class=\"p-px rounded-[20px] bg-gradient-to-br from-white/10 to-transparent shadow-[0_15px_30px_-5px_rgba(0,0,0,0.9)]\">\n                    <div class=\"w-52 h-52 rounded-[20px] bg-surface/80 backdrop-blur-md p-1 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] border border-transparent\">\n                        <div class=\"w-full h-full rounded-[16px] overflow-hidden relative border border-white/10 shadow-[inset_0_2px_10px_rgba(0,0,0,0.8)] group-hover:border-white/20 transition-colors\">\n                            <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/bfef5098-c30f-4cd9-b4ac-04b2673ab943_800w.jpg\" alt=\"Abstract Asset\" class=\"w-full h-full object-cover mix-blend-luminosity opacity-50 transition-opacity group-hover:opacity-70\" style=\"filter: grayscale(1) sepia(1) hue-rotate(240deg) saturate(2);\">\n                            <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-90\"></div>\n                            <div class=\"absolute bottom-3 left-3 right-3 flex justify-between items-end\">\n                                <div>\n                                    <div class=\"font-mono text-xs text-synapse mb-0.5 tracking-widest\">NODE</div>\n                                    <div class=\"text-xs font-medium text-white tracking-tight\">Engram.Schematic</div>\n                                </div>\n                                <div class=\"w-6 h-6 rounded-full bg-white/10 backdrop-blur border border-white/20 flex items-center justify-center shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)]\">\n                                    <iconify-icon icon=\"solar:maximize-square-linear\" class=\"text-white text-xs\"></iconify-icon>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </article>\n\n    </main>\n\n    <!-- WebGL & Interaction Scripts -->\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            // --- 1. Aura Isometric Visualization System ---\n            const canvas = document.getElementById('webgl-canvas');\n            const scene = new THREE.Scene();\n\n            // Strictly Orthographic Camera configuration\n            let d = 16;\n            let aspect = window.innerWidth / window.innerHeight;\n            const camera = new THREE.OrthographicCamera(-d * aspect, d * aspect, d, -d, 1, 1000);\n            camera.position.set(20, 20, 20); // Forced Isometric View\n            camera.lookAt(0, 0, 0);\n\n            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n            renderer.setSize(window.innerWidth, window.innerHeight);\n\n            const sceneGroup = new THREE.Group();\n            scene.add(sceneGroup);\n\n            // Lighting Setup\n            const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);\n            scene.add(ambientLight);\n\n            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);\n            dirLight.position.set(10, 20, 10);\n            scene.add(dirLight);\n\n            const pointLight = new THREE.PointLight(0xa855f7, 2.0, 50); // Violet glow\n            pointLight.position.set(0, 4.5, 0);\n            sceneGroup.add(pointLight);\n\n            // Material Palette (Neural/Crystal Theme)\n            const matBase = new THREE.MeshStandardMaterial({ color: 0x0f0f0f, roughness: 0.8, metalness: 0.2 });\n            const matCore = new THREE.MeshStandardMaterial({ color: 0xa855f7, emissive: 0xa855f7, emissiveIntensity: 0.8, roughness: 0.2 });\n            const matWireframe = new THREE.LineBasicMaterial({ color: 0x333333, transparent: true, opacity: 0.3 });\n            const matAccentLine = new THREE.LineBasicMaterial({ color: 0xa855f7, transparent: true, opacity: 0.4 });\n\n            function buildOrthogonalBlock(w, h, d, material, yPos) {\n                const group = new THREE.Group();\n                const geo = new THREE.BoxGeometry(w, h, d);\n                const mesh = new THREE.Mesh(geo, material);\n\n                const edges = new THREE.EdgesGeometry(geo);\n                const lines = new THREE.LineSegments(edges, matWireframe);\n\n                group.add(mesh);\n                group.add(lines);\n                group.position.y = yPos;\n                return group;\n            }\n\n            // Architecture Assembly (Abstract Node Structure)\n            const platform = buildOrthogonalBlock(16, 0.5, 16, matBase, 0.25);\n            sceneGroup.add(platform);\n\n            const gridHelper = new THREE.GridHelper(24, 24, 0xa855f7, 0x222222);\n            gridHelper.material.transparent = true;\n            gridHelper.material.opacity = 0.15;\n            gridHelper.position.y = 0.51;\n            sceneGroup.add(gridHelper);\n\n            const midStructure = buildOrthogonalBlock(8, 2, 8, matBase, 1.5);\n            sceneGroup.add(midStructure);\n\n            const topStructure = buildOrthogonalBlock(4, 3, 4, matBase, 4);\n            sceneGroup.add(topStructure);\n\n            // Logic Core Element (Octahedron for Crystal/Brain vibe)\n            const coreGeo = new THREE.OctahedronGeometry(1.5, 0);\n            const logicCoreMesh = new THREE.Mesh(coreGeo, matCore);\n            const logicCoreEdges = new THREE.LineSegments(new THREE.EdgesGeometry(coreGeo), matAccentLine);\n            const logicCore = new THREE.Group();\n            logicCore.add(logicCoreMesh);\n            logicCore.add(logicCoreEdges);\n            logicCore.position.y = 7;\n            sceneGroup.add(logicCore);\n\n            // Floating synaptic lines (Wireframe boxes)\n            for(let i=0; i<4; i++) {\n                const ringGeo = new THREE.EdgesGeometry(new THREE.BoxGeometry(10 + i*3, 0, 10 + i*3));\n                const ring = new THREE.LineSegments(ringGeo, matAccentLine);\n                ring.position.y = 1.5 + i*2;\n                sceneGroup.add(ring);\n            }\n\n            // Orbital Data Nodes\n            const nodesGroup = new THREE.Group();\n            sceneGroup.add(nodesGroup);\n            const nodes = [];\n\n            for(let i=0; i<12; i++) {\n                const angle = (i / 12) * Math.PI * 2;\n                const radius = 7 + Math.random() * 4;\n                const nodeGeo = new THREE.OctahedronGeometry(0.3, 0);\n                const nodeMesh = new THREE.Mesh(nodeGeo, matCore);\n\n                const nodeEdges = new THREE.LineSegments(new THREE.EdgesGeometry(nodeGeo), matAccentLine);\n                nodeMesh.add(nodeEdges);\n\n                nodeMesh.position.set(Math.cos(angle)*radius, 2 + Math.random()*6, Math.sin(angle)*radius);\n                nodesGroup.add(nodeMesh);\n\n                nodes.push({\n                    mesh: nodeMesh,\n                    baseY: nodeMesh.position.y,\n                    offset: Math.random() * Math.PI * 2\n                });\n            }\n\n            sceneGroup.position.y = -4; // Center structure vertically\n\n            // --- 2. Pointer & Animation Loop ---\n            const domCards = document.querySelectorAll('.card-wrapper');\n            let time = 0;\n            let mouseX = 0, mouseY = 0;\n            let targetMouseX = 0, targetMouseY = 0;\n\n            window.addEventListener('mousemove', (e) => {\n                targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;\n                targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;\n            });\n\n            window.addEventListener('resize', () => {\n                aspect = window.innerWidth / window.innerHeight;\n                camera.left = -d * aspect;\n                camera.right = d * aspect;\n                camera.top = d;\n                camera.bottom = -d;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n\n                const sceneDom = document.getElementById('scene');\n                const scale = Math.min(1, window.innerWidth / 1100); // Mobile scaling\n                gsap.set(sceneDom, { scale: scale });\n            });\n            window.dispatchEvent(new Event('resize'));\n\n            gsap.ticker.add(() => {\n                time += 0.01;\n\n                mouseX += (targetMouseX - mouseX) * 0.05;\n                mouseY += (targetMouseY - mouseY) * 0.05;\n\n                // Sync Emissive Pulse\n                const pulse = (Math.sin(time * 2.5) + 1) * 0.5;\n                matCore.emissiveIntensity = 0.4 + pulse * 0.6;\n                pointLight.intensity = 1.0 + pulse * 1.5;\n\n                // Core rotation\n                logicCore.rotation.y = time * 0.5;\n                logicCore.rotation.z = Math.sin(time * 0.5) * 0.2;\n\n                // Orbital Drift & Breathing\n                sceneGroup.rotation.y = Math.sin(time * 0.3) * 0.1;\n                nodesGroup.rotation.y += 0.002;\n\n                // Node Behavior (Bouncing)\n                nodes.forEach(node => {\n                    node.mesh.position.y = node.baseY + Math.sin(time * 1.5 + node.offset) * 1.0;\n                    node.mesh.rotation.y += 0.02;\n                    node.mesh.rotation.x += 0.01;\n                });\n\n                // Subtle Isometric Camera Drift\n                camera.position.x = 20 + mouseX * 2.0;\n                camera.position.z = 20 + mouseY * 2.0;\n                camera.lookAt(0, 0, 0);\n\n                renderer.render(scene, camera);\n\n                // DOM Cards Parallax\n                domCards.forEach((card, i) => {\n                    const bx = parseFloat(card.dataset.x);\n                    const by = parseFloat(card.dataset.y);\n                    const br = parseFloat(card.dataset.r);\n                    const depth = parseFloat(card.dataset.depth);\n\n                    const floatY = Math.sin(time * 1.1 + i) * 10 * depth;\n                    const floatX = Math.cos(time * 0.7 + i) * 5 * depth;\n                    const floatR = Math.sin(time + i) * 1.0 * depth;\n\n                    const pX = mouseX * 50 * depth;\n                    const pY = -mouseY * 50 * depth;\n\n                    const rotX = mouseY * 8 * depth;\n                    const rotY = mouseX * 8 * depth;\n\n                    gsap.set(card, {\n                        xPercent: -50,\n                        yPercent: -50,\n                        x: bx + pX + floatX,\n                        y: by + pY + floatY,\n                        rotationZ: br + floatR,\n                        rotationX: rotX,\n                        rotationY: rotY,\n                        transformOrigin: \"center center\"\n                    });\n                });\n            });\n\n            // --- 3. Entrance Animation Sequences ---\n            const tl = gsap.timeline({ delay: 0.1 });\n\n            tl.fromTo('.border-white\\\\/\\\\[0\\\\.02\\\\] > div, .border-white\\\\/\\\\[0\\\\.1\\\\]',\n                { opacity: 0 },\n                { opacity: 1, duration: 1.5, stagger: 0.05, ease: \"power2.inOut\" }, 0\n            );\n\n            tl.fromTo(domCards,\n                { y: \"+=50\", opacity: 0, scale: 0.9 },\n                {\n                    y: \"-=50\",\n                    opacity: 1,\n                    scale: 1,\n                    duration: 1.4,\n                    stagger: 0.12,\n                    ease: \"power3.out\",\n                    onStart: function() {\n                        gsap.set(this.targets()[0], { clearProps: \"y,scale\" });\n                    }\n                }, 0.4\n            );\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "nexus-neural-synchrony.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexus-neural-synchrony.jpg", "source_name": "nexus-neural-synchrony-DESIGN.md", "views": 202, "forks": 5, "private": false, "featured": true, "created_by": "2e815afb-cac1-4c01-90e1-cf3810246e35", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T23:45:03.398633+00:00"}