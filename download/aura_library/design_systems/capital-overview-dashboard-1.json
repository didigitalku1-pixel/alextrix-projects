ansform = 'translateY(100%)';\n                    wordSpan.className = 'reveal-word';\n                    // Render the word along with a non-breaking space\n                    wordSpan.innerHTML = word + '&nbsp;';\n\n                    wordContainer.appendChild(wordSpan);\n                    el.appendChild(wordContainer);\n                });\n\n                // Animate words from below\n                gsap.to(el.querySelectorAll('.reveal-word'), {\n                    y: '0%',\n                    ease: 'power4.out',\n                    duration: 1.2,\n                    stagger: 0.03,\n                    scrollTrigger: {\n                        trigger: el,\n                        start: 'top 95%',\n                        toggleActions: 'play none none none'\n                    }\n                });\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "capital-overview-dashboard-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/capital-overview-dashboard-1.jpg", "source_name": "capital-overview-dashboard-1-DESIGN.md", "views": 2181, "forks": 62, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-04-29T01:10:29.088865+00:00", "updated_at": "2026-07-03T19:30:03.438863+00:00"}