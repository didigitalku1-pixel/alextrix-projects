  <!-- Floating Indicators (Depth-Aware Data Anchors) -->\n    <div class=\"hidden md:flex absolute top-[18%] left-[12%] z-0 p-[1px] bg-gradient-to-b from-[#ffffff] via-[#FDFBF7] to-[#DCD6CC] rounded-md shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)]\">\n        <div class=\"bg-gradient-to-b from-[#FDFBF7]/95 to-[#F5F2EB]/95 backdrop-blur-md rounded-[5px] px-4 py-2 flex items-center gap-3 shadow-[inset_0_1px_0_rgba(255,255,255,1),inset_0_-1px_1px_rgba(0,0,0,0.02)]\">\n            <div class=\"relative flex h-2 w-2 shadow-[inset_0_1px_1px_rgba(0,0,0,0.2)] rounded-sm bg-[#DCD6CC]\">\n                <span class=\"animate-ping absolute inline-flex h-full w-full rounded-sm bg-[#A3907A] opacity-75\"></span>\n                <span class=\"relative inline-flex rounded-sm h-2 w-2 bg-[#A3907A] shadow-[inset_0_1px_0_rgba(255,255,255,0.4)]\"></span>\n            </div>\n            <span class=\"text-xs text-[#4A4845] tracking-tight [text-shadow:0_1px_0_white]\">14.2 GB/s Channel Rate</span>\n        </div>\n    </div>\n\n    <div class=\"hidden md:flex absolute top-[35%] right-[8%] z-0 p-[1px] bg-gradient-to-b from-[#ffffff] via-[#FDFBF7] to-[#DCD6CC] rounded-md shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)]\">\n        <div class=\"bg-gradient-to-b from-[#FDFBF7]/95 to-[#F5F2EB]/95 backdrop-blur-md rounded-[5px] p-4 flex flex-col gap-1.5 shadow-[inset_0_1px_0_rgba(255,255,255,1),inset_0_-1px_1px_rgba(0,0,0,0.02)] relative\">\n            <div class=\"absolute -left-[6px] top-1/2 -translate-y-1/2 w-[12px] h-[12px] bg-gradient-to-br from-[#ffffff] to-[#F5F2EB] border-l border-b border-[#DCD6CC] rotate-45 rounded-[2px] shadow-[inset_1px_-1px_1px_rgba(255,255,255,1)]\"></div>\n            <div class=\"text-xs text-[#8C8273] font-extralight uppercase tracking-widest [text-shadow:0_1px_0_white]\">Cluster Heart</div>\n            <div class=\"text-sm text-[#2C2C2A] tracking-tight [text-shadow:0_1px_0_white]\">Latency: 11ms</div>\n        </div>\n    </div>\n\n    <!-- Main Content Wrapper -->\n    <main class=\"relative z-10 w-full flex flex-col items-center pt-20 md:pt-28\">\n\n        <!-- Hero Section -->\n        <header class=\"flex flex-col items-center text-center px-4 mb-16 md:mb-24 w-full max-w-4xl mx-auto\">\n            <span class=\"text-sm font-extralight text-[#8C8273] mb-6 tracking-wide [text-shadow:0_1px_0_white]\">Initializing Node Handshake</span>\n\n            <h1 class=\"text-5xl md:text-7xl lg:text-8xl leading-[1.05] font-extralight tracking-tight uppercase mb-6 text-[#1C1C1B] [text-shadow:0_1px_0_rgba(255,255,255,0.8),0_4px_12px_rgba(0,0,0,0.03)]\">\n                The Matrix<br/>Framework\n            </h1>\n\n            <p class=\"text-lg md:text-xl text-[#8C8273] mb-10 font-extralight max-w-2xl [text-shadow:0_1px_0_white]\">\n                Coordinate decentralized systems silently through exacting structural formatting.\n            </p>\n\n            <!-- Skeuo Premium Button -->\n            <div class=\"p-[1px] rounded-md bg-gradient-to-b from-[#ffffff] to-[#DCD6CC] shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)] group hover:shadow-[0px_3px_5px_-1px_rgba(0,0,0,0.12),0px_1px_0px_0px_rgba(25,28,33,0.03),0px_0px_0px_1px_rgba(25,28,33,0.08)] transition-shadow duration-300\">\n                <button class=\"relative inline-flex items-center gap-2 px-8 py-3.5 bg-gradient-to-b from-[#FDFBF7] to-[#EAE5DF] rounded-[5px] text-[#2C2C2A] font-light text-sm shadow-[inset_0_1px_0_rgba(255,255,255,1),inset_0_-1px_1px_rgba(0,0,0,0.04)] [text-shadow:0_1px_0_white]\">\n                    Commence Sync\n                    <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-lg transition-transform duration-300 group-hover:translate-x-1 [filter:drop-shadow(0_1px_0_white)]\" stroke-width=\"1.5\"></iconify-icon>\n                </button>\n            </div>\n        </header>\n\n        <!-- Skeuomorphic Mockup Interface -->\n        <section class=\"w-full max-w-7xl px-4 md:px-8 relative z-20\">\n\n            <!-- Outer Gradient Bezel (Beautiful lg Shadow) -->\n            <div class=\"relative rounded-xl md:rounded-2xl p-[1px] bg-gradient-to-b from-[#ffffff] via-[#EAE5DF] to-[#DCD6CC] shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)]\">\n\n                <!-- Inner Bezel Carved Surface -->\n                <div class=\"rounded-[11px] md:rounded-[15px] p-2 md:p-3 bg-gradient-to-b from-[#FDFBF7]/80 to-[#EAE5DF]/80 backdrop-blur-md shadow-[inset_0_1px_1px_rgba(255,255,255,1),inset_0_-1px_1px_rgba(0,0,0,0.05)]\">\n\n                    <!-- Screen Border Wrapper -->\n                    <div class=\"rounded-lg md:rounded-xl p-[1px] bg-gradient-to-b from-[#DCD6CC] to-[#ffffff]\">\n\n                        <!-- Screen Surface -->\n                        <div class=\"bg-gradient-to-b from-[#FDFBF7] to-[#F5F2EB] rounded-[7px] md:rounded-[11px] overflow-hidden relative w-full flex flex-col min-h-[400px] shadow-[inset_0_2px_4px_rgba(0,0,0,0.03)]\">\n\n                            <!-- Interface Header -->\n                            <div class=\"flex items-center justify-between px-6 md:px-10 py-6 border-b border-[#EAE5DF]/60 shadow-[0_1px_0_white]\">\n                                <div class=\"flex items-center gap-3\">\n                                    <iconify-icon icon=\"solar:widget-5-linear\" class=\"text-3xl text-[#2C2C2A] [filter:drop-shadow(0_1px_0_white)]\" stroke-width=\"1.5\"></iconify-icon>\n                                    <span class=\"text-xl md:text-2xl font-light tracking-tight text-[#1C1C1B] [text-shadow:0_1px_0_white]\">Stratum</span>\n                                </div>\n\n            