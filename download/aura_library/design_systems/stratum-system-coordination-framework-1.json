hidden sm:flex items-center gap-6 px-4 py-1 border-l border-[#EAE5DF] shadow-[inset_1px_0_0_white]\">\n                    <a href=\"#\" class=\"text-xs font-light text-[#8C8273] hover:text-[#2C2C2A] transition-colors [text-shadow:0_1px_0_white]\">Nodes</a>\n                    <a href=\"#\" class=\"text-xs font-light text-[#8C8273] hover:text-[#2C2C2A] transition-colors [text-shadow:0_1px_0_white]\">Verification</a>\n                    <a href=\"#\" class=\"text-xs font-light text-[#8C8273] hover:text-[#2C2C2A] transition-colors [text-shadow:0_1px_0_white]\">Bandwidth</a>\n                </div>\n\n                <div class=\"p-[1px] rounded-md bg-gradient-to-b from-[#ffffff] to-[#DCD6CC] shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)] ml-auto sm:ml-0 group\">\n                    <button class=\"px-5 py-2.5 bg-gradient-to-b from-[#FDFBF7] to-[#EAE5DF] group-hover:from-[#ffffff] group-hover:to-[#F5F2EB] text-[#2C2C2A] rounded-[5px] text-xs font-light transition-colors duration-300 shadow-[inset_0_1px_0_white,inset_0_-1px_1px_rgba(0,0,0,0.05)] [text-shadow:0_1px_0_white]\">\n                        Interface\n                    </button>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- 3D Spatial Network Canvas Logic -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            const canvas = document.getElementById('networkGlobe');\n            const ctx = canvas.getContext('2d');\n            let width, height, centerX, centerY;\n\n            function resize() {\n                width = window.innerWidth;\n                height = window.innerHeight;\n                canvas.width = width;\n                canvas.height = height;\n                centerX = width / 2;\n                centerY = height / 2;\n            }\n            window.addEventListener('resize', resize);\n            resize();\n\n            const nodes = [];\n            const numNodes = 130;\n            for(let i = 0; i < numNodes; i++) {\n                let phi = Math.acos(-1 + (2 * i) / numNodes);\n                let theta = Math.sqrt(numNodes * Math.PI) * phi;\n                nodes.push({\n                    x: Math.cos(theta) * Math.sin(phi),\n                    y: Math.sin(theta) * Math.sin(phi),\n                    z: Math.cos(phi),\n                    pulsePhase: Math.random() * Math.PI * 2\n                });\n            }\n\n            function draw(time) {\n                ctx.clearRect(0, 0, width, height);\n                const R = Math.min(width, height) * 0.4;\n                const angleY = time * 0.0003;\n                const driftY = Math.sin(time * 0.001) * 20;\n\n                const projected = nodes.map(n => {\n                    let xProj = n.x * Math.cos(angleY) + n.z * Math.sin(angleY);\n                    let zProj = -n.x * Math.sin(angleY) + n.z * Math.cos(angleY);\n                    return { xProj, yProj: n.y, zProj, orig: n };\n                });\n\n                ctx.lineWidth = 0.5;\n                for(let i = 0; i < projected.length; i++) {\n                    for(let j = i + 1; j < projected.length; j++) {\n                        const n1 = projected[i];\n                        const n2 = projected[j];\n                        const dx = n1.xProj - n2.xProj;\n                        const dy = n1.yProj - n2.yProj;\n                        const dz = n1.zProj - n2.zProj;\n                        const distSq = dx*dx + dy*dy + dz*dz;\n\n                        if(distSq < 0.12) {\n                            const avgZ = (n1.zProj + n2.zProj) / 2;\n                            if(avgZ > -0.6) {\n                                const alpha = Math.max(0, Math.min(0.35, (avgZ + 0.6) * (1 - distSq/0.12)));\n                                ctx.strokeStyle = `rgba(163, 154, 143, ${alpha})`;\n                                ctx.beginPath();\n                                ctx.moveTo(centerX + n1.xProj * R, centerY + n1.yProj * R + driftY);\n                                ctx.lineTo(centerX + n2.xProj * R, centerY + n2.yProj * R + driftY);\n                                ctx.stroke();\n                            }\n                        }\n                    }\n                }\n\n                projected.forEach(n => {\n                    if(n.zProj > -0.8) {\n                        const alpha = Math.min(1, (n.zProj + 0.8) * 1.5);\n                        const pulseScale = (Math.sin(time * 0.003 + n.orig.pulsePhase) + 1) / 2;\n                        const size = 1.2 + pulseScale * 1.5;\n\n                        ctx.fillStyle = `rgba(163, 154, 143, ${alpha * 0.8})`;\n                        ctx.beginPath();\n                        ctx.arc(centerX + n.xProj * R, centerY + n.yProj * R + driftY, size, 0, Math.PI * 2);\n                        ctx.fill();\n                    }\n                });\n\n                requestAnimationFrame(draw);\n            }\n            requestAnimationFrame(draw);\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "stratum-system-coordination-framework-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/stratum-system-coordination-framework-1.jpg", "source_name": "stratum-system-coordination-framework-1-DESIGN.md", "views": 656, "forks": 15, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-03T21:19:36.063811+00:00"}