      <div class=\"absolute inset-x-0 bottom-[-10%] h-[80%] opacity-40 transition-transform duration-1000\" style=\"background-image: radial-gradient(rgba(255,255,255,0.8) 1.5px, transparent 1.5px); background-size: 8px 8px; transform: perspective(600px) rotateX(45deg); mask-image: radial-gradient(ellipse 120% 80% at 50% 100%, black 20%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse 120% 80% at 50% 100%, black 20%, transparent 70%);\"></div>\n                    <div class=\"absolute inset-x-0 bottom-0 h-[50%] opacity-60\" style=\"background-image: radial-gradient(rgba(255,255,255,1) 1px, transparent 1px); background-size: 5px 5px; mask-image: radial-gradient(ellipse 100% 100% at 50% 100%, black 10%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 100% 100% at 50% 100%, black 10%, transparent 80%);\"></div>\n                </div>\n\n                <div class=\"space-y-6 relative z-10 max-w-[90%]\">\n                    <p class=\"text-sm font-medium text-white leading-relaxed tracking-wide\">\n                        We believe tomorrow isn't waiting to be found—it's actively forged by what we engineer today.\n                    </p>\n                    <p class=\"text-sm font-medium text-neutral-400 leading-relaxed tracking-wide\">\n                        Driven by unyielding exploration and foresight, our core is powered by absolute technical prowess.\n                    </p>\n                    <p class=\"text-sm font-medium text-neutral-400 leading-relaxed tracking-wide\">\n                        Every raw concept has magnitude. Every barrier is merely an invitation to innovate.\n                    </p>\n                    <p class=\"text-sm font-medium text-neutral-400 leading-relaxed tracking-wide\">\n                        We exist to break conventional boundaries, developing without limits to turn pure ambition into measurable progress.\n                    </p>\n                </div>\n\n                <div class=\"flex-grow\"></div>\n\n                <!-- W/07 SVG (Animated) -->\n                <div class=\"relative z-10 mb-2\">\n                     <svg class=\"h-8 w-auto text-white fill-current opacity-90 transition-opacity duration-500 hover:opacity-100 animate-[pulse_3s_ease-in-out_infinite]\" viewBox=\"0 0 100 30\">\n                        <circle cx=\"3\" cy=\"3\" r=\"2\"></circle><circle cx=\"15\" cy=\"3\" r=\"2\"></circle><circle cx=\"27\" cy=\"3\" r=\"2\"></circle>\n                        <circle cx=\"3\" cy=\"9\" r=\"2\"></circle><circle cx=\"15\" cy=\"9\" r=\"2\"></circle><circle cx=\"27\" cy=\"9\" r=\"2\"></circle>\n                        <circle cx=\"3\" cy=\"15\" r=\"2\"></circle><circle cx=\"9\" cy=\"15\" r=\"2\"></circle><circle cx=\"15\" cy=\"15\" r=\"2\"></circle><circle cx=\"21\" cy=\"15\" r=\"2\"></circle><circle cx=\"27\" cy=\"15\" r=\"2\"></circle>\n                        <circle cx=\"9\" cy=\"21\" r=\"2\"></circle><circle cx=\"21\" cy=\"21\" r=\"2\"></circle>\n                        <circle cx=\"9\" cy=\"27\" r=\"2\"></circle><circle cx=\"21\" cy=\"27\" r=\"2\"></circle>\n                        <circle cx=\"45\" cy=\"3\" r=\"2\"></circle><circle cx=\"41\" cy=\"9\" r=\"2\"></circle><circle cx=\"37\" cy=\"15\" r=\"2\"></circle><circle cx=\"33\" cy=\"21\" r=\"2\"></circle><circle cx=\"29\" cy=\"27\" r=\"2\"></circle>\n                        <circle cx=\"55\" cy=\"3\" r=\"2\"></circle><circle cx=\"61\" cy=\"3\" r=\"2\"></circle><circle cx=\"67\" cy=\"3\" r=\"2\"></circle>\n                        <circle cx=\"55\" cy=\"9\" r=\"2\"></circle><circle cx=\"67\" cy=\"9\" r=\"2\"></circle>\n                        <circle cx=\"55\" cy=\"15\" r=\"2\"></circle><circle cx=\"67\" cy=\"15\" r=\"2\"></circle>\n                        <circle cx=\"55\" cy=\"21\" r=\"2\"></circle><circle cx=\"67\" cy=\"21\" r=\"2\"></circle>\n                        <circle cx=\"55\" cy=\"27\" r=\"2\"></circle><circle cx=\"61\" cy=\"27\" r=\"2\"></circle><circle cx=\"67\" cy=\"