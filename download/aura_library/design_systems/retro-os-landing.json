] bg-[#1a1a1a] rounded-[1.5rem] md:rounded-[2rem] p-3 md:p-4 relative\" style=\"box-shadow: inset 0 15px 30px rgba(0,0,0,0.95), 0 2px 0 rgba(255,255,255,0.4), 0 -1px 2px rgba(0,0,0,0.3);\">\n\n            <!-- CRT Glass Reflection Curve -->\n            <div class=\"absolute inset-3 md:inset-4 rounded-[1rem] md:rounded-[1.5rem] pointer-events-none z-30\" style=\"box-shadow: inset 0 25px 50px rgba(255,255,255,0.04); border-radius: inherit;\"></div>\n\n            <!-- Actual Screen Content -->\n            <div class=\"w-full h-full rounded-[1rem] md:rounded-[1.2rem] overflow-hidden relative flex items-center justify-center\" style=\"background: linear-gradient(180deg, #6282C9 0%, #E29A88 60%, #F15A36 100%);\">\n\n                <!-- Inner Screen Shadow -->\n                <div class=\"absolute inset-0 pointer-events-none z-10\" style=\"box-shadow: inset 0 0 30px rgba(0,0,0,0.4);\"></div>\n\n                <!-- macOS UI Window inside Screen -->\n                <div class=\"relative z-20 w-[90%] md:w-[85%] h-[85%] md:h-[80%] rounded-xl flex flex-col overflow-hidden bg-white/10 backdrop-blur-md shadow-[0_20px_40px_-10px_rgba(0,0,0,0.5)] border border-white/20 transition-transform duration-500 hover:scale-[1.01]\">\n\n                    <!-- macOS Titlebar -->\n                    <div class=\"h-8 md:h-10 bg-white/10 backdrop-blur-sm border-b border-white/10 flex items-center px-3 md:px-4 gap-2 shrink-0 w-full relative\">\n                        <!-- Traffic Lights -->\n                        <div class=\"flex gap-1.5 md:gap-2\">\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-[#FF5F56] shadow-sm border border-black/10\"></div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-[#FFBD2E] shadow-sm border border-black/10\"></div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-[#27C93F] shadow-sm border border-black/10\"></div>\n                        </div>\n                        <div class=\"absol