             </div>\n                                    <iconify-icon icon=\"solar:close-linear\" class=\"text-zinc-600 text-sm rotate-45\"></iconify-icon>\n                                </div>\n                                <p class=\"text-zinc-400 group-hover:text-zinc-200 transition-colors duration-300 text-sm leading-[1.6]\">Found this library and wow, the attention to detail is staggering! Love the high-end feel and robust architecture.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Masked Word Reveal for Heading (Kept exact)\n            const heading = document.getElementById('animated-heading');\n            if (heading) {\n                const text = heading.innerText;\n                heading.innerHTML = '';\n                \n                const words = text.split(' ');\n                words.forEach((word, index) => {\n                    const wrapper = document.createElement('span');\n                    wrapper.className = 'inline-block overflow-hidden align-bottom pb-1 mr-2';\n                    \n                    const inner = document.createElement('span');\n                    inner.className = 'inline-block text-white';\n                    inner.innerText = word;\n                    inner.style.transform = 'translateY(110%)'; \n\n                    wrapper.appendChild(inner);\n                    heading.appendChild(wrapper);\n                });\n\n                gsap.to(heading.querySelectorAll('.inline-block.text-white'), {\n                    y: '0%',\n                    duration: 0.9,\n                    stagger: 0.1,\n                    ease: \"power4.out\",\n                    scrollTrigger: {\n                        trigger: heading,\n                        start: \"top 85%\",\n                    }\n                });\n            }\n\n            // Infinite Marquee Animations\n            const trackDown1 = document.querySelector('.marquee-track-down-1');\n            const trackUp = document.querySelector('.marquee-track-up');\n            const trackDown2 = document.querySelector('.marquee-track-down-2');\n\n            // Starts visually shifted by half (showing duplicated set), moves down to top (original set) smoothly\n            if(trackDown1) {\n                gsap.fromTo(trackDown1, \n                    { yPercent: -50 }, \n                    { yPercent: 0, duration: 25, ease: \"none\", repeat: -1 }\n                );\n            }\n\n            // Starts at top, moves up to halfway point smoothly\n            if(trackUp) {\n                gsap.fromTo(trackUp, \n                    { yPercent: 0 }, \n                    { yPercent: -50, duration: 30, ease: \"none\", repeat: -1 }\n                );\n            }\n\n            // Third column, slightly different speed for visual variance\n            if(trackDown2) {\n                gsap.fromTo(trackDown2, \n                    { yPercent: -50 }, \n                    { yPercent: 0, duration: 28, ease: \"none\", repeat: -1 }\n                );\n            }\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "trusted-by-engineers-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/trusted-by-engineers-1.jpg", "source_name": "trusted-by-engineers-1-DESIGN.md", "views": 51, "forks": 1, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-03T23:38:30.507834+00:00"}