y: 'DM Mono', monospace;\">NODE ALPHA</span>\n                </div>\n\n                <div class=\"z-10 relative mt-auto flex justify-between items-end w-full\">\n                    <div class=\"flex flex-col\">\n                        <h2 class=\"text-6xl md:text-7xl tracking-tight text-white/90 leading-none\" style=\"font-family: 'Instrument Serif', serif; font-style: italic;\">Flow</h2>\n                        <h3 class=\"text-3xl md:text-4xl tracking-tight text-neutral-400 font-light mt-2\" style=\"font-family: 'Space Grotesk', sans-serif;\">.Align()</h3>\n                    </div>\n                    <span class=\"text-xs font-light text-neutral-500 text-right max-w-[120px] hidden md:block leading-relaxed\" style=\"font-family: 'DM Mono', monospace;\">Calibrating metrics.</span>\n                </div>\n            </div>\n        </div>\n\n        <!-- Card 4: Bottom Right -->\n        <div class=\"card-wrapper relative h-[400px] rounded-sm p-[1px] overflow-hidden group\" style=\"background-color: #1F1F1F;\">\n            <div class=\"pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0\" style=\"background: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.4), transparent 40%);\"></div>\n\n            <div class=\"relative h-full w-full rounded-sm p-6 md:p-8 flex flex-col overflow-hidden z-10\" style=\"background-color: #0A0A0A;\">\n                <div class=\"flex justify-between items-start z-10 relative mb-4\">\n                    <span class=\"text-xs font-light text-neutral-500 uppercase tracking-widest\" style=\"font-family: 'DM Mono', monospace;\">Prism</span>\n                    <div class=\"flex gap-1\">\n                        <div class=\"w-2 h-2\" style=\"background-color: #5EBD3E;\"></div>\n                        <div class=\"w-2 h-2\" style=\"background-color: #FFB900;\"></div>\n                        <div class=\"w-2 h-2\" style=\"background-color: #F78200;\"></div>\n                        <div class=\"w-2 h-2\" style=\"background-color: #E23838;\"></div>\n                        <div class=\"w-2 h-2\" style=\"background-color: #973999;\"></div>\n                        <div class=\"w-2 h-2\" style=\"background-color: #009CDF;\"></div>\n                    </div>\n                </div>\n\n                <h2 class=\"text-5xl md:text-6xl tracking-tight text-white/90 z-10 relative mb-8 leading-none\" style=\"font-family: 'Instrument Serif', serif; font-style: italic;\">Visual</h2>\n\n                <div class=\"flex flex-col flex-grow w-full h-full gap-0 z-10 rounded-sm overflow-hidden\" style=\"border: 1px solid #1F1F1F;\">\n                    <div class=\"flex-1 w-full flex justify-between items-center px-4 transition-all hover:px-6\" style=\"background-color: #5EBD3E;\">\n                        <span class=\"text-xs font-light text-black/80\" style=\"font-family: 'Space Grotesk', sans-serif;\">Green</span>\n                        <span class=\"text-xs font-light text-black/60\" style=\"font-family: 'DM Mono', monospace;\">#5EBD3E</span>\n                    </div>\n                    <div class=\"flex-1 w-full flex justify-between items-center px-4 transition-all hover:px-6\" style=\"background-color: #FFB900;\">\n                        <span class=\"text-xs font-light text-black/80\" style=\"font-family: 'Space Grotesk', sans-serif;\">Yellow</span>\n                        <span class=\"text-xs font-light text-black/60\" style=\"font-family: 'DM Mono', monospace;\">#FFB900</span>\n                    </div>\n                    <div class=\"flex-1 w-full flex justify-between items-center px-4 transition-all hover:px-6\" style=\"background-color: #F78200;\">\n                        <span class=\"text-xs font-light text-black/80\" style=\"font-family: 'Space Grotesk', sans-serif;\">Orange</span>\n                        <span class=\"text-xs font-light text-black/60\" style=\"font-family: 'DM Mono', monospace;\">#F78200</span>\n                    </div>\n                    <div class=\"flex-1 w-full flex justify-between items-center px-4 transition-all hover:px-6\" style=\"background-color: #E23838;\">\n                        <span class=\"text-xs font-light text-white/90\" style=\"font-family: 'Space Grotesk', sans-serif;\">Red</span>\n                        <span class=\"text-xs font-light text-white/70\" style=\"font-family: 'DM Mono', monospace;\">#E23838</span>\n                    </div>\n                    <div class=\"flex-1 w-full flex justify-between items-center px-4 transition-all hover:px-6\" style=\"background-color: #973999;\">\n                        <span class=\"text-xs font-light text-white/90\" style=\"font-family: 'Space Grotesk', sans-serif;\">Purple</span>\n                        <span class=\"text-xs font-light text-white/70\" style=\"font-family: 'DM Mono', monospace;\">#973999</span>\n                    </div>\n                    <div class=\"flex-1 w-full flex justify-between items-center px-4 transition-all hover:px-6\" style=\"background-color: #009CDF;\">\n                        <span class=\"text-xs font-light text-white/90\" style=\"font-family: 'Space Grotesk', sans-serif;\">Blue</span>\n                        <span class=\"text-xs font-light text-white/70\" style=\"font-family: 'DM Mono', monospace;\">#009CDF</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            // Global Flashlight Effect\n            const flashlight = document.getElementById('flashlight');\n            document.addEventListener('mousemove', (e) => {\n                flashlight.classList.remove('opacity-0');\n                const x = e.clientX;\n                const y = e.clientY;\n                flashlight.style.maskImage = `radial-gradient(circle 250px at ${x}px ${y}px, black, transparent)`;\n                flashlight.style.webkitMaskImage = `radial-gradient(circle 250px at ${x}px ${y}px, black, transparent)`;\n            });\n\n            // Card Border Flashlight Effect\n            const cards = document.querySelectorAll('.card-wrapper');\n            cards.forEach(card => {\n                card.addEventListener('mousemove', e => {\n                    const rect = card.getBoundingClientRect();\n                    const x = e.clientX - rect.left;\n                    const y = e.clientY - rect.top;\n                    card.style.setProperty('--mouse-x', `${x}px`);\n                    card.style.setProperty('--mouse-y', `${y}px`);\n                });\n            });\n\n            // SVG Path Animation\n            const paths = document.querySelectorAll('.anim-line');\n            paths.forEach((path, index) => {\n                const length = path.getTotalLength();\n                path.style.strokeDasharray = length;\n                path.style.strokeDashoffset = length;\n                path.getBoundingClientRect(); // Reflow\n\n                path.style.transition = `stroke-dashoffset 2s cubic-bezier(0.25, 1, 0.5, 1) ${index * 0.15}s`;\n                path.style.strokeDashoffset = '0';\n\n                setTimeout(() => {\n                    path.style.transition = 'opacity 3s ease-in-out';\n                    let isDim = false;\n                    setInterval(() => {\n                        path.style.opacity = isDim ? '1' : '0.85';\n                        isDim = !isDim;\n                    }, 3000 + (index * 500));\n                }, 2500);\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "system-interface-remixed.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/system-interface-remixed.jpg", "source_name": "system-interface-remixed-DESIGN.md", "views": 150, "forks": 6, "private": false, "fe