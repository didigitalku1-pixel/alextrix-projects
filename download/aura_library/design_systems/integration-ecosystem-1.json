);\n            }\n\n            // Start the animation loop\n            requestAnimationFrame(animateLoop);\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "integration-ecosystem-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/integration-ecosystem-1.jpg", "source_name": "integration-ecosystem-1-DESIGN.md", "views": 127, "forks": 3, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-03T19:00:59.449365+00:00"}