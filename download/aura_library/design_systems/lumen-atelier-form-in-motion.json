 z-30\"></div>\n            <div class=\"corner-bracket absolute -bottom-2 -right-2 w-6 h-6 border-b border-r hidden lg:block z-30\"></div>\n\n            <!-- Primary frame -->\n            <div class=\"absolute top-0 left-0 w-[80%] sm:w-[72%] h-[88%] p-[1px] rounded-[4px] media-element z-10 frame-outer\">\n                <div class=\"frame-inner w-full h-full rounded-[3px] overflow-hidden relative\">\n                    <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/4f30f4f2-b81c-4bf1-88c7-86b1dc41acd1_3840w.jpg\" alt=\"Exhibition plate: figure study in structured form\" class=\"photo-treatment w-full h-full object-cover\">\n\n                    <div class=\"absolute inset-0\" style=\"background:linear-gradient(to top, rgba(7,7,7,0.58), transparent 58%), radial-gradient(circle at 50% 28%, transparent 0%, rgba(7,7,7,0.24) 100%);\"></div>\n\n                    <div class=\"image-caption absolute top-4 left-4 text-[0.64rem] tracking-[0.20em] uppercase font-medium px-3 py-1.5 rounded-full\">\n                        Plate 01\n                    </div>\n\n                    <div class=\"absolute bottom-5 left-5 right-5 flex justify-between items-end text-[#E9E5DA]/78\">\n                        <span class=\"text-[0.64rem] uppercase tracking-[0.22em]\">Figure / Form Study</span>\n                        <span class=\"text-[0.64rem] uppercase tracking-[0.22em]\">Archive 26</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Overlapping detail frame -->\n            <div class=\"absolute bottom-0 right-0 w-[48%] sm:w-[44%] aspect-[3/4] p-[1px] rounded-[4px] media-element z-20 hidden sm:block frame-outer\">\n                <div class=\"frame-inner w-full h-full rounded-[3px] overflow-hidden group relative\">\n                    <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/f49e1522-5739-4873-8cf4-7e66424c5869_3840w.jpg\" alt=\"Exhibition detail: material and surface study\" class=\"photo-treatment-detail w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000 ease-out\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#070707]/48 to-transparent\"></div>\n                    <div class=\"image-caption absolute bottom-4 left-4 text-[0.62rem] tracking-[0.18em] uppercase font-medium px-2.5 py-1 rounded-full\">\n                        Detail B\n                    </div>\n                </div>\n            </div>\n\n            <!-- Rotating marker -->\n            <div class=\"rotating-marker absolute top-[6%] -right-[3%] w-24 h-24 border rounded-full border-dashed items-center justify-center z-0 hidden lg:flex animate-[spin_26s_linear_infinite]\">\n                <span class=\"text-xs tracking-[0.14em] uppercase font-medium\">Room 04</span>\n                <div class=\"w-1.5 h-1.5 bg-[#D8C18A] rounded-full absolute top-0 -translate-y-1/2 shadow-[0_0_24px_rgba(216,193,138,0.48)]\"></div>\n            </div>\n        </div>\n\n        <!-- Right: Exhibition typography -->\n        <div class=\"w-full lg:w-[54%] order-1 lg:order-2 flex flex-col justify-center\">\n\n            <div class=\"mb-6 flex items-center gap-3 reveal-fade\">\n                <span class=\"w-10 h-[1px] bg-[#D8C18A]/50\"></span>\n                <span class=\"small-label text-xs font-medium gold-text\">\n                    Exhibition Catalogue — Room IV\n                </span>\n            </div>\n\n            <h1 class=\"headline-main leading-[0.96] reveal-text-container\">\n                <span class=\"block text-5xl sm:text-7xl lg:text-[5.55rem] font-bold\">\n                    <span class=\"headline-mask\">\n                        <span class=\"headline-word reveal-word\">STUDIES</span>\n                    </span>\n\n                    <span class=\"headline-mask\">\n                        <span class=\"headline-word reveal-word\">IN FORM,</span>\n                    </span>\n                </span>\n\n                <span class=\"headline-mask mt-1\">\n                    <span class=\"headline-word reveal-word headline-italic block text-4xl sm:text-6xl lg:text-[4.5rem] italic font-normal\">\n                        held in motion.\n                    </span>\n                </span>\n            </h1>\n\n            <p class=\"mt-7 text-sm sm:text-base text-muted font-light leading-relaxed max-w-md reveal-fade\">\n                A curated index of silhouettes, surfaces, and gestures. Each work is presented as a quiet record of material tension, human movement, and the space between object and body.\n            </p>\n\n            <!-- Actions -->\n            <div class=\"mt-9 flex flex-col sm:flex-row items-center gap-5 reveal-fade\">\n                <a href=\"#\" class=\"primary-cta w-full sm:w-auto rounded-full px-8 py-3.5 flex items-center justify-center gap-3 transition-all duration-300\">\n                    <span class=\"text-sm font-medium tracking-tight\">Explore the Index</span>\n                    <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-base\"></iconify-icon>\n                </a>\n\n                <a href=\"#\" class=\"ghost-link text-sm font-medium flex items-center gap-2 transition-colors underline-offset-4 hover:underline\">\n                    <iconify-icon icon=\"solar:play-circle-linear\" class=\"text-xl\"></iconify-icon>\n                    Curator Notes\n                </a>\n            </div>\n\n            <!-- Detail grid -->\n            <div class=\"mt-14 sm:mt-20 grid grid-cols-3 gap-6 border-t meta-rule pt-8 reveal-fade\">\n                <div>\n                    <p class=\"text-2xl font-medium tracking-tight text-[#E9E5DA]\">24</p>\n                    <p class=\"text-xs text-meta mt-1\">Catalogued Works</p>\n                </div>\n\n                <div>\n                    <p class=\"text-2xl font-medium tracking-tight text-[#E9E5DA]\">06</p>\n                    <p class=\"text-xs text-meta mt-1\">Material Studies</p>\n                </div>\n\n                <div>\n                    <p class=\"text-2xl font-medium tracking-tight text-[#E9E5DA]\">04</p>\n                    <p class=\"text-xs text-meta mt-1\">Gallery Rooms</p>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <script>\n        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n        if (!reduced && typeof gsap !== 'undefined') {\n            gsap.registerPlugin(ScrollTrigger);\n\n            gsap.to(\".reveal-word\", {\n                y: \"0%\",\n                rotate: 0,\n                filter: \"blur(0px)\",\n                opacity: 1,\n                duration: 1.35,\n                stagger: 0.14,\n                ease: \"expo.out\",\n                delay: 0.18\n            });\n\n            gsap.fromTo(\".headline-main\", {\n                letterSpacing: \"-0.025em\"\n            }, {\n                letterSpacing: \"-0.064em\",\n                duration: 1.55,\n                ease: \"power3.out\",\n                delay: 0.22\n            });\n\n            gsap.fromTo(\".reveal-fade\", {\n                opacity: 0,\n                y: 22,\n                filter: \"blur(8px)\"\n            }, {\n                opacity: 1,\n                y: 0,\n                filter: \"blur(0px)\",\n                duration: 1,\n                stagger: 0.16,\n                ease: \"power2.out\",\n                delay: 0.52\n            });\n\n            gsap.fromTo(\".media-element\", {\n                opacity: 0,\n                scale: 0.965,\n                y: 38,\n                filter: \"blur(7px)\"\n            }, {\n                opacity: 1,\n                scale: 1,\n                y: 0,\n                filter: \"blur(0px)\",\n                duration: 1.45,\n                stagger: 0.18,\n                ease: \"power3.out\",\n                delay: 0.16\n            });\n\n            gsap.to(\".media-element:first-child\", {\n                yPercent: 4,\n                ease: \"none\",\n                scrollTrigger: {\n                    trigger: \"main\",\n                    start: \"top top\",\n                    end: \"bottom top\",\n                    scrub: true\n                }\n            });\n\n            gsap.to(\".gallery-wash\", {\n                opacity: 0.72,\n                duration: 4.5,\n                repeat: -1,\n                yoyo: true,\n                ease: \"sine.inOut\"\n            });\n        } else {\n            document.querySelectorAll('.reveal-word').forEach(w => {\n                w.style.transform = 'translateY(0)';\n                w.style.filter = 'blur(0)';\n            });\n\n            document.querySelectorAll('.reveal-fade, .media-element').forEach(e => {\n                e.style.opacity = 1;\n                e.style.filter = 'blur(0)';\n            });\n        }\n    </script>\n\n</body>\n</html>", "preview_file_name": "lumen-atelier-form-in-motion.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/lumen-atelier-form-in-motion.jpg", "source_name": "lumen-atelier-form-in-motion-DESIGN.md", "views": 50, "forks": 0, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-06-21T11:39:54.279152+00:00", "updated_at": "2026-07-02T13:31:36.565027+00:00"}