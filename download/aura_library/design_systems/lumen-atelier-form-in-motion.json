0,0,0,0.64),\n                0 0 58px rgba(216,193,138,0.13);\n        }\n\n        .primary-cta {\n            background:\n                linear-gradient(135deg, #D8C18A, #E9E5DA 48%, #AFA89B);\n            color: #070707;\n            border: 1px solid rgba(233,229,218,0.18);\n            box-shadow:\n                0 24px 84px rgba(0,0,0,0.46),\n                inset 0 1px 0 rgba(255,255,255,0.42);\n        }\n\n        .primary-cta:hover {\n            transform: translateY(-2px);\n            box-shadow:\n                0 34px 110px rgba(0,0,0,0.58),\n                inset 0 1px 0 rgba(255,255,255,0.48);\n        }\n\n        .ghost-link {\n            color: rgba(233,229,218,0.66);\n        }\n\n        .ghost-link:hover {\n            color: var(--gallery-gold);\n        }\n\n        .corner-bracket {\n            border-color: rgba(216,193,138,0.34);\n        }\n\n        .rotating-marker {\n            border-color: rgba(216,193,138,0.34);\n            color: rgba(216,193,138,0.72);\n            background: rgba(7,7,7,0.24);\n            box-shadow:\n                inset 0 0 44px rgba(216,193,138,0.055),\n                0 0 80px rgba(216,193,138,0.05);\n            backdrop-filter: blur(10px);\n            -webkit-backdrop-filter: blur(10px);\n        }\n\n        .meta-rule {\n            border-color: rgba(233,229,218,0.12);\n        }\n\n        .small-label {\n            letter-spacing: 0.22em;\n            text-transform: uppercase;\n        }\n\n        .text-muted {\n            color: rgba(233,229,218,0.58);\n        }\n\n        .text-meta {\n            color: rgba(184,178,166,0.76);\n        }\n\n        .gold-text {\n            color: rgba(216,193,138,0.86);\n        }\n\n        @media (max-width: 768px) {\n            .headline-main,\n            .headline-italic {\n                letter-spacing: -0.045em;\n            }\n        }\n    </style>\n</head>\n\n<body class=\"min-h-screen flex flex-col relative overflow-x-hidden text-[#E9