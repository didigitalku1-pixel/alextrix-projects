ify-between stagger-detail opacity-0\">\n                        <div class=\"flex items-center gap-2\">\n                            <div class=\"flex gap-1.5 px-2\">\n                                <span class=\"size-2.5 rounded-full bg-white/20 border border-white/10 hover:bg-red-400 transition-colors cursor-pointer\"></span>\n                                <span class=\"size-2.5 rounded-full bg-white/20 border border-white/10 hover:bg-yellow-400 transition-colors cursor-pointer\"></span>\n                                <span class=\"size-2.5 rounded-full bg-white/20 border border-white/10 hover:bg-emerald-400 transition-colors cursor-pointer\"></span>\n                            </div>\n                            <span class=\"ml-3 text-xs tracking-tight text-white/50 hidden sm:block\">\n                                workspace / project-alpha\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"hidden sm:flex items-center gap-2 rounded-lg bg-white/5 px-3 py-1.5 border border-white/5 hover:border-white/10 transition-colors backdrop-blur-md\">\n                                <iconify-icon icon=\"solar:magnifer-linear\" class=\"text-white/40 text-sm\"></iconify-icon>\n                                <input class=\"w-32 bg-transparent text-xs text-white/80 placeholder:text-white/30 focus:outline-none sm:w-48\" placeholder=\"Search commands...\">\n                                <span class=\"text-[10px] text-white/30 border border-white/10 rounded px-1\">⌘K</span>\n                            </div>\n                            <button class=\"rounded-lg bg-white/5 p-2 border border-white/5 transition-all hover:bg-white/10\">\n                                <iconify-icon icon=\"solar:bell-linear\" stroke-width=\"1.5\" class=\"text-white/70 text-sm\"></iconify-icon>\n                            </button>\n                            <img alt=\"avatar\" class=\"border border-white/10 size-7 object-cover rounded-full hover:border-white/30 transition-all cursor-pointer\" src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/986db8ed-1c5d-42fb-8c1d-4b3716d2e317_320w.jpg\">\n                        </div>\n                    </div>\n\n                    <!-- Dashboard Grid -->\n                    <div class=\"grid grid-cols-1 lg:grid-cols-4 gap-4 pb-16 sm:pb-2\">\n\n                        <!-- Sidebar -->\n                        <aside class=\"rounded-xl border border-white/5 bg-white/[0.02] p-3 stagger-detail opacity-0 hover:bg-white/[0.04] transition-colors\">\n                            <div class=\"mb-3 px-2 text-[10px] tracking-tight text-white/40 uppercase\">\n                                Environment\n                            </div>\n                            <nav class=\"grid gap-1 font-normal text-xs\">\n                                <button class=\"group flex items-center justify-between rounded-lg px-2 py-2 text-white/60 hover:bg-white/5 hover:text-white/90 transition-all\">\n                                    <span class=\"flex items-center gap-2.5\">\n                                        <iconify-icon icon=\"solar:widget-2-linear\" stroke-width=\"1.5\" class=\"text-sm opacity-50 group-hover:opacity-100 transition-opacity\"></iconify-icon>\n                                        Overview\n                                    </span>\n                                </button>\n                                <button class=\"group flex items-center justify-between rounded-lg px-2 py-2 text-white/90 bg-white/5 transition-all border border-white/5 shadow-sm\">\n                                    <span class=\"flex items-center gap-2.5\">\n                                        <iconify-icon icon=\"solar:cpu-linear\" stroke-width=\"1.5\" class=\"text-sm text-blue-400\"></iconify-icon>\n                                        Deployments\n                                    </span>\n                                    <span class=\"rounded bg-blue-500/10 text-blue-400 px-1.5 py-0.5 text-[9px] border border-blue-500/20\">Active</span>\n                                </button>\n                                <button class=\"group flex items-center justify-between rounded-lg px-2 py-2 text-white/60 hover:bg-white/5 hover:text-white/90 transition-all\">\n                                    <span class=\"flex items-center gap-2.5\">\n                                        <iconify-icon icon=\"solar:folder-with-files-linear\" stroke-width=\"1.5\" class=\"text-sm opacity-50 group-hover:opacity-100 transition-opacity\"></iconify-icon>\n                                        Resources\n                                    </span>\n                                    <span class=\"text-[10px] text-white/30 group-hover:text-white/60\">24</span>\n                                </button>\n                                <button class=\"group flex items-center justify-between rounded-lg px-2 py-2 text-white/60 hover:bg-white/5 hover:text-white/90 transition-all\">\n                                    <span class=\"flex items-center gap-2.5\">\n                                        <iconify-icon icon=\"solar:chart-square-linear\" stroke-width=\"1.5\" class=\"text-sm opacity-50 group-hover:opacity-100 transition-opacity\"></iconify-icon>\n                                        Analytics\n                                    </span>\n                                </button>\n                                <div class=\"h-px bg-white/5 my-2 mx-2\"></div>\n                                <button class=\"group flex items-center justify-between rounded-lg px-2 py-2 text-white/60 hover:bg-white/5 hover:text-white/90 transition-all\">\n                                    <span class=\"flex items-center gap-2.5\">\n                                        <iconify-icon icon=\"solar:settings-linear\" stroke-width=\"1.5\" class=\"text-sm opacity-50 group-hover:opacity-100 transition-opacity\"></iconify-icon>\n                                        Settings\n                                    </span>\n                                </button>\n                            </nav>\n                        </aside>\n\n                        <!-- Main Content Area (Spans 3 cols) -->\n                        <div class=\"col-span-1 lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-4\">\n\n                            <!-- Activity Card -->\n                            <div class=\"rounded-xl border border-white/5 bg-white/[0.02] p-4 stagger-detail opacity-0 hover:bg-white/[0.04] transition-colors flex flex-col\">\n                                <div class=\"mb-4 flex items-center justify-between\">\n                                    <span class=\"text-xs font-normal text-white/50 tracking-tight\">System Events</span>\n                                    <iconify-icon icon=\"solar:menu-dots-linear\" class=\"text-white/30 cursor-pointer hover:text-white/70\"></iconify-icon>\n                                </div>\n                                <div class=\"grid gap-2.5 flex-grow\">\n                                    <div class=\"group flex items-center justify-between rounded-lg bg-white/[0.02] border border-white/5 px-3 py-2.5 hover:bg-white/[0.06] hover:border-white/10 transition-all cursor-pointer\">\n                                        <div class=\"flex items-center gap-3\">\n                                            <div class=\"relative\">\n                                                <img src=\"https://i.pravatar.cc/100?img=1\" class=\"size-6 rounded-full border border-white/10 grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all\">\n                                                <div class=\"absolute -bottom-0.5 -right-0.5 size-2.5 bg-[#050505] rounded-full flex items-center justify-center\"><div class=\"size-1.5 bg-emerald-400 rounded-full\"></div></div>\n                                            </div>\n                                            <div class=\"flex flex-col\">\n                                                <span class=\"text-xs text-white/80\">Production Sync</span>\n                                                <span class=\"text-[10px] text-white/40\">API Gateway updated</span>\n                                            </div>\n                                        </div>\n                                        <span class=\"text-[10px] text-white/30\">Just now</span>\n                                    </div>\n                                    <div class=\"group flex items-center justify-between rounded-lg bg-white/[0.02] border border-white/5 px-3 py-2.5 hover:bg-white/[0.06] hover:border-white/10 transition-all cursor-pointer\">\n                                        <div class=\"flex items-center gap-3\">\n                                            <div class=\"relative\">\n                                                <div class=\"size-6 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/50 group-hover:text-white/80\"><iconify-icon icon=\"solar:code-linear\" class=\"text-xs\"></iconify-icon></div>\n                                                <div class=\"absolute -bottom-0.5 -right-0.5 size-2.5 bg-[#050505] rounded-full flex items-center justify-center\"><div class=\"size-1.5 bg-blue-400 rounded-full animate-pulse\"></div></div>\n                                            </div>\n                                            <div class=\"flex flex-col\">\n                                                <span class=\"text-xs text-white/80\">Build PR-402</span>\n                                                <span class=\"text-[10px] text-white/40\">Compiling assets...</span>\n                                            </div>\n                                        </div>\n                                        