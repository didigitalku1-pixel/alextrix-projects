    opacity: 1,\n                y: 0,\n                duration: 1,\n                ease: \"power3.out\",\n                delay: 0.1\n            });\n\n            // 2. Masked Word Reveal for Main Title\n            gsap.to('.reveal-word', {\n                scrollTrigger: {\n                    trigger: '#hero-title',\n                    start: 'top 85%'\n                },\n                y: \"0%\",\n                duration: 0.8,\n                stagger: 0.1,\n                ease: \"power3.out\",\n                delay: 0.2\n            });\n\n            // 3. Dashboard Container Entrance Scale + Opacity\n            gsap.to('.dashboard-container', {\n                opacity: 1,\n                scale: 1,\n                duration: 1.2,\n                ease: \"expo.out\",\n                delay: 0.4\n            });\n\n            // 4. Stagger Detail Items in Dashboard\n            gsap.to('.stagger-detail', {\n                scrollTrigger: {\n                    trigger: '.dashboard-container',\n                    start: 'top 75%'\n                },\n                opacity: 1,\n                y: 0,\n                duration: 0.8,\n                stagger: 0.08,\n                ease: \"power2.out\",\n                clearProps: \"transform\" // allows hover scale to work properly later\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "analytics-dashboard-remixed.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/analytics-dashboard-remixed.jpg", "source_name": "analytics-dashboard-remixed-DESIGN.md", "views": 491, "forks": 4, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-02T01:34:00.274306+00:00"}