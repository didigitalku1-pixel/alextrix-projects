n                                        <div class=\"schema-node size-9 rounded-xl bg-gradient-to-b from-emerald-500/20 to-emerald-500/5 border border-emerald-500/20 flex items-center justify-center z-10 relative shadow-[0_0_20px_rgba(52,211,153,0.1)] backdrop-blur-md\">\n                                            <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-emerald-400\"></iconify-icon>\n                                            <div class=\"absolute -top-6 text-[9px] text-emerald-400/60 whitespace-nowrap\">Success</div>\n                                        </div>\n                                    </div>\n                                    <style>\n                                        .schema-pulse {\n                                            stroke-dasharray: 40 100;\n                                            animation: flowLine 3s linear infinite;\n                                        }\n                                        .delay-100 { animation-delay: -0.75s; }\n                                        .delay-200 { animation-delay: -1.5s; }\n                                        .delay-300 { animation-delay: -2.25s; }\n                                        @keyframes flowLine {\n                                            from { stroke-dashoffset: 140; }\n                                            to { stroke-dashoffset: 0; }\n                                        }\n                                        /* Helper to keep SVG paths scaled responsive-ish */\n                                        svg .vector-line { vector-effect: non-scaling-stroke; }\n                                    </style>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Floating Course / Overlay Card -->\n                    <div class=\"absolute -bottom-8 sm:bottom-4 left-4 sm:left-auto sm:right-4 w-[calc(100%-2rem)] sm:w-[