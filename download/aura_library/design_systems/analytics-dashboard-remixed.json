conify-icon icon=\"solar:alt-arrow-right-linear\"></iconify-icon>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- ORBIT Component (Right) -->\n                <div class=\"pointer-events-none absolute -right-24 top-10 hidden sm:block stagger-detail opacity-0\" style=\"z-index:-1;\">\n                    <div class=\"relative flex items-center justify-center rounded-full bg-[#050505] p-3 border border-white/5 shadow-[0_0_40px_rgba(58,131,255,0.05)]\">\n                        <div class=\"size-32\">\n                            <div class=\"relative size-full\">\n                                <svg viewBox=\"0 0 200 200\" class=\"block size-full overflow-visible\" data-orbit value=\"98\" data-label=\"EFFICIENCY\">\n                                    <defs>\n                                        <filter id=\"glowLight\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n                                            <feGaussianBlur stdDeviation=\"4\" result=\"blur\"></feGaussianBlur>\n                                            <feMerge>\n                                                <feMergeNode in=\"blur\"></feMergeNode>\n                                                <feMergeNode in=\"SourceGraphic\"></feMergeNode>\n                                            </feMerge>\n                                        </filter>\n                                        <linearGradient id=\"orbitGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                                            <stop offset=\"0%\" stop-color=\"#C8D5FF\"></stop>\n                                            <stop offset=\"100%\" stop-color=\"#3A83FF\"></stop>\n                                        </linearGradient>\n                                        <path id=\"txtPathRight\" d=\"M100,100 m-94,0 a94,94 0 1,1 188,0 a94,94 0 1,1 -188,0\"></path>\n         