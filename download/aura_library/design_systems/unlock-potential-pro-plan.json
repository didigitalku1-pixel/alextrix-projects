">\n                <span class=\"rounded-full p-px shrink-0\" style=\"background:linear-gradient(135deg, rgba(212,237,87,0.5), rgba(255,255,255,0.08) 55%, rgba(255,255,255,0.02));\">\n                  <span class=\"flex h-14 w-14 items-center justify-center rounded-full bg-[#15160f]\">\n                    <iconify-icon icon=\"solar:headphones-round-linear\" class=\"text-[#d4ed57] text-2xl\" stroke-width=\"1.5\" aria-hidden=\"true\"></iconify-icon>\n                  </span>\n                </span>\n                <div>\n                  <h3 class=\"text-base font-medium text-white\">Priority Support</h3>\n                  <p class=\"mt-0.5 text-sm font-light text-zinc-500\">Get help when you need it</p>\n                </div>\n              </li>\n            </ul>\n          </div>\n\n          <!-- CENTER : layered stack illustration -->\n          <div class=\"lg:col-span-4 relative flex items-center justify-center min-h-[22rem] lg:min-h-0\" aria-hidden=\"true\">\n            <div class=\"relative h-80 w-72 sm:h-96 sm:w-80\" style=\"perspective:1200px;\">\n\n              <!-- vertical beam -->\n              <div class=\"absolute left-1/2 top-0 bottom-10 w-px -translate-x-1/2\" style=\"background:linear-gradient(to bottom, rgba(212,237,87,0.9), rgba(212,237,87,0.15) 60%, transparent);\"></div>\n              <div class=\"absolute left-1/2 top-0 h-2.5 w-2.5 -translate-x-1/2 rounded-full\" style=\"background:#d4ed57; box-shadow:0 0 18px 4px rgba(212,237,87,0.6);\"></div>\n\n              <!-- Layer 1 : glowing top -->\n              <div class=\"stack-layer absolute left-1/2 top-[18%] h-44 w-44 sm:h-52 sm:w-52 -translate-x-1/2 rounded-3xl\" style=\"transform-style:preserve-3d; transform:translateX(-50%) rotateX(58deg) rotateZ(45deg); background:linear-gradient(135deg, rgba(220,242,110,0.95), rgba(190,220,70,0.8)); box-shadow:0 0 60px 10px rgba(212,237,87,0.35), inset 0 0 30px rgba(255,255,255,0.35); border:1px solid rgba(255,255,255,0.5);\"></div>\n\n              <!-- Layer 2 -->\n              <div class=\"stack-layer absolute left-1/2 top-[36%] h-44 w-44 sm:h-52 sm:w-52 -translate-x-1/2 rounded-3xl\" style=\"transform:translateX(-50%) rotateX(58deg) rotateZ(45deg); background:linear-gradient(135deg,#26271f,#15160f); border:1px solid rgba(212,237,87,0.25); box-shadow:0 14px 30px rgba(0,0,0,0.6);\"></div>\n\n              <!-- Layer 3 -->\n              <div class=\"stack-layer absolute left-1/2 top-[52%] h-44 w-44 sm:h-52 sm:w-52 -translate-x-1/2 rounded-3xl\" style=\"transform:translateX(-50%) rotateX(58deg) rotateZ(45deg); background:linear-gradient(135deg,#202118,#101109); border:1px solid rgba(255,255,255,0.12); box-shadow:0 14px 30px rgba(0,0,0,0.6);\"></div>\n\n              <!-- Base layer with rings -->\n              <div class=\"stack-layer absolute left-1/2 top-[68%] h-52 w-52 sm:h-60 sm:w-60 -translate-x-1/2 rounded-[2rem] overflow-hidden\" style=\"transform:translateX(-50%) rotateX(58deg) rotateZ(45deg); background:linear-gradient(135deg,#2a2b22,#0d0e08); border:1px solid rgba(212,237,87,0.2); box-shadow:0 24px 50px rgba(0,0,0,0.7);\">\n                <div class=\"absolute inset-6 rounded-3xl\" style=\"border:1px solid rgba(212,237,87,0.18);\"></div>\n                <div class=\"absolute inset-12 rounded-2xl\" style=\"border:1px solid rgba(212,237,87,0.25);\"></div>\n                <div class=\"absolute inset-[4.5rem] rounded-xl\" style=\"border:1px solid rgba(212,237,87,0.35);\"></div>\n                <div class=\"absolute left-1/2 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full\" style=\"background:#d4ed57; box-shadow:0 0 20px 6px rgba(212,237,87,0.5);\"></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- RIGHT : pricing -->\n          <div class=\"lg:col-span-4 relative\">\n            <!-- Mobile light bg -->\n            <div class=\"absolute -inset-6 rounded-3xl lg:hidden\" style=\"background:linear-gradient(160deg,#f4f6e9,#e6e9d8);\" aria-hidden=\"true\"></div>\n\n            <div class=\"relative lg:pl-8\">\n              <p class=\"reveal-fade text-sm font-medium tracking-[0.18em] text-[#9aaf2e]\">PRO PLAN</p>\n\n              <div class=\"mt-4 flex items-end gap-1 text-zinc-900\">\n                <span class=\"reveal-fade -translate-y-1 text-3xl font-light\" style=\"font-family:'Michroma',sans-serif;\" aria-hidden=\"true\">$</span>\n                <span class=\"price-number text-7xl sm:text-8xl font-light leading-none tracking-tight\" style=\"font-family:'Inter',sans-serif;\" aria-label=\"49 dollars per month\">49</span>\n                <span class=\"reveal-fade pb-2 text-2xl font-light text-zinc-500\">/mo</span>\n              </div>\n\n              <div class=\"reveal-fade mt-4 flex items-center gap-3\">\n                <span class=\"text-base font-light text-zinc-600\">Billed annually</span>\n                <span class=\"rounded-full bg-[#e3eebb] px-3.5 py-1.5 text-xs font-medium text-[#4a5713]\" style=\"border:1px solid rgba(154,175,46,0.35);\">SAVE 20%</span>\n              </div>\n\n              <!-- CTA with gradient border -->\n              <div class=\"reveal-fade mt-8 rounded-2xl p-px\" style=\"background:linear-gradient(120deg, rgba(212,237,87,0.6), rgba(255,255,255,0.15) 40%, rgba(212,237,87,0.3));\">\n                <a href=\"#\" class=\"group flex w-full items-center justify-center gap-3 rounded-[calc(1rem-1px)] bg-[#101109] px-8 py-4 text-base font-medium text-white transition-colors duration-200 hover:bg-[#1a1b12]\" aria-label=\"Get started with the Pro plan\">\n                  Get Started\n                  <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-[#d4ed57] text-xl transition-transform duration-200 group-hover:translate-x-1\" stroke-width=\"1.5\" aria-hidden=\"true\"></iconify-icon>\n                </a>\n              </div>\n\n              <!-- Guarantee divider -->\n              <div class=\"reveal-fade mt-7 flex items-center gap-4\">\n                <span class=\"h-px flex-1 bg-zinc-300/80\" aria-hidden=\"true\"></span>\n                <span class=\"text-xs font-medium tracking-[0.14em] text-zinc-500 whitespace-nowrap\">30-DAY MONEY BACK GUARANTEE</span>\n                <span class=\"h-px flex-1 bg-zinc-300/80\" aria-hidden=\"true\"></span>\n              </div>\n\n              <!-- Plan includes with gradient border -->\n              <div class=\"reveal-fade mt-7 rounded-2xl p-px\" style=\"background:linear-gradient(135deg, rgba(154,175,46,0.4), rgba(0,0,0,0.08) 50%, rgba(154,175,46,0.25));\">\n                <div class=\"rounded-[calc(1rem-1px)] bg-[#f6f8ec]/90 p-6\" style=\"backdrop-filter:blur(6px);\">\n                  <h2 class=\"text-xs font-medium tracking-[0.18em] text-zinc-600\">PLAN INCLUDES</h2>\n                  <ul class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5\" role=\"list\">\n                    <li class=\"plan-item flex items-center gap-2.5\">\n                      <span class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[#dce8ad]\" aria-hidden=\"true\">\n                        <iconify-icon icon=\"solar:check-read-linear\" class=\"text-[#5a6a18] text-xs\" stroke-width=\"1.5\"></iconify-icon>\n                      </span>\n                      <span class=\"text-sm font-light text-zinc-700\">Unlimited Projects</span>\n                    </li>\n                    <li class=\"plan-item flex items-center gap-2.5\">\n                      <span class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[#dce8ad]\" aria-hidden=\"true\">\n                        <iconify-icon icon=\"solar:check-read-linear\" class=\"text-[#5a6a18] text-xs\" stroke-width=\"1.5\"></iconify-icon>\n                      </span>\n                      <span class=\"text-sm font-light text-zinc-700\">Priority Support</span>\n                    </li>\n                    <li class=\"plan-item flex items-center gap-2.5\">\n                      <span class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[#dce8ad]\" aria-hidden=\"true\">\n                        <iconify-icon icon=\"solar:check-read-linear\" class=\"text-[#5a6a18] text-xs\" stroke-width=\"1.5\"></iconify-icon>\n                      </span>\n                      <span class=\"text-sm font-light text-zinc-700\">Advanced Analytics</span>\n                    </li>\n                    <li class=\"plan-item flex items-center gap-2.5\">\n                      <span class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[#dce8ad]\" aria-hidden=\"true\">\n                        <iconify-icon icon=\"solar:check-read-linear\" class=\"text-[#5a6a18] text-xs\" stroke-width=\"1.5\"></iconify-icon>\n                      </span>\n                      <span class=\"text-sm font-light text-zinc-700\">Custom Integrations</span>\n                    </li>\n                    <li class=\"plan-item flex items-center gap-2.5\">\n                      <span class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[#dce8ad]\" aria-hidden=\"true\">\n                        <iconify-icon icon=\"solar:check-read-linear\" class=\"text-[#5a6a18] text-xs\" stroke-width=\"1.5\"></iconify-icon>\n                      </span>\n                      <span class=\"text-sm font-light text-zinc-700\">Team Collaboration</span>\n                    </li>\n                    <li class=\"plan-item flex items-center gap-2.5\">\n                      <span class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[#dce8ad]\" aria-hidden=\"true\">\n                        <iconify-icon icon=\"solar:check-read-linear\" class=\"text-[#5a6a18] text-xs\" stroke-width=\"1.5\"></iconify-icon>\n                      </span>\n                      <span class=\"text-sm font-light text-zinc-700\">Early Access</span>\n                    </li>\n                  </ul>\n                </div>\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </section>\n    </div>\n  </main>\n\n  <script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Masked staggered word reveal for headline\n    gsap.set(\".mask-word\", { yPercent: 110 });\n    gsap.to(\".mask-word\", {\n      yPercent: 0,\n      duration: 1.1,\n      ease: \"power4.out\",\n      stagger: 0.14,\n      scrollTrigger: { trigger: \".mask-line\", start: \"top 85%\" }\n    });\n\n    // Masked word reveal for subcopy\n    (function () {\n      var p = document.getElementById(\"subcopy\");\n      var words = p.textContent.trim().split(/\\s+/);\n      p.innerHTML = words.map(function (w) {\n        return '<span class=\"inline-block overflow-hidden align-bottom\"><span class=\"sub-word inline-block\">' + w + '&nbsp;</span></span>';\n      }).join(\"\");\n      gsap.set(\".sub-word\", { yPercent: 110 });\n      gsap.to(\".sub-word\", {\n        yPercent: 0,\n        duration: 0.8,\n        ease: \"power3.out\",\n        stagger: 0.035,\n        scrollTrigger: { trigger: \"#subcopy\", start: \"top 88%\" }\n      });\n    })();\n\n    // Feature list stagger\n    gsap.from(\".feature-item\", {\n      opacity: 0, x: -28, duration: 0.8, ease: \"power3.out\", stagger: 0.15,\n      scrollTrigger: { trigger: \".feature-item\", start: \"top 90%\" }\n    });\n\n    // Right column fades\n    gsap.utils.toArray(\".reveal-fade\").forEach(function (el, i) {\n      gsap.from(el, {\n        opacity: 0, y: 22, duration: 0.8, ease: \"power3.out\", delay: (i % 6) * 0.06,\n        scrollTrigger: { trigger: el, start: \"top 92%\" }\n      });\n    });\n\n    // Price number count-up\n    (function () {\n      var el = document.querySelector(\".price-number\");\n      var obj = { v: 0 };\n      gsap.to(obj, {\n        v: 49, duration: 1.4, ease: \"power2.out\",\n        onUpdate: function () { el.textContent = Math.round(obj.v); },\n        scrollTrigger: { trigger: el, start: \"top 90%\" }\n      });\n    })();\n\n    // Plan includes items stagger\n    gsap.from(\".plan-item\", {\n      opacity: 0, y: 14, duration: 0.6, ease: \"power2.out\", stagger: 0.08,\n      scrollTrigger: { trigger: \".plan-item\", start: \"top 95%\" }\n    });\n\n    // Stack layers: entrance + continuous float\n    gsap.from(\".stack-layer\", {\n      opacity: 0, y: 60, duration: 1.2, ease: \"power3.out\", stagger: 0.12,\n      scrollTrigger: { trigger: \".stack-layer\", start: \"top 90%\" }\n    });\n    gsap.utils.toArray(\".stack-layer\").forEach(function (layer, i) {\n      gsap.to(layer, {\n        y: i === 0 ? -14 : -7 - i * 2,\n        duration: 2.6 + i * 0.4,\n        ease: \"sine.inOut\",\n        yoyo: true,\n        repeat: -1,\n        delay: i * 0.25\n      });\n    });\n  </script>\n</body>\n</html>", "preview_file_name": "unlock-potential-pro-plan.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/unlock-potential-pro-plan.jpg", "source_name": "unlock-potential-pro-plan-DESIGN.md", "views": 166, "forks": 3, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-06-21T11:39:54.279152+00:00", "updated_at": "2026-07-03T13:19:13.509973+00:00"}