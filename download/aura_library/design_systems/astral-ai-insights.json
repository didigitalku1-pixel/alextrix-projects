g-white/5 cursor-pointer transition-colors\">\n                                    <iconify-icon icon=\"solar:bell-bing-linear\"></iconify-icon>\n                                    <span class=\"font-medium text-xs\">Alerts</span>\n                                </div>\n                            </div>\n                            <div class=\"mt-auto mb-6 px-6\">\n                                <div class=\"flex items-center gap-3 text-neutral-400 hover:text-neutral-200 cursor-pointer transition-colors\">\n                                    <iconify-icon icon=\"solar:settings-linear\"></iconify-icon>\n                                    <span class=\"font-medium text-xs\">Settings</span>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Main Content Area -->\n                        <div class=\"flex-1 flex flex-col p-6 overflow-hidden\">\n\n                            <!-- Header -->\n                            <div class=\"flex justify-between items-start mb-6\">\n                                <div>\n                                    <h3 class=\"text-base font-medium text-neutral-100\">Good morning, Alex 👋</h3>\n                                    <p class=\"text-xs text-neutral-500 mt-1\">Here's what's happening with your projects today.</p>\n                                </div>\n                                <div class=\"flex items-center gap-2 px-3 py-1.5 rounded-md border border-white/10 bg-white/5 text-xs text-neutral-300\">\n                                    <iconify-icon icon=\"solar:calendar-linear\"></iconify-icon>\n                                    May 1 – May 31\n                                    <iconify-icon icon=\"solar:alt-arrow-down-linear\" class=\"ml-1 text-neutral-500\"></iconify-icon>\n                                </div>\n                            </div>\n\n                            <!-- Metrics Row -->\n                            <div class=\"grid grid-cols-4 gap-4 mb-6\">\n                                <!-- Card 1 -->\n                                <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 flex flex-col gap-1 dash-card transform translate-y-4 opacity-0\">\n                                    <span class=\"text-[10px] font-medium text-neutral-400\">Total Revenue</span>\n                                    <span class=\"text-lg font-medium text-white tracking-tight\">$84,230</span>\n                                    <div class=\"flex items-center gap-1 text-[10px] text-green-400 mt-1\">\n                                        <iconify-icon icon=\"solar:arrow-right-up-linear\"></iconify-icon>\n                                        12.5%\n                                    </div>\n                                    <!-- Mini sparkline -->\n                                    <div class=\"w-full h-6 mt-2 relative\">\n                                        <svg viewBox=\"0 0 100 20\" class=\"w-full h-full preserve-aspect-none\" style=\"overflow: visible;\">\n                                            <path d=\"M0,15 Q10,5 20,10 T40,12 T60,5 T80,15 T100,2\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"1.5\" class=\"chart-line\" style=\"stroke-dasharray: 120; stroke-dashoffset: 120;\"></path>\n                                        </svg>\n                                    </div>\n                                </div>\n                                <!-- Card 2 -->\n                                <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 flex flex-col gap-1 dash-card transform translate-y-4 opacity-0\">\n                                    <span class=\"text-[10px] font-medium text-neutral-400\">Active Users</span>\n                                    <span class=\"text-lg font-medium text-white tracking-tight\">23,846</span>\n                                    <div class=\"flex items-center gap-1 text-[10px] text-green-400 mt-1\">\n                                        <iconify-icon icon=\"solar:arrow-right-up-linear\"></iconify-icon>\n                                        8.2%\n                                    </div>\n                                    <div class=\"w-full h-6 mt-2 relative\">\n                                        <svg viewBox=\"0 0 100 20\" class=\"w-full h-full preserve-aspect-none\" style=\"overflow: visible;\">\n                                            <path d=\"M0,18 Q15,10 25,15 T50,8 T75,12 T100,4\" fill=\"none\" stroke=\"#60a5fa\" stroke-width=\"1.5\" class=\"chart-line\" style=\"stroke-dasharray: 120; stroke-dashoffset: 120;\"></path>\n                                        </svg>\n                                    </div>\n                                </div>\n                                <!-- Card 3 -->\n                                <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 flex flex-col gap-1 dash-card transform translate-y-4 opacity-0\">\n                                    <span class=\"text-[10px] font-medium text-neutral-400\">Conversion Rate</span>\n                                    <span class=\"text-lg font-medium text-white tracking-tight\">4.32%</span>\n                                    <div class=\"flex items-center gap-1 text-[10px] text-orange-400 mt-1\">\n                                        <iconify-icon icon=\"solar:arrow-right-up-linear\"></iconify-icon>\n                                        16.3%\n                                    </div>\n                                    <div class=\"w-full h-6 mt-2 relative\">\n                                        <svg viewBox=\"0 0 100 20\" class=\"w-full h-full preserve-aspect-none\" style=\"overflow: visible;\">\n                                            <path d=\"M0,10 Q20,15 30,5 T60,10 T80,5 T100,12\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.5\" class=\"chart-line\" style=\"stroke-dasharray: 120; stroke-dashoffset: 120;\"></path>\n                                        </svg>\n                                    </div>\n                                </div>\n                                <!-- Card 4 -->\n                                <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 flex flex-col gap-1 dash-card transform translate-y-4 opacity-0\">\n                                    <span class=\"text-[10px] font-medium text-neutral-400\">Sessions</span>\n                                    <span class=\"text-lg font-medium text-white tracking-tight\">125,430</span>\n                                    <div class=\"flex items-center gap-1 text-[10px] text-green-400 mt-1\">\n                                        <iconify-icon icon=\"solar:arrow-right-up-linear\"></iconify-icon>\n                                        7.1%\n                                    </div>\n                                    <div class=\"w-full h-6 mt-2 relative\">\n                                        <svg viewBox=\"0 0 100 20\" class=\"w-full h-full preserve-aspect-none\" style=\"overflow: visible;\">\n                                            <path d=\"M0,12 Q15,8 30,14 T65,6 T85,10 T100,3\" fill=\"none\" stroke=\"#c084fc\" stroke-width=\"1.5\" class=\"chart-line\" style=\"stroke-dasharray: 120; stroke-dashoffset: 120;\"></path>\n                                        </svg>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- Bottom Charts Area -->\n                            <div class=\"flex-1 grid grid-cols-3 gap-6\">\n                                <!-- Main Line Chart -->\n                                <div class=\"col-span-2 rounded-xl bg-white/[0.02] border border-white/5 p-4 flex flex-col relative\">\n                                    <div class=\"flex justify-between items-center mb-4\">\n                                        <span class=\"text-xs font-medium text-neutral-200\">Performance Overview</span>\n                                        <div class=\"flex items-center gap-1 text-[10px] text-neutral-400 border border-white/10 rounded px-2 py-1 cursor-pointer\">\n                                            This Month <iconify-icon icon=\"solar:alt-arrow-down-linear\"></iconify-icon>\n                                        </div>\n                                    </div>\n                                    <!-- Chart Grid Lines -->\n                                    <div class=\"absolute inset-0 pt-12 pb-8 px-4 flex flex-col justify-between pointer-events-none opacity-20\">\n                                        <div class=\"border-b border-white/20 w-full h-px\"></div>\n                                        <div class=\"border-b border-white/20 w-full h-px\"></div>\n                                        <div class=\"border-b border-white/20 w-full h-px\"></div>\n                                        <div class=\"border-b border-white/20 w-full h-px\"></div>\n                                    </div>\n                                    <!-- Y Axis Labels -->\n                                    <div class=\"absolute left-4 pt-10 bottom-8 flex flex-col justify-between text-[8px] text-neutral-600 h-[calc(100%-4.5rem)]\">\n                                        <span>100K</span><span>75K</span><span>50K</span><span>25K</span><span>0</span>\n                                    </div>\n                                    <!-- SVG Lines -->\n                                    <div class=\"flex-1 relative ml-6 mt-2\">\n                                        <svg viewBox=\"0 0 400 150\" class=\"w-full h-full\" style=\"overflow: visible;\" preserveAspectRatio=\"none\">\n                                            <!-- Purple Line -->\n                                            <path d=\"M0,120 C40,90 80,130 120,80 C160,30 200,90 240,60 C280,30 320,60 360,20 L400,40\" fill=\"none\" stroke=\"#c084fc\" stroke-width=\"2.5\" class=\"chart-line-main\" style=\"stroke-dasharray: 600; stroke-dashoffset: 600; filter: drop-shadow(0px 4px 6px rgba(192,132,252,0.3));\"></path>\n                                            <!-- Blue Line -->\n                                            <path d=\"M0,140 C50,130 90,145 140,110 C190,75 230,120 280,90 C330,60 370,100 400,70\" fill=\"none\" stroke=\"#60a5fa\" stroke-width=\"2\" class=\"chart-line-main\" style=\"stroke-dasharray: 600; stroke-dashoffset: 600; opacity: 0.7;\"></path>\n                                            <!-- Orange Line -->\n                                            <path d=\"M0,150 C60,145 100,155 160,130 C220,105 260,140 320,120 C380,100 390,130 400,110\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.5\" class=\"chart-line-main\" style=\"stroke-dasharray: 600; stroke-dashoffset: 600; opacity: 0.5;\"></path>\n                                        </svg>\n                                    </div>\n                                    <!-- X Axis Labels -->\n                                    <div class=\"flex justify-between text-[8px] text-neutral-600 ml-6 mt-2 px-2\">\n                                        <span>May 1</span><span>May 7</span><span>May 14</span><span>May 21</span><span>May 31</span>\n                                    </div>\n                                </div>\n\n                                <!-- Donut Chart Area -->\n                                <div class=\"col-span-1 rounded-xl bg-white/[0.02] border border-white/5 p-4 flex flex-col\">\n                                    <span class=\"text-xs font-medium text-neutral-200 mb-4\">Top Channels</span>\n                                    <div class=\"flex-1 flex flex-col items-center justify-center relative\">\n                                        <!-- CSS Donut approximation -->\n                                        <div id=\"donut-chart\" class=\"w-24 h-24 rounded-full relative flex items-center justify-center transform scale-50 opacity-0\"\n                                             style=\"background: conic-gradient(from 180deg, #c084fc 0% 48%, #3b82f6 48% 76%, #8b5cf6 76% 92%, #fb923c 92% 100%);\">\n                                            <div class=\"absolute inset-0 rounded-full box-border border-[16px] border-[#0A0A12] bg-transparent pointer-events-none\"></div>\n                                            <div class=\"w-16 h-16 rounded-full bg-[#0A0A12] flex items-center justify-center z-10 shadow-inner\">\n                                                <span class=\"text-xs font-medium text-white\">125K</span>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"mt-4 flex flex-col gap-2\">\n                                        <div class=\"flex justify-between items-center text-[9px]\">\n                                            <div class=\"flex items-center gap-1.5 text-neutral-400\"><div class=\"w-1.5 h-1.5 rounded-full bg-purple-400\"></div>Organic Search</div>\n                                            <span class=\"text-white\">48%</span>\n                                        </div>\n                                        <div class=\"flex justify-between items-center text-[9px]\">\n                                            <div class=\"flex items-center gap-1.5 text-neutral-400\"><div class=\"w-1.5 h-1.5 rounded-full bg-blue-500\"></div>Direct</div>\n                                            <span class=\"text-white\">28%</span>\n                                        </div>\n                                        <div class=\"flex justify-between items-center text-[9px]\">\n                                            <div class=\"flex items-center gap-1.5 text-neutral-400\"><div class=\"w-1.5 h-1.5 rounded-full bg-indigo-500\"></div>Referral</div>\n                                            <span class=\"text-white\">16%</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Bottom Section: Logos & Features -->\n    <section class=\"relative z-10 max-w-7xl mx-auto px-6 pb-24 flex flex-col gap-16\">\n\n        <!-- Trusted By -->\n        <div class=\"flex flex-col gap-4\">\n            <span class=\"text-[10px] font-medium tracking-widest text-neutral-500 uppercase\">Trusted by innovative teams</span>\n            <div class=\"flex flex-wrap items-center gap-8 md:gap-12 opacity-50 grayscale hover:grayscale-0 transition-all duration-500\">\n                <!-- Placeholder Logos using Iconify for structure -->\n                <div class=\"flex items-center gap-1.5 text-xl font-medium tracking-tight\"><iconify-icon icon=\"solar:augmented-reality-linear\"></iconify-icon> layer</div>\n                <div class=\"flex items-center gap-1.5 text-xl font-medium tracking-tight\"><iconify-icon icon=\"solar:radar-linear\"></iconify-icon> Echo</div>\n                <div class=\"flex items-center gap-1.5 text-xl font-medium tracking-tight\"><iconify-icon icon=\"solar:cpu-linear\"></iconify-icon> vertex</div>\n                <div class=\"flex items-center gap-1.5 text-xl font-medium tracking-tight\"><iconify-icon icon=\"solar:cloud-linear\"></iconify-icon> cloudly</div>\n                <div class=\"flex items-center gap-1.5 text-xl font-medium tracking-tight\"><iconify-icon icon=\"solar:box-minimalistic-linear\"></iconify-icon> pixelz</div>\n            </div>\n        </div>\n\n        <!-- Features Grid -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n            <!-- Feature 1 -->\n            <div class=\"p-[1px] rounded-xl bg-gradient-to-b from-white/10 to-transparent feature-card opacity-0 transform translate-y-8\">\n                <div class=\"h-full p-5 rounded-xl bg-[#080810]/90 backdrop-blur-sm border border-white/5 flex flex-col gap-2 hover:bg-[#0A0A14] transition-colors cursor-default\">\n                    <iconify-icon icon=\"solar:layers-minimalistic-linear\" class=\"text-2xl text-purple-400 mb-1\"></iconify-icon>\n                    <h4 class=\"text-sm font-medium text-neutral-100\">Unify Your Data</h4>\n                    <p class=\"text-xs text-neutral-500 leading-relaxed\">Connect all your sources and bring your data together.</p>\n                </div>\n            </div>\n            <!-- Feature 2 -->\n            <div class=\"p-[1px] rounded-xl bg-gradient-to-b from-white/10 to-transparent feature-card opacity-0 transform translate-y-8\">\n                <div class=\"h-full p-5 rounded-xl bg-[#080810]/90 backdrop-blur-sm border border-white/5 flex flex-col gap-2 hover:bg-[#0A0A14] transition-colors cursor-default\">\n                    <iconify-icon icon=\"solar:graph-up-linear\" class=\"text-2xl text-orange-400 mb-1\"></iconify-icon>\n                    <h4 class=\"text-sm font-medium text-neutral-100\">Real-time Insights</h4>\n                    <p class=\"text-xs text-neutral-500 leading-relaxed\">Get up-to-the-minute analytics you can act on instantly.</p>\n                </div>\n            </div>\n            <!-- Feature 3 -->\n            <div class=\"p-[1px] rounded-xl bg-gradient-to-b from-white/10 to-transparent feature-card opacity-0 transform translate-y-8\">\n                <div class=\"h-full p-5 rounded-xl bg-[#080810]/90 backdrop-blur-sm border border-white/5 flex flex-col gap-2 hover:bg-[#0A0A14] transition-colors cursor-default\">\n                    <iconify-icon icon=\"solar:bolt-linear\" class=\"text-2xl text-pink-400 mb-1\"></iconify-icon>\n                    <h4 class=\"text-sm font-medium text-neutral-100\">Automate Smarter</h4>\n                    <p class=\"text-xs text-neutral-500 leading-relaxed\">Let AI handle the heavy lifting so you can focus on growth.</p>\n                </div>\n            </div>\n            <!-- Feature 4 -->\n            <div class=\"p-[1px] rounded-xl bg-gradient-to-b from-white/10 to-transparent feature-card opacity-0 transform translate-y-8\">\n                <div class=\"h-full p-5 rounded-xl bg-[#080810]/90 backdrop-blur-sm border border-white/5 flex flex-col gap-2 hover:bg-[#0A0A14] transition-colors cursor-default\">\n                    <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-2xl text-blue-400 mb-1\"></iconify-icon>\n                    <h4 class=\"text-sm font-medium text-neutral-100\">Enterprise Ready</h4>\n                    <p class=\"text-xs text-neutral-500 leading-relaxed\">Built for scale, security, and your peace of mind.</p>\n                </div>\n            </div>\n        </div>\n\n    </section>\n\n    <!-- JavaScript for Animations and WebGL -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // --- 1. GSAP UI Animations ---\n\n            // Masked Text Reveal\n            gsap.to(\".reveal-word\", {\n                y: \"0%\",\n                duration: 1.2,\n                stagger: 0.15,\n                ease: \"power4.out\",\n                delay: 0.2\n            });\n\n            // Fade ins\n            gsap.to(\".hero-fade-in\", {\n                opacity: 1,\n                y: 0,\n                duration: 1,\n                stagger: 0.1,\n                ease: \"power3.out\",\n                delay: 0.8\n            });\n\n            // Dashboard 3D Intro\n            const dashIntro = gsap.timeline({delay: 0.6});\n            dashIntro.to(\"#dashboard-3d\", {\n                opacity: 1,\n                duration: 1.5,\n                ease: \"power2.out\"\n            }, 0)\n            .fromTo(\"#dashboard-3d\",\n                { rotateY: -20, rotateX: 10, y: 40 },\n                { rotateY: -12, rotateX: 4, y: 0, duration: 2, ease: \"power3.out\" }, 0\n            );\n\n            // Dashboard Inner Elements Stagger\n            dashIntro.to(\".dash-card\", {\n                opacity: 1,\n                y: 0,\n                duration: 0.8,\n                stagger: 0.1,\n                ease: \"power2.out\"\n            }, \"-=1.0\");\n\n            // Chart Lines Draw In\n            dashIntro.to(\".chart-line\", {\n                strokeDashoffset: 0,\n                duration: 1.5,\n                stagger: 0.1,\n                ease: \"power2.inOut\"\n            }, \"-=0.5\");\n\n            dashIntro.to(\".chart-line-main\", {\n                strokeDashoffset: 0,\n                duration: 2.5,\n                stagger: 0.2,\n                ease: \"power2.inOut\"\n            }, \"-=1.0\");\n\n            // Donut Chart Pop\n            dashIntro.to(\"#donut-chart\", {\n                scale: 1,\n                opacity: 1,\n                duration: 1,\n                ease: \"back.out(1.5)\"\n            }, \"-=1.5\");\n\n            // Subtle Dashboard Float (Continuous)\n            gsap.to(\"#dashboard-3d\", {\n                y: \"-=12\",\n                rotateX: \"+=1.5\",\n                rotateY: \"+=1\",\n                duration: 4,\n                yoyo: true,\n                repeat: -1,\n                ease: \"sine.inOut\",\n                delay: 2.5\n            });\n\n            // Dashboard Mouse Parallax\n            const dashboard = document.getElementById('dashboard-3d');\n            document.addEventListener('mousemove', (e) => {\n                const xAxis = (window.innerWidth / 2 - e.pageX) / 50;\n                const yAxis = (window.innerHeight / 2 - e.pageY) / 50;\n                gsap.to(dashboard, {\n                    rotateY: -12 + xAxis,\n                    rotateX: 4 + yAxis,\n                    duration: 1,\n                    ease: \"power1.out\"\n                });\n            });\n\n            // Bottom Features Scroll Reveal\n            gsap.to(\".feature-card\", {\n                scrollTrigger: {\n                    trigger: \".feature-card\",\n                    start: \"top 90%\",\n                },\n                opacity: 1,\n                y: 0,\n                duration: 0.8,\n                stagger: 0.1,\n                ease: \"power3.out\"\n            });\n\n\n            // --- 2. WebGL Background (Three.js) ---\n            const container = document.getElementById('webgl-container');\n            const scene = new THREE.Scene();\n\n            // Camera\n            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n            camera.position.z = 30;\n            camera.position.y = 5;\n\n            // Renderer\n            const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n            container.appendChild(renderer.domElement);\n\n            // A. Eclipse Ring (Background Right)\n            const ringGroup = new THREE.Group();\n            ringGroup.position.set(25, 10, -20);\n            ringGroup.rotation.y = -Math.PI / 4;\n            ringGroup.rotation.x = Math.PI / 8;\n            scene.add(ringGroup);\n\n            // Core sharp ring\n            const ringGeo = new THREE.TorusGeometry(20, 0.05, 16, 100);\n            const ringMat = new THREE.MeshBasicMaterial({ color: 0xffaa55, transparent: true, opacity: 0.8 });\n            const ring = new THREE.Mesh(ringGeo, ringMat);\n            ringGroup.add(ring);\n\n            // Glowing outer aura (simulated with larger blurred toruses)\n            const glowMat1 = new THREE.MeshBasicMaterial({ color: 0xff5500, transparent: true, opacity: 0.3, blending: THREE.AdditiveBlending });\n            const glow1 = new THREE.Mesh(new THREE.TorusGeometry(20, 0.4, 16, 100), glowMat1);\n            ringGroup.add(glow1);\n\n            const glowMat2 = new THREE.MeshBasicMaterial({ color: 0xaa00ff, transparent: true, opacity: 0.15, blending: THREE.AdditiveBlending });\n            const glow2 = new THREE.Mesh(new THREE.TorusGeometry(20, 1.2, 16, 100), glowMat2);\n            ringGroup.add(glow2);\n\n            // B. Animated Rainbow Energy Path (Flowing lines)\n            const linesGroup = new THREE.Group();\n            scene.add(linesGroup);\n\n            const pathCurves = [];\n            const numLines = 25;\n            const colors = [0xff0088, 0xaa00ff, 0xff5500, 0x4400ff];\n\n            // Generate sweeping curves from bottom-center to background-right\n            for(let i=0; i<numLines; i++) {\n                const spreadX = (Math.random() - 0.5) * 15;\n                const spreadY = (Math.random() - 0.5) * 4;\n\n                const curve = new THREE.CatmullRomCurve3([\n                    new THREE.Vector3(0 + spreadX*0.2, -20, 15), // Start bottom center-ish\n                    new THREE.Vector3(-5 + spreadX*0.5, -5 + spreadY, 5),\n                    new THREE.Vector3(15 + spreadX, 5 + spreadY*1.5, -15),\n                    new THREE.Vector3(40 + spreadX*2, 10 + spreadY*2, -30) // End towards eclipse\n                ]);\n                pathCurves.push(curve);\n\n                const points = curve.getPoints(100);\n                const geometry = new THREE.BufferGeometry().setFromPoints(points);\n\n                const color = new THREE.Color(colors[Math.floor(Math.random() * colors.length)]);\n\n                // Shader material to animate drawing/flowing effect\n                const material = new THREE.ShaderMaterial({\n                    uniforms: {\n                        color: { value: color },\n                        time: { value: 0 },\n                        dashSize: { value: Math.random() * 0.2 + 0.1 },\n                        gapSize: { value: Math.random() * 0.2 + 0.1 },\n                        speed: { value: Math.random() * 2 + 1 },\n                        opacityMult: { value: Math.random() * 0.5 + 0.3 }\n                    },\n                    vertexShader: `\n                        varying vec2 vUv;\n                        void main() {\n                            vUv = uv;\n                            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n                        }\n                    `,\n                    fragmentShader: `\n                        uniform vec3 color;\n                        uniform float time;\n                        uniform float speed;\n                        uniform float dashSize;\n                        uniform float gapSize;\n                        uniform float opacityMult;\n                        varying vec2 vUv;\n\n                        void main() {\n                            // Simple distance based dash animation\n                            float dashDist = fract((vUv.x - time * speed * 0.1) * 10.0);\n                            float alpha = step(gapSize, dashDist) * opacityMult;\n\n                            // Fade out at ends\n                            float edgeFade = smoothstep(0.0, 0.1, vUv.x) * smoothstep(1.0, 0.8, vUv.x);\n                            alpha *= edgeFade;\n\n                            gl_FragColor = vec4(color, alpha);\n                        }\n                    `,\n                    transparent: true,\n                    blending: THREE.AdditiveBlending,\n                    depthWrite: false\n                });\n\n                // Line width isn't well supported in WebGL on all platforms, so we use TubeGeometry for thickness\n                const tubeGeo = new THREE.TubeGeometry(curve, 64, Math.random() * 0.05 + 0.01, 3, false);\n                // We need custom UVs for the tube to animate along length\n                const uvs = tubeGeo.attributes.uv;\n                for ( let j = 0; j < uvs.count; j ++ ) {\n                    uvs.setX( j, j / (uvs.count-1) ); // Set U coordinate along length\n                }\n\n                const lineMesh = new THREE.Mesh(tubeGeo, material);\n                linesGroup.add(lineMesh);\n            }\n\n            // C. Ambient Particles (Cosmic Dust)\n            const particlesGeo = new THREE.BufferGeometry();\n            const particlesCount = 300;\n            const posArray = new Float32Array(particlesCount * 3);\n            for(let i = 0; i < particlesCount * 3; i++) {\n                posArray[i] = (Math.random() - 0.5) * 60;\n            }\n            particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n            const particlesMat = new THREE.PointsMaterial({\n                size: 0.1,\n                color: 0xaa88ff,\n                transparent: true,\n                opacity: 0.6,\n                blending: THREE.AdditiveBlending\n            });\n            const particlesMesh = new THREE.Points(particlesGeo, particlesMat);\n            scene.add(particlesMesh);\n\n            // Animation Loop\n            const clock = new THREE.Clock();\n\n            function animate() {\n                requestAnimationFrame(animate);\n                const elapsedTime = clock.getElapsedTime();\n\n                // Rotate Eclipse\n                ringGroup.rotation.z = elapsedTime * 0.05;\n                glow1.scale.setScalar(1 + Math.sin(elapsedTime * 2) * 0.02); // Breathing effect\n\n                // Flow Rainbow Road\n                linesGroup.children.forEach(line => {\n                    line.material.uniforms.time.value = elapsedTime;\n                });\n\n                // Slow particle drift\n                particlesMesh.rotation.y = elapsedTime * 0.02;\n\n                renderer.render(scene, camera);\n            }\n            animate();\n\n            // Handle Resize\n            window.addEventListener('resize', () => {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "astral-ai-insights.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/astral-ai-insights.jpg", "source_name": "astral-ai-insights-DESIGN.md", "views": 423, "forks": 23, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-03T12:36:24.987645+00:00"}