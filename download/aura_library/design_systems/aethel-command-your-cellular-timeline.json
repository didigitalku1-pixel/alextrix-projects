class=\"flex justify-between items-end\">\n                                    <div>\n                                        <div class=\"text-xs text-white/40 font-light mb-1\">Aging Velocity</div>\n                                        <div class=\"flex items-baseline gap-1\">\n                                            <span class=\"text-lg font-light text-white\">0.7x</span>\n                                            <span class=\"text-xs text-white/40 font-light flex items-center gap-1\">\n                                                <div class=\"w-1.5 h-1.5 rounded-full bg-red-500/80\"></div> slower\n                                            </span>\n                                        </div>\n                                    </div>\n                                    <div class=\"text-right\">\n                                        <div class=\"text-xs text-white/40 font-light mb-1\">Aethel Age</div>\n                                        <div class=\"flex items-center justify-end gap-1.5\">\n                                            <span class=\"text-lg font-light text-white\">26.4</span>\n                                            <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-lime-400\" width=\"14\"></iconify-icon>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Bottom Navigation -->\n                        <div class=\"absolute bottom-6 left-1/2 -translate-x-1/2 w-max z-50\">\n                            <div class=\"bg-white/[0.03] border border-white/5 rounded-full p-1.5 flex items-center gap-2\" style=\"backdrop-filter: blur(12px);\">\n                                <div class=\"w-12 h-10 rounded-full bg-lime-400 flex items-center justify-center text-black shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)]\">\n                                    <iconify-icon icon=\"solar:widget-5-linear\" width=\"20\"></iconify-icon>\n                                </div>\n                                <div class=\"w-10 h-10 rounded-full flex items-center justify-center text-white/40\">\n                                    <iconify-icon icon=\"solar:moon-linear\" width=\"20\"></iconify-icon>\n                                </div>\n                                <div class=\"w-10 h-10 rounded-full flex items-center justify-center text-white/40\">\n                                    <iconify-icon icon=\"solar:link-circle-linear\" width=\"20\"></iconify-icon>\n                                </div>\n                                <div class=\"w-10 h-10 rounded-full flex items-center justify-center text-white/40\">\n                                    <iconify-icon icon=\"solar:document-text-linear\" width=\"20\"></iconify-icon>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            // Text Reveal Animation\n            gsap.to(\".reveal-text\", {\n                y: \"0%\",\n                duration: 0.8,\n                stagger: 0.1,\n                ease: \"power3.out\",\n                delay: 0.5\n            });\n\n            // Graph Line Animation\n            gsap.to(\".graph-line\", {\n                strokeDashoffset: 0,\n                duration: 2,\n                ease: \"power3.out\",\n                delay: 1.2\n            });\n\n            // Blob Floating Animations\n            gsap.to(\".blob-1\", {\n                x: 20, y: -30, rotation: 5, scale: 1.1,\n                duration: 4, yoyo: true, repeat: -1, ease: \"sine.inOut\"\n            });\n            gsap.to(\".blob-2\", {\n                x: -30, y: 40, rotation: -5, scale: 0.95,\n                duration: 5, yoyo: true, repeat: -1, ease: \"sine.inOut\"\n            });\n\n            // Three.js Setup for Screen 3\n            const container = document.getElementById('webgl-container');\n            if(container) {\n                const scene = new THREE.Scene();\n                const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);\n                camera.position.z = 40;\n\n                const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });\n                renderer.setSize(container.clientWidth, container.clientHeight);\n                renderer.setPixelRatio(window.devicePixelRatio);\n                container.appendChild(renderer.domElement);\n\n                const particlesGeometry = new THREE.BufferGeometry();\n                const particlesCount = 4000;\n                const posArray = new Float32Array(particlesCount * 3);\n                const colorsArray = new Float32Array(particlesCount * 3);\n                const colorBase = new THREE.Color(0xa3e635);\n\n                for(let i = 0; i < particlesCount * 3; i+=3) {\n                    const radius = 15 + (Math.random() - 0.5) * 2;\n                    const theta = Math.random() * 2 * Math.PI;\n                    const phi = Math.acos((Math.random() * 2) - 1);\n\n                    let x = radius * Math.sin(phi) * Math.cos(theta);\n                    let y = radius * Math.sin(phi) * Math.sin(theta);\n                    let z = radius * Math.cos(phi);\n\n                    if (x > 0) {\n                        x += Math.random() * 8;\n                        y += (Math.random() - 0.5) * 10;\n                    }\n\n                    posArray[i] = x;\n                    posArray[i+1] = y;\n                    posArray[i+2] = z;\n\n                    colorsArray[i] = colorBase.r + (Math.random() * 0.2);\n                    colorsArray[i+1] = colorBase.g;\n                    colorsArray[i+2] = colorBase.b;\n                }\n\n                particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n                particlesGeometry.setAttribute('color', new THREE.BufferAttribute(colorsArray, 3));\n\n                const material = new THREE.PointsMaterial({\n                    size: 0.15,\n                    vertexColors: true,\n                    transparent: true,\n                    opacity: 0.8,\n                    blending: THREE.AdditiveBlending\n                });\n\n                const particlesMesh = new THREE.Points(particlesGeometry, material);\n                particlesMesh.rotation.x = Math.PI / 4;\n                particlesMesh.rotation.y = -Math.PI / 6;\n                scene.add(particlesMesh);\n\n                const clock = new THREE.Clock();\n\n                const animate = () => {\n                    requestAnimationFrame(animate);\n                    const elapsedTime = clock.getElapsedTime();\n                    particlesMesh.rotation.y += 0.002;\n\n                    const positions = particlesGeometry.attributes.position.array;\n                    for(let i = 0; i < particlesCount; i++) {\n                        const i3 = i * 3;\n                        const x = particlesGeometry.attributes.position.array[i3];\n                        positions[i3+1] += Math.sin(elapsedTime + x) * 0.005;\n                    }\n                    particlesGeometry.attributes.position.needsUpdate = true;\n                    renderer.render(scene, camera);\n                }\n                animate();\n            }\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "aethel-command-your-cellular-timeline.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/aethel-command-your-cellular-timeline.jpg", "source_name": "