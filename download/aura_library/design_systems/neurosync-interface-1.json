3 w-full lg:w-[120px] shrink-0\" style=\"border: 1px solid #26231f; box-shadow: inset 0 0 10px rgba(0,0,0,0.6);\">\n                    <!-- Screws -->\n                    <div class=\"absolute top-2 left-2 w-1.5 h-1.5 rounded-full bg-[#222] border border-[#111]\"></div>\n                    <div class=\"absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-[#222] border border-[#111]\"></div>\n                    <div class=\"absolute bottom-2 left-2 w-1.5 h-1.5 rounded-full bg-[#222] border border-[#111]\"></div>\n                    <div class=\"absolute bottom-2 right-2 w-1.5 h-1.5 rounded-full bg-[#222] border border-[#111]\"></div>\n\n                    <div class=\"w-16 h-8 rounded-full bg-[#0a0a0a] p-1 relative\" style=\"border: 1px solid #222; box-shadow: inset 0 4px 6px rgba(0,0,0,0.8);\">\n                        <div class=\"absolute right-1 top-1 bottom-1 w-7 rounded-full bg-gradient-to-b from-[#f3c27b] to-[#a37a3b]\" style=\"box-shadow: 0 0 10px rgba(243,194,123,0.5), inset 0 2px 4px rgba(255,255,255,0.4);\"></div>\n                    </div>\n                    <span class=\"text-[10px] text-[#5a554e] tracking-widest mt-2\">POWER</span>\n                </div>\n\n                <!-- Nav Container -->\n                <div class=\"panel flex-1 bg-[#161513] rounded-xl flex items-center h-[70px] overflow-x-auto overflow-y-hidden hide-scrollbar\" style=\"border: 1px solid #26231f; box-shadow: inset 0 0 10px rgba(0,0,0,0.6);\">\n                    <!-- Active Item -->\n                    <div class=\"flex-1 min-w-[120px] h-full flex items-center justify-center gap-2 relative bg-[#1a1714] border-r border-[#222] cursor-pointer group\">\n                        <iconify-icon icon=\"solar:widget-5-linear\" class=\"text-lg text-[#f3c27b] drop-shadow-[0_0_5px_rgba(243,194,123,0.5)]\"></iconify-icon>\n                        <span class=\"text-xs text-[#f3c27b] tracking-wider font-medium\">DASHBOARD</span>\n                        <!-- Glow Line Bottom -->\n                        <div class=\"absolute bottom-0 left-4 right-4 h-[2px] bg-[#f3c27b] shadow-[0_0_8px_#f3c27b]\"></div>\n                    </div>\n\n                    <!-- Inactive Items -->\n                    <div class=\"flex-1 min-w-[120px] h-full flex items-center justify-center gap-2 border-r border-[#222] cursor-pointer group hover:bg-[#1a1714] transition-colors\">\n                        <iconify-icon icon=\"solar:history-linear\" class=\"text-lg text-[#6a655e] group-hover:text-[#8a857a] transition-colors\"></iconify-icon>\n                        <span class=\"text-xs text-[#6a655e] tracking-wider font-medium group-hover:text-[#8a857a] transition-colors\">SESSIONS</span>\n                    </div>\n                    <div class=\"flex-1 min-w-[120px] h-full flex items-center justify-center gap-2 border-r border-[#222] cursor-pointer group hover:bg-[#1a1714] transition-colors\">\n                        <iconify-icon icon=\"solar:chart-square-linear\" class=\"text-lg text-[#6a655e] group-hover:text-[#8a857a] transition-colors\"></iconify-icon>\n                        <span class=\"text-xs text-[#6a655e] tracking-wider font-medium group-hover:text-[#8a857a] transition-colors\">INSIGHTS</span>\n                    </div>\n                    <div class=\"flex-1 min-w-[120px] h-full flex items-center justify-center gap-2 border-r border-[#222] cursor-pointer group hover:bg-[#1a1714] transition-colors\">\n                        <iconify-icon icon=\"solar:document-text-linear\" class=\"text-lg text-[#6a655e] group-hover:text-[#8a857a] transition-colors\"></iconify-icon>\n                        <span class=\"text-xs text-[#6a655e] tracking-wider font-medium group-hover:text-[#8a857a] transition-colors\">REPORTS</span>\n                    </div>\n                    <div class=\"flex-1 min-w-[120px] h-full flex items-center justify-center gap-2 cursor-pointer group hover:bg-[#1a1714] transition-colors\">\n                        <iconify-icon icon=\"solar:settings-linear\" class=\"text-lg text-[#6a655e] group-hover:text-[#8a857a] transition-colors\"></iconify-icon>\n                        <span class=\"text-xs text-[#6a655e] tracking-wider font-medium group-hover:text-[#8a857a] transition-colors\">SETTINGS</span>\n                    </div>\n                </div>\n\n                <!-- Vent Detail Right -->\n                <div class=\"panel bg-[#161513] rounded-xl flex items-center justify-center p-3 h-[70px] w-[80px] shrink-0\" style=\"border: 1px solid #26231f; box-shadow: inset 0 0 10px rgba(0,0,0,0.6);\">\n                    <div class=\"w-full flex flex-col gap-1.5\">\n                        <div class=\"h-1 bg-[#0a0a0a] rounded-full border-t border-[#333] shadow-[inset_0_2px_4px_#000]\"></div>\n                        <div class=\"h-1 bg-[#0a0a0a] rounded-full border-t border-[#333] shadow-[inset_0_2px_4px_#000]\"></div>\n                        <div class=\"h-1 bg-[#0a0a0a] rounded-full border-t border-[#333] shadow-[inset_0_2px_4px_#000]\"></div>\n                    </div>\n                </div>\n\n            </div>\n\n        </div>\n    </div>\n\n    <style>\n        /* Hide scrollbar utility for the nav container on small screens */\n        .hide-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        .hide-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n    </style>\n\n    <script>\n        // Ensure GSAP and ScrollTrigger are ready\n        gsap.registerPlugin(ScrollTrigger);\n\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n\n            // 1. Masked Staggered Word Reveal Setup (Skill Directive)\n            const splitElements = document.querySelectorAll('.split-reveal');\n\n            splitElements.forEach(el => {\n                const text = el.innerText;\n                el.innerHTML = '';\n                const words = text.split(' ');\n\n                words.forEach((word, index) => {\n                    // Create mask wrapper\n                    const maskSpan = document.createElement('span');\n                    maskSpan.style.display = 'inline-block';\n                    maskSpan.style.overflow = 'hidden';\n                    maskSpan.style.verticalAlign = 'top';\n                    // Add space after word if not the last\n                    if(index < words.length - 1) {\n                        maskSpan.style.marginRight = '0.25em';\n                    }\n\n                    // Create inner word\n                    const wordSpan = document.createElement('span');\n                    wordSpan.style.display = 'inline-block';\n                    wordSpan.innerText = word;\n                    wordSpan.classList.add('word-inner');\n                    // Initial state for animation\n                    gsap.set(wordSpan, { y: '100%' });\n\n                    maskSpan.appendChild(wordSpan);\n                    el.appendChild(maskSpan);\n                });\n            });\n\n            // Master Timeline tied to ScrollTrigger\n            const tl = gsap.timeline({\n                scrollTrigger: {\n                    trigger: \"#dashboard-container\",\n                    start: \"top 80%\", // Triggers when top of dashboard hits 80% of viewport height\n                    once: true // Run once\n                }\n            });\n\n            // Animate masked words\n            tl.to('.word-inner', {\n                y: '0%',\n                duration: 0.8,\n                ease: \"power3.out\",\n                stagger: 0.05\n            });\n\n            // 2. Main Gauge Animation\n            tl.fromTo(\"#gauge-needle\",\n                { rotation: -135 },\n                { rotation: 20, duration: 2, ease: \"elastic.out(1, 0.5)\" },\n                \"<0.2\" // Start slightly after text reveal starts\n            );\n\n            // 3. Counter Animations\n            const counters = document.querySelectorAll('.counter-val');\n            counters.forEach(counter => {\n                const target = parseFloat(counter.getAttribute('data-target'));\n                tl.to(counter, {\n                    innerHTML: target,\n                    duration: 2,\n                    ease: \"power2.out\",\n                    snap: { innerHTML: 1 }, // Snap to whole numbers\n                    onUpdate: function() {\n                        counter.innerHTML = Math.round(this.targets()[0].innerHTML);\n                    }\n                }, \"<\"); // Run concurrently with gauge\n            });\n\n            // Gauge main number counter (custom to handle glow slightly)\n            const gaugeNum = document.querySelector('.gauge-number');\n            tl.fromTo(gaugeNum,\n                { innerHTML: 0, opacity: 0 },\n                {\n                    innerHTML: 72,\n                    opacity: 1,\n                    duration: 2,\n                    snap: { innerHTML: 1 },\n                    ease: \"power2.out\"\n                },\n                \"<\"\n            );\n\n            // 4. SVG Path Drawings\n            const mainLine = document.getElementById('main-chart-line');\n            const brainwave = document.getElementById('brainwave-path');\n\n            const lineLength = mainLine.getTotalLength();\n            const brainLength = brainwave.getTotalLength();\n\n            gsap.set([mainLine, brainwave], {\n                strokeDasharray: (i, target) => target.getTotalLength(),\n                strokeDashoffset: (i, target) => target.getTotalLength()\n            });\n\n            tl.to(mainLine, {\n                strokeDashoffset: 0,\n                duration: 2,\n                ease: \"power2.inOut\"\n            }, \"-=1.5\");\n\n            tl.to(brainwave, {\n                strokeDashoffset: 0,\n                duration: 1.5,\n                ease: \"power1.inOut\"\n            }, \"<0.5\");\n\n            // 5. Tube Icons Fade/Scale In\n            tl.from('.tube-icon', {\n                opacity: 0,\n                scale: 0.5,\n                duration: 1,\n                stagger: 0.15,\n                ease: \"back.out(1.7)\"\n            }, \"-=2\");\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "neurosync-interface-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/neurosync-interface-1.jpg", "source_name": "neurosync-interface-1-DESIGN.md", "views": 151, "forks": 5, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-03T08:05:11.0024+00:00"}