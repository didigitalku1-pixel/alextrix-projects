n                        <span class=\"text-sm text-[#a39e93] font-medium tracking-wide\">NeuroSync</span>\n                    </div>\n\n                    <!-- Gauge Graphic -->\n                    <div class=\"relative w-[220px] h-[220px] mt-8 rounded-full flex items-center justify-center bg-[#0a0a0a]\" style=\"border: 4px solid #2a2621; box-shadow: 0 0 20px rgba(0,0,0,0.8), inset 0 0 30px rgba(0,0,0,1);\">\n                        <!-- Gold Rim -->\n                        <div class=\"absolute inset-0 rounded-full\" style=\"border: 2px solid #5a4b31; box-shadow: inset 0 0 10px #000; margin: 4px;\"></div>\n\n                        <!-- Ticks (SVG) -->\n                        <svg class=\"absolute inset-0 w-full h-full\" viewBox=\"0 0 100 100\">\n                            <g stroke=\"#4a453e\" stroke-width=\"0.5\" stroke-linecap=\"round\">\n                                <!-- Generated ticks via JS logic, here hardcoded representative -->\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"10\" transform=\"rotate(-135 50 50)\" />\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"8\" transform=\"rotate(-105 50 50)\" stroke-width=\"0.2\"/>\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"10\" transform=\"rotate(-90 50 50)\" />\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"8\" transform=\"rotate(-75 50 50)\" stroke-width=\"0.2\"/>\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"10\" transform=\"rotate(-45 50 50)\" />\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"8\" transform=\"rotate(-15 50 50)\" stroke-width=\"0.2\"/>\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"10\" transform=\"rotate(0 50 50)\" />\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"8\" transform=\"rotate(15 50 50)\" stroke-width=\"0.2\"/>\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"10\" transform=\"rotate(45 50 50)\" />\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"8\" transform=\"rotate(75 50 50)\" stroke-width=\"0.2\"/>\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"10\" transform=\"rotate(90 50 50)\" />\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"8\" transform=\"rotate(105 50 50)\" stroke-width=\"0.2\"/>\n                                <line x1=\"50\" y1=\"5\" x2=\"50\" y2=\"10\" transform=\"rotate(135 50 50)\" />\n                            </g>\n                            <text x=\"20\" y=\"70\" fill=\"#7a756e\" font-size=\"6\" text-anchor=\"middle\" class=\"font-medium\">0</text>\n                            <text x=\"25\" y=\"35\" fill=\"#7a756e\" font-size=\"6\" text-anchor=\"middle\" class=\"font-medium\">25</text>\n                            <text x=\"50\" y=\"22\" fill=\"#7a756e\" font-size=\"6\" text-anchor=\"middle\" class=\"font-medium\">50</text>\n                            <text x=\"75\" y=\"35\" fill=\"#7a756e\" font-size=\"6\" text-anchor=\"middle\" class=\"font-medium\">75</text>\n                            <text x=\"80\" y=\"70\" fill=\"#7a756e\" font-size=\"6\" text-anchor=\"middle\" class=\"font-medium\">100</text>\n                        </svg>\n\n                        <!-- Inner Stats -->\n                        <div class=\"flex flex-col items-center z-10 relative mt-4\">\n                            <span class=\"text-xs text-[#8a857a] tracking-widest uppercase font-medium split-reveal\">Cognitive Score</span>\n                            <span class=\"text-6xl text-[#f3c27b] tracking-tight font-light my-1 gauge-number\" style=\"text-shadow: 0 0 15px rgba(243,194,123,0.5);\">72</span>\n                            <span class=\"text-xs text-[#6a655e] font-medium\">Optimal Range</span>\n                            <span class=\"text-xs text-[#6a655e] font-medium\">65 - 85</span>\n                        </div>\n\n                        <!-- Needle -->\n                        <div id=\"gauge-needle\" class=\"absolute top-1/2 left-1/2 w-[90px] h-[2px] bg-gradient-to-r from-transparent via-[#8a7a5a] to-[#f3c27b] origin-left\" style=\"transform: rotate(20deg); box-shadow: 2px 0 5px rgba(243,194,123,0.5);\">\n                             <div class=\"absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-[#f3c27b]\" style=\"box-shadow: 0 0 10px #f3c27b;\"></div>\n                        </div>\n                        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[#111] z-20\" style=\"border: 2px solid #3a352f; box-shadow: inset 0 2px 4px rgba(255,255,255,0.1), 0 2px 5px rgba(0,0,0,0.5);\"></div>\n                    </div>\n                </div>\n\n                <!-- TOP MIDDLE: Vacuum Tubes -->\n                <div class=\"panel bg-[#161513] rounded-2xl relative p-6 grid grid-cols-4 gap-4\" style=\"border: 1px solid #26231f; box-shadow: inset 0 0 15px rgba(0,0,0,0.6);\">\n                    <!-- Screws -->\n                    <div class=\"absolute top-3 left-3 w-2 h-2 rounded-full bg-[#222] border border-[#111]\"></div>\n                    <div class=\"absolute top-3 right-3 w-2 h-2 rounded-full bg-[#222] border border-[#111]\"></div>\n                    <div class=\"absolute bottom-3 left-3 w-2 h-2 rounded-full bg-[#222] border border-[#111]\"></div>\n                    <div class=\"absolute bottom-3 right-3 w-2 h-2 rounded-full bg-[#222] border border-[#111]\"></div>\n\n                    <!-- Tube 1 -->\n                    <div class=\"flex flex-col items-center justify-between\">\n                        <span class=\"text-xs text-[#8a857a] tracking-widest font-medium mb-3 split-reveal\">Focus</span>\n                        <div class=\"relative w-14 h-32 rounded-full bg-[#0a0a0a] flex items-center justify-center overflow-hidden\" style=\"border: 1px solid #333; box-shadow: inset 0 0 15px #000, inset 0 10px 10px rgba(255,255,255,0.05);\">\n                            <div class=\"absolute top-0 w-8 h-4 rounded-b-full bg-[#222] border-b border-[#444]\"></div>\n                            <div class=\"absolute bottom-0 w-8 h-4 rounded-t-full bg-[#222] border-t border-[#444]\"></div>\n                            <div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-[rgba(255,255,255,0.02)] to-transparent rounded-full\"></div>\n                            <iconify-icon icon=\"solar:target-linear\" class=\"text-3xl text-[#f3c27b] tube-icon z-10\" style=\"filter: drop-shadow(0 0 8px rgba(243,194,123,0.8));\"></iconify-icon>\n                        </div>\n                        <div class=\"w-10 h-10 mt-4 rounded-full bg-[#1a1815] flex items-center justify-center relative\" style=\"border: 1px solid #111; box-shadow: 0 4px 6px rgba(0,0,0,0.8), inset 0 2px 5px rgba(255,255,255,0.1);\">\n                            <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-[#3a352f] to-[#111]\"></div>\n                            <div class=\"absolute w-1 h-3 bg-[#555] top-1 rounded-sm\"></div>\n                        </div>\n                    </div>\n\n                    <!-- Tube 2 -->\n                    <div class=\"flex flex-col items-center justify-between\">\n                        <span class=\"text-xs text-[#8a857a] tracking-widest font-medium mb-3 split-reveal\">Clarity</span>\n                        <div class=\"relative w-14 h-32 rounded-full bg-[#0a0a0a] flex items-center justify-center overflow-hidden\" style=\"border: 1px solid #333; box-shadow: inset 0 0 15px #000, inset 0 10px 10px rgba(255,255,255,0.05);\">\n                            <div class=\"absolute top-0 w-8 h-4 rounded-b-full bg-[#222] border-b border-[#444]\"></div>\n                            <div class=\"absolute bottom-0 w-8 h-4 rounded-t-full bg-[#222] border-t border-[#444]\"></div>\n                            <iconify-icon icon=\"solar:eye-linear\" class=\"text-3xl text-[#f3c27b] tube-icon z-10\" style=\"filter: drop-shadow(0 0 8px rgba(243,194,123,0.8));\"></iconify-icon>\n                        </div>\n                        <div class=\"w-10 h-10 mt-4 rounded-full bg-[#1a1815] flex items-center justify-center relative\" style=\"border: 1px solid #111; box-shadow: 0 4px 6px rgba(0,0,0,0.8), inset 0 2px 5px rgba(255,255,255,0.1);\">\n                            <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-[#3a352f] to-[#111]\" style=\"transform: rotate(45deg);\"></div>\n                            <div class=\"absolute w-1 h-3 bg-[#555] top-1.5 right-1.5 rounded-sm\" style=\"transform: rotate(45deg);\"></div>\n                        </div>\n                    </div>\n\n                    <!-- Tube 3 -->\n                    <div class=\"flex flex-col items-center justify-between\">\n                        <span class=\"text-xs text-[#8a857a] tracking-widest font-medium mb-3 split-reveal\">Calm</span>\n                        <div class=\"relative w-14 h-32 rounded-full bg-[#0a0a0a] flex items-center justify-center overflow-hidden\" style=\"border: 1px solid #333; box-shadow: inset 0 0 15px #000, inset 0 10px 10px rgba(255,255,255,0.05);\">\n                            <div class=\"absolute top-0 w-8 h-4 rounded-b-full bg-[#222] border-b border-[#444]\"></div>\n                            <div class=\"absolute bottom-0 w-8 h-4 rounded-t-full bg-[#222] border-t border-[#444]\"></div>\n                            <iconify-icon icon=\"solar:waterdrops-linear\" class=\"text-3xl text-[#f3c27b] tube-icon z-10\" style=\"filter: drop-shadow(0 0 8px rgba(243,194,123,0.8));\"></iconify-icon>\n                        </div>\n                        <div class=\"w-10 h-10 mt-4 rounded-full bg-[#1a1815] flex items-center justify-center relative\" style=\"border: 1px solid #111; box-shadow: 0 4px 6px rgba(0,0,0,0.8), inset 0 2px 5px rgba(255,255,255,0.1);\">\n                            <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-[#3a352f] to-[#111]\" style=\"transform: rotate(-30deg);\"></div>\n                            <div class=\"absolute w-1 h-3 bg-[#555] top-1.5 left-1.5 rounded-sm\" style=\"transform: rotate(-45deg);\"></div>\n                        </div>\n                    </div>\n\n                    <!-- Tube 4 -->\n                    <div class=\"flex flex-col items-center justify-between\">\n                        <span class=\"text-xs text-[#8a857a] tracking-widest font-medium mb-3 split-reveal\">Energy</span>\n                        <div class=\"relative w-14 h-32 rounded-full bg-[#0a0a0a] flex items-center justify-center overflow-hidden\" style=\"border: 1px solid #333; box-shadow: inset 0 0 15px #000, inset 0 10px 10px rgba(255,255,255,0.05);\">\n                            <div class=\"absolute top-0 w-8 h-4 rounded-b-full bg-[#222] border-b border-[#444]\"></div>\n                            <div class=\"absolute bottom-0 w-8 h-4 rounded-t-full bg-[#222] border-t border-[#444]\"></div>\n                            <iconify-icon icon=\"solar:bolt-linear\" class=\"text-3xl text-[#f3c27b] tube-icon z-10\" style=\"filter: drop-shadow(0 0 8px rgba(243,194,123,0.8));\"></iconify-icon>\n                        </div>\n                        <div class=\"w-10 h-10 mt-4 rounded-full bg-[#1a1815] flex items-center justify-center relative\" style=\"border: 1px solid #111; box-shadow: 0 4px 6px rgba(0,0,0,0.8), inset 0 2px 5px rgba(255,255,255,0.1);\">\n                            <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-[#3a352f] to-[#111]\" style=\"transform: rotate(80deg);\"></div>\n                            <div class=\"absolute w-3 h-1 bg-[#555] right-1 top-1/2 -translate-y-1/2 rounded-sm\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- TOP RIGHT: Brainwave Monitor -->\n                <div class=\"panel bg-[#161513] rounded-2xl relative flex flex-col\" style=\"border: 1px solid #26231f; box-shadow: inset 0 0 15px rgba(0,0,0,0.6);\">\n                    <!-- Screws -->\n                    <div class=\"absolute top-3 left-3 w-2 h-2 rounded-full bg-[#222] border border-[#111]\"></div>\n                    <div class=\"absolute top-3 right-3 w-2 h-2 rounded-full bg-[#222] border border-[#111]\"></div>\n\n                    <div class=\"flex items-center justify-between p-4 border-b border-[#222]\">\n                        <span class=\"text-xs text-[#8a857a] tracking-widest font-medium split-reveal\">Brainwave Monitor</span>\n                        <div class=\"flex items-center gap-2 border border-[#4a3a1f] px-2 py-1 rounded-full bg-[#1a150a]\">\n                            <div class=\"w-1.5 h-1.5 rounded-full bg-[#f3c27b] shadow-[0_0_5px_#f3c27b] animate-pulse\"></div>\n                            <span class=\"text-xs text-[#f3c27b] font-medium tracking-wide\">LIVE</span>\n                        </div>\n                    </div>\n\n                    <!-- Screen Area -->\n                    <div class=\"flex-1 bg-[#050505] relative overflow-hidden flex items-center justify-center\" style=\"box-shadow: inset 0 0 20px #000;\">\n                        <!-- Grid lines -->\n                        <div class=\"absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:10px_10px]\"></div>\n\n                        <!-- Glowing Wave SVG -->\n                        <svg class=\"w-full h-full absolute inset-0 preserve-3d\" viewBox=\"0 0 300 100\" preserveAspectRatio=\"none\">\n                            <defs>\n                                <linearGradient id=\"waveGlow\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                                    <stop offset=\"0%\" stop-color=\"rgba(243,194,123, 0.6)\" />\n                                    <stop offset=\"50%\" stop-color=\"rgba(243,194,123, 0)\" />\n                                </linearGradient>\n                            </defs>\n                            <path id=\"brainwave-path\" d=\"M0,50 Q10,45 20,50 T40,50 Q45,30 50,50 T60,50 Q65,60 70,50 T80,50 Q85,20 90,50 T100,50 Q105,70 110,50 T120,50 Q130,20 140,50 T150,50 Q155,40 160,50 T170,50 Q180,30 190,50 T200,50 Q205,65 210,50 T220,50 Q230,25 240,50 T250,50 Q260,60 270,50 T280,50 Q290,40 300,50\"\n                                fill=\"none\" stroke=\"#f3c27b\" stroke-width=\"1.5\" class=\"drop-shadow-[0_0_8px_rgba(243,194,123,0.8)]\" />\n                            <path d=\"M0,50 Q10,45 20,50 T40,50 Q45,30 50,50 T60,50 Q65,60 70,50 T80,50 Q85,20 90,50 T100,50 Q105,70 110,50 T120,50 Q130,20 140,50 T150,50 Q155,40 160,50 T170,50 Q180,30 190,50 T200,50 Q205,65 210,50 T220,50 Q230,25 240,50 T250,50 Q260,60 270,50 T280,50 Q290,40 300,50 L300,100 L0,100 Z\" fill=\"url(#waveGlow)\" opacity=\"0.5\"/>\n                        </svg>\n                    </div>\n\n                    <!-- Stats Footer -->\n                    <div class=\"grid grid-cols-5 p-4 border-t border-[#222] bg-[#111] rounded-b-2xl\">\n                        <div class=\"flex flex-col items-center\">\n                            <span class=\"text-[10px] text-[#6a655e] mb-1\">DELTA</span>\n                            <span class=\"text-xs text-[#a39e93]\">1.2 <span class=\"text-[10px]\">Hz</span></span>\n                        </div>\n                        <div class=\"flex flex-col items-center\">\n                            <span class=\"text-[10px] text-[#6a655e] mb-1\">THETA</span>\n                            <span class=\"text-xs text-[#a39e93]\">4.8 <span class=\"text-[10px]\">Hz</span></span>\n                        </div>\n                        <div class=\"flex flex-col items-center relative\">\n                            <!-- Highlight Box -->\n                            <div class=\"absolute inset-0 bg-[#2a1f0a] -m-1 rounded z-0 border border-[#3a2f1a]\"></div>\n           