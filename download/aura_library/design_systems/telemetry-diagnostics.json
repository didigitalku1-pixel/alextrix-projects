ace] text-xs text-[#8eb364]/80 tracking-widest uppercase\">Active Nodes</span>\n                        <iconify-icon icon=\"solar:server-square-linear\" class=\"text-[#8eb364] text-lg\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                    </div>\n                    <!-- Custom Checkbox 1 -->\n                    <label class=\"flex items-center gap-3 cursor-pointer group/cb\">\n                        <div class=\"w-3 h-3 border border-[#8eb364] bg-[#8eb364]/20 flex items-center justify-center relative\">\n                            <div class=\"w-1.5 h-1.5 bg-[#8eb364] shadow-[0_0_5px_rgba(142,179,100,0.8)]\"></div>\n                        </div>\n                        <span class=\"font-['DM_Mono',monospace] text-xs text-[#c3d1b6] font-extralight tracking-widest\">NODE-ALPHA</span>\n                    </label>\n                    <!-- Custom Checkbox 2 -->\n                    <label class=\"flex items-center gap-3 cursor-pointer group/cb\">\n                        <div class=\"w-3 h-3 border border-[#8eb364]/40 flex items-center justify-center relative group-hover/cb:border-[#8eb364]/80 transition-colors\">\n                        </div>\n                        <span class=\"font-['DM_Mono',monospace] text-xs text-[#c3d1b6]/60 font-extralight tracking-widest\">NODE-BETA</span>\n                    </label>\n                    <!-- Custom Checkbox 3 -->\n                    <label class=\"flex items-center gap-3 cursor-pointer group/cb\">\n                        <div class=\"w-3 h-3 border border-[#8eb364] bg-[#8eb364]/20 flex items-center justify-center relative\">\n                            <div class=\"w-1.5 h-1.5 bg-[#8eb364] shadow-[0_0_5px_rgba(142,179,100,0.8)]\"></div>\n                        </div>\n                        <span class=\"font-['DM_Mono',monospace] text-xs text-[#c3d1b6] font-extralight tracking-widest\">NODE-GAMMA</span>\n                    </label>\n                </div>\n\n                <!-- Panel 4: Data Stream -->\n                <div class=\"border border-[#8eb364]/20 bg-[#121a10]/60 backdrop-blur-sm p-5 flex flex-col gap-2 justify-between hover:border-[#8eb364]/40 transition-colors\">\n                    <div class=\"flex items-center justify-between\">\n                        <span class=\"font-['DM_Mono',monospace] text-xs text-[#8eb364]/80 tracking-widest uppercase\">Data Stream</span>\n                        <iconify-icon icon=\"solar:code-scan-linear\" class=\"text-[#8eb364] text-lg\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                    </div>\n                    <div class=\"font-['DM_Mono',monospace] text-xs text-[#c3d1b6]/70 font-extralight tracking-widest space-y-2 mt-2\">\n                        <div class=\"flex justify-between\"><span>> INITIATING...</span> <span class=\"text-[#8eb364]\">OK</span></div>\n                        <div class=\"flex justify-between\"><span>> SYNC_RATE:</span> <span class=\"text-[#8eb364]\">144HZ</span></div>\n                        <div class=\"flex justify-between\"><span>> PACKET_LOSS:</span> <span class=\"text-[#8eb364]\">0.01%</span></div>\n                        <div class=\"flex justify-between opacity-50\"><span>> AWAITING_CMD_</span> <span class=\"animate-pulse text-[#8eb364]\">_</span></div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n    </div>\n\n    <!-- Interactive Flashlight Script -->\n    <script>\n        const card = document.getElementById('main-card');\n        card.addEventListener('mousemove', (e) => {\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            card.style.setProperty('--mouse-x', `${x}px`);\n            card.style.setProperty('--mouse-y', `${y}px`);\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "telemetry-diagnostics.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/