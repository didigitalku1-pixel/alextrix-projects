nk rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:ital,wght@0,300;0,400;1,300&family=Space+Grotesk:wght@300;400&display=swap\" rel=\"stylesheet\">\n</head>\n<body class=\"bg-[#c9d1c1] min-h-screen flex items-center justify-center p-4 md:p-12 overflow-hidden selection:bg-[#8eb364] selection:text-[#161f14]\">\n\n    <!-- Main Container -->\n    <div id=\"main-card\" class=\"relative w-full max-w-[1400px] aspect-[4/3] md:aspect-[21/9] rounded-sm shadow-2xl overflow-hidden flex group\"\n         style=\"background-color: #161f14;\n                background-image: repeating-linear-gradient(90deg, #161f14 0px, #161f14 16px, #121a10 16px, #121a10 32px);\n                box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 2px 4px rgba(255,255,255,0.05), inset 0 -4px 8px rgba(0,0,0,0.8);\n                --mouse-x: 50%;\n                --mouse-y: 50%;\">\n\n        <!-- Blueprint Grid Overlay -->\n        <div class=\"absolute inset-0 pointer-events-none z-0 opacity-50\"\n             style=\"background-size: 40px 40px; background-image: linear-gradient(to right, rgba(142,179,100,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(142,179,100,0.05) 1px, transparent 1px);\">\n        </div>\n\n        <!-- Vertical Container-Size Lines -->\n        <div class=\"absolute left-[25%] top-0 bottom-0 w-px bg-[#8eb364]/20 z-10 hidden md:flex flex-col justify-end pb-8 items-center\">\n            <span class=\"text-[#8eb364]/30 text-xs font-['DM_Mono'] uppercase tracking-widest\" style=\"writing-mode: vertical-rl;\">Sector-01</span>\n        </div>\n        <div class=\"absolute left-[50%] top-0 bottom-0 w-px bg-[#8eb364]/10 z-10 hidden md:block\"></div>\n        <div class=\"absolute left-[75%] top-0 bottom-0 w-px bg-[#8eb364]/20 z-10 hidden md:flex flex-col justify-start pt-8 items-center\">\n            <span class=\"text-[#8eb364]/30 text-xs font-['DM_Mono'] uppercase tracking-widest\" style=\"writing-mode: vertical-rl;\">Sector-02</span>\n        </div>\n\n        <!-- Horizontal Lines -->\n        <div class=\"absolute top-[33%] left-0 right-0 h-px bg-[#8eb364]/10 z-10 hidden md:block\"></div>\n        <div class=\"absolute top-[66%] left-0 right-0 h-px bg-[#8eb364]/10 z-10 hidden md:block\"></div>\n\n        <!-- Subtle Lighting Gradient -->\n        <div class=\"absolute inset-0 pointer-events-none z-0\"\n             style=\"background: radial-gradient(circle at 50% 50%, transparent 0%, rgba(0,0,0,0.6) 100%);\"></div>\n\n        <!-- Flashlight Hover Effect -->\n        <div class=\"absolute inset-0 pointer-events-none z-20 transition-opacity duration-500 opacity-0 group-hover:opacity-100 border-2 border-[#8eb364]\"\n             style=\"background-image: repeating-linear-gradient(45deg, rgba(142,179,100,0.3) 0px, rgba(142,179,100,0.3) 1px, transparent 1px, transparent 24px),\n                                      repeating-linear-gradient(-45deg, rgba(142,179,100,0.3) 0px, rgba(142,179,100,0.3) 1px, transparent 1px, transparent 24px);\n                    mask-image: radial-gradient(350px circle at var(--mouse-x) var(--mouse-y), black 0%, transparent 100%);\n                    -webkit-mask-image: radial-gradient(350px circle at var(--mouse-x) var(--mouse-y), black 0%, transparent 100%);\">\n        </div>\n\n        <!-- Architectural Corner Castings -->\n        <div class=\"absolute top-0 left-0 w-8 h-8 border-b border-r border-[#8eb364]/40 z-30 flex items-start justify-start p-1.5\"><div class=\"w-1 h-1 bg-[#8eb364]/60\"></div></div>\n        <div class=\"absolute top-0 right-0 w-8 h-8 border-b border-l border-[#8eb364]/40 z-30 flex items-start justify-end p-1.5\"><div class=\"w-1 h-1 bg-[#8eb364]/60\"></div></div>\n        <div class=\"absolute bottom-0 left-0 w-8 h-8 border-t border-r border-[#8eb364]/40 z-30 flex items-end justify-start p-1.5\"><div class=\"w-1 h-1 bg-[#8eb364]/60\"></div></div>\n        <div class=\"absolute bottom-0 right-0 w-8 h-8 border-t border-l border-[#8eb364]/40 z-30 flex items-end justify-end p-1.5\"><div class=\"w-1 h-1 bg-[#8eb364]/60\"></div></div>\n\n        <!-- Top Left Typography -->\n        <div class=\"absolute left-6 md:left-12 top-6 md:top-12 z-30 pointer-events-none flex flex-col gap-1\">\n            <div class=\"font-['DM_Mono',monospace] text-xs text-[#8eb364]/60 mb-2 font-extralight tracking-widest\">01 // TELEMETRY</div>\n            <h1 class=\"font-['Cormorant_Garamond',serif] text-4xl md:text-6xl font-normal tracking-tight text-[#c3d1b6] leading-none italic\">\n                Diagnostics\n            </h1>\n            <h2 class=\"font-['Space_Grotesk',sans-serif] text-xl md:text-2xl font-extralight tracking-tight text-[#8eb364] uppercase mt-1\">\n                System / Matrix\n            </h2>\n        </div>\n\n        <!-- Bottom Left Typography -->\n        <div class=\"absolute left-6 md:left-12 bottom-6 md:bottom-12 z-30 pointer-events-none hidden md:flex flex-col items-center gap-6\">\n            <div class=\"font-['Space_Grotesk',sans-serif] text-lg font-extralight tracking-tight text-[#8eb364] uppercase opacity-80\" style=\"writing-mode: vertical-rl; transform: rotate(180deg);\">\n                Nodes Active\n            </div>\n            <div class=\"font-['DM_Mono',monospace] text-xs text-[#8eb364]/60 font-extralight tracking-widest\" style=\"writing-mode: vertical-rl; transform: rotate(180deg);\">03 // SYS</div>\n        </div>\n\n        <!-- Top Right Typography -->\n        <div class=\"absolute right-6 md:right-12 top-6 md:top-12 z-30 pointer-events-none flex items-start gap-6 hidden md:flex\">\n            <div class=\"font-['DM_Mono',monospace] text-xs tracking-widest text-[#8eb364]/60 uppercase font-extralight mt-1\">\n                02 // STATUS\n            </div>\n            <div class=\"grid grid-cols-3 gap-1.5 text-center text-[#c3d1b6] font-extralight text-xs tracking-widest font-['Space_Grotesk',sans-serif]\">\n                <div class=\"col-start-2 text-[#8eb364]\">Y</div>\n                <div class=\"col-start-1 row-start-2\">-X</div>\n                <div class=\"col-start-2 row-start-2 flex items-center justify-center text-[#8eb364]\">\n                    <iconify-icon icon=\"solar:radar-linear\" class=\"text-sm\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                </div>\n                <div class=\"col-start-3 row-start-2\">X</div>\n                <div class=\"col-start-2 row-start-3\">-Y</div>\n            </div>\n        </div>\n\n        <!-- Bottom Right Typography -->\n        <div class=\"absolute right-6 md:right-12 bottom-6 md:bottom-12 z-30 pointer-events-none text-right flex flex-col items-end gap-3\">\n            <div class=\"font-['Space_Grotesk',sans-serif] text-4xl md:text-5xl font-normal tracking-tight text-[#c3d1b6] leading-none flex items-start gap-4\">\n                <span class=\"font-['DM_Mono',monospace] text-xs text-[#8eb364]/60 font-extralight tracking-widest mt-1\">04 // NET</span>\n                <div>12<span class=\"text-[#8eb364]\">.</span>04</div>\n            </div>\n            <div class=\"font-['DM_Mono',monospace] text-xs text-[#c3d1b6] opacity-75 uppercase tracking-widest space-y-1 font-extralight mt-1\">\n                <p>UPLINK: STABLE</p>\n                <p>BANDWIDTH: OPTIMAL</p>\n            </div>\n        </div>\n\n        <!-- Dashboard Grid Overlay -->\n        <div class=\"absolute inset-0 z-30 flex items-center justify-center p-6 md:p-24 pointer-events-none\">\n            <div class=\"w-full max-w-3xl grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 pointer-events-auto mt-24 md:mt-8\">\n\n                <!-- Panel 1: Resonance & Frequency -->\n                <div class=\"border border-[#8eb364]/20 bg-[#121a10]/60 backdrop-blur-sm p-5 flex flex-col gap-4 hover:border-[#8eb364]/40 transition-colors group/panel\">\n                    <div clas