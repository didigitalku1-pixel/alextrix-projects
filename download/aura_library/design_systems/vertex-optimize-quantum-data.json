rder-gray-200/80 bg-white rounded-full hover:shadow-md hover:border-gray-300 transition-all cursor-pointer group\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/2f563338-39fa-47ea-9761-658d4f3f84db_1600w.jpg\" class=\"w-12 h-12 rounded-full object-cover group-hover:scale-105 transition-transform\">\n                        <span class=\"font-semibold text-sm flex-1 text-gray-800\">Silas Thorne</span>\n                        <span class=\"text-xs text-gray-400 font-medium\">(1)</span>\n                    </div>\n                    <div class=\"flex items-center gap-4 p-2 pr-6 border border-gray-200/80 bg-white rounded-full hover:shadow-md hover:border-gray-300 transition-all cursor-pointer group\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/4f5668c5-fc4a-44e0-bc5e-a664189d3c31_1600w.jpg\" class=\"w-12 h-12 rounded-full object-cover group-hover:scale-105 transition-transform\">\n                        <span class=\"font-semibold text-sm flex-1 text-gray-800\">Maya Lin</span>\n                        <span class=\"text-xs text-gray-400 font-medium\">(2)</span>\n                    </div>\n                    <div class=\"flex items-center gap-4 p-2 pr-6 border border-gray-200/80 bg-white rounded-full hover:shadow-md hover:border-gray-300 transition-all cursor-pointer group\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/e534354d-c5f2-4399-a1d9-2f50338e8c47_1600w.jpg\" class=\"w-12 h-12 rounded-full object-cover group-hover:scale-105 transition-transform\">\n                        <span class=\"font-semibold text-sm flex-1 text-gray-800\">Kaelen Voss</span>\n                        <span class=\"text-xs text-gray-400 font-medium\">(3)</span>\n                    </div>\n                    <div class=\"flex items-center gap-4 p-2 pr-6 border border-gray-200/80 bg-white rounded-full hover:shadow-md hover:border-gray-300 transition-all cursor-pointer group\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/eca707cc-a5b7-439a-b4fd-247f6106c2e1_1600w.jpg\" class=\"w-12 h-12 rounded-full object-cover group-hover:scale-105 transition-transform\">\n                        <span class=\"font-semibold text-sm flex-1 text-gray-800\">Nova Chen</span>\n                        <span class=\"text-xs text-gray-400 font-medium\">(4)</span>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Bottom CTA Footer -->\n            <footer class=\"bg-gray-50/50 border-t border-gray-200/80 p-6 lg:p-12 relative z-10 gs-reveal\">\n                <div class=\"text-center max-w-2xl mx-auto flex flex-col items-center py-12\">\n                    <h2 class=\"text-3xl lg:text-4xl font-semibold tracking-tight uppercase mb-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2\">\n                        Deploy a\n                        <span class=\"relative inline-block px-8 py-2 border-2 border-black rounded-full shadow-[0_4px_0_0_rgba(0,0,0,1)] bg-white transform -rotate-1\">\n                            <span class=\"absolute -top-3 -right-3 w-6 h-6 bg-[#d4ff00] rounded-full border border-black flex items-center justify-center\">\n                                <iconify-icon icon=\"solar:star-bold\" width=\"12\" class=\"text-black\"></iconify-icon>\n                            </span>\n                            NODE!\n                        </span>\n                    </h2>\n                    <p class=\"text-sm text-gray-500 mb-8 font-medium max-w-lg leading-relaxed\">\n                        Integrate your clusters onto a quantum-encrypted framework overseen by the consensus protocol. Begin your initialization phase today.\n                    </p>\n                    <div class=\"flex items-center gap-4\">\n                        <button class=\"px-6 py-2.5 border border-gray-300 bg-white rounded-full text-sm font-semibold hover:border-black transition-colors text-gray-700 hover:text-black shadow-sm\">\n                            Read Docs\n                        </button>\n                        <button class=\"px-6 py-2.5 bg-black text-white rounded-full text-sm font-semibold hover:bg-gray-800 transition-colors shadow-md\">\n                            Start Sequence\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"mt-8 pt-6 border-t border-gray-200 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-400 font-medium\">\n                    <p>© 2025, Vertex Framework. All sequences active.</p>\n                    <button class=\"flex items-center gap-1.5 hover:text-black transition-colors\" onclick=\"window.scrollTo({top:0, behavior:'smooth'})\">\n                        Page upper <iconify-icon icon=\"solar:alt-arrow-up-linear\" width=\"16\"></iconify-icon>\n                    </button>\n                </div>\n            </footer>\n\n        </div>\n    </main>\n\n    <script>\n        // WebGL Particle Field Implementation\n        const initWebGL = () => {\n            const canvas = document.querySelector('#webgl-canvas');\n            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });\n            // Clamp DPR to max 2 for performance while maintaining crispness\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n            const resize = () => {\n                renderer.setSize(window.innerWidth, window.innerHeight);\n                if(camera) {\n                    camera.aspect = window.innerWidth / window.innerHeight;\n                    camera.updateProjectionMatrix();\n                }\n            };\n            window.addEventListener('resize', resize);\n            resize();\n\n            const scene = new THREE.Scene();\n            // Dark fog to fade particles in the distance softly\n            scene.fog = new THREE.FogExp2(0x0a0a0a, 0.0015);\n\n            const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n            camera.position.z = 40;\n\n            // Geometry construction\n            const particlesCount = 3000;\n            const geometry = new THREE.BufferGeometry();\n            const positions = new Float32Array(particlesCount * 3);\n            const randoms = new Float32Array(particlesCount);\n\n            for(let i = 0; i < particlesCount * 3; i+=3) {\n                // Wide spread across x and y, deep spread on z\n                positions[i] = (Math.random() - 0.5) * 150;\n                positions[i+1] = (Math.random() - 0.5) * 150;\n                positions[i+2] = (Math.random() - 0.5) * 100 - 20;\n                randoms[i/3] = Math.random();\n            }\n\n            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));\n            geometry.setAttribute('aRandom', new THREE.BufferAttribute(randoms, 1));\n\n            // Custom Shader for soft dots and breathing pulse\n            const material = new THREE.ShaderMaterial({\n                uniforms: {\n                    uTime: { value: 0 },\n                    uColor: { value: new THREE.Color('#3a3a3a') } // Subtle technical grey\n                },\n                vertexShader: `\n                    uniform float uTime;\n                    attribute float aRandom;\n                    varying float vAlpha;\n\n                    void main() {\n                        vec4 modelPosition = modelMatrix * vec4(position, 1.0);\n\n                        // Slow breathing pulse affecting Z position\n                        float pulse = sin(uTime * 0.3 + aRandom * 10.0) * 3.0;\n                        modelPosition.z += pulse;\n\n                        vec4 viewPosition = viewMatrix * modelPosition;\n                        gl_Position = projectionMatrix * viewPosition;\n\n                        // Dynamic point size based on depth and pulse\n                        float size = (3.0 + aRandom * 3.0 + sin(uTime * 0.5)*1.0);\n                        gl_PointSize = size * (20.0 / -viewPosition.z);\n\n                        vAlpha = 0.5 + sin(uTime * 0.5 + aRandom * 5.0) * 0.3; // Alpha pulse\n                    }\n                `,\n                fragmentShader: `\n                    uniform vec3 uColor;\n                    varying float vAlpha;\n\n                    void main() {\n                        // Soft circle fade logic\n                        float dist = distance(gl_PointCoord, vec2(0.5));\n                        if(dist > 0.5) discard;\n\n                        // Soft edge\n                        float strength = (0.5 - dist) * 2.0;\n                        gl_FragColor = vec4(uColor, strength * vAlpha * 0.4); // Keep overall opacity low\n                    }\n                `,\n                transparent: true,\n                depthWrite: false,\n                blending: THREE.AdditiveBlending\n            });\n\n            const particles = new THREE.Points(geometry, material);\n            scene.add(particles);\n\n            // Pointer drift interaction\n            let mouseX = 0;\n            let mouseY = 0;\n            let targetX = 0;\n            let targetY = 0;\n\n            document.addEventListener('mousemove', (event) => {\n                mouseX = (event.clientX / window.innerWidth) * 2 - 1;\n                mouseY = -(event.clientY / window.innerHeight) * 2 + 1;\n            });\n\n            const clock = new THREE.Clock();\n\n            const tick = () => {\n                const elapsedTime = clock.getElapsedTime();\n                material.uniforms.uTime.value = elapsedTime;\n\n                // Ease pointer tracking\n                targetX += (mouseX - targetX) * 0.05;\n                targetY += (mouseY - targetY) * 0.05;\n\n                // Subtle parallax camera drift\n                camera.position.x = targetX * 5;\n                camera.position.y = targetY * 5;\n                camera.lookAt(scene.position);\n\n                // Extremely slow rotation\n                particles.rotation.y = elapsedTime * 0.01;\n                particles.rotation.z = elapsedTime * 0.005;\n\n                renderer.render(scene, camera);\n                window.requestAnimationFrame(tick);\n            };\n            tick();\n        };\n\n        // Initialize WebGL\n        if(typeof THREE !== 'undefined') {\n            initWebGL();\n        }\n\n        // GSAP Animations Setup\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Main container entry\n        gsap.from(\".gs-reveal-container\", {\n            y: 60,\n            opacity: 0,\n            duration: 1.5,\n            ease: \"power4.out\",\n            delay: 0.2\n        });\n\n        // Staggered reveals for internal sections\n        gsap.utils.toArray('.gs-reveal').forEach((elem, i) => {\n            gsap.from(elem, {\n                scrollTrigger: {\n                    trigger: elem,\n                    start: \"top 85%\",\n                    toggleActions: \"play none none reverse\"\n                },\n                y: 30,\n                opacity: 0,\n                duration: 1,\n                ease: \"power3.out\",\n                delay: i === 0 ? 0.5 : 0 // slight delay for the first item (header/hero)\n            });\n        });\n\n        // Specific pop animation for the highlighted text\n        gsap.from(\"h1 span.inline-block\", {\n            scale: 0.8,\n            rotation: -15,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"elastic.out(1, 0.5)\",\n            delay: 1\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "vertex-optimize-quantum-data.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/vertex-optimize-quantum-data.jpg", "source_name": "vertex-optimize-quantum-data-DESIGN.md", "views": 365, "forks": 22, "private": false, "featured": true, "created_by": "2e815afb-cac1-4c01-90e1-cf3810246e35", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T21:43:28.166511+00:00"}