art Session\n                </button>\n              </div>\n\n              <div class=\"space-y-3\">\n                <div class=\"flex items-center gap-3 text-xs font-light text-gray-500\">\n                  <iconify-icon icon=\"solar:shield-warning-linear\" class=\"text-base\"></iconify-icon> Do Not Disturb enabled\n                </div>\n                <div class=\"flex items-center justify-between text-xs font-light text-gray-500\">\n                  <div class=\"flex items-center gap-3\">\n                    <iconify-icon icon=\"solar:clock-circle-linear\" class=\"text-base\"></iconify-icon> 2 hours remaining\n                  </div>\n                  <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/2f563338-39fa-47ea-9761-658d4f3f84db_800w.jpg\" class=\"w-6 h-6 rounded-full border-2 border-white shadow-sm object-cover\">\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"absolute bottom-0 left-0 right-0 p-8 pt-32 bg-gradient-to-t from-[#0a0a0c] via-[#0a0a0c]/90 to-transparent z-40 pointer-events-none rounded-b-[32px]\">\n            <p class=\"text-gray-400 text-lg font-light leading-relaxed max-w-md gs-fade-up opacity-0\">\n              <span class=\"text-white font-normal tracking-tight\">Focus Sessions.</span> Organize your day with clarity and intention.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Card 4: Notifications -->\n      <div class=\"md:col-span-5 bg-[#0a0a0c] rounded-[32px] overflow-hidden border border-white/[0.08] shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_24px_48px_rgba(0,0,0,0.4)] flex flex-col relative group h-[520px] transition-colors duration-500 hover:border-white/[0.12] gs-card\">\n\n        <div class=\"absolute inset-0 flex items-center justify-center z-0 mb-10 pointer-events-none\">\n          <!-- Gradient Ring -->\n          <div class=\"gs-spin-ring absolute w-64 h-64 rounded-full opacity-60 mix-blend-screen\" style=\"background: conic-gradient(from 0deg, #3b82f6, #0a0a0c, #f97316, #0a0a0c, #3b82f6); filter: blur(28px);\"></div>\n\n          <!-- Concentric Energy Waves -->\n          <div class=\"gs-pulse-ring absolute w-36 h-36 border-2 border-white/10 rounded-full\"></div>\n          <div class=\"gs-pulse-ring absolute w-36 h-36 border border-white/5 rounded-full\" style=\"animation-delay: 1.5s;\"></div>\n\n          <!-- Bell Container -->\n          <div class=\"gs-bell-container relative w-24 h-24 bg-[#141417] border border-white/10 rounded-full flex items-center justify-center shadow-[0_0_40px_rgba(0,0,0,0.8),inset_0_1px_1px_rgba(255,255,255,0.1)]\">\n            <iconify-icon icon=\"solar:bell-linear\" class=\"text-white text-4xl\"></iconify-icon>\n            <!-- Badge -->\n            <div class=\"gs-pulse-badge-bell absolute top-2 right-1.5 w-6 h-6 bg-gradient-to-tr from-orange-600 to-orange-400 rounded-full border-2 border-[#141417] flex items-center justify-center text-xs text-white font-normal shadow-lg\">\n              28\n            </div>\n          </div>\n        </div>\n\n        <div class=\"relative z-20 mt-auto p-8 bg-gradient-to-t from-[#0a0a0c] via-[#0a0a0c]/80 to-transparent pointer-events-none\">\n          <p class=\"text-gray-400 text-lg font-light leading-relaxed gs-fade-up opacity-0\">\n            <span class=\"text-white font-normal\">Notifications.</span> Keep up to date with any changes by receiving instant notifications.\n          </p>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      gsap.registerPlugin(ScrollTrigger);\n\n      // Hero Text Split & Reveal\n      const titleText = \"Agency-grade momentum\";\n      const titleContainer = document.getElementById('hero-title');\n\n      titleText.split(' ').forEach(word => {\n        const wordDiv = document.createElement('div');\n        wordDiv.className = 'overflow-hidden inline-block pb-2';\n        const wordSpan = document.createElement('span');\n        wordSpan.className = 'inline-block transform translate-y-full opacity-0 gs-reveal-word';\n        wordSpan.innerText = word;\n        wordDiv.appendChild(wordSpan);\n        titleContainer.appendChild(wordDiv);\n      });\n\n      const tl = gsap.timeline();\n      tl.to('.gs-reveal-word', {\n        y: 0,\n        opacity: 1,\n        duration: 1.2,\n        stagger: 0.1,\n        ease: 'power4.out',\n      })\n      .to('.gs-reveal-sub', {\n        y: 0,\n        opacity: 1,\n        duration: 1.2,\n        ease: 'power4.out',\n      }, \"-=0.8\");\n\n      // Global Reveal for Grid Items\n      gsap.from('.gs-card', {\n        y: 40,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.15,\n        ease: 'power3.out',\n        scrollTrigger: {\n          trigger: '.gs-grid-container',\n          start: 'top 85%'\n        }\n      });\n\n      // Card 1 Animations\n      gsap.to('.gs-god-ray', { x: \"5%\", rotation: -2, duration: 4, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n      gsap.to('.gs-key-press', { y: 2, boxShadow: \"0 0px 2px rgba(0,0,0,0.8), inset 0 1px 1px rgba(255,255,255,0.02)\", duration: 0.15, yoyo: true, repeat: -1, repeatDelay: 1.5 });\n      gsap.to('.gs-key-glow', { backgroundColor: \"rgba(249,115,22,0.1)\", color: \"rgba(255,255,255,0.8)\", boxShadow: \"0 0 16px rgba(249,115,22,0.3), inset 0 1px 1px rgba(255,255,255,0.1)\", duration: 0.5, yoyo: true, repeat: -1, repeatDelay: 2 });\n      gsap.to('.gs-glass-sweep', { x: \"250%\", duration: 6, repeat: -1, ease: \"none\", delay: 2 });\n      gsap.to('.gs-cursor', { opacity: 0, duration: 0.5, yoyo: true, repeat: -1, ease: \"steps(1)\" });\n\n      ScrollTrigger.create({\n        trigger: '.gs-palette',\n        start: 'top 90%',\n        onEnter: () => {\n          gsap.to('.gs-palette', { y: 0, opacity: 1, duration: 1, ease: 'back.out(1.2)', delay: 0.2 });\n          gsap.to('.gs-palette-text', { y: 0, opacity: 1, duration: 0.5, stagger: 0.1, ease: 'power2.out', delay: 0.6 });\n          gsap.to('.gs-palette', { y: -4, duration: 3, yoyo: true, repeat: -1, ease: 'sine.inOut', delay: 1.2 });\n        }\n      });\n\n      // Card 2 Animations\n      gsap.to('.gs-shimmer', { opacity: 0.3, duration: 2, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n      gsap.to('.gs-breathe', { scale: 1.05, opacity: 0.6, duration: 3.5, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n      gsap.to('.gs-pulse-badge', { opacity: 0.6, duration: 1.5, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n      gsap.to('.gs-avatar-float', { y: -2, duration: 2, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n\n      ScrollTrigger.create({\n        trigger: '.gs-main-card',\n        start: 'top 90%',\n        onEnter: () => {\n          gsap.to('.gs-side-card', { opacity: 0.4, filter: 'blur(2px)', duration: 1, stagger: 0.2 });\n          gsap.to('.gs-main-card', { y: 0, opacity: 1, duration: 1, ease: 'power3.out' });\n          gsap.to('.gs-task', { y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: 'power2.out', delay: 0.3 });\n          gsap.to('.gs-fade-up', { y: -10, opacity: 1, duration: 1, delay: 0.5 });\n          // Continuous floating\n          gsap.to('.gs-main-card', { y: -8, duration: 4, yoyo: true, repeat: -1, ease: 'sine.inOut', delay: 1 });\n        }\n      });\n\n      // Card 3 Animations\n      gsap.to('.gs-pulse-dot', { scale: 1.5, boxShadow: \"0 0 0 6px rgba(59,130,246,0)\", duration: 2, repeat: -1, ease: \"power2.out\" });\n      gsap.to('.gs-float-main', { y: -12, scale: 1.02, duration: 3, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n      gsap.to('.gs-float-sec', { y: -6, duration: 3.5, yoyo: true, repeat: -1, ease: \"sine.inOut\", delay: 0.5 });\n\n      // Card 4 Animations\n      gsap.to('.gs-spin-ring', { rotation: 360, duration: 10, repeat: -1, ease: \"none\" });\n      gsap.fromTo('.gs-pulse-ring',\n        { scale: 0.8, opacity: 0.8 },\n        { scale: 1.8, opacity: 0, duration: 3, repeat: -1, ease: \"power2.out\" }\n      );\n      gsap.to('.gs-pulse-badge-bell', { scale: 1.1, duration: 1, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\n\n      // Hover effect manual trigger for bell\n      const card4 = document.querySelectorAll('.gs-card')[3];\n      const bell = document.querySelector('.gs-bell-container');\n      card4.addEventListener('mouseenter', () => gsap.to(bell, { scale: 1.1, duration: 0.5, ease: 'back.out(2)' }));\n      card4.addEventListener('mouseleave', () => gsap.to(bell, { scale: 1, duration: 0.5, ease: 'power2.out' }));\n    });\n  </script>\n</body>\n</html>", "preview_file_name": "axiom-os-momentum.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/axiom-os-momentum.jpg", "source_name": "axiom-os-momentum-DESIGN.md", "views": 286, "forks": 9, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-03T16:16:17.850093+00:00"}