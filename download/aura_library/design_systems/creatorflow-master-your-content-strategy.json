\"text-sm text-brand-dark/70 transition hover:text-brand-pink\">Benefits</a>\n        <a href=\"#categories\" class=\"text-sm text-brand-dark/70 transition hover:text-brand-pink\">Expertise</a>\n        <a href=\"#testimonials\" class=\"text-sm text-brand-dark/70 transition hover:text-brand-pink\">Results</a>\n      </nav>\n\n      <div class=\"flex items-center gap-3\">\n        <a href=\"#mentor-cta\" class=\"hidden rounded-full px-4 py-2 text-sm font-medium text-brand-dark transition hover:bg-brand-dark/5 md:inline-flex\">Join as Mentor</a>\n        <a href=\"#hero-cta\" class=\"inline-flex rounded-full bg-brand-pink px-4 py-2 text-sm font-medium text-white transition hover:bg-[#e01e65] shadow-sm shadow-brand-pink/20\">Find an Expert</a>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"top\" class=\"relative z-10\">\n    <!-- Hero Section -->\n    <section class=\"relative overflow-hidden pt-16 pb-12 sm:pt-24 lg:pt-32 lg:pb-24\">\n      <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative\">\n        <!-- Subtle background glow -->\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-pink/5 rounded-full blur-[100px] pointer-events-none\"></div>\n\n        <div class=\"grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8\">\n          <div class=\"max-w-2xl relative z-10\">\n            <div class=\"mb-6 inline-flex items-center gap-2 rounded-full border border-brand-dark/10 bg-white px-3 py-1.5 text-xs font-medium text-brand-dark/70 shadow-sm\">\n              <span class=\"flex h-2 w-2 rounded-full bg-brand-pink relative\">\n                <span class=\"absolute inset-0 rounded-full bg-brand-pink animate-ping opacity-75\"></span>\n              </span>\n              Elite strategists available now\n            </div>\n\n            <h1 class=\"reveal font-heading text-4xl font-medium leading-tight tracking-tight text-brand-dark sm:text-5xl lg:text-6xl\">\n              Elevate your content game with industry experts.\n            </h1>\n\n            <p class=\"mt-6 max-w-xl text-base leading-relaxed text-brand-dark/70 sm:text-lg\">\n              Stop guessing the algorithm. Get practical 1:1 guidance on strategy, production, and monetization from creators who have actually done it.\n            </p>\n\n            <div id=\"hero-cta\" class=\"mt-8 flex flex-col gap-4 sm:flex-row\">\n              <a href=\"#categories\" class=\"inline-flex items-center justify-center gap-2 rounded-full bg-brand-dark px-6 py-3.5 text-sm font-medium text-white transition hover:bg-brand-dark/90 shadow-lg shadow-brand-dark/10\">\n                <iconify-icon icon=\"solar:magnifer-linear\" width=\"18\" height=\"18\" stroke-width=\"1.5\"></iconify-icon>\n                Browse Mentors\n              </a>\n              <a href=\"#how\" class=\"inline-flex items-center justify-center gap-2 rounded-full border border-brand-dark/10 bg-white px-6 py-3.5 text-sm font-medium text-brand-dark transition hover:bg-brand-dark/5\">\n                <iconify-icon icon=\"solar:play-circle-linear\" width=\"18\" height=\"18\" stroke-width=\"1.5\"></iconify-icon>\n                See how it works\n              </a>\n            </div>\n\n            <div class=\"mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-brand-dark/5 pt-8\">\n              <div>\n                <div class=\"font-heading text-2xl font-medium tracking-tight text-brand-dark\">50+</div>\n                <div class=\"mt-1 text-xs text-brand-dark/60\">Vetted creators</div>\n              </div>\n              <div>\n                <div class=\"font-heading text-2xl font-medium tracking-tight text-brand-dark\">10k+</div>\n                <div class=\"mt-1 text-xs text-brand-dark/60\">Hours mentored</div>\n              </div>\n              <div>\n                <div class=\"font-heading text-2xl font-medium tracking-tight text-brand-dark\">4.9/5</div>\n                <div class=\"mt-1 text-xs text-brand-dark/60\">Average rating</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"relative mx-auto w-full max-w-md lg:max-w-none\">\n            <!-- Premium Border Gradient Wrapper -->\n            <div class=\"rounded-[2.5rem] p-[1px]\" style=\"background: linear-gradient(135deg, rgba(17,35,69,0.15), rgba(251,40,117,0.2), rgba(17,35,69,0.05));\">\n              <div class=\"relative overflow-hidden rounded-[calc(2.5rem-1px)] bg-white p-2\">\n                <div class=\"relative overflow-hidden rounded-[2rem] aspect-[4/5]\">\n                  <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/582afef4-b810-47b8-a047-8b3597c323e1_3840w.webp\" alt=\"Content creator mentoring session\" class=\"h-full w-full object-cover\" />\n                  \n                  <!-- Floating UI Element -->\n                  <div class=\"absolute bottom-6 left-6 right-6 rounded-2xl border border-white/20 bg-white/90 p-4 backdrop-blur-md shadow-xl\">\n                    <div class=\"flex items-center gap-3\">\n                      <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/2f563338-39fa-47ea-9761-658d4f3f84db_1600w.jpg\" alt=\"Mentor\" class=\"h-10 w-10 rounded-full object-cover border border-brand-dark/10\" />\n                      <div class=\"flex-1\">\n                        <div class=\"text-sm font-medium text-brand-dark\">Session with Elena</div>\n                        <div class=\"text-xs text-brand-dark/60\">Brand Strategy Review</div>\n                      </div>\n                      <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-brand-pink/10 text-brand-pink\">\n                        <iconify-icon icon=\"solar:check-circle-linear\" width=\"18\" height=\"18\" stroke-width=\"1.5\"></iconify-icon>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Logo Cloud (Optional subtle trust building) -->\n    <section class=\"border-y border-brand-dark/5 bg-brand-light/30 py-8\">\n      <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n        <p class=\"text-center text-xs font-medium uppercase tracking-[0.15em] text-brand-dark/40 mb-6\">Mentors featured in</p>\n        <div class=\"flex flex-wrap justify-center gap-8 md:gap-16 opacity-60 grayscale\">\n          <div class=\"text-lg font-heading font-medium tracking-tight\">Forbes</div>\n          <div class=\"text-lg font-heading font-medium tracking-tight\">Vogue</div>\n          <div class=\"text-lg font-heading font-medium tracking-tight\">TechCrunch</div>\n          <div class=\"text-lg font-heading font-medium tracking-tight\">FastCompany</div>\n        </div>\n      </div>\n    </section>\n\n    <!-- How it works -->\n    <section id=\"how\" class=\"py-16 sm:py-24 lg:py-32 relative\">\n      <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n        <div class=\"mb-16 max-w-2xl\">\n          <h2 class=\"reveal font-heading text-3xl font-medium tracking-tight text-brand-dark sm:text-4xl\">Your path to mastering <br/>the digital landscape.</h2>\n          <p class=\"mt-4 text-sm leading-relaxed text-brand-dark/70 sm:text-base\">A streamlined process designed to get you the exact actionable advice you need, without the fluff.</p>\n        </div>\n\n        <div class=\"grid gap-6 md:grid-cols-3\">\n          <!-- Premium Border Gradient Card -->\n          <div class=\"rounded-3xl p-[1px] group\" style=\"background: linear-gradient(180deg, rgba(17,35,69,0.08), rgba(17,35,69,0.02));\">\n            <article class=\"h-full rounded-[calc(1.5rem-1px)] bg-white p-8 transition-all hover:shadow-lg hover:shadow-brand-dark/5\">\n              <div class=\"mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-brand-dark/5 text-brand-dark\">\n                <iconify-icon icon=\"solar:target-bold-duotone\" width=\"24\" height=\"24\"></iconify-icon>\n              </div>\n              <div class=\"text-xs font-medium text-brand-pink mb-2\">Phase 01</div>\n              <h3 class=\"font-heading text-xl font-medium tracking-tight text-brand-dark\">Define the goal</h3>\n              <p class=\"mt-3 text-sm leading-relaxed text-brand-dark/60\">Identify your current bottleneck—whether it's audience retention, aesthetic coherence, or monetization pathways.</p>\n            </article>\n          </div>\n\n          <div class=\"rounded-3xl p-[1px]\" style=\"background: linear-gradient(180deg, rgba(17,35,69,0.08), rgba(17,35,69,0.02));\">\n            <article class=\"h-full rounded-[calc(1.5rem-1px)] bg-white p-8 transition-all hover:shadow-lg hover:shadow-brand-dark/5\">\n              <div class=\"mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-brand-pink/10 text-brand-pink\">\n                <iconify-icon icon=\"solar:users-group-rounded-bold-duotone\" width=\"24\" height=\"24\"></iconify-icon>\n              </div>\n              <div class=\"text-xs font-medium text-brand-pink mb-2\">Phase 02</div>\n              <h3 class=\"font-heading text-xl font-medium tracking-tight text-brand-dark\">Match with an expert</h3>\n              <p class=\"mt-3 text-sm leading-relaxed text-brand-dark/60\">Browse profiles of vetted industry leaders based on your specific niche and desired outcomes.</p>\n            </article>\n          </div>\n\n          <div class=\"rounded-3xl p-[1px]\" style=\"background: linear-gradient(180deg, rgba(17,35,69,0.08), rgba(17,35,69,0.02));\">\n            <article class=\"h-full rounded-[calc(1.5rem-1px)] bg-white p-8 transition-all hover:shadow-lg hover:shadow-brand-dark/5\">\n              <div class=\"mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-brand-dark/5 text-brand-dark\">\n                <iconify-icon icon=\"solar:video-frame-bold-duotone\" width=\"24\" height=\"24\"></iconify-icon>\n              </div>\n              <div class=\"text-xs font-medium text-brand-pink mb-2\">Phase 03</div>\n              <h3 class=\"font-heading text-xl font-medium tracking-tight text-brand-dark\">Execute in 1:1 sessions</h3>\n              <p class=\"mt-3 text-sm leading-relaxed text-brand-dark/60\">Jump on a focused video call to review strategy, analyze data, and build an actionable roadmap together.</p>\n            </article>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Categories / Areas of Expertise -->\n    <section id=\"categories\" class=\"border-t border-brand-dark/5 bg-brand-light/20 py-16 sm:py-24 lg:py-32\">\n      <div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n        <div class=\"mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between\">\n          <div class=\"max-w-2xl\">\n            <h2 class=\"reveal font-heading text-3xl font-medium tracking-tight text-brand-dark sm:text-4xl\">Areas of expertise.</h2>\n            <p class=\"mt-4 text-sm leading-relaxed text-brand-dark/70\">Targeted support across the entire content lifecycle.</p>\n          </div>\n          <a href=\"#\" class=\"inline-flex items-center gap-2 text-sm font-medium text-brand-pink hover:text-[#e01e65]\">\n            View all categories <iconify-icon icon=\"solar:arrow-right-linear\" width=\"16\" height=\"16\"></iconify-icon>\n          </a>\n        </div>\n\n        <div class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          <!-- Category Item -->\n          <a href=\"#\" class=\"group flex items-start gap-4 rounded-2xl border border-brand-dark/10 bg-white p-6 transition-all hover:border-brand-pink/30 hover:shadow-md\">\n            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-dark text-white\">\n              <iconify-icon icon=\"solar:clapperboard-edit-linear\" width=\"20\" height=\"20\" stroke-width=\"1.5\"></iconify-icon>\n            