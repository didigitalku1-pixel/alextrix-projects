ll('.reveal-word-inner'), {\n                        y: '0%',\n                        rotate: 0,\n                        duration: 1.2,\n                        stagger: 0.03,\n                        ease: 'power4.out',\n                        scrollTrigger: {\n                            trigger: el,\n                            start: 'top 90%',\n                            toggleActions: 'play none none reverse'\n                        }\n                    });\n                });\n            };\n\n            setTimeout(setupTextReveal, 100);\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "verdant-syntax-precision-botanical-architecture.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/verdant-syntax-precision-botanical-architecture.jpg", "source_name": "verdant-syntax-precision-botanical-architecture-DESIGN.md", "views": 977, "forks": 39, "private": false, "featured": false, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T01:10:29.088865+00:00", "updated_at": "2026-07-03T10:58:08.539475+00:00"}