k-0\" aria-hidden=\"true\">\n                        <div class=\"w-1 h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-[2px] h-4/5 bg-[#0F191E]\"></div>\n                        <div class=\"w-2 h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-[1px] h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-[3px] h-3/5 bg-[#0F191E]\"></div>\n                        <div class=\"w-1 h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-[2px] h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-[1px] h-4/5 bg-[#0F191E]\"></div>\n                        <div class=\"w-2 h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-1 h-3/5 bg-[#0F191E]\"></div>\n                        <div class=\"w-[3px] h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-[1px] h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-1 h-4/5 bg-[#0F191E]\"></div>\n                        <div class=\"w-[2px] h-full bg-[#0F191E]\"></div>\n                        <div class=\"w-[1px] h-3/5 bg-[#0F191E]\"></div>\n                        <div class=\"w-2 h-full bg-[#0F191E]\"></div>\n                    </div>\n\n                </div>\n            </div>\n\n        </section>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Utility to prepare text for masked reveal\n            function prepareMaskedText(selector) {\n                document.querySelectorAll(selector).forEach(el => {\n                    const text = el.innerText;\n                    // Split by spaces, keep spaces\n                    const words = text.split(/(\\s+)/);\n                    el.innerHTML = '';\n\n                    words.forEach(word => {\n                        if(word.trim() === '') {\n                            el.appendChild(document.createTextNode(word));\n                            return;\n                        }\n                        const wrapper = document.createElement('span');\n                        wrapper.className = 'gs-word-wrapper';\n\n                        const inner = document.createElement('span');\n                        inner.className = 'gs-word-inner';\n                        inner.innerText = word;\n\n                        wrapper.appendChild(inner);\n                        el.appendChild(wrapper);\n                    });\n                });\n            }\n\n            prepareMaskedText('.gs-reveal-title');\n\n            // --- Main Timeline Arc (5-10s Sequence) ---\n            const tl = gsap.timeline({\n                defaults: { ease: \"power3.out\" }\n            });\n\n            // Set initial states to prevent flash of unstyled content during load\n            gsap.set('.grid-cell', { opacity: 0, scale: 0.98, y: 10 });\n            gsap.set('.logo-shape', { scale: 0, rotation: -15, opacity: 0 });\n            gsap.set('.sidebar-item', { opacity: 0, x: 20 });\n            gsap.set('.sidebar-list-item', { opacity: 0, y: 15 });\n            gsap.set('.yellow-footer', { yPercent: 100 });\n\n            // 1. Clear Loader\n            tl.to('#global-loader', {\n                opacity: 0,\n                duration: 0.8,\n                ease: \"power2.inOut\",\n                onComplete: () => document.getElementById('global-loader').style.display = 'none'\n            })\n\n            // 2. Structural Grid Reveal\n            .to('.grid-cell', {\n                opacity: 1,\n                scale: 1,\n                y: 0,\n                duration: 0.8,\n                stagger: { amount: 0.6, grid: \"auto\", from: \"top left\" }\n            }, \"-=0.2\")\n\n            // 3. Masked Title Reveal\n            .to('.gs-reveal-title .gs-word-inner', {\n                y: '0%',\n                duration: 1.2,\n                stagger: 0.1,\n                ease: \"expo.out\"\n            }, \"-=0.6\")\n\n            // 4. Sidebar Context Items\n            .to('.sidebar-item', {\n                opacity: 1,\n                x: 0,\n                duration: 0.8,\n                stagger: 0.1\n            }, \"-=0.8\")\n\n            // 5. Logo Shapes spring in\n            .to('.logo-shape', {\n                scale: 1,\n                rotation: 0,\n                opacity: 1,\n                duration: 1.2,\n                stagger: { amount: 0.5, grid: \"auto\", from: \"random\" },\n                ease: \"elastic.out(1, 0.7)\"\n            }, \"-=0.6\")\n\n            // 6. Yellow Footer slides up\n            .to('.yellow-footer', {\n                yPercent: 0,\n                duration: 1,\n                ease: \"expo.out\"\n            }, \"-=0.8\");\n\n\n            // --- ScrollTrigger Implementation ---\n            // Ensures lists reveal gracefully if they fall below the fold on smaller screens\n            ScrollTrigger.batch(\".sidebar-list-item\", {\n                start: \"top 95%\",\n                onEnter: batch => gsap.to(batch, {\n                    opacity: 1,\n                    y: 0,\n                    duration: 0.6,\n                    stagger: 0.1,\n                    ease: \"power2.out\",\n                    overwrite: true\n                }),\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "zenith-x-core-systems.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/zenith-x-core-systems.jpg", "source_name": "zenith-x-core-systems-DESIGN.md", "views": 184, "forks": 14, "private": false, "featured": true, "created_by": "2e815afb-cac1-4c01-90e1-cf3810246e35", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T10:08:37.122867+00:00"}