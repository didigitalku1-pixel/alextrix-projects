border-[#0F191E] rounded-full flex items-center justify-center p-2\">\n                        <div class=\"w-full h-full border border-[#0F191E] rotate-45 group-hover:-rotate-45 transition-transform duration-1000\"></div>\n                    </div>\n                    <span class=\"mt-6 text-[0.7rem] font-semibold tracking-widest uppercase\">Stellaris</span>\n                </div>\n                 <div class=\"grid-cell aspect-square border-b border-r border-[#0F191E]/30 relative flex flex-col items-center justify-center p-6 group overflow-hidden bg-[#E2F1F2] hidden lg:flex\">\n                    <span class=\"absolute top-2 left-3 font-mono text-[0.6rem] opacity-70\">11</span>\n                    <span class=\"absolute -top-[5px] -left-[5px] text-[#0F191E] text-xs leading-none opacity-50\">+</span>\n                    <div class=\"w-16 h-20 flex gap-2 items-end logo-shape\">\n                        <div class=\"w-3 h-3/4 bg-[#0F191E] group-hover:h-full transition-all duration-300\"></div>\n                        <div class=\"w-3 h-full bg-[#0F191E] group-hover:h-2/4 transition-all duration-300 delay-75\"></div>\n                        <div class=\"w-3 h-2/4 bg-[#0F191E] group-hover:h-3/4 transition-all duration-300 delay-150\"></div>\n                    </div>\n                    <span class=\"mt-6 text-[0.7rem] font-semibold tracking-widest uppercase\">Metrics</span>\n                </div>\n                 <div class=\"grid-cell aspect-square border-b border-r border-[#0F191E]/30 relative flex flex-col items-center justify-center p-6 group overflow-hidden bg-[#E2F1F2] hidden lg:flex\">\n                    <span class=\"absolute top-2 left-3 font-mono text-[0.6rem] opacity-70\">12</span>\n                    <span class=\"absolute -top-[5px] -left-[5px] text-[#0F191E] text-xs leading-none opacity-50\">+</span>\n                    <div class=\"w-20 h-20 relative flex items-center justify-center logo-shape\">\n                         <iconify-icon i