events-none absolute inset-0 z-30 border border-white/5\"></div>\n\n        <!-- Instrument crosshairs and framing -->\n        <div class=\"pointer-events-none absolute left-0 top-0 z-40 h-8 w-8 border-l border-t border-white/40\"></div>\n        <div class=\"pointer-events-none absolute right-0 top-0 z-40 h-8 w-8 border-r border-t border-white/40\"></div>\n        <div class=\"pointer-events-none absolute bottom-0 left-0 z-40 h-8 w-8 border-b border-l border-white/40\"></div>\n        <div class=\"pointer-events-none absolute bottom-0 right-0 z-40 h-8 w-8 border-b border-r border-white/40\"></div>\n\n        <div class=\"pointer-events-none absolute left-[6.5%] top-0 z-40 h-full w-px bg-white/10\">\n          <span class=\"absolute -left-[3px] top-[7%] h-1.5 w-1.5 rounded-full border border-white/50 bg-black\"></span>\n          <span class=\"absolute -left-[3px] bottom-[7%] h-1.5 w-1.5 rounded-full border border-white/50 bg-black\"></span>\n        </div>\n        <div class=\"pointer-events-none absolute right-[6.5%] top-0 z-40 h-full w-px bg-white/10\">\n          <span class=\"absolute -left-[3px] top-[7%] h-1.5 w-1.5 rounded-full border border-white/50 bg-black\"></span>\n          <span class=\"absolute -left-[3px] bottom-[7%] h-1.5 w-1.5 rounded-full border border-white/50 bg-black\"></span>\n        </div>\n        <div class=\"pointer-events-none absolute left-0 top-[18%] z-40 h-px w-full bg-white/[0.04]\"></div>\n        <div class=\"pointer-events-none absolute left-0 bottom-[22%] z-40 h-px w-full bg-white/[0.04]\"></div>\n\n        <div id=\"carousel\" class=\"relative z-10 flex h-full w-full overflow-hidden\">\n\n          <!-- PANEL 1 -->\n          <article class=\"panel group relative h-full min-w-0 flex-none overflow-hidden border-r border-white/10\" data-index=\"0\" data-active=\"true\" aria-label=\"Void Resonance panel\" style=\"width: 52%;\">\n            <div class=\"absolute inset-0 bg-black\" style=\"background: radial-gradient(circle at 64% 38%, rgba(255,255,255,0.06), transparent 40%), radial-gradient(circle at 24% 68%, rgba(255,255,255,0.03), transparent 30%);\"></div>\n\n            <!-- Clock/Dial Centerpiece -->\n            <div class=\"ring-field pointer-events-none absolute left-[12%] top-[13%] h-[58%] w-[70%] opacity-80\" aria-hidden=\"true\">\n              <!-- Degree Ticks -->\n              <div class=\"absolute inset-0 rounded-full opacity-40\" style=\"background: repeating-conic-gradient(from 0deg, #fff 0deg, #fff 0.5deg, transparent 0.5deg, transparent 4deg); mask-image: radial-gradient(circle, transparent 67%, black 68%); -webkit-mask-image: radial-gradient(circle, transparent 67%, black 68%);\"></div>\n              <!-- Inner Rings -->\n              <div class=\"wire-ring absolute left-[8%] top-[8%] h-[84%] w-[84%] rounded-full border border-white/10 border-dashed\" style=\"transform: rotate(12deg) scaleX(1.02);\"></div>\n              <div class=\"wire-ring absolute left-[18%] top-[18%] h-[64%] w-[64%] rounded-full border border-white/20\" style=\"transform: rotate(-18deg);\"></div>\n              <!-- Rotating Axis Guides -->\n              <div class=\"absolute left-1/2 top-0 h-full w-px bg-white/10 -translate-x-1/2\"></div>\n              <div class=\"absolute top-1/2 left-0 h-px w-full bg-white/10 -translate-y-1/2\"></div>\n              <!-- Core -->\n              <div class=\"absolute left-[47%] top-[47%] h-[6%] w-[6%] rounded-full border border-white/40 bg-black shadow-[0_0_12px_rgba(255,255,255,0.15)]\"></div>\n            </div>\n\n            <header class=\"absolute right-[7%] top-[6%] z-20 text-right uppercase tracking-[0.24rem] text-zinc-100\">\n              <div class=\"text-2xl font-normal leading-none sm:text-3xl\">NK</div>\n              <p class=\"mt-2 text-[0.62rem] font-medium tracking-[0.22rem] text-zinc-400 sm:text-xs\">KINSEY LABS</p>\n            </header>\n\n            <div class=\"title-wrap absolute left-[6.5%] top-[18%] z-10 max-w-[62%]\">\n              <p class=\"mb-3 text-xs font-medium uppercase tracking-[0.34rem] text-zinc-400\">Calibration 01</p>\n              <h1 class=\"tracking-tight text-5xl font-medium uppercase leading-[0.86] text-white sm:text-7xl md:text-8xl lg:text-9xl\" style=\"font-family: Didot, 'Bodoni 72', 'Bodoni MT', 'Playfair Display', serif;\">VOID<br />RESONANCE</h1>\n            </div>\n\n            <div class=\"product absolute bottom-[13%] left-[35%] z-20 h-[65%] w-[38%] rounded-3xl p-px bg-gradient-to-br from-white/20 via-white/5 to-transparent shadow-[0_10px_40px_rgba(0,0,0,0.8)]\" aria-hidden=\"true\">\n              <div class=\"relative h-full w-full overflow-hidden rounded-[1.4rem] bg-black/80 backdrop-blur-md\">\n                <div class=\"absolute inset-0 z-10 bg-gradient-to-t from-black/60 to-transparent\"></div>\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/fb6415fd-bf4d-4ccf-8e9d-7ab445e99207_1600w.jpg\" class=\"h-full w-full object-cover opacity-60 mix-blend-luminosity\" alt=\"Isometric modern structure\" />\n              </div>\n            </div>\n\n            <button class=\"play-btn absolute left-[55%] top-[47%] z-30 flex h-16 w-16 items-center justify-center rounded-full p-px bg-gradient-to-b from-white/30 to-white/5 shadow-[0_0_15px_rgba(255,255,255,0.05)] transition-transform duration-300 hover:scale-105 focus:outline-none focus:ring-1 focus:ring-white/50 sm:h-20 sm:w-20\" aria-label=\"Engage Void Resonance\">\n              <div class=\"flex h-full w-full items-center justify-center rounded-full bg-black/80 backdrop-blur-md\">\n                <iconify-icon icon=\"solar:play-linear\" width=\"28\" height=\"28\" aria-hidden=\"true\" class=\"text-white\"></iconify-icon>\n              </div>\n            </button>\n\n            <nav aria-label=\"Void Resonance modules\" class=\"absolute bottom-[6%] left-[6.5%] right-[6.5%] z-20 grid grid-cols-2 gap-3 border-t border-white/10 pt-4 text-zinc-300\">\n              <a href=\"#\" class=\"flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:clock-circle-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Chrono</span>Shift</span>\n              </a>\n              <a href=\"#\" class=\"flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:radar-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Phase</span>Sync</span>\n              </a>\n            </nav>\n          </article>\n\n          <!-- PANEL 2 -->\n          <article class=\"panel group relative h-full min-w-0 flex-none overflow-hidden border-r border-white/10\" data-index=\"1\" aria-label=\"Lumen Metrics panel\" style=\"width: 24%;\">\n            <div class=\"absolute inset-0 bg-black\" style=\"background: radial-gradient(circle at 54% 43%, rgba(255,255,255,0.05), transparent 30%), radial-gradient(circle at 18% 80%, rgba(255,255,255,0.02), transparent 25%);\"></div>\n\n            <div class=\"ring-field pointer-events-none absolute left-[16%] top-[17%] h-[58%] w-[72%] opacity-70\" aria-hidden=\"true\">\n              <div class=\"absolute inset-0 rounded-full opacity-30\" style=\"background: repeating-conic-gradient(from 15deg, #fff 0deg, #fff 1deg, transparent 1deg, transparent 8deg); mask-image: radial-gradient(circle, transparent 65%, black 66%); -webkit-mask-image: radial-gradient(circle, transparent 65%, black 66%);\"></div>\n              <div class=\"wire-ring absolute left-[5%] top-[5%] h-[90%] w-[90%] rounded-full border border-white/10\" style=\"transform: rotate(-12deg);\"></div>\n              <div class=\"wire-ring absolute left-[20%] top-[20%] h-[60%] w-[60%] rounded-full border border-white/20 border-dashed\" style=\"transform: rotate(22deg);\"></div>\n              <div class=\"absolute left-1/2 top-[10%] h-[80%] w-px bg-white/10 -translate-x-1/2\"></div>\n              <div class=\"absolute top-1/2 left-[10%] h-px w-[80%] bg-white/10 -translate-y-1/2\"></div>\n            </div>\n\n            <header class=\"absolute right-[7%] top-[6%] z-20 text-right uppercase tracking-[0.24rem] text-zinc-100\">\n              <div class=\"text-3xl font-normal leading-none\">ER</div>\n              <p class=\"mt-2 text-[0.62rem] font-medium tracking-[0.22rem] text-zinc-400 sm:text-xs\">CORE SYS</p>\n            </header>\n\n            <div class=\"title-wrap absolute left-[6.5%] top-[18%] z-10 max-w-[64%]\">\n              <p class=\"mb-3 text-xs font-medium uppercase tracking-[0.34rem] text-zinc-400\">Diagnostic 404</p>\n              <h2 class=\"tracking-tight text-5xl font-medium uppercase leading-[0.86] text-white sm:text-7xl md:text-8xl lg:text-9xl\" style=\"font-family: Didot, 'Bodoni 72', 'Bodoni MT', 'Playfair Display', serif;\">LUMEN<br />METRICS</h2>\n            </div>\n\n            <div class=\"product absolute bottom-[22%] left-[38%] z-20 h-[45%] w-[38%] rounded-[2.5rem] p-px bg-gradient-to-tr from-white/20 via-white/5 to-transparent shadow-[0_10px_40px_rgba(0,0,0,0.8)]\" aria-hidden=\"true\">\n              <div class=\"relative h-full w-full overflow-hidden rounded-[2.4rem] bg-black/80 backdrop-blur-md\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/724142aa-44a6-48d3-9cf3-761e00d05b78_1600w.jpg\" class=\"h-full w-full object-cover opacity-60 mix-blend-luminosity\" alt=\"Futuristic Deconstructed Pyramid\" />\n              </div>\n            </div>\n\n            <div class=\"product absolute bottom-[16%] left-[16%] z-20 h-[16%] w-[16%] rounded-2xl p-px bg-gradient-to-br from-white/20 to-transparent shadow-[0_5px_20px_rgba(0,0,0,0.8)]\" aria-hidden=\"true\">\n              <div class=\"relative h-full w-full overflow-hidden rounded-[0.9rem] bg-black/80 backdrop-blur-md\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/4734259a-bad7-422f-981e-ce01e79184f2_1600w.jpg\" class=\"h-full w-full object-cover opacity-50 mix-blend-luminosity\" alt=\"Abstract gradient hills\" />\n              </div>\n            </div>\n\n            <button class=\"play-btn absolute left-[69%] top-[43%] z-30 flex h-16 w-16 items-center justify-center rounded-full p-px bg-gradient-to-b from-white/30 to-white/5 shadow-[0_0_15px_rgba(255,255,255,0.05)] transition-transform duration-300 hover:scale-105 focus:outline-none focus:ring-1 focus:ring-white/50 sm:h-20 sm:w-20\" aria-label=\"Engage Lumen Metrics\">\n              <div class=\"flex h-full w-full items-center justify-center rounded-full bg-black/80 backdrop-blur-md\">\n                <iconify-icon icon=\"solar:play-linear\" width=\"28\" height=\"28\" aria-hidden=\"true\" class=\"text-white\"></iconify-icon>\n              </div>\n            </button>\n\n            <nav aria-label=\"Lumen Metrics modules\" class=\"absolute bottom-[6%] left-[6.5%] right-[6.5%] z-20 grid grid-cols-3 gap-2 border-t border-white/10 pt-4 text-zinc-300\">\n              <a href=\"#\" class=\"flex items-center gap-2 text-xs font-medium uppercase tracking-[0.13rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:pulse-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Pulse</span>Rate</span>\n              </a>\n              <a href=\"#\" class=\"flex items-center gap-2 text-xs font-medium uppercase tracking-[0.13rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:thermometer-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Heat</span>Index</span>\n              </a>\n              <a href=\"#\" class=\"flex items-center gap-2 text-xs font-medium uppercase tracking-[0.13rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:cpu-bolt-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Flux</span>Field</span>\n              </a>\n            </nav>\n          </article>\n\n          <!-- PANEL 3 -->\n          <article class=\"panel group relative h-full min-w-0 flex-none overflow-hidden\" data-index=\"2\" aria-label=\"Astral Flux panel\" style=\"width: 24%;\">\n            <div class=\"absolute inset-0 bg-black\" style=\"background: radial-gradient(circle at 55% 44%, rgba(255,255,255,0.04), transparent 25%), radial-gradient(circle at 84% 16%, rgba(255,255,255,0.03), transparent 20%);\"></div>\n\n            <div class=\"ring-field pointer-events-none absolute left-[14%] top-[15%] h-[64%] w-[72%] opacity-60\" aria-hidden=\"true\">\n              <div class=\"absolute inset-0 rounded-full opacity-50\" style=\"background: repeating-conic-gradient(from 0deg, #fff 0deg, #fff 0.25deg, transparent 0.25deg, transparent 2deg); mask-image: radial-gradient(circle, transparent 70%, black 71%); -webkit-mask-image: radial-gradient(circle, transparent 70%, black 71%);\"></div>\n              <div class=\"wire-ring absolute left-[12%] top-[12%] h-[76%] w-[76%] rounded-full border border-white/10\" style=\"transform: rotate(10deg);\"></div>\n              <div class=\"wire-ring absolute left-[26%] top-[26%] h-[48%] w-[48%] rounded-full border border-white/20 border-dotted\" style=\"transform: rotate(-26deg);\"></div>\n              <div class=\"absolute left-1/2 top-0 h-full w-px bg-white/10 -translate-x-1/2\"></div>\n              <div class=\"absolute top-1/2 left-0 h-px w-full bg-white/10 -translate-y-1/2\"></div>\n              <div class=\"absolute left-[48%] top-[48%] h-[4%] w-[4%] rounded-full bg-white/30\"></div>\n            </div>\n\n            <header class=\"absolute right-[7%] top-[6%] z-20 text-right uppercase tracking-[0.24rem] text-zinc-100\">\n              <div class=\"text-3xl font-normal leading-none\">JV</div>\n              <p class=\"mt-2 text-[0.62rem] font-medium tracking-[0.22rem] text-zinc-400 sm:text-xs\">SEC-9 ATELIER</p>\n            </header>\n\n            <div class=\"title-wrap absolute left-[6.5%] top-[18%] z-10 max-w-[64%]\">\n              <p class=\"mb-3 text-xs font-medium uppercase tracking-[0.34rem] text-zinc-400\">Sector 992</p>\n              <h2 class=\"tracking-tight text-5xl font-medium uppercase leading-[0.86] text-white sm:text-7xl md:text-8xl lg:text-9xl\" style=\"font-family: Didot, 'Bodoni 72', 'Bodoni MT', 'Playfair Display', serif;\">ASTRAL<br />FLUX</h2>\n            </div>\n\n            <div class=\"product absolute bottom-[22%] left-[35%] z-20 h-[43%] w-[42%] rounded-full p-px bg-gradient-to-tr from-white/20 via-white/5 to-transparent shadow-[0_10px_40px_rgba(0,0,0,0.8)]\" aria-hidden=\"true\">\n              <div class=\"relative h-full w-full overflow-hidden rounded-full bg-black/80 backdrop-blur-md\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/5ee0a38a-b5d3-4531-8793-98beed4af162_1600w.jpg\" class=\"h-full w-full object-cover opacity-60 mix-blend-luminosity\" alt=\"Ring-Shaped Futuristic City\" />\n              </div>\n            </div>\n\n            <button class=\"play-btn absolute left-[69%] top-[30%] z-30 flex h-16 w-16 items-center justify-center rounded-full p-px bg-gradient-to-b from-white/30 to-white/5 shadow-[0_0_15px_rgba(255,255,255,0.05)] transition-transform duration-300 hover:scale-105 focus:outline-none focus:ring-1 focus:ring-white/50 sm:h-20 sm:w-20\" aria-label=\"Engage Astral Flux\">\n              <div class=\"flex h-full w-full items-center justify-center rounded-full bg-black/80 backdrop-blur-md\">\n                <iconify-icon icon=\"solar:play-linear\" width=\"28\" height=\"28\" aria-hidden=\"true\" class=\"text-white\"></iconify-icon>\n              </div>\n            </button>\n\n            <nav aria-label=\"Astral Flux modules\" class=\"absolute bottom-[6%] left-[6.5%] right-[6.5%] z-20 grid grid-cols-3 gap-2 border-t border-white/10 pt-4 text-zinc-300\">\n              <a href=\"#\" class=\"flex items-center gap-2 text-xs font-medium uppercase tracking-[0.13rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:black-hole-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Void</span>Dynamics</span>\n              </a>\n              <a href=\"#\" class=\"flex items-center gap-2 text-xs font-medium uppercase tracking-[0.13rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:server-square-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Data</span>Suite</span>\n              </a>\n              <a href=\"#\" class=\"flex items-center gap-2 text-xs font-medium uppercase tracking-[0.13rem] transition-colors hover:text-white\">\n                <iconify-icon icon=\"solar:target-linear\" width=\"22\" height=\"22\" aria-hidden=\"true\" class=\"opacity-60\"></iconify-icon>\n                <span><span class=\"block text-zinc-500\">Apex</span>Cal</span>\n              </a>\n            </nav>\n          </article>\n        </div>\n\n        <!-- System Pill -->\n        <div class=\"pointer-events-none absolute left-6 top-6 z-40 flex items-center gap-3 rounded-full border border-white/10 bg-black/40 px-4 py-2 text-xs font-medium uppercase tracking-[0.24rem] text-zinc-300 shadow-lg backdrop-blur-md\">\n          <span class=\"h-1.5 w-1.5 rounded-full bg-white shadow-[0_0_8px_rgba(255,255,255,0.8)]\"></span>\n          <span>Core System</span>\n        </div>\n\n        <div class=\"absolute bottom-6 right-6 z-40 flex items-center gap-2 rounded-full border border-white/10 bg-black/40 p-2 shadow-lg backdrop-blur-md\" aria-label=\"Carousel progress\">\n          <button class=\"dot h-1 w-6 bg-white/80 transition-all hover:bg-white\" data-dot=\"0\" aria-label=\"Show Void Resonance\"></button>\n          <button class=\"dot h-1 w-6 bg-white/20 transition-all hover:bg-white/50\" data-dot=\"1\" aria-label=\"Show Lumen Metrics\"></button>\n          <button class=\"dot h-1 w-6 bg-white/20 transition-all hover:bg-white/50\" data-dot=\"2\" aria-label=\"Show Astral Flux\"></button>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <script>\n    const panels = Array.from(document.querySelectorAll('.panel'));\n    const dots = Array.from(document.querySelectorAll('.dot'));\n    const products = Array.from(document.querySelectorAll('.product'));\n    const ringFields = Array.from(document.querySelectorAll('.ring-field'));\n    let activeIndex = 0;\n    let timer;\n\n    function setActive(index) {\n      activeIndex = index;\n      panels.forEach((panel, i) => {\n        panel.dataset.active = i === index ? 'true' : 'false';\n        gsap.to(panel, {\n          width: i === index ? '52%' : '24%',\n          duration: 0.9,\n          ease: 'cubic-bezier(0.22, 1, 0.36, 1)'\n        });\n        gsap.to(panel.querySelector('.title-wrap'), {\n          xPercent: i === index ? 0 : -4,\n          opacity: i === index ? 1 : 0.4,\n          duration: 0.9,\n          ease: 'power3.out'\n        });\n        gsap.to(panel.querySelectorAll('.product'), {\n          xPercent: i === index ? 0 : 9,\n          yPercent: i === index ? 0 : 2,\n          scale: i === index ? 1 : 0.92,\n          opacity: i === index ? 1 : 0.4,\n          duration: 0.9,\n          ease: 'power3.out',\n          stagger: 0.03\n        });\n        gsap.to(panel.querySelector('.play-btn'), {\n          scale: i === index ? 1 : 0.86,\n          opacity: i === index ? 1 : 0.2,\n          duration: 0.9,\n          ease: 'power3.out'\n        });\n      });\n      dots.forEach((dot, i) => {\n        gsap.to(dot, {\n          backgroundColor: i === index ? 'rgba(255,255,255,0.8)' : 'rgba(255,255,255,0.2)',\n          width: i === index ? 32 : 24,\n          duration: 0.35,\n          ease: 'power2.out'\n        });\n      });\n    }\n\n    function startAuto() {\n      clearInterval(timer);\n      timer = setInterval(() => setActive((activeIndex + 1) % panels.length), 4000);\n    }\n\n    panels.forEach((panel, index) => {\n      panel.addEventListener('mouseenter', () => {\n        setActive(index);\n        startAuto();\n      });\n    });\n\n    dots.forEach((dot, index) => {\n      dot.addEventListener('click', () => {\n        setActive(index);\n        startAuto();\n      });\n    });\n\n    document.addEventListener('mousemove', (event) => {\n      const x = (event.clientX / window.innerWidth - 0.5) * 2;\n      const y = (event.clientY / window.innerHeight - 0.5) * 2;\n      products.forEach((product) => {\n        const panel = product.closest('.panel');\n        const intensity = panel && panel.dataset.active === 'true' ? 1 : 0.35;\n        gsap.to(product, {\n          x: x * 10 * intensity,\n          y: y * 8 * intensity,\n          duration: 0.9,\n          ease: 'power2.out'\n        });\n      });\n    });\n\n    // Subdued glowing pulse for dark instrument panel\n    gsap.to('.play-btn', {\n      boxShadow: '0 0 0 8px rgba(255,255,255,0.03)',\n      duration: 2,\n      repeat: -1,\n      yoyo: true,\n      ease: 'sine.inOut',\n      stagger: 0.4\n    });\n\n    // Slow, meditative rotation for the dial components\n    gsap.ticker.add(() => {\n      const t = performance.now() * 0.000015; // Slowed down significantly for instrument feel\n      ringFields.forEach((field, i) => {\n        field.style.transform = 'rotate(' + ((t * 360 * (i % 2 ? -1 : 1)) % 360) + 'deg)';\n      });\n    });\n\n    setActive(0);\n    startAuto();\n\n    // Subtle drifting wisps instead of bright colors\n    const canvas = document.getElementById('webgl-field');\n    const gl = canvas.getContext('webgl', { alpha: true, antialias: true });\n    let program, positionBuffer, timeLocation, resolutionLocation, vertexCount = 200;\n\n    function createShader(type, source) {\n      const shader = gl.createShader(type);\n      gl.shaderSource(shader, source);\n      gl.compileShader(shader);\n      return shader;\n    }\n\n    function resizeCanvas() {\n      const ratio = Math.min(window.devicePixelRatio || 1, 2);\n      canvas.width = Math.floor(window.innerWidth * ratio);\n      canvas.height = Math.floor(window.innerHeight * ratio);\n      gl.viewport(0, 0, canvas.width, canvas.height);\n    }\n\n    if (gl) {\n      const vertexSource = `\n        attribute vec2 a_position;\n        uniform float u_time;\n        uniform vec2 u_resolution;\n        varying float v_alpha;\n        void main() {\n          vec2 p = a_position;\n          float wave = sin((p.x * 4.0) + u_time * 0.4) * 0.04 + cos((p.y * 5.0) - u_time * 0.3) * 0.03;\n          p.x += wave;\n          p.y += sin(u_time * 0.2 + p.x * 3.0) * 0.02;\n          gl_Position = vec4(p, 0.0, 1.0);\n          gl_PointSize = 1.2;\n          v_alpha = 0.08 + 0.08 * sin(u_time * 0.5 + p.x * 3.0 + p.y * 4.0);\n        }\n      `;\n\n      const fragmentSource = `\n        precision mediump float;\n        varying float v_alpha;\n        void main() {\n          float d = distance(gl_PointCoord, vec2(0.5));\n          float a = smoothstep(0.5, 0.0, d) * v_alpha;\n          // Pure white/smoky points\n          vec3 color = vec3(0.9, 0.9, 0.95);\n          gl_FragColor = vec4(color, a);\n        }\n      `;\n\n      const vertexShader = createShader(gl.VERTEX_SHADER, vertexSource);\n      const fragmentShader = createShader(gl.FRAGMENT_SHADER, fragmentSource);\n      program = gl.createProgram();\n      gl.attachShader(program, vertexShader);\n      gl.attachShader(program, fragmentShader);\n      gl.linkProgram(program);\n      gl.useProgram(program);\n\n      const positions = [];\n      for (let i = 0; i < vertexCount; i++) {\n        const col = i % 20;\n        const row = Math.floor(i / 20);\n        positions.push(-1 + col / 9.5);\n        positions.push(-1 + row / 4.5);\n      }\n\n      positionBuffer = gl.createBuffer();\n      gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);\n      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(positions), gl.STATIC_DRAW);\n\n      const positionLocation = gl.getAttribLocation(program, 'a_position');\n      timeLocation = gl.getUniformLocation(program, 'u_time');\n      resolutionLocation = gl.getUniformLocation(program, 'u_resolution');\n\n      gl.enableVertexAttribArray(positionLocation);\n      gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);\n      gl.enable(gl.BLEND);\n      gl.blendFunc(gl.SRC_ALPHA, gl.ONE);\n      resizeCanvas();\n\n      function render(time) {\n        gl.clearColor(0, 0, 0, 0);\n        gl.clear(gl.COLOR_BUFFER_BIT);\n        gl.uniform1f(timeLocation, time * 0.001);\n        gl.uniform2f(resolutionLocation, canvas.width, canvas.height);\n        gl.drawArrays(gl.POINTS, 0, vertexCount);\n        requestAnimationFrame(render);\n      }\n      requestAnimationFrame(render);\n      window.addEventListener('resize', resizeCanvas);\n    }\n  </script>\n</body>\n</html>", "preview_file_name": "system-calibration-framework.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/system-calibration-framework.jpg", "source_name": "system-calibration-framework-DESIGN.md", "views": 26, "forks": 0, "private": false, "featured": true, "created_by": "2e815afb-cac1-4c01-90e1-cf3810246e35", "created_at": "2026-06-21T11:39:54.279152+00:00", "updated_at": "2026-07-03T21:02:29.483733+00:00"}