utral-400 rounded-full\"></div></div>\n                                </li>\n                                <li class=\"flex flex-col gap-1.5\">\n                                    <div class=\"flex justify-between items-end\">\n                                        <span class=\"text-xs font-light text-neutral-400\">Data Degradation</span>\n                                        <span class=\"text-xs font-['JetBrains_Mono'] text-neutral-300\">0.00%</span>\n                                    </div>\n                                    <div class=\"w-full h-[2px] bg-neutral-800 rounded-full overflow-hidden\"><div class=\"w-[2%] h-full bg-neutral-400 rounded-full\"></div></div>\n                                </li>\n                                <li class=\"flex flex-col gap-1.5\">\n                                    <div class=\"flex justify-between items-end\">\n                                        <span class=\"text-xs font-light text-neutral-400\">Hardware Temp</span>\n                                        <span class=\"text-xs font-['JetBrains_Mono'] text-neutral-300\">42.1°C</span>\n                                    </div>\n                                    <div class=\"w-full h-[2px] bg-neutral-800 rounded-full overflow-hidden\"><div class=\"w-[60%] h-full bg-neutral-400 rounded-full\"></div></div>\n                                </li>\n                            </ul>\n\n                            <!-- Custom Toggle -->\n                            <div class=\"flex items-center justify-between mb-5\">\n                                <span class=\"text-xs font-['JetBrains_Mono'] text-neutral-500 uppercase tracking-widest\">Secure Tunnel</span>\n                                <div class=\"w-8 h-4 rounded-full bg-black border border-neutral-800 relative cursor-pointer shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)] group/tgl\">\n                                    <div class=\"absolute top-px right-px w-3 h-3 rounded-full bg-neutral-200 shadow-[0_0_5px_rgba(255,255,255,0.4)] transition-transform group-hover/tgl:scale-95\"></div>\n                                </div>\n                            </div>\n\n                            <div class=\"pt-4 border-t border-white/[0.05]\">\n                                <div class=\"w-full p-3 bg-black rounded-xl border border-white/[0.03] shadow-[inset_0_2px_10px_rgba(0,0,0,0.5)] text-xs font-['JetBrains_Mono'] text-neutral-500 break-all leading-loose\">\n                                    > INITIATING HANDSHAKE<br>\n                                    > VERIFYING CERTIFICATES<br>\n                                    <span class=\"text-neutral-300\">> ACCESS GRANTED<span class=\"animate-pulse ml-1\">_</span></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </aside>\n\n            </div>\n        </div>\n    </main>\n\n    <script>\n        const ASSETS = [\n            \"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/4734259a-bad7-422f-981e-ce01e79184f2_800w.jpg\",\n            \"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/e534354d-c5f2-4399-a1d9-2f50338e8c47_800w.jpg\",\n            \"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/724142aa-44a6-48d3-9cf3-761e00d05b78_800w.jpg\",\n            \"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/5ee0a38a-b5d3-4531-8793-98beed4af162_800w.jpg\",\n            \"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/bfef5098-c30f-4cd9-b4ac-04b2673ab943_800w.jpg\"\n        ];\n\n        const initWebGL = () => {\n            const canvas = document.getElementById('webgl-canvas');\n            const scene = new THREE.Scene();\n\n            const camera = new THREE.OrthographicCamera( window.innerWidth / - 2, window.innerWidth / 2, window.innerHeight / 2, window.innerHeight / - 2, 1, 1000 );\n            camera.position.z = 10;\n\n            const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n            const geometry = new THREE.BufferGeometry();\n            const particlesCount = 2000;\n            const posArray = new Float32Array(particlesCount * 3);\n\n            const spreadX = window.innerWidth * 1.5;\n            const spreadY = window.innerHeight * 1.5;\n\n            for(let i = 0; i < particlesCount * 3; i+=3) {\n                let x = (Math.random() - 0.5) * spreadX;\n                let y = (Math.random() - 0.5) * spreadY;\n                x = Math.round(x / 60) * 60;\n                y = Math.round(y / 60) * 60;\n                posArray[i] = x;\n                posArray[i+1] = y;\n                posArray[i+2] = (Math.random() - 0.5) * 200 - 50;\n            }\n\n            geometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n\n            const material = new THREE.PointsMaterial({\n                size: 1.5,\n                color: 0xffffff,\n                transparent: true,\n                opacity: 0.08,\n                sizeAttenuation: true,\n                blending: THREE.AdditiveBlending\n            });\n\n            const particlesMesh = new THREE.Points(geometry, material);\n            scene.add(particlesMesh);\n\n            let mouseX = 0, mouseY = 0;\n            const windowHalfX = window.innerWidth / 2;\n            const windowHalfY = window.innerHeight / 2;\n\n            document.addEventListener('mousemove', (event) => {\n                mouseX = (event.clientX - windowHalfX);\n                mouseY = (event.clientY - windowHalfY);\n            });\n\n            const clock = new THREE.Clock();\n\n            const tick = () => {\n                const elapsedTime = clock.getElapsedTime();\n                material.opacity = 0.05 + Math.sin(elapsedTime * 0.3) * 0.05;\n                particlesMesh.position.x += ((mouseX * 0.015) - particlesMesh.position.x) * 0.05;\n                particlesMesh.position.y += ((-mouseY * 0.015) - particlesMesh.position.y) * 0.05;\n                renderer.render(scene, camera);\n                window.requestAnimationFrame(tick);\n            };\n\n            tick();\n\n            window.addEventListener('resize', () => {\n                camera.left = window.innerWidth / - 2;\n                camera.right = window.innerWidth / 2;\n                camera.top = window.innerHeight / 2;\n                camera.bottom = window.innerHeight / - 2;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            });\n        };\n\n        const initImageTrail = () => {\n            const container = document.getElementById('trail-container');\n            const images = [];\n            const TOTAL_IMAGES = ASSETS.length;\n\n            ASSETS.forEach(url => {\n                const item = document.createElement('div');\n                item.className = 'absolute top-0 left-0 opacity-0 w-40 aspect-[4/5] rounded-[12px] overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.8),inset_0_1px_1px_rgba(255,255,255,0.1)] border border-white/[0.05] will-change-transform scale-50 transform-origin-center';\n                const inner = document.createElement('div');\n                inner.className = 'w-[120%] h-[120%] bg-cover bg-center -ml-[10%] -mt-[10%] mix-blend-luminosity filter grayscale contrast-125';\n                inner.style.backgroundImage = `url('${url}')`;\n                const overlay = document.createElement('div');\n                overlay.className = 'absolute inset-0 bg-neutral-900/30 mix-blend-overlay';\n                item.appendChild(inner);\n                item.appendChild(overlay);\n                container.appendChild(item);\n                images.push({ el: item, inner: inner });\n            });\n\n            const mathLerp = (a, b, n) => (1 - n) * a + n * b;\n            const getDistance = (p1, p2) => Math.hypot(p1.x - p2.x, p1.y - p2.y);\n\n            let mousePos = { x: window.innerWidth / 2, y: window.innerHeight / 2 };\n            let lastMousePos = { x: mousePos.x, y: mousePos.y };\n            let cacheMousePos = { x: mousePos.x, y: mousePos.y };\n            let imgPosition = 0;\n            let zIndexVal = 100;\n            const threshold = 100;\n\n            window.addEventListener('mousemove', e => {\n                mousePos.x = e.clientX;\n                mousePos.y = e.clientY;\n            });\n\n            const render = () => {\n                let distance = getDistance(mousePos, lastMousePos);\n                cacheMousePos.x = mathLerp(cacheMousePos.x, mousePos.x, 0.15);\n                cacheMousePos.y = mathLerp(cacheMousePos.y, mousePos.y, 0.15);\n\n                if (distance > threshold) {\n                    showNextImage(distance);\n                    lastMousePos = { ...mousePos };\n                }\n                requestAnimationFrame(render);\n            };\n\n            const showNextImage = (speedDist) => {\n                zIndexVal++;\n                imgPosition = imgPosition < TOTAL_IMAGES - 1 ? imgPosition + 1 : 0;\n                const imgObj = images[imgPosition];\n                let dx = mousePos.x - cacheMousePos.x;\n                let dy = mousePos.y - cacheMousePos.y;\n                let speed = Math.min(speedDist / 10, 10);\n\n                gsap.killTweensOf(imgObj.el);\n                gsap.killTweensOf(imgObj.inner);\n\n                gsap.timeline()\n                    .fromTo(imgObj.el,\n                        { opacity: 1, scale: 0.2, zIndex: zIndexVal, x: cacheMousePos.x - 80, y: cacheMousePos.y - 100, rotation: (Math.random() - 0.5) * 20 },\n                        { duration: 0.8, ease: 'power3.out', scale: 1 + (speed * 0.03), x: mousePos.x - 80 + (dx * 0.4), y: mousePos.y - 100 + (dy * 0.4), rotation: (Math.random() - 0.5) * 5 }, 0)\n                    .fromTo(imgObj.inner, { scale: 1.3 }, { duration: 0.8, ease: 'power2.out', scale: 1 }, 0)\n                    .to(imgObj.el, { duration: 0.5, ease: 'power2.in', opacity: 0, scale: 0.85, y: `+=${40}` }, 0.5);\n            };\n\n            requestAnimationFrame(render);\n        };\n\n        const initMarquees = () => {\n            if(document.getElementById('marquee-top')) {\n                gsap.to('#marquee-top', { xPercent: -50, ease: 'none', duration: 40, repeat: -1 });\n            }\n            if(document.getElementById('marquee-bottom')) {\n                gsap.fromTo('#marquee-bottom', { xPercent: -50 }, { xPercent: 0, ease: 'none', duration: 45, repeat: -1 });\n            }\n        };\n\n        const initUIAnimation = () => {\n            const elements = document.querySelectorAll('.gsap-ui');\n            gsap.to(elements, { opacity: 1, y: 0, scale: 1, duration: 1.2, stagger: 0.1, ease: 'power3.out', delay: 0.1 });\n        };\n\n        const initGlobe = async () => {\n            const container = document.getElementById('globe-container');\n            const canvas = document.getElementById('globe-canvas');\n            if (!canvas || !container) return;\n\n            const context = canvas.getContext('2d');\n            const rect = container.getBoundingClientRect();\n            const width = rect.width || 340;\n            const height = rect.height || 340;\n            const dpr = window.devicePixelRatio || 1;\n\n            canvas.width = width * dpr;\n            canvas.height = height * dpr;\n            context.scale(dpr, dpr);\n\n            const radius = Math.min(width, height) / 2.2;\n            const projection = d3.geoOrthographic()\n                .scale(radius)\n                .translate([width / 2, height / 2])\n                .clipAngle(90);\n\n            const path = d3.geoPath().projection(projection).context(context);\n\n            try {\n                const response = await fetch('https://raw.githubusercontent.com/holtzy/D3-graph-gallery/master/DATA/world.geojson');\n                const world = await response.json();\n\n                function generateDots(feature, density = 20) {\n                    const dots = [];\n                    const bounds = d3.geoBounds(feature);\n                    if (!bounds || isNaN(bounds[0][0])) return dots;\n                    for (let lng = bounds[0][0]; lng <= bounds[1][0]; lng += density * 0.14) {\n                        for (let lat = bounds[0][1]; lat <= bounds[1][1]; lat += density * 0.14) {\n                            if (d3.geoContains(feature, [lng, lat])) dots.push({lng, lat});\n                        }\n                    }\n                    return dots;\n                }\n\n                let allDots = [];\n                world.features.forEach(feature => {\n                    allDots = allDots.concat(generateDots(feature, 20));\n                });\n\n                document.getElementById('globe-loading').style.opacity = '0';\n                setTimeout(() => document.getElementById('globe-loading').remove(), 500);\n\n                document.getElementById('globe-canvas').classList.remove('opacity-0');\n                document.getElementById('globe-glow').classList.remove('opacity-0');\n                document.getElementById('globe-label').classList.remove('opacity-0');\n\n                let rotate = [0, -15, 0];\n                let isInteracting = false;\n                let inertiaTimer = null;\n                const uiX = document.getElementById('ui-x');\n                const uiY = document.getElementById('ui-y');\n\n                function updateCoordinates() {\n                    if (uiX && uiY) {\n                        uiX.innerText = String(Math.round(rotate[0] % 360)).padStart(3, '0') + '°';\n                        uiY.innerText = String(Math.round(rotate[1] % 360)).padStart(3, '0') + '°';\n                    }\n                }\n\n                function render() {\n                    context.clearRect(0, 0, width, height);\n\n                    context.beginPath();\n                    path(d3.geoGraticule()());\n                    context.strokeStyle = 'rgba(255,255,255,0.02)';\n                    context.stroke();\n\n                    context.beginPath();\n                    context.arc(width/2, height/2, projection.scale(), 0, 2*Math.PI);\n                    context.strokeStyle = 'rgba(255, 255, 255, 0.04)';\n                    context.lineWidth = 1;\n                    context.stroke();\n\n                    context.fillStyle = '#e5e5e5';\n                    allDots.forEach(d => {\n                        const p = projection([d.lng, d.lat]);\n                        if (p) {\n                            context.beginPath();\n                            context.arc(p[0], p[1], 1.0, 0, 2*Math.PI);\n                            context.fill();\n                        }\n                    });\n\n                    if (!isInteracting && !inertiaTimer) {\n                        rotate[0] += 0.3;\n                        projection.rotate(rotate);\n                        updateCoordinates();\n                    }\n\n                    requestAnimationFrame(render);\n                }\n\n                const drag = d3.drag()\n                    .on(\"start\", () => {\n                        isInteracting = true;\n                        if (inertiaTimer) clearTimeout(inertiaTimer);\n                    })\n                    .on(\"drag\", (event) => {\n                        rotate[0] += event.dx * 0.4;\n                        rotate[1] -= event.dy * 0.4;\n                        rotate[1] = Math.max(-90, Math.min(90, rotate[1]));\n                        projection.rotate(rotate);\n                        updateCoordinates();\n                    })\n                    .on(\"end\", () => {\n                        isInteracting = false;\n                        inertiaTimer = setTimeout(() => {\n                            inertiaTimer = null;\n                        }, 1000);\n                    });\n\n                d3.select(canvas).call(drag);\n\n                const zoom = d3.zoom()\n                    .scaleExtent([0.8, 2.0])\n                    .on(\"zoom\", (event) => {\n                        projection.scale(radius * event.transform.k);\n                    });\n                d3.select(canvas).call(zoom);\n\n                canvas.addEventListener(\"wheel\", e => e.preventDefault(), {passive: false});\n\n                render();\n\n            } catch (error) {\n                console.error(\"Globe init error:\", error);\n                document.getElementById('globe-loading').innerHTML = `<span class=\"text-neutral-500 font-['JetBrains_Mono'] text-xs tracking-widest\">INIT FAILED</span>`;\n            }\n        };\n\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            initWebGL();\n            initImageTrail();\n            initMarquees();\n            initUIAnimation();\n\n            requestAnimationFrame(() => {\n                initGlobe();\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "aether-node-dashboard.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s-v3/aether-node-dashboard.jpg", "source_name": "aether-node-dashboard-DESIGN.md", "views": 443, "forks": 18, "private": false, "featured": true, "created_by": "2e815afb-cac1-4c01-90e1-cf3810246e35", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T04:30:43.140913+00:00"}