                      </div>\n                            </div>\n                        </div>\n\n                        <!-- Action Button -->\n                        <div class=\"relative z-10 mt-8 flex justify-end\">\n                            <button class=\"relative px-6 py-2.5 bg-neutral-100 rounded-lg shadow-[0_2px_10px_rgba(255,255,255,0.1)] hover:bg-white active:scale-95 transition-all duration-200 flex items-center gap-2 group\">\n                                <span class=\"text-sm font-medium text-black tracking-wide\">Trigger Analysis</span>\n                                <iconify-icon icon=\"solar:arrow-right-linear\" stroke-width=\"1.5\" class=\"text-black group-hover:translate-x-1 transition-transform\"></iconify-icon>\n                            </button>\n                        </div>\n                    </div>\n                </section>\n\n                <!-- Right Column: Details & Terminal -->\n                <aside class=\"hidden lg:flex col-span-3 flex-col gap-8 h-full\">\n                    <div class=\"gsap-ui opacity-0 translate-y-4\">\n                        <div class=\"p-4 bg-neutral-900/40 backdrop-blur-md border border-white/[0.04] rounded-2xl flex items-center gap-4 shadow-[0_4px_12px_rgba(0,0,0,0.3)]\">\n                            <!-- Skeuomorphic Avatar Inset -->\n                            <div class=\"relative w-12 h-12 rounded-full p-px bg-gradient-to-b from-white/20 to-transparent shadow-[0_2px_8px_rgba(0,0,0,0.5)]\">\n                                <div class=\"w-full h-full rounded-full overflow-hidden bg-black border border-black\">\n                                    <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/2f563338-39fa-47ea-9761-658d4f3f84db_800w.jpg\" alt=\"Profile\" class=\"w-full h-full object-cover grayscale opacity-80 mix-blend-screen\">\n                                </div>\n                                <div class=\"absolute -bottom-1 -right