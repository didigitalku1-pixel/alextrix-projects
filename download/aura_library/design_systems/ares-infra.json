         <iconify-icon icon=\"solar:map-arrow-square-linear\" class=\"text-[#CB4D22] text-lg\"></iconify-icon>\n                        </div>\n                    </div>\n\n                    <!-- Card 2 (Center, Tallest - Strongest Lift) -->\n                    <div class=\"fade-in-up w-1/3 h-[90%] rounded-sm relative overflow-hidden group cursor-pointer shadow-[0_2.8px_2.2px_rgba(0,_0,_0,_0.034),_0_6.7px_5.3px_rgba(0,_0,_0,_0.048),_0_12.5px_10px_rgba(0,_0,_0,_0.06),_0_22.3px_17.9px_rgba(0,_0,_0,_0.072),_0_41.8px_33.4px_rgba(0,_0,_0,_0.086),_0_100px_80px_rgba(0,_0,_0,_0.12)] opacity-0 translate-y-5\" style=\"animation-delay: 400ms;\">\n                        <div class=\"absolute inset-0 bg-[url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/724142aa-44a6-48d3-9cf3-761e00d05b78_1600w.jpg')] bg-cover bg-center transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105\"></div>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#2D1B11] via-[#2D1B11]/50 to-transparent\"></div>\n                        <div class=\"absolute inset-0 p-5 flex flex-col justify-end\">\n                            <h3 class=\"text-white text-base font-medium tracking-wide mb-3\">Colony Nexus</h3>\n                            <p class=\"text-[#EAE0D6] text-[10px] leading-relaxed mb-6 font-light opacity-90\">\n                                Centralized pyramid structures designed to withstand extreme surface storms while housing key agricultural bio-domes.\n                            </p>\n                            <button class=\"w-full bg-black/30 backdrop-blur-sm border border-white/30 rounded-sm py-2 px-3 flex justify-between items-center text-white text-xs hover:bg-white hover:text-[#2D1B11] transition-colors group/btn font-light\">\n                                View Schematics\n                                <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-[#CB4D22] group-hover/btn:text-[#2D1B11]\"></iconify-icon>\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Card 3 (Right, Smallest) -->\n                    <div class=\"fade-in-up w-1/3 h-[65%] rounded-sm relative overflow-hidden group cursor-pointer mb-8 shadow-[0px_0px_0px_1px_rgba(0,0,0,0.06),0px_1px_1px_-0.5px_rgba(0,0,0,0.06),0px_3px_3px_-1.5px_rgba(0,0,0,0.06),_0px_6px_6px_-3px_rgba(0,0,0,0.06),0px_12px_12px_-6px_rgba(0,0,0,0.06),0px_24px_24px_-12px_rgba(0,0,0,0.06)] opacity-0 translate-y-5\" style=\"animation-delay: 500ms;\">\n                        <div class=\"absolute inset-0 bg-[url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/fb6415fd-bf4d-4ccf-8e9d-7ab445e99207_1600w.jpg')] bg-cover bg-center transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105\"></div>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#2D1B11] via-[#2D1B11]/50 to-transparent\"></div>\n                        <div class=\"absolute inset-0 p-4 flex flex-col justify-end\">\n                            <h3 class=\"text-white text-sm font-light tracking-wide mb-2 leading-snug\">Modular Pods</h3>\n                            <iconify-icon icon=\"solar:box-minimalistic-linear\" class=\"text-[#CB4D22] text-lg\"></iconify-icon>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Style for basic keyframes not handled by GSAP -->\n    <style>\n        @keyframes fadeInUp {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .fade-in-up {\n            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n    </style>\n\n    <!-- Animation and Interaction Scripts -->\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n\n            // 1. GSAP Masked Text Reveal\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Initial animation for the title words\n            gsap.to('.gsap-word', {\n                y: \"0%\",\n                duration: 1.2,\n                ease: \"power4.out\",\n                stagger: 0.05,\n                delay: 0.1,\n                scrollTrigger: {\n                    trigger: \".gsap-title\",\n                    start: \"top 90%\",\n                }\n            });\n\n            // 2. Main Container Entrance\n            gsap.to('main', {\n                y: 0,\n                opacity: 1,\n                duration: 1,\n                ease: \"power3.out\"\n            });\n\n            // 3. Canvas Background Particles Script (Martian Dust Effect)\n            const canvas = document.getElementById('bg-canvas');\n            const ctx = canvas.getContext('2d');\n\n            let width, height;\n            let particles = [];\n\n            function resize() {\n                width = canvas.width = window.innerWidth;\n                height = canvas.height = window.innerHeight;\n            }\n\n            window.addEventListener('resize', resize);\n            resize();\n\n            class Particle {\n                constructor() {\n                    this.x = Math.random() * width;\n                    this.y = Math.random() * height;\n                    this.size = Math.random() * 1.5 + 0.2;\n                    // Slow, drifting movement simulating thin atmosphere dust\n                    this.speedX = Math.random() * 0.5 - 0.25;\n                    this.speedY = Math.random() * 0.5 - 0.25;\n                    this.life = Math.random() * 100;\n                }\n\n                update() {\n                    this.x += this.speedX;\n                    this.y += this.speedY;\n                    this.life += 0.02;\n\n                    // Wrap around edges seamlessly\n                    if (this.x > width) this.x = 0;\n                    if (this.x < 0) this.x = width;\n                    if (this.y > height) this.y = 0;\n                    if (this.y < 0) this.y = height;\n                }\n\n                draw() {\n                    ctx.beginPath();\n                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n                    // Rust/Dust color #CB4D22 with oscillating opacity\n                    const opacity = Math.sin(this.life) * 0.2 + 0.1;\n                    ctx.fillStyle = `rgba(203, 77, 34, ${opacity})`;\n                    ctx.fill();\n                }\n            }\n\n            function init() {\n                particles = [];\n                // Fewer particles for a cleaner aesthetic\n                for (let i = 0; i < 70; i++) {\n                    particles.push(new Particle());\n                }\n            }\n\n            function animate() {\n                ctx.clearRect(0, 0, width, height);\n\n                particles.forEach(p => {\n                    p.update();\n                    p.draw();\n                });\n\n                requestAnimationFrame(animate);\n            }\n\n            init();\n            animate();\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "ares-infra.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/ares-infra.jpg", "source_name": "ares-infra-DESIGN.md", "views": 539, "forks": 18, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T05:58:53.707946+00:00"}