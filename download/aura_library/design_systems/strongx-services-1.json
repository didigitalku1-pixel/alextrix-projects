/span></span>\n                    <span class=\"inline-block overflow-hidden\"><span class=\"reveal-word inline-block transform translate-y-[120%]\">to</span></span>\n                    <span class=\"inline-block overflow-hidden\"><span class=\"reveal-word inline-block transform translate-y-[120%]\">optimize</span></span>\n                    <span class=\"inline-block overflow-hidden\"><span class=\"reveal-word inline-block transform translate-y-[120%]\">performance.</span></span>\n                </p>\n            </div>\n        </section>\n\n        <!-- Image Gallery Grid -->\n        <section class=\"w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 h-auto md:h-[65vh] min-h-[500px]\">\n\n            <!-- Panel 1 -->\n            <div class=\"relative w-full h-[300px] md:h-full overflow-hidden group cursor-pointer\">\n                <!-- Gradient Borders -->\n                <div class=\"absolute right-0 top-0 bottom-0 w-px hidden md:block bg-gradient-to-b from-white/20 to-transparent z-20\"></div>\n                <div class=\"absolute bottom-0 left-0 right-0 h-px md:hidden bg-gradient-to-r from-white/20 to-transparent z-20\"></div>\n\n                <div class=\"absolute inset-0 bg-cover bg-center transition-transform duration-1000 ease-out group-hover:scale-105\" style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/0d868fef-f560-45ca-ab35-5dad4fc29059_3840w.webp'); filter: grayscale(60%) contrast(1.1) brightness(0.6);\"></div>\n                <div class=\"absolute inset-0\" style=\"background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);\"></div>\n                <div class=\"absolute bottom-8 left-0 w-full text-center z-30\">\n                    <h3 class=\"text-xl md:text-2xl text-white uppercase tracking-tight font-semibold\" style=\"font-family: ui-sans-serif, system-ui, sans-serif;\">Strength</h3>\n                </div>\n            </div>\n\n            <!-- Panel 2 -->\n            <div class=\"relative w-full h-[300px] md:h-full overflow-hidden group cursor-pointer\">\n                <div class=\"absolute right-0 top-0 bottom-0 w-px hidden md:block bg-gradient-to-b from-white/20 to-transparent z-20\"></div>\n                <div class=\"absolute bottom-0 left-0 right-0 h-px md:hidden bg-gradient-to-r from-white/20 to-transparent z-20\"></div>\n\n                <div class=\"absolute inset-0 bg-cover bg-center transition-transform duration-1000 ease-out group-hover:scale-105\" style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/3186f9ea-5f5a-49f7-8fcf-568ad52f515e_3840w.webp'); filter: grayscale(40%) contrast(1.05) brightness(0.55);\"></div>\n                <div class=\"absolute inset-0\" style=\"background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);\"></div>\n                <div class=\"absolute bottom-8 left-0 w-full text-center z-30\">\n                    <h3 class=\"text-xl md:text-2xl text-white uppercase tracking-tight font-semibold\" style=\"font-family: ui-sans-serif, system-ui, sans-serif;\">Mobility</h3>\n                </div>\n            </div>\n\n            <!-- Panel 3 -->\n            <div class=\"relative w-full h-[300px] md:h-full overflow-hidden group cursor-pointer\">\n                <div class=\"absolute right-0 top-0 bottom-0 w-px hidden md:block bg-gradient-to-b from-white/20 to-transparent z-20\"></div>\n                <div class=\"absolute bottom-0 left-0 right-0 h-px md:hidden bg-gradient-to-r from-white/20 to-transparent z-20\"></div>\n\n                <div class=\"absolute inset-0 bg-cover bg-center transition-transform duration-1000 ease-out group-hover:scale-105\" style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/65695f80-23f9-46ee-8487-cbb6c93cc48b_3840w.webp'); filter: grayscale(50%) contrast(1.1) brightness(0.65);\"></div>\n                <div class=\"absolute inset-0\" style=\"background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);\"></div>\n                <div class=\"absolute bottom-8 left-0 w-full text-center z-30\">\n                    <h3 class=\"text-xl md:text-2xl text-white uppercase tracking-tight font-semibold\" style=\"font-family: ui-sans-serif, system-ui, sans-serif;\">Combat</h3>\n                </div>\n            </div>\n\n            <!-- Panel 4 -->\n            <div class=\"relative w-full h-[300px] md:h-full overflow-hidden group cursor-pointer\">\n                <div class=\"absolute right-0 top-0 bottom-0 w-px hidden md:block bg-gradient-to-b from-white/20 to-transparent z-20\"></div>\n                <div class=\"absolute bottom-0 left-0 right-0 h-px md:hidden bg-gradient-to-r from-white/20 to-transparent z-20\"></div>\n\n                <div class=\"absolute inset-0 bg-cover bg-center transition-transform duration-1000 ease-out group-hover:scale-105\" style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/0d063fd9-f7c1-4536-ade0-9fd133f07279_3840w.webp'); filter: grayscale(55%) contrast(1.15) brightness(0.6);\"></div>\n                <div class=\"absolute inset-0\" style=\"background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);\"></div>\n                <div class=\"absolute bottom-8 left-0 w-full text-center z-30\">\n                    <h3 class=\"text-xl md:text-2xl text-white uppercase tracking-tight font-semibold\" style=\"font-family: ui-sans-serif, system-ui, sans-serif;\">Classes</h3>\n                </div>\n            </div>\n\n            <!-- Panel 5 -->\n            <div class=\"relative w-full h-[300px] md:h-full overflow-hidden group cursor-pointer\">\n                <div class=\"absolute inset-0 bg-cover bg-center transition-transform duration-1000 ease-out group-hover:scale-105\" style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/582afef4-b810-47b8-a047-8b3597c323e1_3840w.webp'); filter: grayscale(20%) contrast(1.05) brightness(0.7) hue-rotate(180deg) saturate(0.8);\"></div>\n                <div class=\"absolute inset-0\" style=\"background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);\"></div>\n                <div class=\"absolute bottom-8 left-0 w-full text-center z-30\">\n                    <h3 class=\"text-xl md:text-2xl text-white uppercase tracking-tight font-semibold\" style=\"font-family: ui-sans-serif, system-ui, sans-serif;\">Aquatics</h3>\n                </div>\n            </div>\n\n        </section>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Infinite Marquee Animations\n            gsap.to(\"#marquee-forward\", {\n                xPercent: -50,\n                ease: \"none\",\n                duration: 25,\n                repeat: -1\n            });\n\n            gsap.fromTo(\"#marquee-reverse\",\n                { xPercent: -50 },\n                { xPercent: 0, ease: \"none\", duration: 30, repeat: -1 }\n            );\n\n            // Staggered Masked Word Reveal on Scroll\n            gsap.fromTo(\".reveal-word\",\n                { y: \"120%\" },\n                {\n                    y: \"0%\",\n                    ease: \"power4.out\",\n                    duration: 1.2,\n                    stagger: 0.04,\n                    scrollTrigger: {\n                        trigger: \".reveal-text\",\n                        start: \"top 85%\",\n                    }\n                }\n            );\n\n            // --- WebGL Dither Background Implementation ---\n            const canvas = document.getElementById('dither-bg');\n            const gl = canvas.getContext('webgl');\n            if (!gl) return;\n\n            const vertices = new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]);\n            const buffer = gl.createBuffer();\n            gl.bindBuffer(gl.ARRAY_BUFFER, buffer);\n            gl.bufferData(gl.ARRAY_BUFFER, vertices, gl.STATIC_DRAW);\n\n            const vs = gl.createShader(gl.VERTEX_SHADER);\n            gl.shaderSource(vs, `attribute vec2 p;void main(){gl_Position=vec4(p,0.0,1.0);}`);\n            gl.compileShader(vs);\n\n            const fs = gl.createShader(gl.FRAGMENT_SHADER);\n            gl.shaderSource(fs, `\n            precision mediump float;\n            uniform vec2 r;\n            uniform float t;\n\n            vec3 hash3(vec2 p) {\n                vec3 q = vec3(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)), dot(p, vec2(419.2, 371.9)));\n                return fract(sin(q) * 43758.5453);\n            }\n\n            float noise(vec2 x) {\n                vec2 p = floor(x);\n                vec2 f = fract(x);\n                f = f * f * (3.0 - 2.0 * f);\n                float a = dot(hash3(p), vec3(1.0));\n                float b = dot(hash3(p + vec2(1.0, 0.0)), vec3(1.0));\n                float c = dot(hash3(p + vec2(0.0, 1.0)), vec3(1.0));\n                float d = dot(hash3(p + vec2(1.0, 1.0)), vec3(1.0));\n                return mix(mix(a, b, f.x), mix(c, d, f.x), f.y) / 3.0;\n            }\n\n            void main(){\n                float pSize = 8.0;\n                vec2 fc = floor(gl_FragCoord.xy / pSize) * pSize;\n                vec2 uv = fc / r;\n\n                // Vignette\n                vec2 center = uv - 0.5;\n                center.x *= r.x / r.y;\n                float dist = length(center);\n                float vig = smoothstep(0.9, 0.2, dist);\n\n                // Organic cloud-like noise\n                float n = noise(uv * 2.5 + t * 0.05) * 0.5 + noise(uv * 5.0 - t * 0.08) * 0.25;\n                n *= vig;\n\n                // 4x4 Bayer Matrix simulation without int arrays\n                float x = mod(fc.x / pSize, 4.0);\n                float y = mod(fc.y / pSize, 4.0);\n                float th = 0.0;\n                if(y < 1.0) {\n                    if(x < 1.0) th = 0.0; else if(x < 2.0) th = 0.5; else if(x < 3.0) th = 0.125; else th = 0.625;\n                } else if(y < 2.0) {\n                    if(x < 1.0) th = 0.75; else if(x < 2.0) th = 0.25; else if(x < 3.0) th = 0.875; else th = 0.375;\n                } else if(y < 3.0) {\n                    if(x < 1.0) th = 0.1875; else if(x < 2.0) th = 0.6875; else if(x < 3.0) th = 0.0625; else th = 0.5625;\n                } else {\n                    if(x < 1.0) th = 0.9375; else if(x < 2.0) th = 0.4375; else if(x < 3.0) th = 0.8125; else th = 0.3125;\n                }\n\n                // Palette: near-black, charcoal, soft gray, white highlights\n                vec3 c1 = vec3(0.04, 0.04, 0.04);\n                vec3 c2 = vec3(0.12, 0.12, 0.12);\n                vec3 c3 = vec3(0.3, 0.3, 0.3);\n                vec3 c4 = vec3(0.8, 0.8, 0.8);\n\n                vec3 col = c1;\n                float spread = 0.45;\n                if(n > th * spread + 0.1) col = c2;\n                if(n > th * spread + 0.35) col = c3;\n                if(n > th * spread + 0.6) col = c4;\n\n                gl_FragColor = vec4(col, 1.0);\n            }\n            `);\n            gl.compileShader(fs);\n\n            const prog = gl.createProgram();\n            gl.attachShader(prog, vs);\n            gl.attachShader(prog, fs);\n            gl.linkProgram(prog);\n            gl.useProgram(prog);\n\n            const pLoc = gl.getAttribLocation(prog, \"p\");\n            gl.enableVertexAttribArray(pLoc);\n            gl.vertexAttribPointer(pLoc, 2, gl.FLOAT, false, 0, 0);\n\n            const rLoc = gl.getUniformLocation(prog, \"r\");\n            const tLoc = gl.getUniformLocation(prog, \"t\");\n\n            function render(time) {\n                gl.viewport(0, 0, canvas.width, canvas.height);\n                gl.uniform2f(rLoc, canvas.width, canvas.height);\n                gl.uniform1f(tLoc, time * 0.001);\n                gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);\n                requestAnimationFrame(render);\n            }\n\n            function resize(){\n                canvas.width = window.innerWidth;\n                canvas.height = window.innerHeight;\n            }\n\n            window.addEventListener('resize', resize);\n            resize();\n            render(0);\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "strongx-services-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/strongx-services-1.jpg", "source_name": "strongx-services-1-DESIGN.md", "views": 97, "forks": 4, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T18:15:07.11985+00:00"}