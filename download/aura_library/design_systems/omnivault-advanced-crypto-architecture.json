"></canvas>\n\n                <!-- Central Glow Fallback -->\n                <div class=\"absolute top-[20%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[1px] bg-gradient-to-r from-transparent via-[#6df5c6] to-transparent shadow-[0_0_50px_rgba(109,245,198,0.6)] z-0\"></div>\n\n                <!-- Top Subtitle -->\n                <div class=\"text-center relative z-10 mb-8\">\n                    <iconify-icon icon=\"coolicons:star\" class=\"text-[#6df5c6] text-xl mb-3 animate-pulse\"></iconify-icon>\n                    <p class=\"text-zinc-400 text-sm md:text-base max-w-sm mx-auto leading-relaxed\">\n                        The definitive architecture for modern finance.\n                    </p>\n                </div>\n\n                <!-- Central Typographical Focus -->\n                <div class=\"w-full max-w-4xl relative z-10 flex flex-col items-center text-center\">\n                    <h1 class=\"text-5xl md:text-7xl leading-[1.05] text-white font-medium tracking-tight mb-8\">\n                        <div class=\"overflow-hidden\"><span class=\"block js-reveal translate-y-full\">Orchestrate Your</span></div>\n                        <div class=\"overflow-hidden\"><span class=\"block js-reveal translate-y-full\">Digital Assets</span></div>\n                        <div class=\"overflow-hidden\"><span class=\"block js-reveal translate-y-full\">With Precision</span></div>\n                    </h1>\n\n                    <p class=\"text-zinc-400 text-sm md:text-base mb-12 max-w-xl mx-auto leading-relaxed\">\n                        Consolidate wealth management, execute microsecond latency trades, and access deep liquidity pools across 4,000+ global markets—all secured by institutional-grade custody.\n                    </p>\n\n                    <button class=\"group relative px-8 py-4 bg-zinc-900 border border-[#6df5c6]/30 rounded-full flex items-center gap-4 hover:border-[#6df5c6] transition-all duration-300 shadow-[0_0_20px_rgba(109,245,198,0.1)] hover:shadow-[0_0_30px_rgba(109,245,198,0.2)] overflow-hidden mb-20\">\n                        <div class=\"absolute inset-0 bg-gradient-to-r from-[#6df5c6]/0 via-[#6df5c6]/10 to-[#6df5c6]/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000\"></div>\n                        <span class=\"text-white font-medium text-sm relative z-10\">Initialize Account</span>\n                        <div class=\"w-8 h-8 rounded-full bg-[#6df5c6] flex items-center justify-center relative z-10 shadow-[0_0_10px_rgba(109,245,198,0.5)]\">\n                            <iconify-icon icon=\"coolicons:arrow-right\" class=\"text-zinc-950 text-sm\"></iconify-icon>\n                        </div>\n                    </button>\n                </div>\n\n                <!-- Restructured Density Grid -->\n                <div class=\"w-full max-w-6xl relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6 text-left\">\n\n                    <!-- Performance Card -->\n                    <div class=\"border-gradient-container rounded-3xl group\">\n                        <div class=\"p-8 flex flex-col relative overflow-hidden\">\n                            <!-- Inner subtle glow -->\n                            <div class=\"absolute -top-10 -right-10 w-32 h-32 bg-[#6df5c6] rounded-full mix-blend-screen filter blur-[70px] opacity-0 group-hover:opacity-20 transition-opacity duration-700\"></div>\n\n                            <div class=\"flex items-center justify-between mb-8\">\n                                <div class=\"w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-[#6df5c6]\">\n                                    <iconify-icon icon=\"coolicons:wallet\" class=\"text-xl\"></iconify-icon>\n                                </div>\n                                <div class=\"inline-flex items-center gap-1.5 bg-zinc-800/60 border border-zinc-700/50 rounded-full px-3 py-1 text-xs text-zinc-300 backdrop-blur-sm\">\n                                    0x4A...2F91\n                                </div>\n                            </div>\n\n                            <div class=\"mb-6\">\n                                <p class=\"text-zinc-500 text-xs font-medium mb-2\">Total Capital</p>\n                                <h3 class=\"text-white text-3xl font-medium tracking-tight\">$24,592<span class=\"text-zinc-500 text-xl font-normal\">.80</span></h3>\n                            </div>\n\n                            <div class=\"mt-auto flex gap-3\">\n                                <button class=\"flex-1 bg-zinc-900 hover:bg-zinc-800 transition-colors border border-zinc-800 text-white text-xs font-medium py-3 rounded-xl flex items-center justify-center gap-2\">\n                                    Receive <iconify-icon icon=\"coolicons:arrow-down-right\" class=\"text-zinc-400\"></iconify-icon>\n                                </button>\n                                <button class=\"flex-1 bg-zinc-900 hover:bg-zinc-800 transition-colors border border-zinc-800 text-white text-xs font-medium py-3 rounded-xl flex items-center justify-center gap-2\">\n                                    Send <iconify-icon icon=\"coolicons:arrow-up-right\" class=\"text-zinc-400\"></iconify-icon>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Market Pulse Card -->\n                    <div class=\"border-gradient-container rounded-3xl group\">\n                        <div class=\"p-8 flex flex-col relative overflow-hidden\">\n                            <div class=\"flex items-center justify-between mb-8\">\n                                <div class=\"w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-[#6df5c6]\">\n                                    <iconify-icon icon=\"coolicons:chart-bar\" class=\"text-xl\"></iconify-icon>\n                                </div>\n                                <div class=\"text-[#6df5c6] text-xs font-medium bg-[#6df5c6]/10 px-2 py-1 rounded flex items-center gap-1\">\n                                    <iconify-icon icon=\"coolicons:trending-up\"></iconify-icon> +14.2%\n                                </div>\n                            </div>\n\n                            <div class=\"mb-4\">\n                                <p class=\"text-zinc-500 text-xs font-medium mb-1\">24h Network Volume</p>\n                                <div class=\"text-white text-lg font-medium tracking-tight\">$3.2B USD</div>\n                            </div>\n\n                            <!-- Integrated floating widget style info -->\n                            <div class=\"mt-auto bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-4\">\n                                <div class=\"flex items-center gap-3\">\n                                    <div class=\"w-8 h-8 rounded-full bg-[#1A1F26] flex items-center justify-center text-white border border-zinc-700/50\">\n                                        <iconify-icon icon=\"coolicons:disc\"></iconify-icon>\n                                    </div>\n                                    <div class=\"flex-1\">\n                                        <div class=\"text-white text-sm font-medium\">Cosmos</div>\n                                        <div class=\"text-zinc-500 text-xs\">ATOM • 14.50</div>\n                                    </div>\n                                    <div class=\"text-right\">\n                                        <div class=\"text-white text-sm font-medium\">8.245</div>\n                                        <div class=\"text-red-400 text-xs flex items-center justify-end gap-1\">\n                                            <iconify-icon icon=\"coolicons:arrow-down-right\"></iconify-icon> 1.2%\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Institutional Integrity Card -->\n                    <div class=\"border-gradient-container rounded-3xl group\">\n                        <div class=\"p-8 flex flex-col relative overflow-hidden\">\n                            <div class=\"flex items-center justify-between mb-8\">\n                                <div class=\"w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-[#6df5c6]\">\n                                    <iconify-icon icon=\"coolicons:shield\" class=\"text-xl\"></iconify-icon>\n                                </div>\n                                <div class=\"inline-flex items-center gap-1.5 bg-zinc-900 border border-zinc-800 rounded-full px-3 py-1\">\n                                    <iconify-icon icon=\"coolicons:check-circle\" class=\"text-zinc-400 text-xs\"></iconify-icon>\n                                    <span class=\"text-zinc-300 text-xs font-medium\">CertiK Audited</span>\n                                </div>\n                            </div>\n\n                            <div class=\"mb-8\">\n                                <h3 class=\"text-white text-2xl font-medium tracking-tight mb-2\">Unbreachable Architecture</h3>\n                                <p class=\"text-zinc-500 text-sm leading-relaxed\">\n                                    Multi-party computation (MPC) combined with hardware isolation protocols ensure absolute asset sovereignty.\n                                </p>\n                            </div>\n\n                            <!-- Chart Area (SVG Adapted from Source) -->\n                            <div class=\"mt-auto relative h-16 w-full\">\n                                <svg viewBox=\"0 0 200 60\" class=\"w-full h-full overflow-visible\">\n                                    <defs>\n                                        <linearGradient id=\"chartGradientNew\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                                            <stop offset=\"0%\" stop-color=\"#6df5c6\" stop-opacity=\"0.15\"/>\n                                            <stop offset=\"100%\" stop-color=\"#6df5c6\" stop-opacity=\"0\"/>\n                                        </linearGradient>\n                                    </defs>\n                                    <path d=\"M0,60 L0,30 C30,30 40,15 60,20 C80,25 90,40 110,30 C130,20 140,10 160,15 C180,20 190,5 200,0 L200,60 Z\" fill=\"url(#chartGradientNew)\"/>\n                                    <path d=\"M0,30 C30,30 40,15 60,20 C80,25 90,40 110,30 C130,20 140,10 160,15 C180,20 190,5 200,0\" fill=\"none\" stroke=\"#6df5c6\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n                                </svg>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </section>\n        </div>\n    </main>\n\n    <script>\n        // GSAP ScrollTrigger Setup for Masked Reveal\n        gsap.registerPlugin(ScrollTrigger);\n\n        gsap.to(\".js-reveal\", {\n            scrollTrigger: {\n                trigger: \".js-reveal\",\n                start: \"top 90%\",\n            },\n            y: \"0%\",\n            duration: 1.2,\n            ease: \"power4.out\",\n            stagger: 0.15,\n            delay: 0.1\n        });\n\n        // Simulated WebGL Beam Animation via Canvas\n        const canvas = document.getElementById('beamCanvas');\n        const ctx = canvas.getContext('2d');\n\n        let width, height;\n        let lines = [];\n        const numLines = 5;\n\n        function resize() {\n            width = canvas.width = canvas.offsetWidth;\n            height = canvas.height = canvas.offsetHeight;\n        }\n\n        class GlowingLine {\n            constructor(index) {\n                this.index = index;\n                this.amplitude = Math.random() * 25 + 10;\n                this.frequency = Math.random() * 0.002 + 0.001;\n                this.speed = Math.random() * 0.015 + 0.005;\n                this.phase = Math.random() * Math.PI * 2;\n                this.color = `rgba(109, 245, 198, ${Math.random() * 0.2 + 0.1})`;\n            }\n\n            draw(time) {\n                ctx.beginPath();\n                ctx.moveTo(0, height / 2);\n\n                for (let x = 0; x < width; x += 5) {\n                    let envelope = Math.sin((x / width) * Math.PI);\n                    let y = height / 2 +\n                            Math.sin(x * this.frequency + time * this.speed + this.phase) *\n                            this.amplitude * envelope;\n                    ctx.lineTo(x, y);\n                }\n\n                ctx.strokeStyle = this.color;\n                ctx.lineWidth = (Math.sin(time * 0.05 + this.index) + 1) * 2 + 1;\n\n                ctx.shadowBlur = 15;\n                ctx.shadowColor = '#6df5c6';\n                ctx.stroke();\n                ctx.shadowBlur = 0;\n            }\n        }\n\n        function initLines() {\n            lines = [];\n            for (let i = 0; i < numLines; i++) {\n                lines.push(new GlowingLine(i));\n            }\n        }\n\n        function animate(time) {\n            ctx.clearRect(0, 0, width, height);\n\n            ctx.beginPath();\n            ctx.moveTo(0, height/2);\n            ctx.lineTo(width, height/2);\n            ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';\n            ctx.lineWidth = 1;\n            ctx.stroke();\n\n            ctx.globalCompositeOperation = 'screen';\n            lines.forEach(line => line.draw(time));\n            ctx.globalCompositeOperation = 'source-over';\n\n            requestAnimationFrame(animate);\n        }\n\n        window.addEventListener('resize', resize);\n        resize();\n        initLines();\n        requestAnimationFrame(animate);\n\n    </script>\n</body>\n</html>", "preview_file_name": "omnivault-advanced-crypto-architecture.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/omnivault-advanced-crypto-architecture.jpg", "source_name": "omnivault-advanced-crypto-architecture-DESIGN.md", "views": 72, "forks": 3, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T06:37:21.354681+00:00"}