ize: 64px 64px;\n  mask-image: radial-gradient(circle at 50% 46%, black 0%, transparent 72%);\n}\n\n.orbit {\n  position: fixed;\n  right: -22vw;\n  top: -28vw;\n  width: 88vw;\n  height: 88vw;\n  z-index: 3;\n  pointer-events: none;\n  border-radius: 999px;\n  border: 1px solid rgba(247, 241, 231, 0.08);\n  transform: rotate(-18deg);\n  animation: orbitDrift 18s ease-in-out infinite alternate;\n}\n\n.orbit::before,\n.orbit::after {\n  content: \"\";\n  position: absolute;\n  border-radius: inherit;\n  border: 1px solid rgba(95, 140, 255, 0.10);\n}\n\n.orbit::before {\n  inset: 8%;\n}\n\n.orbit::after {\n  inset: 18%;\n  border-color: rgba(216, 168, 95, 0.10);\n}\n\n.page {\n  position: relative;\n  z-index: 10;\n  min-height: 100vh;\n  width: min(100%, 1440px);\n  margin: 0 auto;\n  padding: 26px clamp(20px, 4vw, 64px) 34px;\n  display: flex;\n  flex-direction: column;\n}\n\n.nav-shell {\n  position: fixed;\n  top: 28px;\n  left: 0;\n  right: 0;\n  z-index: 50;\n  width: 100%;\n  pointer-events: none;\n  display: flex;\n  justify-content: center;\n  padding: 0 clamp(20px, 4vw, 64px);\n}\n\n.nav-frame {\n  pointer-events: auto;\n  width: fit-content;\n  max-width: 100%;\n  padding: 1px;\n  border-radius: 999px;\n  background:\n    linear-gradient(135deg, rgba(247, 241, 231, 0.28), rgba(247, 241, 231, 0.07) 48%, rgba(95, 140, 255, 0.16));\n  box-shadow:\n    0 24px 80px rgba(0, 0, 0, 0.34),\n    0 0 64px rgba(95, 140, 255, 0.07);\n}\n\n.nav-inner {\n  height: 54px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 18px;\n  padding: 7px 9px 7px 16px;\n  border-radius: 999px;\n  border: 1px solid rgba(247, 241, 231, 0.07);\n  background: rgba(7, 8, 13, 0.78);\n  backdrop-filter: blur(24px);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  min-width: max-content;\n  font-size: 14px;\n  font-weight: 650;\n  letter-spacing: -0.035em;\n  padding-right: 4px;\n}\n\n.brand-mark {\n  position: relative;\n  width: 28px;\n  height: 28px;\n  border-radius: 10px;\n  border: 1px solid rgba(247, 241, 231, 0.15);\n  background:\n    radial-gradient(circle at 34% 28%, rgba(216, 168, 95, 0.85), transparent 34%),\n    linear-gradient(135deg, rgba(95, 140, 255, 0.32), rgba(247, 241, 231, 0.04));\n  box-shadow:\n    0 0 30px rgba(95, 140, 255, 0.16),\n    inset 0 1px 0 rgba(255, 255, 255, 0.16);\n}\n\n.brand-mark::after {\n  content: \"\";\n  position: absolute;\n  inset: 8px;\n  border-radius: 999px;\n  border: 1px solid rgba(143, 217, 193, 0.72);\n  border-left-color: transparent;\n  transform: rotate(-26deg);\n}\n\n.nav-links {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n\n.nav-links a {\n  height: 34px;\n  display: inline-flex;\n  align-items: center;\n  padding: 0 13px;\n  border-radius: 999px;\n  color: rgba(247, 241, 231, 0.55);\n  font-size: 11px;\n  font-family: var(--mono);\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  transition: color 0.25s ease, background 0.25s ease;\n}\n\n.nav-links a:hover,\n.nav-links a.active {\n  color: var(--paper);\n  background: rgba(247, 241, 231, 0.075);\n}\n\n.nav-cta {\n  height: 38px;\n  padding: 0 6px 0 15px;\n  border-radius: 999px;\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  color: #09090d;\n  background: #f4ead9;\n  font-size: 12px;\n  font-weight: 700;\n  box-shadow:\n    0 16px 36px rgba(244, 234, 217, 0.12),\n    0 0 0 1px rgba(255, 255, 255, 0.18) inset,\n    inset 0 -10px 18px rgba(216, 168, 95, 0.15);\n  transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;\n}\n\n.nav-cta:hover {\n  transform: translateY(-1px);\n  background: #fff4df;\n  box-shadow:\n    0 20px 44px rgba(244, 234, 217, 0.16),\n    0 0 0 1px rgba(255, 255, 255, 0.22) inset,\n    inset 0 -10px 18px rgba(216, 168, 95, 0.16);\n}\n\n.nav-cta span {\n  width: 26px;\n  height: 26px;\n  display: grid;\n  place-items: center;\n  border-radius: 999px;\n  background: rgba(7, 8, 13, 0.90);\n  color: var(--paper);\n}\n\n.hero {\n  flex: 1;\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: 112px 0 42px;\n  text-align: center;\n}\n\n.hero-card-frame {\n  width: min(100%, 980px);\n  padding: 1px;\n  border-radius: 34px;\n  background:\n    linear-gradient(135deg, rgba(247, 241, 231, 0.30), rgba(247, 241, 231, 0.06) 48%, rgba(95, 140, 255, 0.20) 72%, rgba(216, 168, 95, 0.14));\n  box-shadow:\n    0 50px 140px rgba(0, 0, 0, 0.34),\n    0 0 90px rgba(95, 140, 255, 0.09);\n}\n\n.hero-card {\n  position: relative;\n  overflow: hidden;\n  min-height: 590px;\n  border-radius: 33px;\n  border: 1px solid rgba(247, 241, 231, 0.08);\n  background:\n    radial-gradient(circle at 50% 12%, rgba(95, 140, 255, 0.20), transparent 22rem),\n    radial-gradient(circle at 84% 70%, rgba(224, 107, 154, 0.10), transparent 18rem),\n    radial-gradient(circle at 16% 82%, rgba(216, 168, 95, 0.10), transparent 18rem),\n    rgba(7, 8, 13, 0.70);\n  backdrop-filter: blur(26px);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.075);\n  padding: clamp(38px, 7vw, 78px);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n.hero-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 18px;\n  border-radius: 24px;\n  border: 1px solid rgba(247, 241, 231, 0.07);\n  pointer-events: none;\n}\n\n.hero-card::after {\n  content: \"\";\n  position: absolute;\n  left: 18px;\n  right: 18px;\n  top: 44%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(95, 140, 255, 0.65), rgba(216, 168, 95, 0.52), transparent);\n  box-shadow: 0 0 36px rgba(95, 140, 255, 0.24);\n  animation: scan 5.2s ease-in-out infinite;\n  pointer-events: none;\n}\n\n.eyebrow {\n  position: relative;\n  z-index: 2;\n  width: fit-content;\n  margin-bottom: 26px;\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px 8px 8px;\n  border-radius: 999px;\n  border: 1px solid rgba(247, 241, 231, 0.11);\n  background: rgba(247, 241, 231, 0.045);\n  backdrop-filter: blur(18px);\n  color: rgba(247, 241, 231, 0.66);\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.065);\n}\n\n.eyebrow-dot {\n  width: 24px;\n  height: 24px;\n  border-radius: 999px;\n  display: grid;\n  place-items: center;\n  color: #07080d;\n  background:\n    radial-gradient(circle at 34% 28%, #fff4df 0%, #d8a85f 44%, #5f8cff 100%);\n  box-shadow: 0 0 22px rgba(95, 140, 255, 0.30);\n}\n\n.headline {\n  position: relative;\n  z-index: 2;\n  margin: 0;\n  max-width: 820px;\n  font-family: var(--display);\n  font-size: clamp(54px, 8vw, 112px);\n  line-height: 0.88;\n  letter-spacing: -0.07em;\n  color: var(--paper);\n}\n\n.headline-line {\n  display: block;\n  overflow: hidden;\n  padding: 0.035em 0 0.13em;\n  margin-bottom: -0.09em;\n}\n\n.headline-line > span {\n  display: inline-block;\n  transform: translateY(112%) rotate(2deg);\n  opacity: 0;\n  filter: blur(18px);\n}\n\n.loaded .headline-line > span {\n  animation: headlineReveal 1.05s var(--ease) forwards;\n  animation-delay: var(--delay, 0s);\n}\n\n.headline .serif {\n  font-family: var(--serif);\n  font-style: italic;\n  font-weight: 400;\n  letter-spacing: -0.055em;\n}\n\n.headline .accent {\n  color: #f4ead9;\n  font-style: normal;\n  text-shadow:\n    0 0 36px rgba(216, 168, 95, 0.14),\n    0 0 70px rgba(95, 140, 255, 0.07);\n}\n\n.subcopy {\n  position: relative;\n  z-index: 2;\n  margin: 32px auto 0;\n  max-width: 620px;\n  color: rgba(247, 241, 231, 0.66);\n  font-size: clamp(15px, 1.25vw, 18px);\n  line-height: 1.72;\n  letter-spacing: -0.015em;\n}\n\n.actions {\n  position: relative;\n  z-index: 2;\n  margin-top: 38px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 14px;\n}\n\n.btn-primary,\n.btn-secondary {\n  min-height: 52px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  border-radius: 999px;\n  padding: 0 22px;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n  transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;\n}\n\n.btn-primary {\n  color: #09090d;\n  background: #f4ead9;\n  box-shadow:\n    0 22px 54px rgba(244, 234, 217, 0.12),\n    0 0 0 1px rgba(255, 255, 255, 0.18) inset,\n    inset 0 -12px 22px rgba(216, 168, 95, 0.14);\n  overflow: hidden;\n  position: relative;\n}\n\n.btn-primary::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.32), transparent);\n  transform: translateX(-120%);\n  animation: shimmer 4.8s ease-in-out infinite;\n}\n\n.btn-primary:hover {\n  background: #fff4df;\n  box-shadow:\n    0 26px 66px rgba(244, 234, 217, 0.16),\n    0 0 0 1px rgba(255, 255, 255, 0.22) inset,\n    inset 0 -12px 22px rgba(216, 168, 95, 0.16);\n}\n\n.btn-secondary {\n  color: rgba(247, 241, 231, 0.82);\n  border: 1px solid rgba(247, 241, 231, 0.13);\n  background: rgba(247, 241, 231, 0.045);\n  backdrop-filter: blur(18px);\n}\n\n.btn-primary:hover,\n.btn-secondary:hover {\n  transform: translateY(-2px);\n}\n\n.btn-secondary:hover {\n  border-color: rgba(216, 168, 95, 0.34);\n  background: rgba(247, 241, 231, 0.075);\n}\n\n.insight-row {\n  position: relative;\n  z-index: 2;\n  width: min(100%, 720px);\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 12px;\n  margin-top: 50px;\n}\n\n.insight-card {\n  text-align: left;\n  min-height: 118px;\n  border: 1px solid rgba(247, 241, 231, 0.095);\n  border-radius: 22px;\n  padding: 17px;\n  background:\n    linear-gradient(180deg, rgba(247, 241, 231, 0.065), rgba(247, 241, 231, 0.025)),\n    rgba(7, 8, 13, 0.52);\n  backdrop-filter: blur(18px);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.055);\n  transition: transform 0.28s var(--ease), border-color 0.28s ease, background 0.28s ease;\n}\n\n.insight-card:hover {\n  transform: translateY(-4px);\n  border-color: rgba(216, 168, 95, 0.22);\n  background:\n    linear-gradient(180deg, rgba(247, 241, 231, 0.078), rgba(247, 241, 231, 0.03)),\n    rgba(9, 11, 18, 0.72);\n}\n\n.insight-card iconify-icon {\n  color: var(--amber);\n  font-size: 22px;\n}\n\n.insight-card h3 {\n  margin: 16px 0 0;\n  font-size: 13px;\n  font-weight: 660;\n  letter-spacing: -0.02em;\n}\n\n.insight-card p {\n  margin: 6px 0 0;\n  color: rgba(247, 241, 231, 0.46);\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.floating-node {\n  position: absolute;\n  z-index: 2;\n  width: 150px;\n  padding: 13px;\n  border: 1px solid rgba(247, 241, 231, 0.10);\n  border-radius: 18px;\n  background: rgba(7, 8, 13, 0.66);\n  backdrop-filter: blur(20px);\n  box-shadow:\n    0 18px 52px rgba(0, 0, 0, 0.24),\n    inset 0 1px 0 rgba(255, 255, 255, 0.06);\n  text-align: left;\n  animation: floatNode 5.8s ease-in-out infinite;\n}\n\n.floating-node.one {\n  left: 34px;\n  top: 82px;\n}\n\n.node-label {\n  display: block;\n  color: rgba(247, 241, 231, 0.40);\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.node-value {\n  display: block;\n  margin-top: 7px;\n  color: var(--paper);\n  font-size: 18px;\n  line-height: 1;\n  letter-spacing: -0.05em;\n  font-weight: 560;\n}\n\n.node-bar {\n  margin-top: 11px;\n  height: 5px;\n  border-radius: 999px;\n  overflow: hidden;\n  background: rgba(247, 241, 231, 0.08);\n}\n\n.node-bar span {\n  display: block;\n  width: var(--w);\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, var(--blue), var(--violet), var(--amber));\n  animation: barLoad 1.6s var(--ease) forwards;\n  transform-origin: left;\n}\n\n.reveal {\n  opacity: 0;\n  transform: translateY(18px);\n  filter: blur(8px);\n}\n\n.loaded .reveal {\n  animation: revealUp 0.9s var(--ease) forwards;\n  animation-delay: var(--delay, 0s);\n}\n\n@keyframes headlineReveal {\n  to {\n    transform: translateY(0) rotate(0deg);\n    opacity: 1;\n    filter: blur(0);\n  }\n}\n\n@keyframes revealUp {\n  to {\n    opacity: 1;\n    transform: translateY(0);\n    filter: blur(0);\n  }\n}\n\n@keyframes scan {\n  0%, 100% {\n    transform: translateY(-190px);\n    opacity: 0;\n  }\n\n  16%, 86% {\n    opacity: 1;\n  }\n\n  50% {\n    transform: translateY(212px);\n  }\n}\n\n@keyframes shimmer {\n  0%, 58% {\n    transform: translateX(-120%);\n  }\n\n  82%, 100% {\n    transform: translateX(120%);\n  }\n}\n\n@keyframes floatNode {\n  0%, 100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(-12px);\n  }\n}\n\n@keyframes barLoad {\n  from {\n    transform: scaleX(0);\n  }\n\n  to {\n    transform: scaleX(1);\n  }\n}\n\n@keyframes orbitDrift {\n  from {\n    transform: rotate(-18deg) translate3d(0, 0, 0);\n  }\n\n  to {\n    transform: rotate(-10deg) translate3d(-2.2vw, 1.2vw, 0);\n  }\n}\n\n@keyframes grain {\n  0%, 100% {\n    transform: translate(0, 0);\n  }\n\n  20% {\n    transform: translate(-4%, 3%);\n  }\n\n  40% {\n    transform: translate(3%, -5%);\n  }\n\n  60% {\n    transform: translate(-3%, -2%);\n  }\n\n  80% {\n    transform: translate(4%, 4%);\n  }\n}\n\n@media (max-width: 860px) {\n  .nav-shell {\n  top: 18px;\n  padding: 0 16px;\n}\n\n  .nav-inner {\n    height: 50px;\n    justify-content: space-between;\n    padding-left: 13px;\n  }\n\n  .nav-links {\n    display: none;\n  }\n\n  .nav-cta strong {\n    display: none;\n  }\n\n  .hero {\n    padding-top: 94px;\n  }\n\n  .hero-card {\n    min-height: auto;\n    padding: 44px 22px;\n    border-radius: 27px;\n  }\n\n  .hero-card-frame {\n    border-radius: 28px;\n  }\n\n  .headline {\n    font-size: clamp(48px, 14vw, 76px);\n    line-height: 0.92;\n  }\n\n  .subcopy {\n    font-size: 15px;\n  }\n\n  .actions a {\n    width: 100%;\n  }\n\n  .insight-row {\n    grid-template-columns: 1fr;\n    margin-top: 34px;\n  }\n\n  .floating-node {\n    display: none !important;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n\n  .reveal,\n  .headline-line > span {\n    opacity: 1 !important;\n    transform: none !important;\n    filter: none !important;\n  }\n}\n</style>\n</head>\n\n<body>\n<div id=\"webgl-container\" aria-hidden=\"true\"></div>\n<div class=\"background-vignette\" aria-hidden=\"true\"></div>\n<div class=\"noise\" aria-hidden=\"true\"></div>\n<div class=\"grid-field\" aria-hidden=\"true\"></div>\n<div class=\"orbit\" aria-hidden=\"true\"></div>\n\n<div class=\"nav-shell reveal\" style=\"--delay: .04s\">\n  <div class=\"nav-frame\">\n    <nav class=\"nav-inner\" aria-label=\"Primary navigation\">\n      <a href=\"#\" class=\"brand\" aria-label=\"Nexus home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n        <span>Nexus</span>\n      </a>\n\n      <div class=\"nav-links\">\n        <a href=\"#\" class=\"active\">Platform</a>\n        <a href=\"#\">Architecture</a>\n        <a href=\"#\">Knowledge</a>\n        <a href=\"#\">Pricing</a>\n      </div>\n\n      <a href=\"#\" class=\"nav-cta\">\n        <strong>Deploy</strong>\n        <span>\n          <iconify-icon icon=\"solar:arrow-right-up-linear\" width=\"15\"></iconify-icon>\n        </span>\n      </a>\n    </nav>\n  </div>\n</div>\n\n<main class=\"page\">\n  <section class=\"hero\">\n    <div class=\"hero-card-frame reveal\" style=\"--delay: .12s\">\n      <div class=\"hero-card\">\n        <div class=\"floating-node one\">\n          <span class=\"node-label\">Intent match</span>\n          <span class=\"node-value\">94.7%</span>\n          <div class=\"node-bar\"><span style=\"--w: 94%\"></span></div>\n        </div>\n\n        <div class=\"eyebrow reveal\" style=\"--delay: .22s\">\n          <span class=\"eyebrow-dot\">\n            <iconify-icon icon=\"solar:cpu-bolt-bold\" width=\"14\"></iconify-icon>\n          </span>\n          Semantic discovery layer\n        </div>\n\n        <h1 class=\"headline\" aria-label=\"Discovery that understands intent\">\n          <span class=\"headline-line\">\n            <span style=\"--delay: .30s\">Discovery</span>\n          </span>\n          <span class=\"headline-line\">\n            <span class=\"serif\" style=\"--delay: .42s\">that understands</span>\n          </span>\n          <span class=\"headline-line\">\n            <span class=\"accent\" style=\"--delay: .54s\">intent.</span>\n          </span>\n        </h1>\n\n        <p class=\"subcopy reveal\" style=\"--delay: .72s\">\n          Nexus connects queries, context, permissions, and product knowledge into one adaptive discovery layer —\n          helping teams route every search toward the most relevant answer, workflow, or dataset.\n        </p>\n\n        <div class=\"actions reveal\" style=\"--delay: .88s\">\n          <a href=\"#\" class=\"btn-primary\">\n            Deploy discovery layer\n            <iconify-icon icon=\"solar:arrow-right-up-linear\" width=\"18\"></iconify-icon>\n          </a>\n\n          <a href=\"#\" class=\"btn-secondary\">\n            <iconify-icon icon=\"solar:play-circle-linear\" width=\"18\" style=\"color: var(--amber);\"></iconify-icon>\n            View knowledge map\n          </a>\n        </div>\n\n        <div class=\"insight-row reveal\" style=\"--delay: 1.02s\">\n          <article class=\"insight-card\">\n            <iconify-icon icon=\"solar:routing-3-linear\"></iconify-icon>\n            <h3>Intent routing</h3>\n            <p>Direct every query through context-aware paths based on role, behavior, and semantic signal.</p>\n          </article>\n\n          <article class=\"insight-card\">\n            <iconify-icon icon=\"solar:graph-new-up-linear\"></iconify-icon>\n            <h3>Knowledge graph</h3>\n            <p>Connect documents, APIs, tickets, and product surfaces into one living discovery network.</p>\n          </article>\n\n          <article class=\"insight-card\">\n            <iconify-icon icon=\"solar:shield-check-linear\"></iconify-icon>\n            <h3>Governed access</h3>\n            <p>Respect workspace permissions while making institutional knowledge easier to find and reuse.</p>\n          </article>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<script type=\"module\">\nimport * as THREE from \"https://unpkg.com/three@0.160.0/build/three.module.js\";\n\nconst container = document.getElementById(\"webgl-container\");\n\nconst scene = new THREE.Scene();\nconst camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);\ncamera.position.z = 1;\n\nconst renderer = new THREE.WebGLRenderer({\n  alpha: true,\n  antialias: false,\n  powerPreference: \"high-performance\"\n});\n\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.8));\nrenderer.setSize(window.innerWidth, window.innerHeight);\ncontainer.appendChild(renderer.domElement);\n\nconst geometry = new THREE.PlaneGeometry(2, 2);\n\nconst material = new THREE.ShaderMaterial({\n  uniforms: {\n    u_resolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },\n    u_time: { value: 0 },\n    u_mouse: { value: new THREE.Vector2(0, 0) }\n  },\n  vertexShader: `\n    void main() {\n      gl_Position = vec4(position, 1.0);\n    }\n  `,\n  fragmentShader: `\n    precision highp float;\n\n    uniform vec2 u_resolution;\n    uniform float u_time;\n    uniform vec2 u_mouse;\n\n    mat2 rot(float a) {\n      float s = sin(a);\n      float c = cos(a);\n      return mat2(c, -s, s, c);\n    }\n\n    float hash(vec2 p) {\n      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n    }\n\n    float noise(vec2 p) {\n      vec2 i = floor(p);\n      vec2 f = fract(p);\n      float a = hash(i);\n      float b = hash(i + vec2(1.0, 0.0));\n      float c = hash(i + vec2(0.0, 1.0));\n      float d = hash(i + vec2(1.0, 1.0));\n      vec2 u = f * f * (3.0 - 2.0 * f);\n      return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;\n    }\n\n    float fbm(vec2 p) {\n      float value = 0.0;\n      float amp = 0.5;\n\n      for (int i = 0; i < 5; i++) {\n        value += amp * noise(p);\n        p = rot(0.58) * p * 2.05 + 12.4;\n        amp *= 0.48;\n      }\n\n      return value;\n    }\n\n    float nodeField(vec2 uv) {\n      vec2 id = floor(uv);\n      vec2 gv = fract(uv) - 0.5;\n\n      float rnd = hash(id);\n      float size = mix(0.035, 0.12, hash(id + 4.2));\n      float node = smoothstep(size, 0.0, length(gv));\n\n      float pulse = 0.58 + 0.42 * sin(u_time * 1.4 + rnd * 6.283);\n      return node * step(0.72, rnd) * pulse;\n    }\n\n    float lineGrid(vec2 uv) {\n      vec2 grid = abs(fract(uv - 0.5) - 0.5) / fwidth(uv);\n      float line = 1.0 - min(min(grid.x, grid.y), 1.0);\n      return line;\n    }\n\n    float semanticContours(vec2 p) {\n      vec2 warped = p;\n      warped.x += fbm(p * 2.4 + u_time * 0.035) * 0.25;\n      warped.y += fbm(p * 2.0 - u_time * 0.026) * 0.18;\n\n      float field = fbm(warped * 3.15 + vec2(u_time * 0.018, -u_time * 0.022));\n      float contour = smoothstep(0.018, 0.0, abs(fract(field * 9.0) - 0.5));\n      float fine = smoothstep(0.010, 0.0, abs(fract(field * 21.0) - 0.5));\n\n      return contour * 0.70 + fine * 0.20;\n    }\n\n    void main() {\n      vec2 uv = gl_FragCoord.xy / u_resolution.xy;\n      vec2 p = uv - 0.5;\n      p.x *= u_resolution.x / u_resolution.y;\n\n      vec2 mouse = u_mouse * 0.055;\n\n      vec3 ink = vec3(0.027, 0.031, 0.052);\n      vec3 deep = vec3(0.042, 0.051, 0.082);\n      vec3 blue = vec3(0.373, 0.549, 1.0);\n      vec3 violet = vec3(0.608, 0.424, 1.0);\n      vec3 rose = vec3(0.878, 0.420, 0.604);\n      vec3 amber = vec3(0.847, 0.659, 0.373);\n      vec3 mint = vec3(0.561, 0.851, 0.757);\n      vec3 paper = vec3(0.969, 0.945, 0.906);\n\n      float radial = smoothstep(0.92, 0.05, length(p - vec2(0.0, 0.02)));\n      vec3 col = mix(ink, deep, uv.y * 0.8 + radial * 0.24);\n\n      vec2 mapUv = (p + mouse) * 1.23;\n      mapUv *= rot(-0.16 + sin(u_time * 0.08) * 0.025);\n\n      float mapMask = smoothstep(0.98, 0.12, length(mapUv * vec2(0.86, 1.08)));\n      float contours = semanticContours(mapUv) * mapMask;\n\n      vec3 gradient = mix(blue, violet, smoothstep(-0.45, 0.42, mapUv.x));\n      gradient = mix(gradient, amber, smoothstep(-0.35, 0.56, mapUv.y) * 0.45);\n\n      col += contours * gradient * 0.52;\n\n      vec2 networkUv = mapUv * vec2(13.0, 8.0) + vec2(u_time * 0.12, -u_time * 0.04);\n      float nodes = nodeField(networkUv) * mapMask;\n      float grid = lineGrid(networkUv) * 0.018 * mapMask;\n\n      col += nodes * mix(mint, paper, 0.32) * 0.48;\n      col += grid * blue;\n\n      float glowBlue = pow(radial, 3.0);\n      col += glowBlue * blue * 0.10;\n      col += pow(radial, 4.2) * amber * 0.055;\n\n      float aurora = fbm(vec2(p.x * 1.2 + u_time * 0.025, p.y * 3.0 - u_time * 0.035));\n      aurora = smoothstep(0.48, 0.74, aurora) * smoothstep(0.78, 0.05, length(p - vec2(0.12, 0.08)));\n      col += aurora * mix(rose, violet, uv.x) * 0.11;\n\n      float stars = step(0.992, hash(floor(uv * vec2(180.0, 100.0)))) * 0.55;\n      col += stars * paper;\n\n      float vignette = smoothstep(0.95, 0.30, length(p));\n      col *= 0.58 + vignette * 0.62;\n\n      float grain = hash(gl_FragCoord.xy + u_time * 20.0) * 0.035;\n      col += grain;\n\n      gl_FragColor = vec4(col, 1.0);\n    }\n  `\n});\n\nconst mesh = new THREE.Mesh(geometry, material);\nscene.add(mesh);\n\nconst clock = new THREE.Clock();\nconst mouse = new THREE.Vector2(0, 0);\nconst easedMouse = new THREE.Vector2(0, 0);\n\nwindow.addEventListener(\"pointermove\", (event) => {\n  mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n  mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n}, { passive: true });\n\nfunction animate() {\n  requestAnimationFrame(animate);\n\n  easedMouse.lerp(mouse, 0.035);\n  material.uniforms.u_time.value = clock.getElapsedTime();\n  material.uniforms.u_mouse.value.copy(easedMouse);\n\n  renderer.render(scene, camera);\n}\n\nanimate();\n\nwindow.addEventListener(\"resize\", () => {\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.8));\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  material.uniforms.u_resolution.value.set(window.innerWidth, window.innerHeight);\n});\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  requestAnimationFrame(() => {\n    document.body.classList.add(\"loaded\");\n  });\n});\n\nif (document.readyState !== \"loading\") {\n  document.body.classList.add(\"loaded\");\n}\n</script>\n</body>\n</html>", "preview_file_name": "nexus-intelligent-discovery.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/nexus-intelligent-discovery.jpg", "source_name": "nexus-intelligent-discovery-DESIGN.md", "views": 101, "forks": 3, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-06-21T11:39:54.279152+00:00", "updated_at": "2026-07-03T09:10:21.574036+00:00"}