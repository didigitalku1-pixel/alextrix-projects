#060912] p-6 relative overflow-hidden\">\n        <div class=\"pointer-events-none absolute inset-0\" style=\"background-image:repeating-linear-gradient(45deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 12px);\"></div>\n        <p id=\"faqAnswer\" class=\"relative text-base sm:text-lg leading-relaxed text-slate-200 tracking-tight\">Think of it as a magic backpack that holds all your tokens, collectibles, and Web3 keys. No middlemen, no surprise parties.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ TESTIMONIAL ============ -->\n  <section class=\"relative z-10 border-t border-white/[0.06] px-5 sm:px-10 lg:px-20 py-16\" style=\"background:#03040a;\">\n    <div class=\"reveal rounded-2xl p-px\" style=\"background:linear-gradient(110deg, rgba(255,255,255,0.08), rgba(34,211,238,0.25) 60%, rgba(14,116,233,0.45));\">\n      <div class=\"rounded-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12\" style=\"background:linear-gradient(110deg, #070a14 0%, #070a14 55%, rgba(8,47,73,0.9) 80%, rgba(3,105,161,0.6) 100%);\">\n        <div class=\"lg:col-span-8 p-8 sm:p-10\">\n          <div class=\"flex items-center gap-3\">\n            <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/c92852bb-a510-405a-85ab-ffa0fde136a4_1600w.jpg\" alt=\"Portrait of Marcus Hale\" class=\"w-11 h-11 rounded-lg object-cover\">\n            <div>\n              <p class=\"text-xs font-medium text-white\">Marcus Hale</p>\n              <p class=\"text-[0.65rem] text-slate-500 flex items-center gap-1.5\">Engineer at <span class=\"inline-flex items-center gap-1 text-slate-300\"><iconify-icon icon=\"solar:layers-minimalistic-linear\" width=\"11\" stroke-width=\"1.5\"></iconify-icon>ledgerly</span></p>\n            </div>\n          </div>\n          <blockquote class=\"mt-6 text-lg sm:text-xl leading-relaxed text-slate-200 tracking-tight max-w-lg\">\n            “Nimbus makes it effortless to buy,