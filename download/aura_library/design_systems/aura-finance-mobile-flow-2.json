0%',\n                    duration: 0.8,\n                    ease: \"power4.out\",\n                    delay: 0.1,\n                    scrollTrigger: {\n                        trigger: container,\n                        start: \"top 95%\",\n                        toggleActions: \"play none none none\"\n                    }\n                });\n            });\n\n            // Flashlight / Proximity Effect Tracker\n            const cards = document.querySelectorAll('.glow-card');\n            cards.forEach(card => {\n                card.addEventListener('mousemove', (e) => {\n                    const rect = card.getBoundingClientRect();\n                    const x = e.clientX - rect.left;\n                    const y = e.clientY - rect.top;\n                    card.style.setProperty('--mouse-x', `${x}px`);\n                    card.style.setProperty('--mouse-y', `${y}px`);\n                });\n\n                // Reset slightly off-center on leave\n                card.addEventListener('mouseleave', () => {\n                    card.style.setProperty('--mouse-x', `50%`);\n                    card.style.setProperty('--mouse-y', `-50%`);\n                });\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "aura-finance-mobile-flow-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/aura-finance-mobile-flow-2.jpg", "source_name": "aura-finance-mobile-flow-2-DESIGN.md", "views": 174, "forks": 8, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-02T19:49:27.644873+00:00"}