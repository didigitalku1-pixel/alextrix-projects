                <video src=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/302e86e0-80d8-4ba5-82e8-004220675655/2026-05-20/1779243884373-c6bdef42-f3eb-47e3-9186-1ff57dd4346e.mp4\" poster=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/302e86e0-80d8-4ba5-82e8-004220675655/2026-05-20/1779243686348-eb642d26-a435-4dff-bb2f-0003b03f706d.png\" data-neuform-generated-video=\"true\" data-neuform-video-preset=\"loop-in-view\" muted=\"\" playsinline=\"\" preload=\"metadata\" loop=\"\" aria-label=\"Cleopatra Classical Monumental Asset\" class=\"w-full h-full object-cover object-center filter grayscale brightness-110 contrast-125 mix-blend-lighten\" style=\"mask-image: linear-gradient(to bottom, black 80%, transparent); -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent);\"></video>\n            </div>\n        </div>\n\n        <!-- Hero Typography Frame -->\n        <div class=\"relative max-w-5xl mx-auto px-6 text-center z-20 flex flex-col items-center mt-auto md:mt-48\">\n            <div class=\"flex items-center gap-2 mb-4 animate-fade-in\">\n                <span class=\"w-8 h-[1px] bg-[#ECAD15]\"></span>\n                <span class=\"text-xs uppercase tracking-[0.4em] text-[#ECAD15]\" style=\"font-family: 'Plus Jakarta Sans', sans-serif;\">CLEOPATRA LP</span>\n                <span class=\"w-8 h-[1px] bg-[#ECAD15]\"></span>\n            </div>\n\n            <h1 class=\"text-3xl md:text-5xl lg:text-7xl font-light tracking-tight text-white mb-6 uppercase leading-none max-w-4xl\" style=\"font-family: 'Cormorant Garamond', serif;\">\n                Ultimate Partner <br>\n                <span class=\"italic text-[#ECAD15]\">for Ruling</span> the LP Markets\n            </h1>\n\n            <p class=\"text-sm md:text-base text-[#FFF2D2]/70 font-light max-w-xl leading-relaxed tracking-wide mb-8\">\n                Whether you're managing deep pools or just getting started, our platform gives liquidity providers the edge they need to rule.\n            </p>\n\n            <div class=\"flex flex-col sm:flex-row gap-4 items-center justify-center\">\n                <a href=\"#philosophy\" class=\"px-8 py-3 bg-[#ECAD15] text-[#221C11] text-xs font-semibold uppercase tracking-widest hover:bg-[#FFF2D2] transition-colors duration-300\">\n                    Explore Ecosystem\n                </a>\n                <a href=\"#portal\" class=\"px-8 py-3 border border-[#FFF2D2]/30 text-[#FFF2D2] text-xs font-semibold uppercase tracking-widest hover:bg-white/10 transition-all duration-300 backdrop-blur-sm\">\n                    View Live Pools\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- SECTION 2: Typography & Philosophy (Slide 2 Style - Louize Inspired) -->\n    <section id=\"philosophy\" class=\"relative py-24 md:py-36 bg-[#FAF6EE] overflow-hidden border-b border-[#8B6200]/10 z-10\">\n        <div class=\"max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-start\">\n\n            <!-- Left Editorial Details -->\n            <div class=\"lg:col-span-5 flex flex-col justify-between h-full space-y-8 lg:space-y-16\">\n                <div>\n                    <span class=\"text-[10px] uppercase tracking-widest text-[#8B6200] block mb-4\">Louize Editorial Standard</span>\n                    <h2 class=\"text-5xl md:text-7xl lg:text-8xl font-light tracking-tight text-[#8B6200] leading-none\" style=\"font-family: 'Cormorant Garamond', serif;\">\n                        Louize\n                    </h2>\n                </div>\n\n                <div class=\"border-t border-[#8B6200]/20 pt-8\">\n                    <p class=\"text-[10px] text-[#8B6200]/60 uppercase tracking-widest mb-2\">Typography &amp; Alignment</p>\n                    <p class=\"text-sm text-[#8B6200]/80 leading-relaxed font-light mb-6\">\n                        The typeface draws inspiration from historical Roman geometry, showcasing the contrast between high hairline curves and stable foundations. It mirrors Cleopatra’s design methodology: classical beauty combined with surgical execution.\n                    </p>\n                    <!-- Character Alphabet Grid matching Slide 2 perfectly -->\n                    <div class=\"font-light text-xs tracking-widest text-[#8B6200]/50 uppercase\" style=\"font-family: 'Cormorant Garamond', serif;\">\n                        ABCDEFGHIJKLMOPQR<br>STUVXYZabcdefghijklmnopq<br>rstuvxyz0123456789!@#$<br>%^&amp;*(){}[];\n                    </div>\n                </div>\n            </div>\n\n            <!-- Right Giant Letter Grid Block matching Slide 2 -->\n            <div class=\"lg:col-span-7 grid grid-cols-3 gap-4 border-l border-[#8B6200]/10 pl-6 lg:pl-12\">\n                <div class=\"flex flex-col justify-end min-h-[300px] lg:min-h-[400px]\">\n                    <span class=\"text-7xl md:text-9xl lg:text-[12rem] font-light text-[#8B6200]/20 leading-none select-none hover:text-[#ECAD15] hover:scale-105 transition-all duration-500 cursor-pointer italic\" style=\"font-family: 'Cormorant Garamond', serif;\">c</span>\n                </div>\n                <div class=\"flex flex-col justify-end\">\n                    <span class=\"text-7xl md:text-9xl lg:text-[12rem] font-light text-[#8B6200]/40 leading-none select-none hover:text-[#ECAD15] hover:scale-105 transition-all duration-500 cursor-pointer\" style=\"font-family: 'Cormorant Garamond', serif;\">c</span>\n                </div>\n                <div class=\"flex flex-col justify-end\">\n                    <span class=\"text-7xl md:text-9xl lg:text-[12rem] font-light text-[#8B6200] leading-none select-none hover:text-[#ECAD15] hover:scale-105 transition-all duration-500 cursor-pointer\" style=\"font-family: 'Cormorant Garamond', serif;\">a</span>\n                </div>\n            </div>\n\n        </div>\n    </section>\n\n    <!-- SECTION 3: GSAP ScrollTrigger Pinned Narrative (Slide 3 & 5 Integrated Storytelling) -->\n    <section id=\"rewards\" class=\"relative bg-[#221C11] text-[#FFF2D2] min-h-screen flex items-center z-10\">\n        <div class=\"w-full grid grid-cols-1 lg:grid-cols-2 lg:h-screen items-stretch\">\n\n            <!-- Left Sticky Text panel -->\n            <div class=\"flex flex-col justify-center px-8 py-16 md:p-16 lg:p-24 bg-[#211A0D] border-r border-[#8B6200]/20\">\n                <div class=\"max-w-lg space-y-12\">\n                    <div class=\"flex items-center gap-3\">\n                        <svg class=\"w-6 h-6 text-[#ECAD15]\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9Z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"></path>\n                        </svg>\n                        <span class=\"text-xs uppercase tracking-[0.3em] text-[#ECAD15]\">Ecosystem Engine</span>\n                    </div>\n\n                    <!-- Slide 3 Title Copy Alignment -->\n                    <div class=\"space-y-6\">\n                        <h3 class=\"text-3xl md:text-5xl font-light tracking-tight text-white leading-tight\" style=\"font-family: 'Cormorant Garamond', serif;\">\n                            Built for liquidity providers who <br>\n                            <span class=\"italic text-[#ECAD15]\">want rewards</span> &amp; <br>\n                            real-time insights.\n                        </h3>\n                        <p class=\"text-sm text-[#FFF2D2]/70 font-light leading-relaxed\">\n                            Whether you're managing deep pools or just getting started, our platform gives liquidity providers the edge they need. Track performance in real time, optimize yield strategies, and unlock insights that help you stay ahead of the curve.\n                        </p>\n                    </div>\n\n                    <!-- Mini Constellation line details mimicking Slide 3/5 center vector -->\n                    <div class=\"relative py-8 border-t border-[#8B6200]/30 flex items-center gap-6\">\n                        <svg class=\"w-16 h-8 text-[#ECAD15]\" viewBox=\"0 0 100 50\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M0 25H100M15 25C15 15 35 15 35 25C35 35 65 35 65 25C65 15 85 15 85 25\" stroke=\"currentColor\" stroke-width=\"1.5\"></path>\n                            <circle cx=\"50\" cy=\"25\" r=\"4\" fill=\"currentColor\"></circle>\n                        </svg>\n                        <span class=\"text-[10px] uppercase tracking-widest text-[#FFF2D2]/50\">Dynamic Yield Routing Enabled</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Right Interactive Graphic / Visual Path mimicking Slide 3 classical view -->\n            <div class=\"relative min-h-[400px] lg:h-full overflow-hidden flex items-center justify-center bg-[#2E2413]\">\n                <!-- Aura Asset: Beautiful Greek Temple Path / Garden mimicking Slide 3 Right exactly -->\n                <img src=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/302e86e0-80d8-4ba5-82e8-004220675655/2026-05-20/1779243717410-ddca821f-6595-4a25-8269-cc90ddb2c1af.png\" alt=\"Classical Temple Pathways\" class=\"absolute inset-0 w-full h-full object-cover mix-blend-luminosity opacity-40 hover:opacity-75 transition-opacity duration-1000 scale-105\" data-element-src=\"https://wypspaektjjiccarxrgy.supabase.co/storage/v1/object/public/generated-page-media/302e86e0-80d8-4ba5-82e8-004220675655/2026-05-20/1779243717410-ddca821f-6595-4a25-8269-cc90ddb2c1af.png\">\n\n                <div class=\"absolute inset-0 bg-gradient-to-r from-[#211A0D] to-transparent\"></div>\n\n                <!-- Live Dynamic Analytics Simulated Overlay (Changes on interaction) -->\n                <div class=\"relative z-10 w-4/5 max-w-md p-6