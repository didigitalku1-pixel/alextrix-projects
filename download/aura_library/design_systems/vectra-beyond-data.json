tiply\"></circle>\n\n                    <!-- Wireframe connections -->\n                    <path d=\"M 115 220 A 120 250 0 0 0 115 380\"></path>\n                    <path d=\"M 285 220 A 120 250 0 0 1 285 380\"></path>\n\n                    <path d=\"M 130 220 A 100 250 0 0 0 130 380\"></path>\n                    <path d=\"M 270 220 A 100 250 0 0 1 270 380\"></path>\n\n                    <path d=\"M 150 220 A 70 250 0 0 0 150 380\"></path>\n                    <path d=\"M 250 220 A 70 250 0 0 1 250 380\"></path>\n\n                    <path d=\"M 175 220 A 35 250 0 0 0 175 380\"></path>\n                    <path d=\"M 225 220 A 35 250 0 0 1 225 380\"></path>\n\n                    <!-- Axis lines -->\n                    <line x1=\"200\" y1=\"135\" x2=\"200\" y2=\"465\" stroke-dasharray=\"2 4\" class=\"stroke-sigma-mint-dark/30\"></line>\n                    <line x1=\"100\" y1=\"300\" x2=\"300\" y2=\"300\" stroke-dasharray=\"2 4\" class=\"stroke-sigma-mint-dark/30\"></line>\n                </svg>\n\n                <!-- Content -->\n                <header class=\"relative z-20\">\n                    <div class=\"flex items-center gap-2 text-zinc-800\">\n                        <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-lg\"></iconify-icon>\n                        <span class=\"font-serif text-sm tracking-wide font-medium\">Vectra</span>\n                    </div>\n                </header>\n\n                <div class=\"relative z-20 w-full pb-8 lg:pb-12 max-w-[85%]\">\n                    <h1 class=\"font-serif text-4xl md:text-5xl lg:text-6xl text-zinc-800 leading-[1.05] tracking-tight font-normal\">\n                        <div class=\"reveal-text\">Trust the</div>\n                        <div class=\"reveal-text italic text-zinc-600\">metrics.</div>\n                        <div class=\"reveal-text\">Ignore the</div>\n                        <div class=\"reveal-text italic text-zinc-600\">static.</div>\n                    </h1>\n                </div>\n            </article>\n\n\n            <!-- ================= CARD 3: RIGHT ================= -->\n            <article class=\"relative w-full aspect-[3/4] lg:aspect-[2/3] overflow-hidden flex flex-col justify-between p-6 lg:p-8\">\n                <!-- Background Image & Overlays -->\n                <div class=\"absolute inset-0 z-0 bg-zinc-900\" style=\"background-image: url('https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/b678d210-2f22-4274-a264-d0e53797612f_3840w.jpg'); background-size: cover; background-position: center; filter: saturate(0.8) contrast(1.1);\">\n                </div>\n                <div class=\"absolute inset-0 z-0 bg-gradient-to-b from-[#0A0A0A]/80 via-[#0A0A0A]/40 to-[#0A0A0A]/90 mix-blend-multiply\"></div>\n\n                <!-- Abstract Glow -->\n                <div class=\"absolute top-[55%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-80 z-0 rounded-full blur-[70px]\" style=\"background: radial-gradient(ellipse, rgba(255,80,0,0.45) 0%, transparent 60%);\"></div>\n\n                <!-- Geometric SVG Overlay -->\n                <svg viewBox=\"0 0 400 600\" class=\"absolute inset-0 w-full h-full z-10 stroke-white/30 fill-none pointer-events-none\" style=\"stroke-width: 0.5;\">\n                    <circle cx=\"200\" cy=\"300\" r=\"100\"></circle>\n                    <path d=\"M 0 150 Q 200 350 400 150\"></path>\n                    <path d=\"M 0 450 Q 200 250 400 450\"></path>\n                    <line x1=\"30\" y1=\"300\" x2=\"370\" y2=\"300\"></line>\n                    <!-- Markers -->\n                    <path d=\"M 65 300 L 75 300 M 70 295 L 70 305\"></path>\n                    <path d=\"M 325 300 L 335 300 M 330 295 L 330 305\"></path>\n                    <!-- Nodes -->\n                    <rect x=\"198\" y=\"198\" width=\"4\" height=\"4\" class=\"fill-white stroke-none opacity-90\"></rect>\n                    <rect x=\"198\" y=\"398\" width=\"4\" height=\"4\" class=\"fill-white stroke-none opacity-90\"></rect>\n                </svg>\n\n                <!-- Content -->\n                <header class=\"relative z-20 flex justify-between items-start\">\n                    <div class=\"flex items-center gap-2 text-zinc-100\">\n                        <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-lg\"></iconify-icon>\n                        <span class=\"font-serif text-sm tracking-wide\">Vectra</span>\n                    </div>\n                    <div class=\"flex gap-4\">\n                        <div class=\"text-right max-w-[140px]\">\n                            <p class=\"text-[10px] leading-tight text-zinc-300 font-light mix-blend-screen drop-shadow-md\">\n                                For enterprise leaders who refuse to navigate markets blindly. Vectra is the data analytics firm that transforms raw metrics into predictive models, empowering you to scale with clarity, not guesswork.\n                            </p>\n                        </div>\n                        <div class=\"flex flex-col items-end border-l border-white/30 pl-4 h-fit\">\n                            <span class=\"text-[10px] tracking-widest text-zinc-200 font-medium uppercase leading-none mb-1\">Beyond</span>\n                            <span class=\"text-[10px] tracking-widest text-zinc-200 font-medium uppercase leading-none\">Data</span>\n                            <span class=\"font-serif text-2xl text-zinc-100 leading-none mt-1\">09</span>\n                        </div>\n                    </div>\n                </header>\n\n                <div class=\"relative z-20 w-full text-center pb-4\">\n                    <h2 class=\"font-serif text-xl md:text-2xl text-zinc-100 font-normal reveal-word\">Execute <span class=\"italic\">faster</span></h2>\n                </div>\n            </article>\n\n        </div>\n    </div>\n\n    <script>\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Utility to wrap words in spans for masking\n        function splitTextToSpans(selector) {\n            const elements = document.querySelectorAll(selector);\n            elements.forEach(el => {\n                const text = el.innerText;\n                const words = text.split(' ');\n                el.innerHTML = '';\n                words.forEach((word, i) => {\n                    const wrapper = document.createElement('span');\n                    wrapper.style.display = 'inline-block';\n                    wrapper.style.overflow = 'hidden';\n                    wrapper.style.verticalAlign = 'top';\n                    wrapper.style.marginRight = i < words.length - 1 ? '0.25em' : '0';\n\n                    const inner = document.createElement('span');\n                    inner.style.display = 'inline-block';\n                    inner.innerText = word;\n                    inner.classList.add('split-inner');\n\n                    wrapper.appendChild(inner);\n                    el.appendChild(wrapper);\n                });\n            });\n        }\n\n        // Apply splitting to main headings\n        splitTextToSpans('.reveal-text');\n        splitTextToSpans('.reveal-word');\n\n        // Animate masked words\n        const tl = gsap.timeline({\n            scrollTrigger: {\n                trigger: \"#card-container\",\n                start: \"top 80%\",\n            }\n        });\n\n        tl.from('.split-inner', {\n            y: '110%',\n            opacity: 0,\n            duration: 0.8,\n            ease: 'power3.out',\n            stagger: 0.05\n        });\n\n        // Subtle entry for graphic elements\n        gsap.from('svg circle, svg path', {\n            strokeDasharray: 1000,\n            strokeDashoffset: 1000,\n            duration: 2,\n            ease: 'power2.inOut',\n            stagger: 0.2,\n            scrollTrigger: {\n                trigger: \"#card-container\",\n                start: \"top 70%\",\n            }\n        });\n    </script>\n\n</body></html>", "preview_file_name": "vectra-beyond-data.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/vectra-beyond-data.jpg", "source_name": "vectra-beyond-data-DESIGN.md", "views": 288, "forks": 3, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-28T16:25:06.614753+00:00", "updated_at": "2026-06-29T14:34:29.601072+00:00"}