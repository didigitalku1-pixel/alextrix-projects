px]\" style=\"background: radial-gradient(circle, rgba(230,130,30,0.4) 0%, transparent 70%);\"></div>\n\n                <!-- Geometric SVG Overlay -->\n                <svg viewBox=\"0 0 400 600\" class=\"absolute inset-0 w-full h-full z-10 stroke-white/20 fill-none pointer-events-none\" style=\"stroke-width: 0.5;\">\n                    <circle cx=\"200\" cy=\"300\" r=\"100\"></circle>\n                    <path d=\"M 0 150 Q 200 350 400 150\"></path>\n                    <path d=\"M 0 450 Q 200 250 400 450\"></path>\n                    <line x1=\"30\" y1=\"300\" x2=\"370\" y2=\"300\"></line>\n                    <!-- Markers -->\n                    <path d=\"M 65 300 L 75 300 M 70 295 L 70 305\"></path>\n                    <path d=\"M 325 300 L 335 300 M 330 295 L 330 305\"></path>\n                    <!-- Nodes -->\n                    <rect x=\"198\" y=\"198\" width=\"4\" height=\"4\" class=\"fill-white stroke-none opacity-80\"></rect>\n                    <rect x=\"198\" y=\"398\" width=\"4\" height=\"4\" class=\"fill-white stroke-none opacity-80\"></rect>\n                </svg>\n\n                <!-- Content -->\n                <header class=\"relative z-20 flex justify-between items-start\">\n                    <div class=\"flex items-center gap-2 text-zinc-100\">\n                        <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-lg\"></iconify-icon>\n                        <span class=\"font-serif text-sm tracking-wide\">Vectra</span>\n                    </div>\n                    <div class=\"flex gap-4\">\n                        <div class=\"text-right max-w-[140px]\">\n                            <p class=\"text-[10px] leading-tight text-zinc-400 font-light mix-blend-screen\">\n                                For enterprise leaders who refuse to navigate markets blindly. Vectra is the data analytics firm that transforms raw metrics into predictive models, empowering you to scale with clarity, not guesswork.\n            