   <div class=\"absolute right-[-2px] top-1/2 transform -translate-y-1/2 w-7 h-7 bg-[#E8E4DB] rounded-full z-10\"></div>\n                <div id=\"draggable-arrow\" class=\"absolute left-[-2px] top-1/2 transform -translate-y-1/2 w-7 h-7 bg-[#3D4A41] rounded-full flex items-center justify-center text-white shadow-md z-20 cursor-grab touch-none select-none\">\n                    <iconify-icon icon=\"solar:arrow-right-linear\" width=\"16\" stroke-width=\"1.5\" class=\"pointer-events-none\"></iconify-icon>\n                </div>\n            </div>\n\n            <!-- Inner Label Container -->\n            <div id=\"inner-label-container\" class=\"mx-5 mb-5 mt-2 p-8 relative overflow-hidden transition-all duration-500\"\n                 style=\"background: linear-gradient(#F4F2EB, #F4F2EB) padding-box, linear-gradient(to bottom right, #ffffff, #e0dcd0) border-box; border: 1px solid transparent; border-radius: 16px; min-height: 480px;\">\n\n                <!-- FRONT PANEL (Original Layout) -->\n                <div id=\"front-panel\" class=\"relative h-full flex flex-col\">\n                    <!-- Header -->\n                    <div class=\"flex items-start justify-between\">\n                        <h1 class=\"font-serif text-5xl font-medium tracking-tight text-stone-900 mask-reveal-front\">Lumina.</h1>\n                        <span class=\"text-xs font-medium text-stone-400 mt-2 mask-reveal-front\">®</span>\n                    </div>\n\n                    <!-- Product Badge -->\n                    <div class=\"mt-5 bg-stone-900 text-stone-50 rounded-full px-5 py-2.5 inline-flex items-center w-full\">\n                        <span class=\"text-sm font-medium mask-reveal-front\">Solid State Cologne - Sandalwood</span>\n                    </div>\n\n                    <!-- Description -->\n                    <div class=\"mt-6 space-y-3\">\n                        <p class=\"text-xs text-stone-800 leading-relaxed mask-reveal-front\">\n                            For external application. Apply desired amount to pulse points. Discontinue use if irritation develops. Store in a cool, dry environment away from direct light.\n                        </p>\n                        <p class=\"text-xs text-stone-800 font-medium leading-relaxed mask-reveal-front\">\n                            ** Notice: Formulation designed to interact with natural body chemistry for a bespoke olfactory experience. **\n                        </p>\n                    </div>\n\n                    <div class=\"w-full h-px bg-stone-300/60 my-5\"></div>\n\n                    <!-- Columns -->\n                    <div class=\"grid grid-cols-2 gap-6\">\n                        <!-- Ingredients -->\n                        <div>\n                            <h3 class=\"text-xs font-medium text-stone-900 mb-2 mask-reveal-front\">Base Formulation:</h3>\n                            <ul class=\"text-xs text-stone-600 leading-tight space-y-0.5 mask-reveal-front\">\n                                <li>Cera Alba (Beeswax)</li>\n                                <li>Simmondsia Chinensis</li>\n                                <li>Butyrospermum Parkii</li>\n                                <li>Santalum Album Oil</li>\n                                <li>Cedrus Atlantica</li>\n                                <li>Tocopherol (Vitamin E)</li>\n                                <li>Amyris Balsamifera</li>\n                                <li>Vetiveria Zizanioides</li>\n                                <li>Pogostemon Cablin</li>\n                                <li>Piper Nigrum Extract</li>\n                                <li>Citrus Aurantium</li>\n                                <li>Linalool (Natural)</li>\n                                <li>Farnesol (Trace)</li>\n                                <li>Plant-derived fixatives</li>\n                            </ul>\n                        </div>\n                        <!-- Claims -->\n                        <div>\n                            <h3 class=\"text-xs font-medium text-stone-900 mb-2 mask-reveal-front\">Performance Details:</h3>\n                            <div class=\"text-xs text-stone-600 leading-relaxed space-y-2 mask-reveal-front\">\n                                <p>Engineered without synthetic alcohols or aluminum compounds. Formulated using ethically sourced botanical extracts and natural waxes.</p>\n                                <p>Moisture-locking barrier properties adapt to skin temperature for sustained release.</p>\n                                <p>Dermatologically evaluated for sensitive profiles; independent clinical assessment verified.</p>\n                                <p>Provides concentrated fragrance dispersion without volatile carrier flash-off.</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"w-full h-px bg-stone-300/60 my-5 mt-auto\"></div>\n\n                    <!-- Footer -->\n                    <div class=\"flex justify-between items-end mt-2\">\n                        <div class=\"pr-4\">\n                            <p class=\"text-sm font-medium tracking-tight text-stone-900 mask-reveal-front\">Batch reference: L-2024-X</p>\n                            <div class=\"mt-2 text-xs text-stone-500 leading-tight mask-reveal-front\">\n                                <p>Formulated by Lumina Labs Inc.</p>\n                                <p>Distributed via primary channels.</p>\n                                <p>Seattle, WA 98101</p>\n                            </div>\n                        </div>\n\n                        <div class=\"flex items-center gap-3\">\n                            <!-- Cert Badge -->\n                            <div class=\"w-10 h-10 rounded-full border border-stone-400 flex items-center justify-center text-[0.4rem] font-medium uppercase text-center leading-none text-stone-600 transform -rotate-12 mask-reveal-front\">\