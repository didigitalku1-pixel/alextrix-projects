                     <div class=\"w-[calc(16.66%-1px)] h-[calc(16.66%-1px)] bg-stone-900\"></div><div class=\"w-[calc(16.66%-1px)] h-[calc(16.66%-1px)] bg-stone-100\"></div><div class=\"w-[calc(16.66%-1px)] h-[calc(16.66%-1px)] bg-stone-900\"></div><div class=\"w-[calc(16.66%-1px)] h-[calc(16.66%-1px)] bg-stone-100\"></div><div class=\"w-[calc(16.66%-1px)] h-[calc(16.66%-1px)] bg-stone-100\"></div><div class=\"w-[calc(16.66%-1px)] h-[calc(16.66%-1px)] bg-stone-900\"></div>\n                            </div>\n\n                            <!-- Barcode -->\n                            <div class=\"w-full relative h-16 flex items-end justify-between px-1\">\n                                <div class=\"w-[2px] h-[90%] bg-stone-900\"></div>\n                                <div class=\"w-[1px] h-full bg-stone-900\"></div>\n                                <div class=\"w-[3px] h-[90%] bg-stone-900\"></div>\n                                <div class=\"w-[2px] h-full bg-stone-900\"></div>\n                                <div class=\"w-[1px] h-[90%] bg-stone-900\"></div>\n                                <div class=\"w-[4px] h-full bg-stone-900\"></div>\n                                <div class=\"w-[2px] h-[90%] bg-stone-900\"></div>\n                                <div class=\"w-[1px] h-full bg-stone-900\"></div>\n                                <div class=\"w-[3px] h-[90%] bg-stone-900\"></div>\n                                <div class=\"w-[1px] h-full bg-stone-900\"></div>\n                                <div class=\"w-[2px] h-[90%] bg-stone-900\"></div>\n                                <div class=\"w-[1px] h-[90%] bg-stone-900\"></div>\n                                <span class=\"absolute -bottom-4 left-0 w-full text-xs tracking-widest text-center font-medium font-mono text-stone-700\">8 12345 67890 5</span>\n                            </div>\n\n                        </div>\n                    </div>\n\n                    <div class=\"w-full h-px bg-stone-300/60 my-5 mt-auto\"></div>\n                    <p class=\"text-xs text-stone-500 text-center font-medium mask-reveal-back pb-1\">Do not ingest. For olfactory enhancement purposes only. Scan code for complete batch diagnostics.</p>\n                </div>\n\n            </div>\n        </div>\n    </main>\n\n    <script>\n        // --- Drag to Cut Arrow Logic & Layout Transition ---\n        const arrow = document.getElementById('draggable-arrow');\n        const cutLine = document.getElementById('cut-line');\n        const container = document.querySelector('.package-container');\n\n        let isDragging = false;\n        let startX = 0;\n        let currentTransformX = 0;\n        let maxDrag = 0;\n        let hasOpened = false;\n\n        const initDrag = () => {\n            if(!hasOpened) maxDrag = container.offsetWidth - arrow.offsetWidth + 4;\n        };\n\n        const handleDragStart = (e) => {\n            if(hasOpened) return;\n            isDragging = true;\n            initDrag();\n            startX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;\n            arrow.style.transition = 'none';\n            cutLine.style.transition = 'none';\n            arrow.classList.remove('cursor-grab');\n            arrow.classList.add('cursor-grabbing');\n\n            const style = window.getComputedStyle(arrow);\n            const matrix = new DOMMatrixReadOnly(style.transform);\n            currentTransformX = matrix.m41;\n        };\n\n        const handleDragMove = (e) => {\n            if (!isDragging || hasOpened) return;\n            if (e.type === 'touchmove') e.preventDefault();\n\n            const clientX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;\n            const deltaX = clientX - startX;\n            let newX = currentTransformX + deltaX;\n\n            if (newX < 0) newX = 0;\n            if (newX > maxDrag) newX = maxDrag;\n\n            arrow.style.transform = `translate(${newX}px, -50%)`;\n            cutLine.style.width = `${newX + 14}px`;\n        };\n\n        const handleDragEnd = () => {\n            if (!isDragging || hasOpened) return;\n            isDragging = false;\n            arrow.classList.remove('cursor-grabbing');\n            arrow.classList.add('cursor-grab');\n\n            const style = window.getComputedStyle(arrow);\n            const matrix = new DOMMatrixReadOnly(style.transform);\n            const finalX = matrix.m41;\n\n            // Snap open and transition layout if dragged more than 80%\n            if (finalX > maxDrag * 0.8) {\n                hasOpened = true;\n                arrow.classList.remove('cursor-grab');\n\n                // Finish cut animation\n                arrow.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';\n                cutLine.style.transition = 'width 0.4s cubic-bezier(0.16, 1, 0.3, 1)';\n                arrow.style.transform = `translate(${maxDrag}px, -50%)`;\n                cutLine.style.width = `${maxDrag + 14}px`;\n\n                // Trigger Layout Split Sequence\n                setTimeout(() => {\n                    const tl = gsap.timeline();\n\n                    // Split the top lid & fade perforation\n                    tl.to(['#top-lid', '#perf-layer'], {\n                        y: -30,\n                        opacity: 0,\n                        duration: 0.6,\n                        ease: 'power2.inOut',\n                        stagger: 0.1\n                    }, 0);\n\n                    // Fade out front panel\n                    tl.to('#front-panel', {\n                        opacity: 0,\n                        y: -10,\n                        duration: 0.4,\n                        ease: 'power2.inOut'\n                    }, 0.2);\n\n                    // Swap DOM elements visually\n                    tl.add(() => {\n                        document.getElementById('top-lid').style.display = 'none';\n                        document.getElementById('perf-layer').style.display = 'none';\n                        document.getElementById('front-panel').style.display = 'none';\n\n                        const innerContainer = document.getElementById('inner-label-container');\n                        innerContainer.classList.remove('mt-2');\n                        innerContainer.classList.add('mt-8'); // compensate visual weight\n\n                        const backPanel = document.getElementById('back-panel');\n                        backPanel.classList.remove('hidden');\n                        backPanel.style.opacity = '0';\n                    });\n\n                    // Animate back panel in\n                    tl.fromTo('#back-panel',\n                        { opacity: 0, y: 20 },\n                        { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }\n                    );\n\n                    // Reveal back panel texts\n                    tl.add(() => {\n                        gsap.to('.mask-reveal-back .word-inner', {\n                            y: '0%',\n                            ease: 'power4.out',\n                            duration: 0.8,\n                            stagger: 0.015\n                        });\n                    }, \"-=0.3\");\n\n                }, 500);\n            } else {\n                // Snap back if not pulled enough\n                arrow.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';\n                cutLine.style.transition = 'width 0.4s cubic-bezier(0.16, 1, 0.3, 1)';\n                arrow.style.transform = `translate(0px, -50%)`;\n                cutLine.style.width = `0px`;\n            }\n        };\n\n        arrow.addEventListener('mousedown', handleDragStart);\n        document.addEventListener('mousemove', handleDragMove);\n        document.addEventListener('mouseup', handleDragEnd);\n\n        arrow.addEventListener('touchstart', handleDragStart, {passive: true});\n        document.addEventListener('touchmove', handleDragMove, {passive: false});\n        document.addEventListener('touchend', handleDragEnd);\n        window.addEventListener('resize', initDrag);\n\n        // --- Masked Reveal Staggered Word Animation ---\n        gsap.registerPlugin(ScrollTrigger);\n\n        const splitTextIntoWords = (element) => {\n            const text = element.innerText;\n            const words = text.split(' ');\n            element.innerHTML = '';\n\n            words.forEach(word => {\n                const wordContainer = document.createElement('span');\n                wordContainer.style.display = 'inline-block';\n                wordContainer.style.overflow = 'hidden';\n                wordContainer.style.verticalAlign = 'top';\n                wordContainer.style.marginRight = '0.25em';\n\n                const wordInner = document.createElement('span');\n                wordInner.style.display = 'inline-block';\n                wordInner.style.transform = 'translateY(110%)';\n                wordInner.classList.add('word-inner');\n                wordInner.innerText = word;\n\n                if(element.tagName.toLowerCase() === 'li') {\n                    wordContainer.style.marginRight = '0.15em';\n                }\n\n                wordContainer.appendChild(wordInner);\n                element.appendChild(wordContainer);\n            });\n            if(element.lastChild) element.lastChild.style.marginRight = '0';\n        };\n\n        // Initialize splits for both front and back\n        document.querySelectorAll('.mask-reveal-front, .mask-reveal-back').forEach(el => {\n            if(el.children.length === 0 || el.tagName.toLowerCase() === 'li') {\n                splitTextIntoWords(el);\n            } else if (el.tagName.toLowerCase() === 'div' && el.classList.contains('bg-stone-900')) {\n                const innerTextEl = el.querySelector('span');\n                if(innerTextEl) splitTextIntoWords(innerTextEl);\n                else {\n                    el.style.overflow = 'hidden';\n                    el.innerHTML = `<span class=\"word-inner block h-full w-full\" style=\"transform: translateY(110%)\">${el.innerHTML}</span>`;\n                }\n            } else {\n                 el.style.overflow = 'hidden';\n                 const content = el.innerHTML;\n                 el.innerHTML = `<div class=\"word-inner\" style=\"transform: translateY(110%)\">${content}</div>`;\n            }\n        });\n\n        // Only animate front panel on initial load\n        gsap.to('.mask-reveal-front .word-inner', {\n            y: '0%',\n            ease: 'power4.out',\n            duration: 1,\n            stagger: 0.015,\n            delay: 0.2,\n            scrollTrigger: {\n                trigger: '.package-container',\n                start: 'top 90%',\n            }\n        });\n\n        // --- WebGL Noise Background ---\n        const initWebGL = () => {\n            const canvas = document.getElementById('webgl-canvas');\n            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n            const scene = new THREE.Scene();\n            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n            camera.position.z = 1;\n\n            const geometry = new THREE.PlaneGeometry(10, 10);\n\n            const vertexShader = `\n                varying vec2 vUv;\n                void main() {\n                    vUv = uv;\n                    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n                }\n            `;\n\n            const fragmentShader = `\n                varying vec2 vUv;\n                uniform float uTime;\n\n                // 2D Random\n                float random (in vec2 st) {\n                    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);\n                }\n\n                // 2D Noise\n                float noise (in vec2 st) {\n                    vec2 i = floor(st);\n                    vec2 f = fract(st);\n                    float a = random(i);\n                    float b = random(i + vec2(1.0, 0.0));\n                    float c = random(i + vec2(0.0, 1.0));\n                    float d = random(i + vec2(1.0, 1.0));\n                    vec2 u = f * f * (3.0 - 2.0 * f);\n                    return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;\n                }\n\n                void main() {\n                    vec2 uv = vUv * 6.0;\n                    uv.y += uTime * 0.1;\n                    float n = noise(uv + uTime * 0.15);\n                    n += 0.5 * noise(uv * 2.0 - uTime * 0.05);\n                    n += 0.25 * noise(uv * 4.0 + uTime * 0.2);\n                    n /= 1.75;\n\n                    vec3 color1 = vec3(0.92, 0.90, 0.87);\n                    vec3 color2 = vec3(0.85, 0.82, 0.77);\n\n                    vec3 finalColor = mix(color1, color2, n);\n                    gl_FragColor = vec4(finalColor, 1.0);\n                }\n            `;\n\n            const material = new THREE.ShaderMaterial({\n                vertexShader,\n                fragmentShader,\n                uniforms: {\n                    uTime: { value: 0.0 }\n                },\n                wireframe: false\n            });\n\n            const mesh = new THREE.Mesh(geometry, material);\n            scene.add(mesh);\n\n            const clock = new THREE.Clock();\n\n            const animate = () => {\n                requestAnimationFrame(animate);\n                material.uniforms.uTime.value = clock.getElapsedTime();\n                renderer.render(scene, camera);\n            };\n\n            animate();\n\n            window.addEventListener('resize', () => {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            });\n        };\n\n        initWebGL();\n\n    </script>\n</body>\n</html>", "preview_file_name": "lumina-solid-cologne-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/lumina-solid-cologne-2.jpg", "source_name": "lumina-solid-cologne-2-DESIGN.md", "views": 138, "forks": 4, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-01T05:22:53.518001+00:00"}