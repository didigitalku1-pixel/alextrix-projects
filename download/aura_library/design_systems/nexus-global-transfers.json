tor('.reveal-card');\n            \n            gsap.fromTo(card, \n                { opacity: 0, x: 50, scale: 0.95 },\n                { \n                    opacity: 1, \n                    x: 0, \n                    scale: 1,\n                    duration: 1.5, \n                    ease: 'power3.out', \n                    delay: 0.4,\n                    onComplete: () => {\n                        gsap.to(\".floating-card\", {\n                            y: -15,\n                            rotationX: \"+=2\",\n                            rotationY: \"+=3\",\n                            duration: 4,\n                            yoyo: true,\n                            repeat: -1,\n                            ease: \"sine.inOut\",\n                            stagger: 0.15\n                        });\n                    }\n                }\n            );\n\n            // Slow looping animation for the wavy background lines\n            gsap.to(\".animated-line\", {\n                x: -30,\n                y: 30,\n                scale: 1.05,\n                transformOrigin: \"center center\",\n                duration: 10,\n                yoyo: true,\n                repeat: -1,\n                ease: \"sine.inOut\",\n                stagger: 1.5\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "Nexus---Global-Transfers (5).html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexus-global-transfers.jpg", "source_name": "Nexus---Global-Transfers-DESIGN.md", "views": 150, "forks": 7, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-28T16:25:09.0363+00:00", "updated_at": "2026-07-02T19:32:42.99004+00:00"}