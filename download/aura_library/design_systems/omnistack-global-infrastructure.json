ormal bg-[#1a5bfa]/5 w-fit px-2.5 py-1 rounded-md\">\n                        <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-emerald-500 text-sm\"></iconify-icon> Optimal • 2.1TB/s\n                    </div>\n                    <div class=\"flex justify-between items-end\">\n                        <div class=\"flex flex-col gap-0.5\">\n                            <p class=\"text-xs font-normal text-[#1a5bfa]/80 tracking-tight\">Region Gamma, Data</p>\n                        </div>\n                        <iconify-icon icon=\"solar:database-linear\" width=\"20\" stroke-width=\"1.5\" class=\"opacity-40\"></iconify-icon>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 4 (Glass Front) -->\n            <div class=\"w-full sm:w-[260px] h-[180px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[130px] lg:-mt-[90px] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] z-40 lg:rotate-[5deg] lg:translate-x-[10px] lg:translate-y-[15px] lg:group-hover:translate-x-[55%] lg:group-hover:translate-y-[0%] lg:group-hover:rotate-0 shadow-2xl\" style=\"background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.05) 100%); padding: 1px; border-radius: 16px;\">\n                <div class=\"bg-white/10 backdrop-blur-xl w-full h-full rounded-[15px] p-5 flex flex-col justify-between text-white\">\n                    <div>\n                        <h3 class=\"text-sm font-medium tracking-tight\">Julian Thorne</h3>\n                        <p class=\"text-xs font-extralight text-white/70 mt-1\">Threat Mitigation</p>\n                    </div>\n                    <div class=\"flex items-center gap-1.5 text-xs font-normal bg-white/10 w-fit px-2.5 py-1 rounded-md\">\n                        <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-emerald-400 text-sm\"></iconify-icon> Secure • 18k/min\n                    </div>\n                    <div class=\"flex justify-between items-end\">\n                        <div class=\"flex flex-col gap-0.5\">\n                            <p class=\"text-xs font-extralight text-white/80 tracking-tight\">Region Delta, WAF</p>\n                        </div>\n                        <iconify-icon icon=\"solar:shield-warning-linear\" width=\"20\" stroke-width=\"1.5\" class=\"opacity-50\"></iconify-icon>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 5 (White Front) -->\n            <div class=\"w-full sm:w-[260px] h-[180px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[130px] lg:-mt-[90px] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] z-50 lg:rotate-[-6deg] lg:translate-x-[-15px] lg:translate-y-[10px] lg:group-hover:-translate-x-[55%] lg:group-hover:translate-y-[110%] lg:group-hover:rotate-0 shadow-2xl\" style=\"background: linear-gradient(135deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.1) 100%); padding: 1px; border-radius: 16px;\">\n                <div class=\"bg-white w-full h-full rounded-[15px] p-5 flex flex-col justify-between text-[#1a5bfa]\">\n                    <div>\n                        <h3 class=\"text-sm font-medium tracking-tight\">Aria Hale</h3>\n                        <p class=\"text-xs font-light text-[#1a5bfa]/70 mt-1\">API Gateway</p>\n                    </div>\n                    <div class=\"flex items-center gap-1.5 text-xs font-normal bg-[#1a5bfa]/5 w-fit px-2.5 py-1 rounded-md\">\n                        <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-emerald-500 text-sm\"></iconify-icon> Optimal • 45k Conns\n                    </div>\n                    <div class=\"flex justify-between items-end\">\n                        <div class=\"flex flex-col gap-0.5\">\n                            <p class=\"text-xs font-normal text-[#1a5bfa]/80 tracking-tight\">Region Epsilon, Entry</p>\n                        </div>\n                        <iconify-icon icon=\"solar:monitor-smartphone-linear\" width=\"20\" stroke-width=\"1.5\" class=\"opacity-40\"></iconify-icon>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 6 (Glass Front) -->\n            <div class=\"w-full sm:w-[260px] h-[180px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[130px] lg:-mt-[90px] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] z-60 lg:rotate-[4deg] lg:translate-x-[5px] lg:translate-y-[-5px] lg:group-hover:translate-x-[55%] lg:group-hover:translate-y-[110%] lg:group-hover:rotate-0 shadow-2xl\" style=\"background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.05) 100%); padding: 1px; border-radius: 16px;\">\n                <div class=\"bg-white/10 backdrop-blur-xl w-full h-full rounded-[15px] p-5 flex flex-col justify-between text-white\">\n                    <div>\n                        <h3 class=\"text-sm font-medium tracking-tight\">Caleb Ren</h3>\n                        <p class=\"text-xs font-extralight text-white/70 mt-1\">Service Mesh</p>\n                    </div>\n                    <div class=\"flex items-center gap-1.5 text-xs font-normal bg-white/10 w-fit px-2.5 py-1 rounded-md\">\n                        <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-emerald-400 text-sm\"></iconify-icon> Optimal • < 1 Hop\n                    </div>\n                    <div class=\"flex justify-between items-end\">\n                        <div class=\"flex flex-col gap-0.5\">\n                            <p class=\"text-xs font-extralight text-white/80 tracking-tight\">Region Zeta, Routing</p>\n                        </div>\n                        <iconify-icon icon=\"solar:globus-linear\" width=\"20\" stroke-width=\"1.5\" class=\"opacity-50\"></iconify-icon>\n                    </div>\n                </div>\n            </div>\n\n        </section>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // GSAP Masked Word Reveal for the Left-Aligned Hero Title\n            const title = document.getElementById('hero-title');\n            if (title) {\n                const html = title.innerHTML;\n                title.innerHTML = '';\n                const lines = html.split(/<br\\s*\\/?>/i);\n\n                lines.forEach((line, index) => {\n                    const words = line.split(/\\s+/);\n                    words.forEach(word => {\n                        if(!word) return;\n\n                        const wrapper = document.createElement('span');\n                        wrapper.style.display = 'inline-block';\n                        wrapper.style.overflow = 'hidden';\n                        wrapper.style.verticalAlign = 'bottom';\n                        wrapper.style.paddingBottom = '0.1em';\n                        wrapper.style.marginBottom = '-0.1em';\n\n                        const inner = document.createElement('span');\n                        inner.innerHTML = word;\n                        inner.style.display = 'inline-block';\n                        inner.classList.add('reveal-word');\n\n                        wrapper.appendChild(inner);\n                        title.appendChild(wrapper);\n                        title.appendChild(document.createTextNode(' '));\n                    });\n\n                    if (index < lines.length - 1) {\n                        title.appendChild(document.createElement('br'));\n                    }\n                });\n\n                gsap.fromTo('.reveal-word',\n                    { y: '120%', opacity: 0, rotateZ: 4 },\n                    {\n                        y: '0%',\n                        opacity: 1,\n                        rotateZ: 0,\n                        duration: 1.2,\n                        ease: 'power4.out',\n                        stagger: 0.04,\n                        scrollTrigger: {\n                            trigger: '#hero-title',\n                            start: 'top 85%',\n                        }\n                    }\n                );\n            }\n\n            // GSAP Vertical Beam Animations\n            const beams = document.querySelectorAll('.v-beam');\n            if (beams.length > 0) {\n                gsap.fromTo(beams,\n                    { y: 0 },\n                    {\n                        y: window.innerHeight + 400,\n                        duration: 3,\n                        ease: \"linear\",\n                        repeat: -1,\n                        stagger: {\n                            each: 0.8,\n                            from: \"random\"\n                        }\n                    }\n                );\n            }\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "omnistack-global-infrastructure.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/omnistack-global-infrastructure.jpg", "source_name": "omnistack-global-infrastructure-DESIGN.md", "views": 317, "forks": 29, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T21:32:58.858931+00:00"}