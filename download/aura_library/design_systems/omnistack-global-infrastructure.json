olar:layers-linear\" width=\"24\" stroke-width=\"1.5\"></iconify-icon>\n                    OmniStack\n                </div>\n                <nav class=\"hidden lg:flex items-center gap-6 text-sm font-normal text-white/80 tracking-tight\">\n                    <a href=\"#\" class=\"hover:text-white transition-colors\">Architecture</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\">Integrations</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\">Telemetry</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\">Billing</a>\n                </nav>\n            </div>\n            <div class=\"flex items-center gap-4\">\n                <a href=\"#\" class=\"text-sm font-normal text-white/90 hover:text-white transition-colors hidden sm:block tracking-tight\">Authenticate</a>\n                <!-- Gradient Border Button -->\n                <div style=\"background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.1) 100%); padding: 1px; border-radius: 9999px;\">\n                    <a href=\"#\" class=\"bg-white text-[#1a5bfa] px-5 py-2 rounded-full font-medium text-xs tracking-tight inline-flex items-center justify-center transition-all hover:bg-white/90 shadow-lg\">\n                        Provision Now\n                    </a>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content: Two Column Layout -->\n    <main class=\"relative z-10 w-full max-w-[1400px] mx-auto px-6 md:px-12 flex-1 flex flex-col lg:flex-row items-center justify-between gap-16 pt-16 pb-24 lg:pt-24 lg:pb-32\">\n\n        <!-- Left Column: Hero Content -->\n        <section class=\"w-full lg:w-1/2 flex flex-col items-start text-left z-20 mt-8 lg:mt-0\">\n            <h1 id=\"hero-title\" class=\"text-4xl md:text-5xl lg:text-7xl font-medium tracking-tight leading-[1.1] mb-6 text-white\">\n                Architect the next web.<br>\n                Scale on OmniStack.<br>\n                Deploy globally.\n            </h1>\n\n            <p class=\"text-sm md:text-base text-white/80 max-w-lg mb-10 font-light leading-relaxed\">\n                An intelligent deployment mesh engineered for absolute performance. Push your repository, and our planetary edge network synchronizes it everywhere in milliseconds.\n            </p>\n\n            <div class=\"flex flex-wrap items-center gap-4\">\n                <!-- Gradient Border CTA -->\n                <div style=\"background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.1) 100%); padding: 1px; border-radius: 9999px; display: inline-block;\">\n                    <a href=\"#\" class=\"bg-white text-[#1a5bfa] px-8 py-3.5 rounded-full font-medium text-sm tracking-tight inline-flex items-center justify-center transition-all hover:bg-white/90 shadow-xl shadow-black/10\">\n                        Initialize Mesh\n                    </a>\n                </div>\n                <a href=\"#\" class=\"px-6 py-3.5 rounded-full font-normal text-sm tracking-tight text-white border border-white/20 hover:bg-white/5 transition-colors inline-flex items-center gap-2\">\n                    Explore API Docs <iconify-icon icon=\"solar:arrow-right-linear\" width=\"16\" stroke-width=\"1.5\"></iconify-icon>\n                </a>\n            </div>\n        </section>\n\n        <!-- Right Column: Interactive Stacking Cards -->\n        <section class=\"w-full lg:w-1/2 relative z-10 lg:min-h-[550px] flex flex-wrap lg:block justify-center gap-4 group\">\n\n            <!-- Card 1 (White Front) -->\n            <div class=\"w-full sm:w-[260px] h-[180px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[130px] lg:-mt-[90px] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] z-10 lg:rotate-[-4deg] lg:translate-x-[-10px] lg:translate-y-[5px] lg:group-hover:-translate-x-[55%] lg:group-hover:-translate-y-[110%] lg:group-hover:rotate-0 shadow-2xl\" style=\"background: linear-gradient(135deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.1) 100%); padding: 1px; border-radius: 16px;\">\n                <div class=\"bg-white w-full h-full rounded-[15px] p-5 flex flex-col justify-between text-[#1a5bfa]\">\n                    <div>\n                        <h3 class=\"text-sm font-medium tracking-tight\">Elena Rostova</h3>\n                        <p class=\"text-xs font-light text-[#1a5bfa]/70 mt-1\">Compute Layer</p>\n                    </div>\n                    <div class=\"flex items-center gap-1.5 text-xs font-normal bg-[#1a5bfa]/5 w-fit px-2.5 py-1 rounded-md\">\n                        <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-emerald-500 text-sm\"></iconify-icon> Optimal • 6ms\n                    </div>\n                    <div class=\"flex justify-between items-end\">\n                        <div class=\"flex flex-col gap-0.5\">\n                            <p class=\"text-xs font-normal text-[#1a5bfa]/80 tracking-tight\">Region Alpha, Core</p>\n                        </div>\n                        <iconify-icon icon=\"solar:server-minimalistic-linear\" width=\"20\" stroke-width=\"1.5\" class=\"opacity-40\"></iconify-icon>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Card 2 (Glass Front) -->\n            <div class=\"w-full sm:w-[260px] h-[180px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[130px] lg:-mt-[90px] transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] z-20 lg:rotate-[3deg] lg:translate-x-[15px] lg:translate-y-[-10px] lg:group-hover:translate-x-[55%] lg:group-hover:-translate-y-[110%] lg:group-hover:rotate-0 shadow-2xl\" style=\"background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.05) 100%); padding: 1px; border-radius: 16px;\">\n                <div class=\"bg-white/10 backdrop-blur-xl w-full h-full rounded-[15px] p-5 flex flex-col justify-between text-white\">\n          