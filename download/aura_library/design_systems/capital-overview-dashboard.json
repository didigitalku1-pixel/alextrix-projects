lassName = 'reveal-word';\n                    // Render the word along with a non-breaking space\n                    wordSpan.innerHTML = word + '&nbsp;'; \n                    \n                    wordContainer.appendChild(wordSpan);\n                    el.appendChild(wordContainer);\n                });\n\n                // Animate words from below \n                gsap.to(el.querySelectorAll('.reveal-word'), {\n                    y: '0%',\n                    ease: 'power4.out',\n                    duration: 1.2,\n                    stagger: 0.03,\n                    scrollTrigger: {\n                        trigger: el,\n                        start: 'top 95%',\n                        toggleActions: 'play none none none'\n                    }\n                });\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "Capital-Overview-Dashboard.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/capital-overview-dashboard.jpg", "source_name": "Capital-Overview-Dashboard-DESIGN.md", "views": 173, "forks": 11, "private": false, "featured": false, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T00:44:46.434433+00:00", "updated_at": "2026-07-03T00:43:47.032049+00:00"}