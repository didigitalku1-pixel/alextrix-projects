]\" style=\"clip-path: polygon(0 0, calc(100% - 23px) 0, 100% 23px, 100% 100%, 23px 100%, 0 calc(100% - 23px));\">\n\n          <div class=\"mb-5 overflow-hidden border border-white/[0.07] aspect-[16/9]\" style=\"clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);\">\n            <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/95d8c74e-6fe4-4d51-9390-853f5b39a219_3840w.jpg\" alt=\"Lawyer presenting oral arguments\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]\">\n          </div>\n\n          <div class=\"mt-auto\">\n            <h3 class=\"text-lg font-semibold text-white mb-3 tracking-tight uppercase transition-colors duration-300 group-hover:text-[#FF5500]\">Oral Arguments</h3>\n            <p class=\"text-xs leading-snug text-white/60 uppercase tracking-wider\">\n              Refine your narrative delivery, structural logic, and commanding professional presence.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Card 5 -->\n      <div class=\"md:col-span-3 relative h-[320px] md:h-[360px] group transition-transform duration-500 hover:-translate-y-1\" style=\"transition-delay: 200ms;\">\n        <div class=\"absolute inset-0 bg-white/[0.075] transition-colors duration-500 group-hover:bg-white/[0.10]\" style=\"clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px)); pointer-events: none;\"></div>\n        <div class=\"absolute inset-[1px] bg-[linear-gradient(180deg,#161616,#111111)] p-6 md:p-7 flex flex-col transition-colors duration-500 group-hover:bg-[linear-gradient(180deg,#181818,#121212)]\" style=\"clip-path: polygon(0 0, calc(100% - 23px) 0, 100% 23px, 100% 100%, 23px 100%, 0 calc(100% - 23px));\">\n\n          <div class=\"mb-5 overflow-hidden border border-white/[0.07] aspect-[16/9]\" style=\"clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);\">\n            <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/c750ae9a-d383-4f85-a342-87d0290b81a0_3840w.jpg\" alt=\"Legal team collaboration\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]\">\n          </div>\n\n          <div class=\"mt-auto\">\n            <h3 class=\"text-lg font-semibold text-white mb-3 tracking-tight uppercase transition-colors duration-300 group-hover:text-[#FF5500]\">Firm Synchronization</h3>\n            <p class=\"text-xs leading-snug text-white/60 uppercase tracking-wider\">\n              Elevate institutional memory and collaborative strategy via deep data analysis.\n            </p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </main>\n\n  <!-- Edge Grading Line Decor -->\n  <div class=\"absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#FF5500]/16 to-transparent pointer-events-none z-20\"></div>\n\n  <!-- Mask Reveal Script -->\n  <script>\n    setTimeout(() => {\n      document.querySelectorAll('#animated-headline > span > span').forEach(el => {\n        el.classList.remove('translate-y-[120%]');\n      });\n    }, 150);\n  </script>\n</body></html>", "preview_file_name": "legal-ai-use-cases-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/legal-ai-use-cases-2.jpg", "source_name": "legal-ai-use-cases-2-DESIGN.md", "views": 99, "forks": 4, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T06:13:20.21304+00:00"}