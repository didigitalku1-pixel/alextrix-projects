<div class=\"absolute inset-0 bg-blue-600/20 mix-blend-color z-0\"></div>\n                </div>\n\n                <!-- Overlapping Floating Card with Skeuomorphism & Diagonal Corners -->\n                <div class=\"absolute bottom-0 lg:bottom-12 left-0 lg:left-[-10%] w-[90%] max-w-[380px] bg-gradient-to-b from-[#3b1763]/95 to-[#1e0836]/95 backdrop-blur-md border-t border-l border-white/20 border-b border-r border-black/60 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2),inset_0_-2px_8px_rgba(0,0,0,0.7),0_20px_40px_rgba(0,0,0,0.8)] transition-transform duration-500 hover:-translate-y-2 group z-30 flex flex-col\" style=\"clip-path: polygon(0 0, 100% 0, 100% calc(100% - 2rem), calc(100% - 2rem) 100%, 0 100%);\">\n\n                    <!-- Card Header -->\n                    <div class=\"px-6 py-4 border-b border-black/50 bg-white/5 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]\">\n                        <span class=\"text-xs text-fuchsia-300 uppercase tracking-widest font-semibold drop-shadow-[0_1px_1px_rgba(0,0,0,0.8)]\">High-Value Asset</span>\n                    </div>\n\n                    <!-- Card Body -->\n                    <div class=\"p-6\">\n                        <h3 class=\"text-2xl text-white mb-6 tracking-tight drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]\" style=\"font-family: 'Syncopate', sans-serif;\">\n                            // NEURAL_CORE_V9 //\n                        </h3>\n\n                        <!-- Player/Faction Info -->\n                        <div class=\"mb-6\">\n                            <span class=\"text-xs text-white/50 block mb-2 uppercase tracking-wider\">Syndicate Origin</span>\n                            <div class=\"flex items-center gap-3\">\n                                <div class=\"w-10 h-10 relative flex items-center justify-center border border-fuchsia-500/50 bg-gradient-to-b from-white/10 to-black/40 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2),inset_0_-1px_2px_rgba(0,0,0,0.5)] rotate-[30deg]\">\n                                    <iconify-icon icon=\"solar:hexagon-linear\" class=\"text-fuchsia-400 absolute text-3xl -rotate-[30deg]\" stroke-width=\"1.5\"></iconify-icon>\n                                    <div class=\"w-1.5 h-1.5 bg-fuchsia-400 rounded-full -rotate-[30deg] shadow-[0_0_5px_#e879f9]\"></div>\n                                </div>\n                                <span class=\"text-sm text-white font-semibold tracking-wider drop-shadow-md\">NEX-77B</span>\n                            </div>\n                        </div>\n\n                        <!-- Divider -->\n                        <div class=\"h-[1px] w-full bg-gradient-to-r from-white/20 via-white/5 to-transparent mb-4 shadow-[0_1px_0_rgba(0,0,0,0.5)]\"></div>\n\n                        <!-- Stats -->\n                        <div class=\"mb-8\">\n                            <span class=\"text-xs text-white/50 block mb-1 uppercase tracking-wider\">Extraction Yield</span>\n                            <div class=\"flex items-baseline gap-2 drop-shadow-md\">\n                                <span class=\"text-2xl font-semibold text-white\">820</span>\n                                <span class=\"text-sm text-white/50\">CRX</span>\n                                <span class=\"text-lg text-fuchsia-400 font-semibold ml-2\">$18,400</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Split CTA Button Skeuomorphic -->\n                    <div class=\"flex w-full h-14 mt-auto border-t border-black/60\">\n                        <button class=\"flex-1 bg-gradient-to-b from-[#a855f7] to-[#7e22ce] text-white font-semibold text-sm uppercase tracking-wider flex items-center justify-center hover:brightness-110 transition-all shadow-[inset_0_1px_2px_rgba(255,255,255,0.4),inset_0_-2px_4px_rgba(0,0,0,0.4)] text-shadow-sm border-r border-black/40\">\n                            Deploy Unit\n                        </button>\n                        <button class=\"w-16 bg-gradient-to-b from-gray-200 to-gray-400 text-black flex items-center justify-center hover:brightness-110 transition-all shadow-[inset_0_1px_2px_rgba(255,255,255,0.9),inset_0_-2px_4px_rgba(0,0,0,0.3)]\">\n                            <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-xl drop-shadow-sm\" stroke-width=\"1.5\"></iconify-icon>\n                        </button>\n                    </div>\n                </div>\n\n            </div>\n        </main>\n    </div>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Staggered word reveal mapped to scroll trigger\n            gsap.to(\".reveal-inner\", {\n                scrollTrigger: {\n                    trigger: \"#hero-headline\",\n                    start: \"top 85%\",\n                    toggleActions: \"play none none reverse\"\n                },\n                y: \"0%\",\n                duration: 1.2,\n                stagger: 0.15,\n                ease: \"power4.out\"\n            });\n\n            // Fade in other elements\n            gsap.to(\".reveal-fade\", {\n                scrollTrigger: {\n                    trigger: \"#hero-headline\",\n                    start: \"top 75%\",\n                },\n                opacity: 1,\n                y: 0,\n                duration: 1,\n                stagger: 0.2,\n                ease: \"power3.out\"\n            });\n\n            // Replace CSS Keyframes with GSAP\n            gsap.to(\".scanline\", {\n                y: \"100vh\",\n                duration: 8,\n                ease: \"none\",\n                repeat: -1\n            });\n\n            gsap.to(\".float-slow\", {\n                y: -15,\n                x: 5,\n                duration: 4,\n                ease: \"sine.inOut\",\n                yoyo: true,\n                repeat: -1\n            });\n\n            gsap.to(\".pulse-glow\", {\n                opacity: 0.6,\n                scale: 1.05,\n                duration: 3,\n                ease: \"sine.inOut\",\n                yoyo: true,\n                repeat: -1\n            });\n\n            // Parallax on card container based on mouse move\n            const rightCol = document.getElementById('parallax-container');\n            if(rightCol) {\n                document.addEventListener('mousemove', (e) => {\n                    const x = (e.clientX / window.innerWidth - 0.5) * 20;\n                    const y = (e.clientY / window.innerHeight - 0.5) * 20;\n                    gsap.to(rightCol, {\n                        x: x,\n                        y: y,\n                        duration: 1,\n                        ease: \"power2.out\"\n                    });\n                });\n            }\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "synth-vanguard-breach-the-cyber-nexus.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/synth-vanguard-breach-the-cyber-nexus.jpg", "source_name": "synth-vanguard-breach-the-cyber-nexus-DESIGN.md", "views": 62, "forks": 0, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-02T17:21:59.025386+00:00"}