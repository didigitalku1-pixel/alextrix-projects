ded-[24px] flex items-center justify-center border border-neutral-800 shadow-[0_0_40px_rgba(226,200,84,0.05)] mb-5\">\n                        <iconify-icon icon=\"solar:programming-broken\" width=\"40\" class=\"text-white\" stroke-width=\"1.5\"></iconify-icon>\n                    </div>\n                    <p class=\"text-xs text-neutral-500 mb-1\">Aura Sync</p>\n                    <h2 class=\"text-2xl text-white font-medium tracking-tight mb-4 reveal-text\">Creative<br>Technologist</h2>\n                    <div class=\"flex gap-2 justify-center\">\n                        <span class=\"px-3 py-1 bg-[#121212] border border-neutral-800 rounded-full text-[10px] text-neutral-400\">Full-time</span>\n                        <span class=\"px-3 py-1 bg-[#121212] border border-neutral-800 rounded-full text-[10px] text-neutral-400\">Distributed</span>\n                    </div>\n                </div>\n\n                <!-- Stats Grid -->\n                <div class=\"grid grid-cols-2 gap-3\">\n                    <div class=\"bg-[#121212] border border-neutral-800/50 rounded-[20px] p-4 flex flex-col items-center text-center gap-2\">\n                        <div class=\"text-neutral-500\"><iconify-icon icon=\"solar:user-rounded-broken\" width=\"20\"></iconify-icon></div>\n                        <span class=\"text-[10px] text-neutral-500\">Level</span>\n                        <span class=\"text-xs text-white\">Staff / Principal</span>\n                    </div>\n                    <div class=\"bg-[#121212] border border-neutral-800/50 rounded-[20px] p-4 flex flex-col items-center text-center gap-2\">\n                        <div class=\"text-neutral-500\"><iconify-icon icon=\"solar:case-broken\" width=\"20\"></iconify-icon></div>\n                        <span class=\"text-[10px] text-neutral-500\">Format</span>\n                        <span class=\"text-xs text-white\">100% Remote</span>\n                    </div>\n                    <div class=\"bg-[#121212] border border-neutral-800/50 rounded-[20px] p-4 flex flex-col items-center text-center gap-2\">\n                        <div class=\"text-neutral-500\"><iconify-icon icon=\"solar:wallet-money-broken\" width=\"20\"></iconify-icon></div>\n                        <span class=\"text-[10px] text-neutral-500\">Compensation</span>\n                        <span class=\"text-xs text-white\">$8k - $12k</span>\n                    </div>\n                    <div class=\"bg-[#121212] border border-neutral-800/50 rounded-[20px] p-4 flex flex-col items-center text-center gap-2\">\n                        <div class=\"text-neutral-500\"><iconify-icon icon=\"solar:map-point-broken\" width=\"20\"></iconify-icon></div>\n                        <span class=\"text-[10px] text-neutral-500\">Timezone</span>\n                        <span class=\"text-xs text-white\">EST / GMT</span>\n                    </div>\n                </div>\n\n                <!-- Content Area -->\n                <div class=\"flex flex-col gap-4\">\n                    <!-- Tabs -->\n                    <div class=\"flex gap-4 border-b border-neutral-800 pb-2\">\n                        <button class=\"text-xs font-medium text-[#E2C854] relative after:absolute after:bottom-[-9px] after:left-0 after:w-full after:h-0.5 after:bg-[#E2C854] after:rounded-t-full\">Parameters</button>\n                        <button class=\"text-xs font-medium text-neutral-500 hover:text-white transition-colors\">Enterprise</button>\n                        <button class=\"text-xs font-medium text-neutral-500 hover:text-white transition-colors\">Prerequisites</button>\n                    </div>\n\n                    <div class=\"flex flex-col gap-3 mt-2\">\n                        <h3 class=\"text-sm text-white font-medium reveal-text\">About the Protocol</h3>\n                        <p class=\"text-[13px] leading-relaxed text-neutral-400 reveal-text\">\n                            We are seeking a polymath builder to bridge the gap between abstract design systems and functional code structures. You will be orchestrating high-fidelity interfaces that demand both rigorous engineering and deep aesthetic sensibility.\n                        </p>\n                        <p class=\"text-[13px] leading-relaxed text-neutral-400 reveal-text\">\n                            Expect to work heavily with procedural generation, micro-interactions, and performant rendering techniques. If you obsess over bezier curves and memory leaks equally, this node is for you.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Sticky CTA -->\n            <div class=\"absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A] to-transparent pt-12 z-20\">\n                <button class=\"w-full h-14 bg-[#E2C854] hover:bg-white text-black rounded-[20px] text-sm font-medium transition-colors flex items-center justify-between px-6 group\">\n                    <span>Initialize Protocol</span>\n                    <div class=\"w-8 h-8 rounded-full bg-black/10 flex items-center justify-center group-hover:bg-black/20 transition-colors\">\n                        <iconify-icon icon=\"solar:arrow-right-broken\" width=\"18\"></iconify-icon>\n                    </div>\n                </button>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        // 1. Flashlight Effect Logic\n        document.querySelectorAll('.flashlight-card').forEach(card => {\n            card.addEventListener('mousemove', (e) => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n\n                const cx = rect.width / 2;\n                const cy = rect.height / 2;\n\n                const dx = x - cx;\n                const dy = y - cy;\n\n                // Calculate angle for conic gradient\n                const angle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;\n\n                // Calculate proximity to edge (normalized 0 to 100)\n                // 100 is at the very edge, 0 is at the exact center\n                const distanceX = Math.abs(dx) / cx;\n                const distanceY = Math.abs(dy) / cy;\n                const distance = Math.max(distanceX, distanceY);\n                const proximity = Math.min(Math.max(distance * 100, 0), 100);\n\n                card.style.setProperty('--cursor-angle', `${angle}deg`);\n                card.style.setProperty('--proximity', proximity);\n            });\n\n            card.addEventListener('mouseleave', () => {\n                // Fade out when leaving\n                card.style.setProperty('--proximity', 0);\n            });\n        });\n\n        // 2. GSAP Staggered Word Reveal\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            const revealElements = document.querySelectorAll('.reveal-text');\n\n            revealElements.forEach(element => {\n                // Split text into words (handling <br> tags carefully)\n                let html = element.innerHTML;\n                let newHtml = '';\n\n                // Simple split by space, but preserve <br>\n                const parts = html.split(/(<br>|\\s+)/);\n\n                parts.forEach(part => {\n                    if(part === '<br>') {\n                        newHtml += part;\n                    } else if (part.trim() !== '') {\n                        newHtml += `<span class=\"reveal-word\"><span class=\"reveal-word-inner\">${part}</span></span> `;\n                    } else {\n                        newHtml += part;\n                    }\n                });\n\n                element.innerHTML = newHtml;\n\n                const innerWords = element.querySelectorAll('.reveal-word-inner');\n\n                gsap.to(innerWords, {\n                    scrollTrigger: {\n                        trigger: element,\n                        start: \"top 95%\", // trigger when element is 95% down the viewport\n                        toggleActions: \"play none none none\"\n                    },\n                    y: \"0%\",\n                    ease: \"power4.out\",\n                    duration: 0.8,\n                    stagger: 0.04\n                });\n            });\n        });\n    </script>\n\n</body></html>", "preview_file_name": "aura-careers-mobile-flow.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/aura-careers-mobile-flow.jpg", "source_name": "aura-careers-mobile-flow-DESIGN.md", "views": 170, "forks": 9, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-01T11:35:06.812421+00:00"}