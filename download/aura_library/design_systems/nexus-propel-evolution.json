 milliseconds.\n            </p>\n        </div>\n\n        <!-- Logo -->\n        <div class=\"absolute bottom-8 left-8 lg:bottom-12 lg:left-24 xl:left-32 flex items-center gap-3 text-[#D8E4DC]\">\n            <iconify-icon icon=\"solar:infinity-linear\" width=\"24\" height=\"24\"></iconify-icon>\n            <span class=\"font-['Instrument_Serif',serif] text-2xl tracking-tight font-normal\">Nexus</span>\n        </div>\n    </main>\n\n    <!-- Right Section: Interactive UI -->\n    <aside class=\"relative z-10 w-full lg:w-1/2 min-h-[50vh] lg:min-h-screen flex items-center justify-center p-4 lg:p-12 bg-transparent\">\n\n        <!-- Background Panel for Accordion -->\n        <div class=\"relative w-full max-w-lg bg-[#2D483A]/90 backdrop-blur-md rounded-[2rem] p-6 lg:p-10 shadow-2xl border border-[#3A5A49]/50\">\n\n            <div class=\"flex flex-col gap-3 w-full divide-y divide-[#3A5A49]/30\" id=\"accordion-container\">\n\n                <!-- Accordion Item 1 -->\n                <div class=\"accordion-item bg-[#E3EFE7] rounded-2xl overflow-hidden cursor-pointer transition-colors duration-300 pt-2\" data-expanded=\"true\">\n                    <div class=\"p-5 lg:p-6\">\n                        <div class=\"flex justify-between items-start w-full\">\n                            <div class=\"icon-title-container flex flex-col items-start gap-4 transition-all duration-500\">\n                                <div class=\"p-2 bg-[#D6E6DC] rounded-full icon-bg transition-colors duration-300\">\n                                    <iconify-icon icon=\"solar:routing-2-linear\" width=\"22\" height=\"22\" class=\"text-[#1A2E23]\"></iconify-icon>\n                                </div>\n                                <h3 class=\"font-['Instrument_Serif',serif] text-xl lg:text-2xl text-[#1A2E23] tracking-tight font-normal\">Optimized Resource Pathways</h3>\n                            </div>\n                            <button class=\"p-2 text-[#1A2E23] transition-transform duration-500 chevron rotate-180\">\n                                <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"20\" height=\"20\"></iconify-icon>\n                            </button>\n                        </div>\n\n                        <div class=\"accordion-content grid grid-rows-[1fr] transition-all duration-500 opacity-100 mt-4\">\n                            <div class=\"overflow-hidden border-t border-[#1A2E23]/10 pt-4\">\n                                <p class=\"font-['Geist',sans-serif] text-xs text-[#304D3F] leading-relaxed max-w-[90%] font-light\">\n                                    Advanced routing algorithms that minimize latency and reduce overhead across decentralized networks, maximizing returns for institutional actors.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Accordion Item 2 -->\n                <div class=\"accordion-item bg-[#D6E6DC] hover:bg-[#E3EFE7] rounded-2xl overflow-hidden cursor-pointer transition-colors duration-300 mt-3 pt-2\" data-expanded=\"false\">\n                    <div class=\"p-5 lg:p-6\">\n                        <div class=\"flex justify-between items-start w-full\">\n                            <div class=\"icon-title-container flex flex-row items-center gap-4 transition-all duration-500\">\n                                <div class=\"p-2 bg-[#C8DACF] rounded-full icon-bg transition-colors duration-300\">\n                                    <iconify-icon icon=\"solar:shield-keyhole-linear\" width=\"22\" height=\"22\" class=\"text-[#1A2E23]\"></iconify-icon>\n                                </div>\n                                <h3 class=\"font-['Instrument_Serif',serif] text-xl lg:text-2xl text-[#1A2E23] tracking-tight font-normal\">Verifiable Security</h3>\n                            </div>\n                            <button class=\"p-2 text-[#1A2E23] transition-transform duration-500 chevron\">\n                                <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"20\" height=\"20\"></iconify-icon>\n                            </button>\n                        </div>\n\n                        <div class=\"accordion-content grid grid-rows-[0fr] transition-all duration-500 opacity-0 mt-0\">\n                            <div class=\"overflow-hidden border-t border-[#1A2E23]/10 pt-0 transition-all duration-500\">\n                                <p class=\"font-['Geist',sans-serif] text-xs text-[#304D3F] leading-relaxed max-w-[90%] mt-4 font-light\">\n                                    Provable state transitions that ensure total operational transparency without relying on centralized trust mechanisms.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Accordion Item 3 -->\n                <div class=\"accordion-item bg-[#D6E6DC] hover:bg-[#E3EFE7] rounded-2xl overflow-hidden cursor-pointer transition-colors duration-300 mt-3 pt-2\" data-expanded=\"false\">\n                    <div class=\"p-5 lg:p-6\">\n                        <div class=\"flex justify-between items-start w-full\">\n                            <div class=\"icon-title-container flex flex-row items-center gap-4 transition-all duration-500\">\n                                <div class=\"p-2 bg-[#C8DACF] rounded-full icon-bg transition-colors duration-300\">\n                                    <iconify-icon icon=\"solar:box-minimalistic-linear\" width=\"22\" height=\"22\" class=\"text-[#1A2E23]\"></iconify-icon>\n                                </div>\n                                <h3 class=\"font-['Instrument_Serif',serif] text-xl lg:text-2xl text-[#1A2E23] tracking-tight font-normal\">Modular Architecture</h3>\n                            </div>\n                            <button class=\"p-2 text-[#1A2E23] transition-transform duration-500 chevron\">\n                                <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"20\" height=\"20\"></iconify-icon>\n                            </button>\n                        </div>\n\n                        <div class=\"accordion-content grid grid-rows-[0fr] transition-all duration-500 opacity-0 mt-0\">\n                            <div class=\"overflow-hidden border-t border-[#1A2E23]/10 pt-0 transition-all duration-500\">\n                                <p class=\"font-['Geist',sans-serif] text-xs text-[#304D3F] leading-relaxed max-w-[90%] mt-4 font-light\">\n                                    Deploy custom logic and integrate seamlessly with existing infrastructure using our comprehensive suite of developer tools and APIs.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Accordion Item 4 -->\n                <div class=\"accordion-item bg-[#D6E6DC] hover:bg-[#E3EFE7] rounded-2xl overflow-hidden cursor-pointer transition-colors duration-300 mt-3 pt-2\" data-expanded=\"false\">\n                    <div class=\"p-5 lg:p-6\">\n                        <div class=\"flex justify-between items-start w-full\">\n                            <div class=\"icon-title-container flex flex-row items-center gap-4 transition-all duration-500\">\n                                <div class=\"p-2 bg-[#C8DACF] rounded-full icon-bg transition-colors duration-300\">\n                                    <iconify-icon icon=\"solar:scale-linear\" width=\"22\" height=\"22\" class=\"text-[#1A2E23]\"></iconify-icon>\n                                </div>\n                                <h3 class=\"font-['Instrument_Serif',serif] text-xl lg:text-2xl text-[#1A2E23] tracking-tight font-normal\">Native Compliance</h3>\n                            </div>\n                            <button class=\"p-2 text-[#1A2E23] transition-transform duration-500 chevron\">\n                                <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"20\" height=\"20\"></iconify-icon>\n                            </button>\n                        </div>\n\n                        <div class=\"accordion-content grid grid-rows-[0fr] transition-all duration-500 opacity-0 mt-0\">\n                            <div class=\"overflow-hidden border-t border-[#1A2E23]/10 pt-0 transition-all duration-500\">\n                                <p class=\"font-['Geist',sans-serif] text-xs text-[#304D3F] leading-relaxed max-w-[90%] mt-4 font-light\">\n                                    Built-in policy enforcement that allows for automated regulatory checks and reporting, streamlining institutional adoption.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </aside>\n\n    <script>\n        // --- Accordion Logic ---\n        const items = document.querySelectorAll('.accordion-item');\n\n        items.forEach(item => {\n            item.addEventListener('click', () => {\n                const isExpanded = item.getAttribute('data-expanded') === 'true';\n\n                // Collapse all\n                items.forEach(i => {\n                    i.setAttribute('data-expanded', 'false');\n                    i.classList.remove('bg-[#E3EFE7]');\n                    i.classList.add('bg-[#D6E6DC]');\n\n                    const content = i.querySelector('.accordion-content');\n                    const iconContainer = i.querySelector('.icon-title-container');\n                    const chevron = i.querySelector('.chevron');\n                    const iconBg = i.querySelector('.icon-bg');\n                    const innerBorder = i.querySelector('.accordion-content > div');\n\n                    // Animate out\n                    content.classList.remove('grid-rows-[1fr]', 'opacity-100', 'mt-4');\n                    content.classList.add('grid-rows-[0fr]', 'opacity-0', 'mt-0');\n                    innerBorder.classList.remove('pt-4');\n                    innerBorder.classList.add('pt-0');\n\n                    // Reset layout to row\n                    iconContainer.classList.remove('flex-col', 'items-start');\n                    iconContainer.classList.add('flex-row', 'items-center');\n\n                    chevron.classList.remove('rotate-180');\n                    if(iconBg) {\n                        iconBg.classList.remove('bg-[#D6E6DC]');\n                        iconBg.classList.add('bg-[#C8DACF]');\n                    }\n                });\n\n                // Expand clicked if it wasn't already expanded\n                if (!isExpanded) {\n                    item.setAttribute('data-expanded', 'true');\n                    item.classList.remove('bg-[#D6E6DC]');\n                    item.classList.add('bg-[#E3EFE7]');\n\n                    const content = item.querySelector('.accordion-content');\n                    const iconContainer = item.querySelector('.icon-title-container');\n                    const chevron = item.querySelector('.chevron');\n                    const iconBg = item.querySelector('.icon-bg');\n                    const innerBorder = item.querySelector('.accordion-content > div');\n\n                    // Animate in\n                    content.classList.remove('grid-rows-[0fr]', 'opacity-0', 'mt-0');\n                    content.classList.add('grid-rows-[1fr]', 'opacity-100', 'mt-4');\n                    innerBorder.classList.remove('pt-0');\n                    innerBorder.classList.add('pt-4');\n\n                    // Change layout to column\n                    iconContainer.classList.remove('flex-row', 'items-center');\n                    iconContainer.classList.add('flex-col', 'items-start');\n\n                    chevron.classList.add('rotate-180');\n                    if(iconBg) {\n                        iconBg.classList.remove('bg-[#C8DACF]');\n                        iconBg.classList.add('bg-[#D6E6DC]');\n                    }\n                }\n            });\n        });\n\n        // --- WebGL-inspired Waves, Particles & Beams Animation ---\n        const canvas = document.getElementById('webgl-lines');\n        const ctx = canvas.getContext('2d');\n        let width, height, waves = [], particles = [], beams = [];\n\n        function initCanvas() {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n            waves = []; particles = []; beams = [];\n\n            // Initialize Waves\n            for (let i = 0; i < 6; i++) {\n                waves.push({\n                    yOffset: height * 0.2 + (height * 0.6 / 5) * i,\n                    amplitude: 30 + Math.random() * 60,\n                    frequency: 0.001 + Math.random() * 0.002,\n                    phase: Math.random() * Math.PI * 2,\n                    speed: 0.002 + Math.random() * 0.004\n                });\n            }\n\n            // Initialize Particles\n            for (let i = 0; i < 70; i++) {\n                particles.push({\n                    x: Math.random() * width,\n                    y: Math.random() * height,\n                    vx: (Math.random() - 0.5) * 0.4,\n                    vy: (Math.random() - 0.5) * 0.4,\n                    size: Math.random() * 1.5 + 0.5\n                });\n            }\n\n            // Initialize Shooting Beams\n            for (let i = 0; i < 4; i++) {\n                beams.push({\n                    waveIndex: Math.floor(Math.random() * waves.length),\n                    progress: Math.random() * width,\n                    speed: 3 + Math.random() * 5,\n                    length: 80 + Math.random() * 150\n                });\n            }\n        }\n\n        window.addEventListener('resize', initCanvas);\n        initCanvas();\n\n        let time = 0;\n        function animateCanvas() {\n            ctx.clearRect(0, 0, width, height);\n\n            // Draw Waves\n            ctx.lineWidth = 1;\n            waves.forEach((wave, index) => {\n                ctx.beginPath();\n                ctx.strokeStyle = `rgba(94, 139, 111, ${0.15 + index * 0.05})`;\n                for (let x = 0; x <= width; x += 15) {\n                    const y = wave.yOffset + Math.sin(x * wave.frequency + time * wave.speed + wave.phase) * wave.amplitude;\n                    x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);\n                }\n                ctx.stroke();\n            });\n\n            // Draw Beams (Shooting Lines)\n            ctx.lineWidth = 2;\n            ctx.strokeStyle = 'rgba(216, 228, 220, 0.9)';\n            beams.forEach(beam => {\n                const wave = waves[beam.waveIndex];\n                if (!wave) return;\n\n                ctx.beginPath();\n                for (let x = beam.progress; x <= beam.progress + beam.length; x += 10) {\n                    if (x < 0 || x > width) continue;\n                    const y = wave.yOffset + Math.sin(x * wave.frequency + time * wave.speed + wave.phase) * wave.amplitude;\n                    x === beam.progress ? ctx.moveTo(x, y) : ctx.lineTo(x, y);\n                }\n                ctx.stroke();\n\n                beam.progress += beam.speed;\n                if (beam.progress > width) {\n                    beam.progress = -beam.length;\n                    beam.waveIndex = Math.floor(Math.random() * waves.length);\n                }\n            });\n\n            // Draw Particles\n            ctx.fillStyle = 'rgba(139, 168, 150, 0.6)';\n            particles.forEach(p => {\n                p.x += p.vx;\n                p.y += p.vy;\n\n                if (p.x < 0) p.x = width;\n                if (p.x > width) p.x = 0;\n                if (p.y < 0) p.y = height;\n                if (p.y > height) p.y = 0;\n\n                ctx.beginPath();\n                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n                ctx.fill();\n            });\n\n            time += 1;\n            requestAnimationFrame(animateCanvas);\n        }\n\n        animateCanvas();\n    </script>\n</body>\n</html>", "preview_file_name": "nexus-propel-evolution.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexus-propel-evolution.jpg", "source_name": "nexus-propel-evolution-DESIGN.md", "views": 86, "forks": 1, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T15:08:25.290404+00:00"}