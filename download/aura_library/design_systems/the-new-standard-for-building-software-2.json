x] text-neutral-500 font-mono\">ORD-184</div>\n                                    <div class=\"flex-1 text-xs font-medium text-neutral-200\">\n                                        Fix dark mode regression\n                                    </div>\n                                    <div class=\"w-32 flex items-center\">\n                                        <div class=\"flex items-center gap-1.5 text-[11px] font-medium text-red-400\">\n                                            <iconify-icon icon=\"solar:danger-triangle-linear\" width=\"14\" height=\"14\"></iconify-icon>\n                                            High\n                                        </div>\n                                    </div>\n                                    <div class=\"w-32 flex items-center\">\n                                        <div class=\"flex items-center gap-1.5 text-[11px] font-medium text-neutral-400\">\n                                            <div class=\"w-2 h-2 rounded-full border border-neutral-500\"></div>\n                                            Todo\n                                        </div>\n                                    </div>\n                                    <div class=\"w-16 flex justify-end\">\n                                        <div class=\"w-5 h-5 rounded-full border border-neutral-600 border-dashed text-neutral-500 flex items-center justify-center text-[10px]\">?</div>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- Floating Command Palette Overlay -->\n                            <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 bg-[#1a1a1a]/95 backdrop-blur-md rounded-xl border border-white/10 shadow-2xl p-[1px] z-30\">\n                                <div class=\"bg-[#141414] rounded-[11px] overflow-hidden\">\n                                    <div class=\"flex items-center px-3 py-2 border-b border-white/10\">\n                                        <iconify-icon icon=\"solar:magnifer-linear\" width=\"16\" height=\"16\" class=\"text-neutral-500 mr-2\"></iconify-icon>\n                                        <input type=\"text\" placeholder=\"Search issues...\" class=\"bg-transparent border-none outline-none text-sm text-neutral-200 w-full placeholder:text-neutral-600\">\n                                        <div class=\"flex gap-1 ml-2\">\n                                            <span class=\"px-1.5 py-0.5 rounded bg-white/10 border border-white/5 text-[9px] text-neutral-400 font-mono\">⌘</span>\n                                            <span class=\"px-1.5 py-0.5 rounded bg-white/10 border border-white/5 text-[9px] text-neutral-400 font-mono\">K</span>\n                                        </div>\n                                    </div>\n                                    <div class=\"p-1.5\">\n                                        <div class=\"flex items-center gap-2 px-2 py-1.5 text-xs text-neutral-300 hover:bg-white/5 rounded cursor-pointer\">\n                                            <iconify-icon icon=\"solar:pen-new-square-linear\" width=\"14\" height=\"14\" class=\"text-neutral-500\"></iconify-icon>\n                                            Create new issue\n                                        </div>\n                                        <div class=\"flex items-center gap-2 px-2 py-1.5 text-xs text-neutral-300 hover:bg-white/5 rounded cursor-pointer\">\n                                            <iconify-icon icon=\"solar:eye-linear\" width=\"14\" height=\"14\" class=\"text-neutral-500\"></iconify-icon>\n                                            Change view\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <!-- Spacer to allow scrolling past hero -->\n    <section class=\"h-screen bg-black w-full\"></section>\n\n    <!-- Scripts for Animations -->\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // 1. Text Reveal Animation (Masked on ScrollTrigger as requested)\n            const heroTexts = document.querySelectorAll('.hero-text');\n\n            // Set initial state\n            gsap.set(heroTexts, { yPercent: 100 });\n\n            // Animate in on scroll trigger\n            gsap.to(heroTexts, {\n                scrollTrigger: {\n                    trigger: \"#hero-title\",\n                    start: \"top 90%\",\n                },\n                yPercent: 0,\n                duration: 1,\n                stagger: 0.05,\n                ease: \"power4.out\"\n            });\n\n            // Fade in subhead and buttons on scroll trigger\n            gsap.to(\".hero-fade-up\", {\n                scrollTrigger: {\n                    trigger: \"#hero-title\",\n                    start: \"top 80%\",\n                },\n                y: 0,\n                opacity: 1,\n                duration: 1,\n                stagger: 0.2,\n                ease: \"power3.out\",\n                delay: 0.2\n            });\n\n            // 2. Dashboard 3D Transform on Scroll\n            const dashboard = document.getElementById('hero-dashboard');\n\n            // Initial tilted state\n            gsap.set(dashboard, {\n                rotateX: 30,     // Tilted back\n                rotateY: 0,\n                rotateZ: -2,     // Slight angle\n                scale: 0.9,      // Slightly smaller\n                y: 80            // Pushed down slightly\n            });\n\n            // ScrollTrigger animation to flat\n            gsap.to(dashboard, {\n                scrollTrigger: {\n                    trigger: \".perspective-container\",\n                    start: \"top 70%\", // Start when container is 70% down viewport\n                    end: \"top 20%\",   // End when container reaches near top\n                    scrub: 1,         // Smooth scrubbing\n                },\n                rotateX: 0,\n                rotateY: 0,\n                rotateZ: 0,\n                scale: 1,\n                y: 0,\n                ease: \"none\"\n            });\n\n            // 3. Subtle Parallax for Nebula Background\n            gsap.to(\".nebula-layer\", {\n                scrollTrigger: {\n                    trigger: \"main\",\n                    start: \"top top\",\n                    end: \"bottom top\",\n                    scrub: 0.5\n                },\n                y: (i, el) => -50 * (i + 1), // Move up slightly at different speeds\n                ease: \"none\"\n            });\n\n            // 4. Animate the line lasers\n            const lasers = [\n                { id: \".laser-line-left-1\", rot: 20, rotOffset: 2, pulse: 0.4 },\n                { id: \".laser-line-left-2\", rot: 40, rotOffset: -2, pulse: 0.2 },\n                { id: \".laser-line-right-1\", rot: -15, rotOffset: -2, pulse: 0.3 },\n                { id: \".laser-line-right-2\", rot: -35, rotOffset: 2, pulse: 0.1 }\n            ];\n\n            lasers.forEach((laser, index) => {\n                // Initialize explicitly so GSAP perfectly reads the starting matrix values applied by Tailwind\n                gsap.set(laser.id, { rotation: laser.rot });\n\n                // Continuous pulse and sweep\n                gsap.to(laser.id, {\n                    rotation: laser.rot + laser.rotOffset,\n                    opacity: laser.pulse,\n                    duration: 2 + (index * 0.5),\n                    yoyo: true,\n                    repeat: -1,\n                    ease: \"sine.inOut\",\n                    delay: index * 0.2\n                });\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "the-new-standard-for-building-software-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/the-new-standard-for-building-software-2.jpg", "source_name": "the-new-standard-for-building-software-2-DESIGN.md", "views": 114, "forks": 5, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T16:47:39.066929+00:00"}