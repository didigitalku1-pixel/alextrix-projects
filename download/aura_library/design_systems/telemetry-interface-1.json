ry #231F20, accent #F26522, background #EADDCF, surface #231F20, text-primary #111827. Keep background, surface, text, and border roles distinct so generated layouts retain the same contrast pattern as the source.\n## Typography\nUse Inter for display moments and Inter for body copy unless the HTML clearly demands a compatible fallback. Labels and technical metadata should use JetBrains Mono or an equivalent mono face.\n## Layout\nKeep spacing deliberate and stable. Favor the same grid direction, max-width behavior, card density, and responsive stacking seen in the HTML. Do not replace distinctive source structures with generic SaaS sections.\n## Components\nDashboard, chart, and data panels should preserve their compact operational hierarchy, nested surfaces, and metric emphasis.\n## Motion\nPreserve existing motion cues such as masked reveals, staggered entrance, hover lift, scroll-triggered transitions, and ambient movement. Keep easing smooth and restrained.\n## WebGL & Effects\n\nIf the source includes canvas, WebGL, Three.js, gradients, particles, or atmospheric effects, rebuild them as supporting layers behind the content. Keep effects performant, responsive, and secondary to the interface.\n\n## Guardrails\n- Do not flatten the source into a generic card grid.\n- Do not swap the color mode unless the source clearly supports it.\n- Preserve the first viewport signal, focal object, and visual density.\n- Keep buttons, cards, and badges aligned to the same radius and border language.", "preview_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Telemetry Interface</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n</head>\n<body class=\"bg-[#eaddcf] text-[#231f20] h-screen flex flex-col overflow-hidden antialiased selection:bg-[#e61b23] selection:text-[#eaddcf] relative\" style=\"font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;\">\n\n    <!-- Subtle Paper Grain / Noise Overlay -->\n    <div class=\"pointer-events-none fixed inset-0 z-50 opacity-[0.07] mix-blend-multiply\" style=\"background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');\"></div>\n\n    <!-- Header Section -->\n    <header class=\"pt-8 sm:pt-12 md:pt-16 px-4 sm:px-8 md:px-12 w-full max-w-[1800px] mx-auto z-10 shrink-0 relative\">\n        <!-- Hard-edged geometry: Angled stripe masks -->\n        <div class=\"absolute top-10 sm:top-16 right-4 sm:right-12 w-32 sm:w-56 h-3 flex gap-1.5 mix-blend-multiply opacity-90\">\n            <div class=\"h-full w-full bg-[#f26522]\" style=\"clip-path: polygon(15% 0, 100% 0, 85% 100%, 0% 100%);\"></div>\n            <div class=\"h-full w-2/5 bg-[#e61b23]\" style=\"clip-path: polygon(25% 0, 100% 0, 75% 100%, 0% 100%);\"></div>\n        </div>\n\n        <!-- Technical micro-labeling -->\n        <div class=\"flex items-center gap-3 mb-3 sm:mb-5\">\n            <span class=\"text-xs font-medium uppercase tracking-tight text-[#eaddcf] bg-[#e61b23] px-1.5 py-0.5 rounded-[2px] mix-blend-multiply\">Active</span>\n            <span class=\"text-xs font-normal uppercase tracking-tight text-[#231f20]/70\">Telemetry // Seq-01</span>\n        </div>\n\n        <h1 class=\"text-7xl sm:text-8xl md:text-[11rem] lg:text-[13rem] font-light tracking-tighter text-[#231f20] uppercase leading-[0.82] m-0 mix-blend-color-burn\">\n            Primary<br>Sequence\n        </h1>\n    </header>\n\n    <!-- Animated Lines Container -->\n    <main class=\"flex-1 relative w-full overflow-hidden mt-2 shrink min-h-[150px] mix-blend-multiply\">\n        <!-- Top fade overlay to blend lines smoothly into paper -->\n        <div class=\"absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-[#eaddcf] to-transparent z-10 pointer-events-none\"></div>\n        <canvas id=\"flowCanvas\" class=\"absolute inset-0 w-full h-full opacity-70\"></canvas>\n    </main>\n\n    <!-- Footer Section -->\n    <footer class=\"relative w-full shrink-0 border-t border-[#231f20]/15 bg-[#eaddcf] shadow-[0_-20px_50px_rgba(0,0,0,0.03)] z-20\">\n        <div class=\"px-4 sm:px-8 md:px-12 py-5 sm:py-7 flex flex-row items-end sm:items-center justify-between max-w-[1800px] mx-auto gap-4\">\n\n            <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-10\">\n                <!-- Skill: Border Gradient applied to this premium badge -->\n                <div class=\"relative px-5 py-2.5 rounded-[2px] bg-[#231f20] shadow-[0_10px_30px_rgba(230,27,35,0.12)]\">\n                    <!-- Masked Gradient Border Pseudo-element simulation -->\n                    <div class=\"absolute inset-0 pointer-events-none rounded-[2px]\" style=\"background: linear-gradient(135deg, rgba(230,27,35,0.9) 0%, rgba(230,27,35,0.1) 50%, rgba(242,101,34,0.8) 100%); padding: 1px; -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude;\"></div>\n\n                    <span class=\"text-2xl sm:text-3xl md:text-4xl font-normal tracking-tight text-[#eaddcf] uppercase relative z-10 block leading-none\">\n                        Node: 88-V2\n                    </span>\n                </div>\n\n                <div class=\"flex-col gap-1 hidden sm:flex\">\n                    <p class=\"text-xs font-medium text-[#231f20] uppercase tracking-tight m-0 flex items-center gap-2\">\n                        <span class=\"w-1.5 h-1.5 bg-[#e61b23] inline-block rounded-[1px]\"></span> Signal Routing\n                    </p>\n                    <p class=\"text-xs font-normal text-[#231f20]/60 max-w-[180px] leading-tight m-0\">\n                        Internal protocol • Sector 4\n                    </p>\n                </div>\n            </div>\n\n            <!-- Action Button -->\n            <button class=\"relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-[2px] bg-[#eaddcf] shadow-[0_4px_12px_rgba(0,0,0,0.05)] hover:bg-[#231f20] hover:text-[#eaddcf] text-[#231f20] transition-colors duration-200 cursor-pointer group focus:outline-none focus:ring-1 focus:ring-[#e61b23] border border-[#231f20]/15\">\n                <!-- Subtle border gradient on hover -->\n                <div class=\"absolute inset-0 pointer-events-none rounded-[2px] opacity-0 group-hover:opacity-100 transition-opacity duration-200\" style=\"background: linear-gradient(135deg, rgba(230,27,35,0.8) 0%, rgba(242,101,34,0.2) 100%); padding: 1px; -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude;\"></div>\n                <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-2xl sm:text-3xl transition-colors\"></iconify-icon>\n            </button>\n\n        </div>\n    </footer>\n\n    <!-- Animation Script -->\n    <script>\n        const canvas = document.getElementById('flowCanvas');\n        const ctx = canvas.getContext('2d');\n        let time = 0;\n\n        function resizeCanvas() {\n            const dpr = window.devicePixelRatio || 1;\n            const rect = canvas.parentElement.getBoundingClientRect();\n\n            canvas.width = rect.width * dpr;\n            canvas.height = rect.height * dpr;\n\n            ctx.scale(dpr, dpr);\n            canvas.style.width = `${rect.width}px`;\n            canvas.style.height = `${rect.height}px`;\n        }\n\n        window.addEventListener('resize', resizeCanvas);\n        setTimeout(resizeCanvas, 0);\n\n        function renderFrame() {\n            const rect = canvas.parentElement.getBoundingClientRect();\n            const width = rect.width;\n            const height = rect.height;\n\n            ctx.clearRect(0, 0, width, height);\n\n            time += 0.002; // Slower, instrumental motion\n            const totalLines = 80;\n\n            for (let i = 0; i < totalLines; i++) {\n                let progress = (i / totalLines + time) % 1;\n\n                let yPosition = Math.pow(progress, 2.5) * height;\n\n                let baseAlpha = 0.05 + (progress * 0.4);\n                let lineThickness = 0.5 + (progress * 2.5);\n\n                let waveModulation = Math.sin(progress * Math.PI * 4 - time * 10) * 0.05;\n                let finalAlpha = Math.max(0, Math.min(1, baseAlpha + waveModulation));\n\n                ctx.beginPath();\n                ctx.moveTo(0, yPosition);\n                ctx.lineTo(width, yPosition);\n\n                // Ink-900 color mapping for lines\n                ctx.strokeStyle = `rgba(35, 31, 32, ${finalAlpha})`;\n                ctx.lineWidth = lineThickness;\n                ctx.stroke();\n            }\n\n            requestAnimationFrame(renderFrame);\n        }\n\n        requestAnimationFrame(renderFrame);\n    </script>\n</body>\n</html>", "preview_file_name": "telemetry-interface-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/telemetry-interface-1.jpg", "source_name": "telemetry-interface-1-DESIGN.md", "views": 117, "forks": 5, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T14:53:00.724516+00:00"}