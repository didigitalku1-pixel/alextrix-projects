performant, responsive, and secondary to the interface.\n\n## Guardrails\n- Do not flatten the source into a generic card grid.\n- Do not swap the color mode unless the source clearly supports it.\n- Preserve the first viewport signal, focal object, and visual density.\n- Keep buttons, cards, and badges aligned to the same radius and border language.", "preview_html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"antialiased\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Nexus Core Systems</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n</head>\n<body class=\"bg-neutral-950 text-neutral-200 min-h-screen relative overflow-x-hidden selection:bg-neutral-800 selection:text-white\" style=\"font-family: 'Inter', sans-serif; background-image: repeating-linear-gradient(-45deg, rgba(255,255,255,0.015) 0, rgba(255,255,255,0.015) 1px, transparent 0, transparent 10px);\">\n\n    <!-- Canvas Background -->\n    <canvas id=\"particle-canvas\" class=\"fixed inset-0 z-0 pointer-events-none opacity-40\"></canvas>\n\n    <main class=\"relative z-10 min-h-screen flex items-center justify-center p-4 sm:p-8 md:p-12\">\n\n        <!-- Main Framed Container -->\n        <div class=\"w-full max-w-5xl relative group\">\n\n            <!-- Premium Border Gradient Underlay -->\n            <div class=\"absolute -inset-[1px] bg-gradient-to-br from-neutral-700/50 via-neutral-900 to-neutral-800/50 z-0\" style=\"background: linear-gradient(135deg, rgba(249, 115, 22, 0.2) 0%, rgba(23, 23, 23, 1) 40%, rgba(23, 23, 23, 1) 60%, rgba(168, 85, 247, 0.2) 100%);\"></div>\n\n            <!-- Frame Brackets -->\n            <div class=\"absolute -top-3 -left-3 w-6 h-6 border-t border-l border-neutral-600 z-20\"></div>\n            <div class=\"absolute -top-3 -right-3 w-6 h-6 border-t border-r border-neutral-600 z-20\"></div>\n            <div class=\"absolute -bottom-3 -left-3 w-6 h-6 border-b border-l border-neutral-600 z-20\"></div>\n            <div class=\"absolute -bottom-3 -right-3 w-6 h-6 border-b border-r border-neutral-600 z-20\"></div>\n\n            <!-- Grid Layout -->\n            <div class=\"relative z-10 grid grid-cols-1 md:grid-cols-3 gap-[1px] bg-neutral-800/80 border border-neutral-800 backdrop-blur-sm shadow-2xl\">\n\n                <!-- Cell 1: Structural (Ref: Bottle) -->\n                <div class=\"bg-neutral-950/95 aspect-square flex flex-col items-center justify-center p-8 relative overflow-hidden transition-colors hover:bg-neutral-900/90\">\n                    <div class=\"absolute top-4 left-4 text-xs font-medium text-neutral-500 tracking-wider\">01</div>\n                    <div class=\"flex flex-col items-center gap-2\">\n                        <div class=\"w-8 h-8 rounded-t-full border border-orange-500/50 bg-orange-500/5 flex items-center justify-center\">\n                            <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-orange-400 text-lg\"></iconify-icon>\n                        </div>\n                        <div class=\"w-16 h-12 rounded-sm border border-neutral-700 bg-neutral-900/50 flex items-center justify-center\">\n                            <div class=\"w-4 h-[1px] bg-neutral-600\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Cell 2: Connection (Ref: Hand) -->\n                <div class=\"bg-neutral-950/95 aspect-square flex flex-col items-center justify-center p-8 relative overflow-hidden transition-colors hover:bg-neutral-900/90\">\n                    <div class=\"absolute top-4 left-4 text-xs font-medium text-neutral-500 tracking-wider\">02</div>\n                    <div class=\"flex items-center w-full justify-between relative px-4\">\n                        <div class=\"w-1/3 h-[1px] bg-neutral-700\"></div>\n                        <div class=\"w-10 h-10 rounded-full border border-neutral-700 flex items-center justify-center bg-neutral-950 z-10 relative group-hover:border-purple-500/50 transition-colors\">\n                            <iconify-icon icon=\"solar:cpu-linear\" class=\"text-neutral-400 group-hover:text-purple-400 transition-colors\"></iconify-icon>\n                        </div>\n                        <div class=\"w-1/3 h-[1px] bg-neutral-700\"></div>\n                    </div>\n                </div>\n\n                <!-- Cell 3: Data Block (Ref: Dice) -->\n                <div class=\"bg-neutral-950/95 aspect-square p-8 relative overflow-hidden transition-colors hover:bg-neutral-900/90 flex items-center justify-center\">\n                    <div class=\"w-full h-full max-w-[180px] max-h-[180px] grid grid-cols-2 grid-rows-2 gap-[1px] bg-neutral-800 border border-neutral-800 transform rotate-2 hover:rotate-0 transition-transform duration-500\">\n                        <div class=\"bg-neutral-950 flex flex-col items-center justify-center p-2\">\n                            <span class=\"text-xs text-neutral-500 font-medium\" style=\"font-family: 'JetBrains Mono', monospace;\">STS</span>\n                        </div>\n                        <div class=\"bg-neutral-950 flex flex-col items-center justify-center p-2\">\n                            <span class=\"text-lg text-neutral-300 font-medium\" style=\"font-family: 'JetBrains Mono', monospace;\">OK</span>\n                        </div>\n                        <div class=\"bg-neutral-950 flex flex-col items-center justify-center p-2\">\n                            <span class=\"text-lg text-orange-400 font-medium\" style=\"font-family: 'JetBrains Mono', monospace;\">99</span>\n                        </div>\n                        <div class=\"bg-neutral-950 flex flex-col items-center justify-center p-2\">\n                            <span class=\"text-lg text-orange-400 font-medium\" style=\"font-family: 'JetBrains Mono', monospace;\">9%</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Cell 4: Hierarchy (Ref: Poop) -->\n                <div class=\"bg-neutral-950/95 aspect-square flex flex-col items-center justify-center p-8 relative overflow-hidden transition-colors hover:bg-neutral-900/90\">\n                    <div class=\"absolute top-4 left-4 text-xs font-medium text-neutral-500 tracking-wider\">04</div>\n                    <div class=\"flex flex-col items-center gap-1.5 opacity-80\">\n                        <iconify-icon icon=\"solar:sort-from-bottom-to-top-linear\" class=\"text-neutral-500 text-xl mb-2\"></iconify-icon>\n                        <div class=\"h-2 w-8 border border-neutral-600 rounded-full\"></div>\n                        <div class=\"h-2 w-14 border border-neutral-600 rounded-full bg-neutral-800\"></div>\n                        <div class=\"h-2 w-20 border border-orange-500/40 rounded-full bg-orange-500/10 shadow-[0_0_10px_rgba(249,115,22,0.1)]\"></div>\n                    </div>\n                </div>\n\n                <!-- Cell 5: Central Node (Ref: Face) -->\n                <div class=\"bg-neutral-950/95 aspect-square flex items-center justify-center relative overflow-hidden group\">\n                    <!-- Subtle background radial gradient -->\n                    <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.03)_0%,transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-700\"></div>\n                    <div class=\"relative w-24 h-24 flex items-center justify-center\">\n                        <div class=\"absolute inset-0 border border-neutral-700 rounded-full animate-[spin_10s_linear_infinite] border-t-neutral-400\"></div>\n                        <div class=\"absolute inset-2 border border-neutral-800 rounded-full animate-[spin_7s_linear_infinite_reverse] border-b-purple-500/50\"></div>\n                        <iconify-icon icon=\"solar:eye-linear\" class=\"text-3xl text-neutral-300\"></iconify-icon>\n                    </div>\n                </div>\n\n                <!-- Cell 6: Intersection (Ref: Peach) -->\n                <div class=\"bg-neutral-950/95 aspect-square flex items-center justify-center p-8 relative overflow-hidden transition-colors hover:bg-neutral-900/90\">\n                    <div class=\"absolute top-4 left-4 text-xs font-medium text-neutral-500 tracking-wider\">06</div>\n                    <div class=\"relative w-32 h-32 flex items-center justify-center\">\n                        <div class=\"absolute w-20 h-20 border border-neutral-600 rounded-full -translate-x-4 mix-blend-screen group-hover:border-purple-400/50 transition-colors\"></div>\n                        <div class=\"absolute w-20 h-20 border border-neutral-600 rounded-full translate-x-4 mix-blend-screen group-hover:border-purple-400/50 transition-colors\"></div>\n                        <iconify-icon icon=\"solar:infinity-linear\" class=\"text-xl text-purple-400/80 z-10\"></iconify-icon>\n                    </div>\n                </div>\n\n                <!-- Cell 7: Wide Banner (Ref: Bottom Text) -->\n                <div class=\"bg-neutral-950/95 md:col-span-3 aspect-[3/1] md:aspect-[4/1] flex flex-col items-center justify-center relative overflow-hidden p-8 border-t border-neutral-800/50 group\">\n\n                    <!-- Decorative subtle lines -->\n                    <div class=\"absolute inset-0 flex flex-col justify-between pointer-events-none opacity-20\">\n                        <div class=\"h-[1px] w-full bg-gradient-to-r from-transparent via-neutral-500 to-transparent translate-y-8\"></div>\n                        <div class=\"h-[1px] w-full bg-gradient-to-r from-transparent via-neutral-500 to-transparent -translate-y-8\"></div>\n                    </div>\n\n                    <div class=\"relative z-10 flex flex-col items-center\">\n                        <h1 id=\"reveal-heading\" class=\"text-5xl md:text-7xl lg:text-8xl font-semibold tracking-tight text-neutral-100 flex gap-4 uppercase leading-none mb-2 md:mb-4\">\n                            <!-- Words will be split here by JS -->\n                            <span class=\"word-wrap overflow-hidden inline-block\"><span class=\"word inline-block translate-y-full\">Nexus</span></span>\n                            <span class=\"word-wrap overflow-hidden inline-block\"><span class=\"word inline-block translate-y-full text-transparent bg-clip-text bg-gradient-to-r from-neutral-100 to-neutral-500\">Core</span></span>\n                        </h1>\n                        <div class=\"flex items-center gap-6 text-neutral-500 tracking-[0.3em] text-xs font-medium uppercase mt-2\">\n                            <span>S y s t e m s</span>\n                            <div class=\"w-1 h-1 bg-orange-500 rounded-full\"></div>\n                            <span>I n t e l</span>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </main>\n\n    <script>\n        // WebGL / Canvas Particle Animation\n        const canvas = document.getElementById('particle-canvas');\n        const ctx = canvas.getContext('2d');\n        let width, height;\n        let particles = [];\n\n        function resize() {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n        }\n\n        window.addEventListener('resize', resize);\n        resize();\n\n        class Particle {\n            constructor() {\n                this.x = Math.random() * width;\n                this.y = Math.random() * height;\n                this.vx = (Math.random() - 0.5) * 0.5;\n                this.vy = (Math.random() - 0.5) * 0.5;\n                this.radius = Math.random() * 1.5;\n            }\n\n            update() {\n                this.x += this.vx;\n                this.y += this.vy;\n\n                if (this.x < 0 || this.x > width) this.vx = -this.vx;\n                if (this.y < 0 || this.y > height) this.vy = -this.vy;\n            }\n\n            draw() {\n                ctx.beginPath();\n                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n                ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';\n                ctx.fill();\n            }\n        }\n\n        function initParticles() {\n            particles = [];\n            const numParticles = Math.min(window.innerWidth / 15, 100); // Responsive amount\n            for (let i = 0; i < numParticles; i++) {\n                particles.push(new Particle());\n            }\n        }\n\n        function animateParticles() {\n            ctx.clearRect(0, 0, width, height);\n\n            for (let i = 0; i < particles.length; i++) {\n                particles[i].update();\n                particles[i].draw();\n\n                // Draw connections\n                for (let j = i + 1; j < particles.length; j++) {\n                    const dx = particles[i].x - particles[j].x;\n                    const dy = particles[i].y - particles[j].y;\n                    const dist = Math.sqrt(dx * dx + dy * dy);\n\n                    if (dist < 120) {\n                        ctx.beginPath();\n                        ctx.moveTo(particles[i].x, particles[i].y);\n                        ctx.lineTo(particles[j].x, particles[j].y);\n                        ctx.strokeStyle = `rgba(255, 255, 255, ${0.1 - dist/1200})`;\n                        ctx.lineWidth = 0.5;\n                        ctx.stroke();\n                    }\n                }\n            }\n            requestAnimationFrame(animateParticles);\n        }\n\n        initParticles();\n        animateParticles();\n\n        // GSAP Masked Reveal Animation\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Animate grid items fading in\n        gsap.from(\".grid > div\", {\n            y: 20,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.1,\n            ease: \"power3.out\",\n            delay: 0.2\n        });\n\n        // Masked word reveal\n        gsap.to(\".word\", {\n            y: 0,\n            duration: 1.2,\n            stagger: 0.15,\n            ease: \"power4.out\",\n            delay: 0.8,\n            scrollTrigger: {\n                trigger: \"#reveal-heading\",\n                start: \"top 90%\",\n            }\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "nexus-core-systems.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/nexus-core-systems.jpg", "source_name": "nexus-core-systems-DESIGN.md", "views": 53, "forks": 2, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-06-29T19:58:36.751674+00:00"}