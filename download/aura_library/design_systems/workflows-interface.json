flex items-center justify-center flex-shrink-0 relative transition-transform hover:scale-105\">\n                        <div class=\"absolute inset-1.5 border border-dashed border-neutral-200 rounded-full\"></div>\n                        <span class=\"text-xs font-mono text-neutral-800 text-center leading-tight z-10 font-geist\">handle_<br>approval()</span>\n                    </div>\n                </div>\n\n                <!-- Step 2 -->\n                <div class=\"flex flex-col sm:flex-row items-center gap-4 w-full sm:-ml-8\">\n                    <div class=\"border border-neutral-200 bg-white shadow-sm rounded-lg px-3 py-2.5 flex items-center gap-2 w-full sm:w-48 transition-transform hover:-translate-y-0.5\">\n                        <iconify-icon icon=\"solar:cpu-linear\" class=\"text-neutral-400 text-sm\"></iconify-icon>\n                        <span class=\"text-xs font-mono text-neutral-600 truncate font-geist\">ProcessEvent</span>\n                    </div>\n                    <div class=\"h-6 w-px sm:h-px sm:flex-1 bg-neutral-300 relative\">\n                        <div class=\"hidden sm:block absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 border-t border-r border-neutral-400 rotate-45\"></div>\n                    </div>\n                    <div class=\"w-20 h-20 rounded-full border border-neutral-200 bg-white shadow-sm flex items-center justify-center flex-shrink-0 relative transition-transform hover:scale-105\">\n                        <div class=\"absolute inset-1.5 border border-dashed border-neutral-200 rounded-full\"></div>\n                        <span class=\"text-xs font-mono text-neutral-800 text-center leading-tight z-10 font-geist\">process()</span>\n                        <!-- Cursor graphic -->\n                        <div class=\"absolute bottom-2 right-2 text-neutral-900 z-20\">\n                            <iconify-icon icon=\"solar:cursor-linear\" class=\"text-base\"></iconify-icon>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Step 3 -->\n                <div class=\"flex flex-col sm:flex-row items-center gap-4 w-full sm:ml-8\">\n                    <div class=\"border border-neutral-200 bg-white shadow-sm rounded-lg px-3 py-2.5 flex items-center gap-2 w-full sm:w-48 transition-transform hover:-translate-y-0.5\">\n                        <iconify-icon icon=\"solar:documents-linear\" class=\"text-neutral-400 text-sm\"></iconify-icon>\n                        <span class=\"text-xs font-mono text-neutral-600 truncate font-geist\">HandleProcessEvent</span>\n                    </div>\n                    <div class=\"h-6 w-px sm:h-px sm:flex-1 bg-neutral-300 relative\">\n                        <div class=\"hidden sm:block absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 border-t border-r border-neutral-400 rotate-45\"></div>\n                    </div>\n                    <div class=\"w-20 h-20 rounded-full border border-neutral-200 bg-white shadow-sm flex items-center justify-center flex-shrink-0 relative transition-transform hover:scale-105\">\n                        <div class=\"absolute inset-1.5 border border-dashed border-neutral-200 rounded-full\"></div>\n                        <span class=\"text-xs font-mono text-neutral-800 text-center leading-tight z-10 font-geist\">gather()</span>\n                    </div>\n                </div>\n\n                <!-- Result Arrow Down -->\n                <div class=\"h-6 w-px bg-neutral-300 relative -mt-4 hidden sm:block\">\n                    <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 border-b border-r border-neutral-400 rotate-45\"></div>\n                </div>\n\n                <!-- Final Result Box -->\n                <div class=\"relative mt-2 w-full sm:w-auto\">\n                    <!-- Vibrant Glow -->\n                    <div class=\"absolute -inset-1.5 bg-gradient-to-r from-blue-400 via-fuchsia-400 to-orange-400 rounded-xl blur-md opacity-80\"></div>\n                    <!-- Box Content -->\n                    <div class=\"relative bg-white border border-neutral-100 rounded-lg px-6 py-3 shadow-md text-xs font-mono text-neutral-800 w-full text-center font-geist\">\n                        {\"result\": \"Processed!\"}\n                    </div>\n                </div>\n\n            </div>\n        </section>\n\n        <!-- Right Column: Features -->\n        <section class=\"lg:col-span-4 p-8 lg:p-10 flex flex-col\">\n            <div class=\"flex items-center gap-2 text-xs font-mono text-neutral-400 mb-16 font-geist\">\n                <div class=\"w-1 h-1 bg-neutral-900\"></div>\n                03\n            </div>\n\n            <div class=\"flex flex-col gap-10 mt-4\">\n\n                <!-- Feature 1 -->\n                <div>\n                    <div class=\"flex items-center gap-3 mb-3\">\n                        <div class=\"w-1 h-1 bg-neutral-900 rounded-sm\"></div>\n                        <h3 class=\"text-lg font-medium tracking-tight text-neutral-900 font-geist\">Orchestrate AI Workflows</h3>\n                    </div>\n                    <p class=\"text-sm text-neutral-500 leading-relaxed pl-4 font-geist\">\n                        Easily chain together multiple steps, loop, and parallel paths.\n                    </p>\n                </div>\n\n                <!-- Feature 2 -->\n                <div>\n                    <div class=\"flex items-center gap-3 mb-3\">\n                        <div class=\"w-1 h-1 bg-neutral-900 rounded-sm\"></div>\n                        <h3 class=\"text-lg font-medium tracking-tight text-neutral-900 font-geist\">Built for Speed</h3>\n                    </div>\n                    <p class=\"text-sm text-neutral-500 leading-relaxed pl-4 font-geist\">\n                        Async-first workflows that seamlessly integrate with modern Python apps, like FastAPI.\n                    </p>\n                </div>\n\n                <!-- Feature 3 -->\n                <div>\n                    <div class=\"flex items-center gap-3 mb-3\">\n                        <div class=\"w-1 h-1 bg-neutral-900 rounded-sm\"></div>\n                        <h3 class=\"text-lg font-medium tracking-tight text-neutral-900 font-geist\">Event-Driven</h3>\n                    </div>\n                    <p class=\"text-sm text-neutral-500 leading-relaxed pl-4 font-geist\">\n                        Architecture for workflows you can launch, pause, and resume—statefully and seamlessly.\n                    </p>\n                </div>\n\n            </div>\n        </section>\n\n    </main>\n\n</body></html>", "preview_file_name": "workflows-interface.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/workflows-interface.jpg", "source_name": "workflows-interface-DESIGN.md", "views": 255, "forks": 13, "private": false, "featured": true, "created_by": "66a84ecf-0972-40f3-8a4c-15b11d3aee0a", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T08:19:41.666491+00:00"}