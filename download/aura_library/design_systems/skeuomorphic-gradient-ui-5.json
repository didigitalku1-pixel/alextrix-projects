31 2.43875 18V6Z\" fill=\"white\" fill-opacity=\"0.15\"/>\n                            </svg>\n                        </div>\n                    </div>\n\n                    <!-- Tools & Settings Row -->\n                    <div class=\"flex items-center justify-between mt-4 mb-4 pb-4 border-b border-black/40 shadow-[0_1px_0_rgba(255,255,255,0.04)]\">\n                        <!-- Dropdown Skueo Surface -->\n                        <div class=\"w-28 flex items-center justify-between bg-gradient-to-b from-[#383838] to-[#2B2B2B] rounded-lg px-2.5 py-1.5 cursor-pointer hover:from-[#404040] hover:to-[#333333] active:scale-[0.98] transition-all ring-1 ring-black/70 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0px_2px_3px_-1px_rgba(0,0,0,0.2),_0px_1px_0px_0px_rgba(25,28,33,0.02),_0px_0px_0px_1px_rgba(25,28,33,0.08)]\">\n                            <span class=\"text-xs font-medium text-[#EBEBEB]\" style=\"text-shadow: 0 1px 1px rgba(0,0,0,0.6);\">Linear</span>\n                            <iconify-icon icon=\"solar:alt-arrow-down-linear\" class=\"text-[#888] drop-shadow-sm\" width=\"12\"></iconify-icon>\n                        </div>\n\n                        <!-- Actions -->\n                        <div class=\"flex items-center gap-0.5 text-[#999999]\">\n                            <button class=\"hover:text-white active:scale-90 p-1.5 rounded-md transition-all flex items-center cursor-pointer hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] hover:bg-white/5\"><iconify-icon icon=\"solar:minimize-square-3-linear\" style=\"stroke-width: 1.5;\" width=\"14\"></iconify-icon></button>\n                            <div class=\"bg-gradient-to-b from-[#555] to-[#383838] text-white p-1.5 rounded-md flex items-center justify-center cursor-pointer ring-1 ring-black/80 shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),_0px_2px_3px_-1px_rgba(0,0,0,0.2),_0px_1px_0px_0px_rgba(25,28,33,0.02),_0px_0px_0px_1px_rgba(25,28,33,0.08)] hover:from-[#5C5C5C] hover:to-[#404040] active:sca