shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]\"><iconify-icon icon=\"solar:close-linear\" style=\"stroke-width: 1.5;\" width=\"14\"></iconify-icon></button>\n                    </div>\n                </div>\n\n                <!-- Body Padding -->\n                <div class=\"p-4\">\n\n                    <!-- Gradient Visualizer Track -->\n                    <div id=\"gradient-track\" class=\"relative h-14 mt-1 mb-2\">\n                        <!-- Background gradient bar (Deeply Recessed) -->\n                        <div id=\"gradient-bar\" class=\"absolute top-3 left-0 right-0 h-8 rounded-lg ring-1 ring-black/80 shadow-[inset_0_3px_6px_rgba(0,0,0,0.7),_0_1px_0_rgba(255,255,255,0.08)]\"\n                             style=\"background: linear-gradient(to right, #F3F4F6 0%, #F2D574 32%, #E83925 66%, #1A6AF0 100%);\">\n                            <div class=\"absolute inset-0 rounded-lg ring-1 ring-white/10 ring-inset pointer-events-none mix-blend-overlay\"></div>\n                        </div>\n\n                        <!-- Handles (Skeuomorphic shape, interactive draggable) -->\n                        <div class=\"gradient-handle absolute top-0 flex flex-col items-center -translate-x-1/2 cursor-grab z-10 hover:scale-110 active:scale-95 transition-transform scale-90\" style=\"left: 0%;\" data-color=\"#F3F4F6\">\n                            <svg width=\"20\" height=\"28\" viewBox=\"0 0 24 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"filter: drop-shadow(0 4px 4px rgba(0,0,0,0.4)) drop-shadow(0 1px 1px rgba(0,0,0,0.3)); pointer-events: none;\">\n                                <path d=\"M2 6C2 3.79086 3.79086 2 6 2H18C20.2091 2 22 3.79086 22 6V18C22 19.3496 21.341 20.6186 20.2443 21.3862L13.1466 26.3546C12.4647 26.8319 11.5353 26.8319 10.8534 26.3546L3.75574 21.3862C2.65901 20.6186 2 19.3496 2 18V6Z\" fill=\"url(#gradHandle)\" stroke=\"#111111\" stroke-width=\"2\"/>\n                                <path d=\"M4 6C4 4.89543 4.89543 4 6 4H18C19