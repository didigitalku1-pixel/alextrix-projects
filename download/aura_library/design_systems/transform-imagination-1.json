g\" alt=\"Abstract\" class=\"w-full h-full object-cover\">\n            </div>\n\n            <!-- Bottom Center -->\n            <div class=\"floating-image w-44 h-28 rounded-[24px] overflow-hidden premium-shadow ring-1 ring-black/5 opacity-70\" style=\"--tx: -1rem; --ty: 25rem; --rot: -20deg; --float-delay: 1.8s; transition-delay: 0.8s;\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/5ee0a38a-b5d3-4531-8793-98beed4af162_1600w.jpg\" alt=\"Architecture\" class=\"w-full h-full object-cover\">\n            </div>\n        </div>\n    </div>\n\n    <!-- Bottom Fade Mask -->\n    <div class=\"fixed bottom-0 left-0 w-full h-64 bg-gradient-to-t from-[#f4f3ef] via-[#f4f3ef]/90 to-transparent z-0 pointer-events-none\"></div>\n\n    <!-- Main Content -->\n    <main class=\"relative z-10 flex flex-col items-center justify-center text-center px-6 max-w-5xl mx-auto w-full pt-40 pb-24 mt-auto mb-auto\">\n\n        <!-- Premium Gradient Border Badge -->\n        <div class=\"animate-on-scroll p-[1px] rounded-full bg-gradient-to-r from-gray-300 via-gray-400 to-gray-300 mb-8 inline-block shadow-sm\" style=\"animation-delay: 0.2s;\">\n            <div class=\"glass-surface inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full\">\n                <iconify-icon icon=\"solar:bolt-linear\" class=\"text-gray-900 text-sm\" style=\"stroke-width: 1.5;\"></iconify-icon>\n                <span class=\"text-xs md:text-sm font-medium tracking-[0.08em] text-gray-800 uppercase mt-[1px] font-newsreader\">The new standard of creation</span>\n            </div>\n        </div>\n\n        <!-- Headline -->\n        <h1 class=\"split-text-target text-5xl md:text-7xl leading-[1.05] tracking-tight text-gray-900 mb-6 font-gfs-didot\">\n            Generate breathtaking<br>visuals seamlessly\n        </h1>\n\n        <!-- Subheadline -->\n        <p class=\"split-text-target text-lg md:text-xl text-gray-500 mb-10 max-w-xl mx-auto font-normal font-newsreader\" style=\"--base-delay: 0.9s;\">\n            Unlock a world of infinite creativity. Build, iterate, and launch stunning concepts directly from your imagination.\n        </p>\n\n        <!-- CTA Button -->\n        <div class=\"animate-on-scroll\" style=\"animation-delay: 1.7s;\">\n            <button class=\"group inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-[#1e1e1e] text-white font-medium text-base hover:bg-black hover:scale-[1.02] transition-all duration-300 button-shadow font-newsreader\">\n                Start creating for free\n                <iconify-icon icon=\"solar:arrow-right-linear\" class=\"text-lg opacity-80 group-hover:translate-x-1 group-hover:opacity-100 transition-all duration-300\" style=\"stroke-width: 1.5;\"></iconify-icon>\n            </button>\n        </div>\n\n        <!-- Social Proof -->\n        <div class=\"animate-on-scroll mt-10 flex flex-col items-center gap-3\" style=\"animation-delay: 2.0s;\">\n            <div class=\"flex items-center -space-x-3\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/2f563338-39fa-47ea-9761-658d4f3f84db_800w.jpg\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-[#f4f3ef] object-cover bg-gray-200 shadow-sm\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/4f5668c5-fc4a-44e0-bc5e-a664189d3c31_800w.jpg\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-[#f4f3ef] object-cover bg-gray-200 shadow-sm\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/eca707cc-a5b7-439a-b4fd-247f6106c2e1_800w.jpg\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-[#f4f3ef] object-cover bg-gray-200 shadow-sm top\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/77415a2e-dcbc-4748-a29d-fced4821881a_800w.jpg\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-[#f4f3ef] object-cover bg-gray-200 shadow-sm\">\n                <div class=\"w-10 h-10 rounded-full border-2 border-[#f4f3ef] bg-gray-100 flex items-center justify-center text-xs font-medium text-gray-600 shadow-sm z-10 font-newsreader\">+10k</div>\n            </div>\n            <p class=\"text-sm font-normal text-gray-500 font-newsreader\">Joined by <span class=\"font-medium text-gray-800 font-newsreader\">10,000+</span> visionary creators</p>\n        </div>\n\n        <!-- Trusted By Company Logos -->\n        <div class=\"animate-on-scroll mt-24 pt-12 w-full flex flex-col items-center border-t border-gray-300/40\" style=\"animation-delay: 2.3s;\">\n            <p class=\"text-xs font-medium text-gray-400 uppercase tracking-[0.15em] mb-8 font-newsreader\">Trusted by industry leaders</p>\n            <div class=\"flex flex-wrap justify-center gap-10 md:gap-16 items-center opacity-50 contrast-0 brightness-0 transition-opacity hover:opacity-70\">\n                <iconify-icon icon=\"logos:vercel\" class=\"text-2xl md:text-3xl\"></iconify-icon>\n                <iconify-icon icon=\"logos:stripe\" class=\"text-4xl md:text-5xl\"></iconify-icon>\n                <iconify-icon icon=\"logos:figma\" class=\"text-2xl md:text-3xl\"></iconify-icon>\n                <iconify-icon icon=\"logos:linear\" class=\"text-3xl md:text-4xl\"></iconify-icon>\n                <iconify-icon icon=\"logos:raycast\" class=\"text-3xl md:text-4xl\"></iconify-icon>\n            </div>\n        </div>\n\n    </main>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            // Split text into words for staggered animation while retaining spaces\n            const splitTextElements = document.querySelectorAll('.split-text-target');\n\n            splitTextElements.forEach((el, index) => {\n                const text = el.innerHTML;\n                const baseDelay = parseFloat(el.style.getPropertyValue('--base-delay') || (index === 0 ? '0.4' : '0.9'));\n\n                const parts = text.split(/<br\\s*\\/?>/i);\n                el.innerHTML = '';\n\n                let wordCount = 0;\n\n                parts.forEach((part, partIndex) => {\n                    const words = part.trim().split(/\\s+/);\n                    words.forEach((word) => {\n                        if (word.length === 0) return;\n                        const span = document.createElement('span');\n                        span.innerHTML = word + '&nbsp;';\n                        span.className = 'word-span';\n                        span.style.animationDelay = `${baseDelay + (wordCount * 0.08)}s`;\n                        el.appendChild(span);\n                        wordCount++;\n                    });\n\n                    if (partIndex < parts.length - 1) {\n                        el.appendChild(document.createElement('br'));\n                    }\n                });\n            });\n\n            // Intersection Observer to trigger animations efficiently\n            const observerOptions = {\n                root: null,\n                rootMargin: '50px 0px',\n                threshold: 0.1\n            };\n\n            const observer = new IntersectionObserver((entries, observer) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.classList.add('is-visible');\n\n                        const wordSpans = entry.target.querySelectorAll('.word-span');\n                        wordSpans.forEach(span => span.classList.add('is-visible'));\n\n                        observer.unobserve(entry.target);\n                    }\n                });\n            }, observerOptions);\n\n            document.querySelectorAll('.animate-on-scroll, .floating-image').forEach(el => {\n                observer.observe(el);\n            });\n\n            splitTextElements.forEach(el => {\n                observer.observe(el);\n            });\n        });\n    </script>\n\n</body></html>", "preview_file_name": "transform-imagination-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/transform-imagination-1.jpg", "source_name": "transform-imagination-1-DESIGN.md", "views": 262, "forks": 12, "private": false, "featured": true, "created_by": "f78092cf-e149-48ff-99e9-efabe9a28d39", "created_at": "2026-05-22T07:58:12.433844+00:00", "updated_at": "2026-07-02T13:33:44.68469+00:00"}