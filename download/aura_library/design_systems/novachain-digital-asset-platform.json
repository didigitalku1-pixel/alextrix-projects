 <!-- From Input -->\n                    <div class=\"bg-black/20 rounded-2xl p-4 border border-white/[0.03] hover:border-white/10 transition-colors group/input\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <button class=\"flex items-center gap-2 bg-white/5 hover:bg-white/10 rounded-full px-3 py-1.5 transition-colors\">\n                                <div class=\"w-5 h-5 rounded-full bg-blue-500 flex items-center justify-center text-[10px] font-semibold\">E</div>\n                                <span class=\"text-sm font-medium\">ETH</span>\n                                <iconify-icon icon=\"solar:alt-arrow-down-linear\" class=\"text-white/50\"></iconify-icon>\n                            </button>\n                            <span class=\"text-xs text-white/40\">Balance: 4.205 ETH</span>\n                        </div>\n                        <div class=\"flex justify-between items-end\">\n                            <div class=\"flex flex-col\">\n                                <span class=\"text-xs text-white/40 mb-1\">Amount</span>\n                                <input type=\"text\" value=\"1.5\" class=\"bg-transparent text-3xl font-medium text-white outline-none w-full p-0 m-0\" style=\"font-family: 'Inter', sans-serif;\" readonly>\n                            </div>\n                            <span class=\"text-xs text-white/40 pb-1\">≈ $3,450.00</span>\n                        </div>\n                    </div>\n\n                    <!-- Swap Button Divider -->\n                    <div class=\"relative h-4 flex justify-center items-center my-2\">\n                        <div class=\"absolute w-full h-[1px] bg-white/[0.05]\"></div>\n                        <button class=\"relative z-10 bg-[#160b26] border border-white/10 rounded-full p-2 text-white/70 hover:text-white hover:bg-white/5 transition-all hover:rotate-180\">\n                            <iconify-icon icon=\"solar:sort-vertical-linear\"></iconify-icon>\n                        </button>\n                    </div>\n\n                    <!-- To Input -->\n                    <div class=\"bg-black/20 rounded-2xl p-4 border border-white/[0.03] hover:border-white/10 transition-colors\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <button class=\"flex items-center gap-2 bg-white/5 hover:bg-white/10 rounded-full px-3 py-1.5 transition-colors\">\n                                <div class=\"w-5 h-5 rounded-full bg-emerald-500 flex items-center justify-center text-[10px] font-semibold text-black\">U</div>\n                                <span class=\"text-sm font-medium\">USDC</span>\n                                <iconify-icon icon=\"solar:alt-arrow-down-linear\" class=\"text-white/50\"></iconify-icon>\n                            </button>\n                            <span class=\"text-xs text-white/40 flex items-center gap-1\">Network Fee <iconify-icon icon=\"solar:info-circle-linear\"></iconify-icon></span>\n                        </div>\n                        <div class=\"flex justify-between items-end\">\n                            <div class=\"flex flex-col\">\n                                <span class=\"text-xs text-white/40 mb-1\">Receive</span>\n                                <input type=\"text\" value=\"3,445.50\" class=\"bg-transparent text-3xl font-medium text-white outline-none w-full p-0 m-0\" style=\"font-family: 'Inter', sans-serif;\" readonly>\n                            </div>\n                            <span class=\"text-xs text-white/40 pb-1\">3.50 USDC</span>\n                        </div>\n                    </div>\n\n                    <button class=\"w-full mt-6 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-medium text-sm py-4 rounded-xl flex justify-center items-center gap-2 transition-all shadow-[0_4px_20px_rgba(147,51,234,0.3)]\">\n                        <iconify-icon icon=\"solar:transfer-horizontal-linear\" class=\"text-lg\"></iconify-icon> Confirm Swap\n                    </button>\n                </div>\n            </div>\n\n            <!-- Right Column -->\n            <div class=\"lg:col-span-4 flex flex-col items-end gap-6 relative text-right\">\n                <div class=\"flex items-center gap-4 justify-end\">\n                    <div class=\"flex -space-x-3\">\n                        <img src=\"https://i.pravatar.cc/100?img=33\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-[#0b0514] relative z-20\">\n                        <img src=\"https://i.pravatar.cc/100?img=47\" alt=\"User\" class=\"w-10 h-10 rounded-full border-2 border-[#0b0514] relative z-10\">\n                    </div>\n                    <button class=\"w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center hover:bg-white/10 transition-colors\">\n                        <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-white\"></iconify-icon>\n                    </button>\n                </div>\n\n                <h1 class=\"text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-tighter leading-[1.1] uppercase text-transparent bg-clip-text bg-gradient-to-b from-white/90 to-white/30\">\n                    Realize<br>Digital<br>Wealth\n                </h1>\n            </div>\n\n        </main>\n\n        <!-- Bottom Features -->\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 pb-12 mt-12 lg:mt-0 relative z-20\">\n            <!-- Feature 1 -->\n            <div class=\"bg-white/[0.02] hover:bg-white/[0.04] border border-white/[0.05] rounded-2xl p-5 flex items-center gap-5 transition-all cursor-pointer group\">\n                <div class=\"w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform\">\n                    <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-2xl text-emerald-400\"></iconify-icon>\n                </div>\n                <div class=\"flex-1\">\n                    <h3 class=\"text-sm font-medium text-white mb-1\">Institutional Security</h3>\n                    <p class=\"text-xs text-white/50 leading-relaxed\">Bank-grade encryption and multi-party computation to keep assets safe.</p>\n                </div>\n                <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-white/30 group-hover:text-white transition-colors\"></iconify-icon>\n            </div>\n\n            <!-- Feature 2 -->\n            <div class=\"bg-white/[0.04] border border-white/[0.08] rounded-2xl p-5 flex items-center gap-5 transition-all cursor-pointer group shadow-[0_0_30px_rgba(255,255,255,0.02)] transform md:-translate-y-4\">\n                <div class=\"w-12 h-12 rounded-full bg-purple-500/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform\">\n                    <iconify-icon icon=\"solar:bolt-linear\" class=\"text-2xl text-purple-400\"></iconify-icon>\n                </div>\n                <div class=\"flex-1\">\n                    <h3 class=\"text-sm font-medium text-white mb-1\">Lightning Execution</h3>\n                    <p class=\"text-xs text-white/50 leading-relaxed\">Experience zero-latency trading with our proprietary matching engine.</p>\n                </div>\n                <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-white/30 group-hover:text-white transition-colors\"></iconify-icon>\n            </div>\n\n            <!-- Feature 3 -->\n            <div class=\"bg-white/[0.02] hover:bg-white/[0.04] border border-white/[0.05] rounded-2xl p-5 flex items-center gap-5 transition-all cursor-pointer group\">\n                <div class=\"w-12 h-12 rounded-full bg-blue-500/10 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform\">\n                    <iconify-icon icon=\"solar:chart-square-linear\" class=\"text-2xl text-blue-400\"></iconify-icon>\n                </div>\n                <div class=\"flex-1\">\n                    <h3 class=\"text-sm font-medium text-white mb-1\">Advanced Analytics</h3>\n                    <p class=\"text-xs text-white/50 leading-relaxed\">Deep market insights and portfolio tracking tools at your fingertips.</p>\n                </div>\n                <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-white/30 group-hover:text-white transition-colors\"></iconify-icon>\n            </div>\n        </div>\n    </div>\n\n    <!-- Canvas Animation Script -->\n    <script>\n        const canvas = document.getElementById('glowCanvas');\n        const ctx = canvas.getContext('2d');\n        let width, height;\n        let time = 0;\n\n        function resize() {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n        }\n\n        window.addEventListener('resize', resize);\n        resize();\n\n        function draw() {\n            ctx.clearRect(0, 0, width, height);\n\n            // Center X\n            const cx = width / 2;\n\n            ctx.globalCompositeOperation = 'screen';\n\n            // Draw multiple flowing lines to create a central glowing beam\n            for (let i = 0; i < 5; i++) {\n                ctx.beginPath();\n                ctx.moveTo(cx, 0);\n\n                for (let y = 0; y <= height; y += 20) {\n                    // Calculate wave offset\n                    // Taper off at top and bottom using sine wave based on height\n                    const taper = Math.sin((y / height) * Math.PI);\n                    const wave = Math.sin((y * 0.003) + time + (i * 0.5)) * (80 + (i * 30)) * taper;\n\n                    ctx.lineTo(cx + wave, y);\n                }\n\n                // Create gradient for stroke\n                const gradient = ctx.createLinearGradient(0, 0, 0, height);\n                gradient.addColorStop(0, `rgba(139, 92, 246, 0)`);\n                gradient.addColorStop(0.5, `rgba(216, 180, 254, ${0.15 + (i * 0.05)})`);\n                gradient.addColorStop(1, `rgba(139, 92, 246, 0)`);\n\n                ctx.strokeStyle = gradient;\n                ctx.lineWidth = 40 + (i * 20);\n                ctx.filter = `blur(${15 + (i * 5)}px)`;\n                ctx.stroke();\n            }\n\n            // Central core bright line\n            ctx.beginPath();\n            ctx.moveTo(cx, 0);\n            for (let y = 0; y <= height; y += 20) {\n                const taper = Math.sin((y / height) * Math.PI);\n                const wave = Math.sin((y * 0.003) + time) * 40 * taper;\n                ctx.lineTo(cx + wave, y);\n            }\n            const coreGradient = ctx.createLinearGradient(0, 0, 0, height);\n            coreGradient.addColorStop(0, 'rgba(255,255,255,0)');\n            coreGradient.addColorStop(0.5, 'rgba(255,255,255,0.8)');\n            coreGradient.addColorStop(1, 'rgba(255,255,255,0)');\n            ctx.strokeStyle = coreGradient;\n            ctx.lineWidth = 4;\n            ctx.filter = 'blur(2px)';\n            ctx.stroke();\n\n            time -= 0.015;\n            requestAnimationFrame(draw);\n        }\n\n        draw();\n    </script>\n</body>\n</html>", "preview_file_name": "novachain-digital-asset-platform.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/novachain-digital-asset-platform.jpg", "source_name": "novachain-digital-asset-platform-DESIGN.md", "views": 116, "forks": 9, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-06-28T23:41:39.515283+00:00"}