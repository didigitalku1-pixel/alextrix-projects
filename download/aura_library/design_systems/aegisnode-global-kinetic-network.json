                    <iconify-icon icon=\"solar:server-square-linear\" width=\"18\" stroke-width=\"1.5\" class=\"text-zinc-500\"></iconify-icon>\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-500\">Logic Instantiation</p>\n                        </div>\n                        <div class=\"space-y-3\">\n                            <div class=\"flex items-center gap-2 text-xs font-medium text-emerald-400 bg-emerald-950/30 w-fit px-2 py-1 rounded border border-emerald-900/50\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></div> 4ms Ping\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-400 tracking-tight border-t border-white/5 pt-2\">EU-Central, Berlin (BER1)</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 2 -->\n                <div class=\"w-full sm:w-[280px] h-[190px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[140px] lg:-mt-[95px] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] z-20 lg:rotate-[2deg] lg:translate-x-[20px] lg:translate-y-[-15px] lg:group-hover:translate-x-[60%] lg:group-hover:-translate-y-[110%] lg:group-hover:rotate-0 shadow-2xl shadow-black\" style=\"background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.02) 100%); padding: 1px; border-radius: 12px;\">\n                    <div class=\"bg-[#0e1411]/90 backdrop-blur-xl w-full h-full rounded-[11px] p-5 flex flex-col justify-between border border-white/5 relative overflow-hidden\">\n                        <div>\n                            <div class=\"flex justify-between items-start mb-1\">\n                                <h3 class=\"text-sm font-medium tracking-tight text-zinc-200\">Sector Secundus</h3>\n                                <iconify-icon icon=\"solar:routing-3-linear\" width=\"18\" stroke-width=\"1.5\" class=\"text-zinc-500\"></iconify-icon>\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-500\">Perimeter Buffer</p>\n                        </div>\n                        <div class=\"space-y-3\">\n                            <div class=\"flex items-center gap-2 text-xs font-medium text-emerald-400 bg-emerald-950/30 w-fit px-2 py-1 rounded border border-emerald-900/50\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></div> 8ms Ping\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-400 tracking-tight border-t border-white/5 pt-2\">US-East, New York (NYC1)</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 3 -->\n                <div class=\"w-full sm:w-[280px] h-[190px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[140px] lg:-mt-[95px] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] z-30 lg:rotate-[-4deg] lg:translate-x-[-10px] lg:translate-y-[-20px] lg:group-hover:-translate-x-[60%] lg:group-hover:translate-y-[5%] lg:group-hover:rotate-0 shadow-2xl shadow-black\" style=\"background: linear-gradient(135deg, rgba(52,211,153,0.3) 0%, rgba(255,255,255,0.02) 100%); padding: 1px; border-radius: 12px;\">\n                    <div class=\"bg-[#0a0f0c] w-full h-full rounded-[11px] p-5 flex flex-col justify-between border border-white/5 relative overflow-hidden\">\n                        <div class=\"absolute bottom-0 left-0 w-32 h-32 bg-emerald-500/5 blur-[40px] rounded-full\"></div>\n                        <div>\n                            <div class=\"flex justify-between items-start mb-1\">\n                                <h3 class=\"text-sm font-medium tracking-tight text-zinc-200\">Sector Tertius</h3>\n                                <iconify-icon icon=\"solar:database-linear\" width=\"18\" stroke-width=\"1.5\" class=\"text-zinc-500\"></iconify-icon>\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-500\">Immutable Ledger</p>\n                        </div>\n                        <div class=\"space-y-3\">\n                            <div class=\"flex items-center gap-2 text-xs font-medium text-emerald-400 bg-emerald-950/30 w-fit px-2 py-1 rounded border border-emerald-900/50\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></div> 1.2TB/s Sync\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-400 tracking-tight border-t border-white/5 pt-2\">AP-East, Seoul (ICN1)</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 4 -->\n                <div class=\"w-full sm:w-[280px] h-[190px] relative lg:absolute lg:top-1/2 lg:left-1/2 lg:-ml-[140px] lg:-mt-[95px] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] z-40 lg:rotate-[4deg] lg:translate-x-[10px] lg:translate-y-[20px] lg:group-hover:translate-x-[60%] lg:group-hover:translate-y-[5%] lg:group-hover:rotate-0 shadow-2xl shadow-black\" style=\"background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.02) 100%); padding: 1px; border-radius: 12px;\">\n                    <div class=\"bg-[#0e1411]/90 backdrop-blur-xl w-full h-full rounded-[11px] p-5 flex flex-col justify-between border border-white/5 relative overflow-hidden\">\n                        <div>\n                            <div class=\"flex justify-between items-start mb-1\">\n                                <h3 class=\"text-sm font-medium tracking-tight text-zinc-200\">Sector Quartus</h3>\n                                <iconify-icon icon=\"solar:shield-check-linear\" width=\"18\" stroke-width=\"1.5\" class=\"text-zinc-500\"></iconify-icon>\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-500\">Zero-Trust Firewall</p>\n                        </div>\n                        <div class=\"space-y-3\">\n                            <div class=\"flex items-center gap-2 text-xs font-medium text-emerald-400 bg-emerald-950/30 w-fit px-2 py-1 rounded border border-emerald-900/50\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></div> Active Rule Engine\n                            </div>\n                            <p class=\"text-xs font-light text-zinc-400 tracking-tight border-t border-white/5 pt-2\">Distributed Anycast Matrix</p>\n                        </div>\n                    </div>\n                </div>\n\n            </section>\n        </div>\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // GSAP Masked Staggered Word Reveal\n            const title = document.getElementById('hero-title');\n            if (title) {\n                const html = title.innerHTML;\n                title.innerHTML = '';\n                // Split by br tags to maintain line breaks\n                const lines = html.split(/<br\\s*\\/?>/i);\n\n                lines.forEach((line, index) => {\n                    const words = line.split(/\\s+/);\n                    words.forEach(word => {\n                        if(!word) return;\n\n                        // Mask wrapper\n                        const wrapper = document.createElement('span');\n                        wrapper.style.display = 'inline-block';\n                        wrapper.style.overflow = 'hidden';\n                        wrapper.style.verticalAlign = 'bottom';\n                        wrapper.style.paddingBottom = '0.1em';\n                        wrapper.style.marginBottom = '-0.1em';\n\n                        // Inner text element\n                        const inner = document.createElement('span');\n                        inner.innerHTML = word;\n                        inner.style.display = 'inline-block';\n                        inner.classList.add('reveal-word');\n\n                        wrapper.appendChild(inner);\n                        title.appendChild(wrapper);\n                        title.appendChild(document.createTextNode(' '));\n                    });\n\n                    if (index < lines.length - 1) {\n                        title.appendChild(document.createElement('br'));\n                    }\n                });\n\n                // Animate inner spans up from below the mask\n                gsap.fromTo('.reveal-word',\n                    { y: '110%', opacity: 0 },\n                    {\n                        y: '0%',\n                        opacity: 1,\n                        duration: 1,\n                        ease: 'power3.out',\n                        stagger: 0.05,\n                        scrollTrigger: {\n                            trigger: '#hero-title',\n                            start: 'top 90%',\n                        }\n                    }\n                );\n            }\n\n            // Cyber Kinetic Background Field\n            const canvas = document.getElementById('kinetic-canvas');\n            const ctx = canvas.getContext('2d');\n            let width, height;\n            let time = 0;\n            let linesArr = [];\n\n            function resize() {\n                width = canvas.width = window.innerWidth;\n                height = canvas.height = window.innerHeight;\n                initLines();\n            }\n\n            function initLines() {\n                linesArr = [];\n                // Line density heuristic\n                const numLines = Math.floor(width / 60);\n                for (let i = 0; i < numLines; i++) {\n                    linesArr.push({\n                        x: (width / numLines) * i,\n                        speed: 0.01 + Math.random() * 0.02,\n                        offset: Math.random() * Math.PI * 2\n                    });\n                }\n            }\n\n            function draw(ctx, width, height, time, linesArr) {\n                // Low opacity trail effect over true black\n                ctx.fillStyle = 'rgba(3, 3, 3, 0.1)';\n                ctx.fillRect(0, 0, width, height);\n\n                linesArr.forEach(line => {\n                    ctx.beginPath();\n                    let centerX = width / 2;\n                    let deltaX = line.x - centerX;\n\n                    // Compute vertical segments\n                    for (let y = height; y > 0; y -= 10) {\n                        let normY = 1 - (y / height);\n                        let wave = Math.sin((y * 0.01) + time * line.speed + line.offset) * 30 * (1 - normY);\n                        // Power-based perspective flare\n                        let perspective = Math.pow(normY, 1.5);\n                        let currentX = centerX + (deltaX * (0.2 + perspective * 0.8)) + wave;\n\n                        y === height ? ctx.moveTo(currentX, y) : ctx.lineTo(currentX, y);\n                    }\n\n                    // Vertical fading gradient using Synthetic Emerald\n                    let grad = ctx.createLinearGradient(0, height, 0, 0);\n                    grad.addColorStop(0, 'rgba(46, 228, 150, 0.15)');\n                    grad.addColorStop(1, 'rgba(255, 255, 255, 0)');\n                    ctx.strokeStyle = grad;\n                    ctx.lineWidth = 1;\n                    ctx.stroke();\n                });\n            }\n\n            function animate() {\n                time += 1;\n                draw(ctx, width, height, time, linesArr);\n                requestAnimationFrame(animate);\n            }\n\n            window.addEventListener('resize', resize);\n            resize();\n            animate();\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "aegisnode-global-kinetic-network.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/aegisnode-global-kinetic-network.jpg", "source_name": "aegisnode-global-kinetic-network-DESIGN.md", "views": 751, "forks": 16, "private": false, "featured": true, "created_by": "9109ecbb-cdc4-4815-981e-2ea83be13765", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T10:47:49.027476+00:00"}