ition-colors\">STATUS: OPERATIONAL</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\">TERMS OF COMPUTATION</a>\n        <a href=\"#\" class=\"hover:text-white transition-colors\">PRIVACY MATRIX</a>\n      </div>\n\n      <div class=\"text-xs font-['Space_Mono'] text-neutral-600\">\n        © 2025 VORTEX CORE INC. ALL PROTOCOLS RESERVED.\n      </div>\n    </div>\n  </footer>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      \n      // Word-by-Word Animation Setup\n      document.querySelectorAll('.animate-word-by-word').forEach(el => {\n        const text = el.innerText;\n        const words = text.split(/\\s+/);\n        el.innerHTML = '';\n        words.forEach((word, index) => {\n          const span = document.createElement('span');\n          span.className = 'inline-block opacity-0 blur-md translate-y-4 transition-all duration-700 ease-out';\n          span.style.transitionDelay = `${index * 80}ms`;\n          span.textContent = word;\n          el.appendChild(span);\n          if (index < words.length - 1) {\n            el.appendChild(document.createTextNode(' '));\n          }\n        });\n      });\n\n      // Keyframes via Web Animations API (Replacing <style> tags)\n      const scrollKeyframes = [\n        { backgroundPosition: '0px 0px' },\n        { backgroundPosition: '22px 22px' }\n      ];\n\n      document.querySelectorAll('.black-dot-matrix').forEach(el => {\n        el.style.backgroundImage = 'radial-gradient(rgba(0, 0, 0, 0.85) 1.5px, transparent 1.5px)';\n        el.style.backgroundSize = '11px 11px';\n        el.animate(scrollKeyframes, { duration: 4000, iterations: Infinity, easing: 'linear' });\n      });\n\n      document.querySelectorAll('.white-dot-matrix').forEach(el => {\n        el.style.backgroundImage = 'radial-gradient(rgba(255, 255, 255, 0.8) 1.5px, transparent 1.5px)';\n        el.style.backgroundSize = '11px 11px';\n        el.animate(scrollKeyframes, { duration: 6000, iterations: Infinity, easing: 'linear' });\n        el.animate([\n          { opacity: 0.8 }, { opacity: 0.3 }, { opacity: 0.8 }\n        ], { duration: 3000, iterations: Infinity, easing: 'ease-in-out' });\n      });\n\n      document.querySelectorAll('.hero-blur-in').forEach(el => {\n        el.animate([\n          { filter: 'blur(12px)', opacity: 0, transform: 'scale(0.95)' },\n          { filter: 'blur(0)', opacity: 1, transform: 'scale(1)' }\n        ], { duration: 800, easing: 'ease-out', fill: 'forwards' });\n      });\n\n      document.querySelectorAll('.hero-fade-in-1').forEach(el => {\n        el.animate([\n          { opacity: 0, transform: 'translateY(10px)' },\n          { opacity: 1, transform: 'translateY(0)' }\n        ], { duration: 1000, delay: 200, easing: 'ease-out', fill: 'both' });\n      });\n\n      document.querySelectorAll('.hero-fade-in-2').forEach(el => {\n        el.animate([\n          { opacity: 0, transform: 'translateY(10px)' },\n          { opacity: 1, transform: 'translateY(0)' }\n        ], { duration: 1000, delay: 400, easing: 'ease-out', fill: 'both' });\n      });\n\n      // Interactive Intersection Observer\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) {\n            if (entry.target.classList.contains('reveal-element')) {\n              entry.target.animate([\n                { opacity: 0, transform: 'translateY(10px)' },\n                { opacity: 1, transform: 'translateY(0)' }\n              ], { duration: 800, easing: 'ease-out', fill: 'both' });\n            }\n            if (entry.target.classList.contains('animate-word-by-word')) {\n              entry.target.querySelectorAll('span').forEach(span => {\n                span.classList.remove('opacity-0', 'blur-md', 'translate-y-4');\n              });\n            }\n            observer.unobserve(entry.target);\n          }\n        });\n      }, { threshold: 0.1 });\n\n      document.querySelectorAll('.reveal-element, .animate-word-by-word').forEach(el => {\n        if (el.classList.contains('reveal-element')) {\n          el.style.opacity = '0';\n        }\n        observer.observe(el);\n      });\n\n      // Custom Slider Logic\n      const sliderContainer = document.getElementById('custom-slider-container');\n      const sliderTrack = document.getElementById('custom-slider-track');\n      const sliderThumb = document.getElementById('custom-slider-thumb');\n      const speedVal = document.getElementById('speed-val');\n      let isDragging = false;\n\n      function updateSlider(e) {\n        const rect = sliderContainer.getBoundingClientRect();\n        let x = e.clientX - rect.left;\n        x = Math.max(0, Math.min(x, rect.width));\n        const percentage = x / rect.width;\n        \n        sliderTrack.style.width = `${percentage * 100}%`;\n        sliderThumb.style.left = `${percentage * 100}%`;\n        \n        const min = 0.1, max = 4.0;\n        const val = min + percentage * (max - min);\n        speedVal.textContent = val.toFixed(1) + 'x';\n      }\n\n      sliderContainer.addEventListener('mousedown', (e) => {\n        isDragging = true;\n        updateSlider(e);\n      });\n      window.addEventListener('mousemove', (e) => {\n        if (isDragging) updateSlider(e);\n      });\n      window.addEventListener('mouseup', () => {\n        isDragging = false;\n      });\n      \n      // Distortion Toggle Logic\n      const toggleKnob = document.getElementById('toggle-knob');\n      const toggleBtn = document.getElementById('distortion-toggle');\n      let enableDistortion = false;\n      \n      toggleBtn.addEventListener('click', () => {\n        enableDistortion = !enableDistortion;\n        if (enableDistortion) {\n          toggleBtn.classList.remove('bg-neutral-800');\n          toggleBtn.classList.add('bg-[#ff5a00]');\n          toggleKnob.classList.add('translate-x-6');\n          toggleKnob.classList.remove('bg-neutral-400');\n          toggleKnob.classList.add('bg-white');\n        } else {\n          toggleBtn.classList.add('bg-neutral-800');\n          toggleBtn.classList.remove('bg-[#ff5a00]');\n          toggleKnob.classList.remove('translate-x-6');\n          toggleKnob.classList.add('bg-neutral-400');\n          toggleKnob.classList.remove('bg-white');\n        }\n      });\n    });\n  </script>\n\n\n</body></html>", "preview_file_name": "vortex-next-generation-performance-engine-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/vortex-next-generation-performance-engine-2.jpg", "source_name": "vortex-next-generation-performance-engine-2-DESIGN.md", "views": 301, "forks": 7, "private": false, "featured": true, "created_by": "f78092cf-e149-48ff-99e9-efabe9a28d39", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-02T21:12:29.895927+00:00"}