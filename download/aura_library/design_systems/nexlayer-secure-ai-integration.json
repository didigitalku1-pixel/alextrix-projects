nly) -->\n        <button class=\"md:hidden text-zinc-400 hover:text-white\">\n            <iconify-icon icon=\"solar:hamburger-menu-linear\" width=\"24\" height=\"24\"></iconify-icon>\n        </button>\n    </header>\n\n    <!-- Main Hero Section -->\n    <main class=\"relative z-10 w-full max-w-7xl mx-auto px-6 pt-16 pb-24 md:pt-32 lg:min-h-[85vh] flex flex-col lg:flex-row items-center justify-between gap-16 lg:gap-8\">\n\n        <!-- Left Content: Typography & Input -->\n        <div class=\"w-full lg:w-1/2 flex flex-col items-start text-left\">\n            <h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-white leading-[1.1] mb-6\">\n                The Smarter, Faster<br class=\"hidden sm:block\" /> Way to Connect AI\n            </h1>\n\n            <p class=\"text-base md:text-lg text-zinc-400 max-w-[480px] mb-10 leading-relaxed\">\n                NexLayer securely links AI agents to your enterprise stack with custom threat detection, granular permissions, and full observability for all deployments.\n            </p>\n\n            <!-- Pill Input Form -->\n            <form class=\"flex items-center w-full max-w-md bg-zinc-900/50 border border-zinc-800 rounded-full p-1.5 focus-within:border-zinc-600 focus-within:bg-zinc-900/80 transition-all shadow-sm\">\n                <input\n                    type=\"email\"\n                    placeholder=\"Enter your email...\"\n                    class=\"w-full bg-transparent text-sm text-zinc-200 placeholder-zinc-500 px-4 focus:outline-none\"\n                    required\n                />\n                <button\n                    type=\"submit\"\n                    class=\"shrink-0 bg-white text-black text-sm font-medium rounded-full px-5 py-2 hover:bg-zinc-200 transition-colors focus:ring-2 focus:ring-brand-500 focus:outline-none\">\n                    Book a Demo\n                </button>\n            </form>\n        </div>\n\n        <!-- Right Content: Isometric 3D Gra