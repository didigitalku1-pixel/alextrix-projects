n-colors mb-8 relative z-10 backdrop-blur-sm shadow-[0_0_15px_rgba(99,102,241,0.1)]\">Start free trial</button>\n\n                            <ul class=\"space-y-5 flex-grow relative z-10\">\n                                <li class=\"flex items-start gap-3\">\n                                    <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-base text-indigo-400 mt-0.5 shrink-0\"></iconify-icon>\n                                    <div>\n                                        <p class=\"text-sm text-gray-200\">5 workspaces included</p>\n                                        <p class=\"text-xs text-gray-500 mt-0.5\">Volume discounts available</p>\n                                    </div>\n                                </li>\n                                <li class=\"flex items-start gap-3\">\n                                    <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-base text-indigo-400 mt-0.5 shrink-0\"></iconify-icon>\n                                    <div>\n                                        <p class=\"text-sm text-gray-200\">First 100,000 requests free</p>\n                                        <p class=\"text-xs text-gray-500 mt-0.5\">High-performance compute</p>\n                                    </div>\n                                </li>\n                                <li class=\"flex items-start gap-3\">\n                                    <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-base text-indigo-400 mt-0.5 shrink-0\"></iconify-icon>\n                                    <div>\n                                        <p class=\"text-sm text-gray-200\">Priority email support</p>\n                                        <p class=\"text-xs text-gray-500 mt-0.5\">24 hour response time</p>\n                                    </div>\n                                </li>\n                                <li class=\"flex items-start gap-3\">\n                                   