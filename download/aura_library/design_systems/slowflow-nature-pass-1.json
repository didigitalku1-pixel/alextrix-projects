text-[#795548]\" style=\"font-family: 'Space Mono', monospace;\">AUTH</span>\n                    <div class=\"h-[14px] w-24 bg-[#3E2723]\"></div>\n                </div>\n                <!-- Leaf Graphic -->\n                <div class=\"w-[42px] h-[52px] rounded-lg overflow-hidden relative anim-element\" style=\"opacity: 0; filter: blur(8px); transform: translateY(15px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 0.9s;\">\n                     <svg viewBox=\"0 0 40 50\" class=\"absolute inset-0 w-full h-full stroke-[#3E2723] fill-none stroke-[1.5]\" style=\"stroke-linecap: round;\">\n                         <path d=\"M20 5 C30 15, 35 30, 20 45 C5 30, 10 15, 20 5 Z\" class=\"svg-draw\" style=\"stroke-dasharray: 120; stroke-dashoffset: 120; transition: stroke-dashoffset 2s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 1.0s;\" />\n                         <path d=\"M20 5 L20 45\" class=\"svg-draw\" style=\"stroke-dasharray: 120; stroke-dashoffset: 120; transition: stroke-dashoffset 2s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 1.1s;\" />\n                         <path d=\"M20 20 L28 15\" class=\"svg-draw\" style=\"stroke-dasharray: 50; stroke-dashoffset: 50; transition: stroke-dashoffset 2s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 1.2s;\" />\n                         <path d=\"M20 28 L12 23\" class=\"svg-draw\" style=\"stroke-dasharray: 50; stroke-dashoffset: 50; transition: stroke-dashoffset 2s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 1.3s;\" />\n                         <path d=\"M20 36 L26 31\" class=\"svg-draw\" style=\"stroke-dasharray: 50; stroke-dashoffset: 50; transition: stroke-dashoffset 2s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 1.4s;\" />\n                     </svg>\n                </div>\n            </div>\n\n            <!-- Bottom QR Layout -->\n            <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-t border-[#A1887F] pt-6\">\n                <!-