onify-icon icon=\"solar:sun-linear\" class=\"text-sm\" stroke-width=\"1.5\"></iconify-icon>\n                                <div class=\"w-2.5 h-2.5 border-l-[1.5px] border-b-[1.5px] border-[#BCAAA4]\"></div>\n                            </div>\n                        </div>\n                        <div class=\"mt-1 animate-words\">NATURAL EXHIBITS AND UNLOCKS A LIFETIME 75% DISCOUNT FOR EVERY</div>\n                        <div class=\"flex justify-between items-center mt-1\">\n                            <span>SEASONAL</span> <span>RELEASE</span> \n                            <span class=\"border-[1.5px] border-[#BCAAA4] w-[14px] h-[14px] inline-block overflow-hidden relative rounded-[2px]\">\n                                <svg viewBox=\"0 0 10 10\" class=\"absolute inset-0 w-full h-full stroke-[#BCAAA4] stroke-[1.5]\"><line x1=\"-2\" y1=\"12\" x2=\"12\" y2=\"-2\"/></svg>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- ================= CARD 3: BOTTOM ================= -->\n        <div class=\"bg-[#BCAAA4] rounded-[1.75rem] w-full p-6 sm:p-7 flex flex-col justify-between text-[#3E2723] anim-element\" style=\"opacity: 0; filter: blur(8px); transform: translateY(15px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 0.4s;\">\n            \n            <!-- Top Link & Pill -->\n            <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#A1887F] pb-4 anim-element\" style=\"opacity: 0; filter: blur(8px); transform: translateY(15px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: 0.5s;\">\n                <div class=\"flex items-center gap-2\">\n                    <div class=\"bg-[#3E2723] text-[#BCAAA4] w-6 h-6 rounded-full flex items-center justify-center font-medium text-xs\">V</div>\n                    <div class=\"border-[1.5px] border-[#3E2723