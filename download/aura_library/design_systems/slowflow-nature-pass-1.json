                    <div class=\"absolute top-[6px] left-[6px] w-[22px] h-[22px] border-[3px] border-[#BCAAA4] rounded-[3px] flex items-center justify-center\"><div class=\"w-2.5 h-2.5 bg-[#BCAAA4] rounded-[1px]\"></div></div>\n                         <div class=\"absolute top-[6px] right-[6px] w-[22px] h-[22px] border-[3px] border-[#BCAAA4] rounded-[3px] flex items-center justify-center\"><div class=\"w-2.5 h-2.5 bg-[#BCAAA4] rounded-[1px]\"></div></div>\n                         <div class=\"absolute bottom-[6px] left-[6px] w-[22px] h-[22px] border-[3px] border-[#BCAAA4] rounded-[3px] flex items-center justify-center\"><div class=\"w-2.5 h-2.5 bg-[#BCAAA4] rounded-[1px]\"></div></div>\n                         \n                         <!-- Inner blocks -->\n                         <div class=\"absolute top-[10px] left-[36px] w-2 h-2 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute top-[20px] left-[34px] w-5 h-2 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute top-[32px] left-[8px] w-2 h-4 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute bottom-[20px] right-[10px] w-7 h-2 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute bottom-[10px] right-[16px] w-3 h-3 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute top-[40px] right-[20px] w-4 h-4 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute top-[36px] left-[16px] w-3 h-3 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute bottom-[10px] left-[36px] w-4 h-2 bg-[#BCAAA4] rounded-[1px]\"></div>\n                         <div class=\"absolute bottom-[32px] left-[32px] w-3 h-3 bg-[#BCAAA4] rounded-[1px]\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </main>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            // Split text into spans for word-by-word animation, preserving spacing\n            document.querySelectorAll('.animate-words').forEach(el => {\n                const text = el.innerText;\n                el.innerHTML = '';\n                text.split(' ').forEach((word, i) => {\n                    if (word.trim() !== '') {\n                        const span = document.createElement('span');\n                        span.className = 'anim-element';\n                        // Apply identical styling to other anim elements dynamically\n                        span.style.opacity = '0';\n                        span.style.filter = 'blur(8px)';\n                        span.style.transform = 'translateY(15px)';\n                        span.style.transition = 'all 0.8s cubic-bezier(0.16, 1, 0.3, 1)';\n                        span.style.transitionDelay = `${(i * 0.05) + 0.6}s`; // Base delay + staggered\n                        span.style.display = 'inline-block';\n                        span.style.whiteSpace = 'pre';\n                        span.innerText = word + ' '; \n                        el.appendChild(span);\n                    }\n                });\n            });\n\n            // Intersection Observer to trigger animations inline when scrolled into view\n            const observerOptions = {\n                root: null,\n                rootMargin: '0px',\n                threshold: 0.1\n            };\n\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        if (entry.target.classList.contains('svg-draw')) {\n                            entry.target.style.strokeDashoffset = '0';\n                        } else {\n                            entry.target.style.opacity = '1';\n                            entry.target.style.filter = 'blur(0)';\n                            entry.target.style.transform = 'translateY(0)';\n                        }\n                    }\n                });\n            }, observerOptions);\n\n            // Observe all elements that require observation\n            document.querySelectorAll('.anim-element, .svg-draw').forEach(el => {\n                observer.observe(el);\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "slowflow-nature-pass-1.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/staff-featured-2026-05-22/slowflow-nature-pass-1.jpg", "source_name": "slowflow-nature-pass-1-DESIGN.md", "views": 182, "forks": 0, "private": false, "featured": true, "created_by": "f78092cf-e149-48ff-99e9-efabe9a28d39", "created_at": "2026-06-12T07:38:10.793894+00:00", "updated_at": "2026-07-02T17:23:05.457626+00:00"}