mb-4 shrink-0\">\n                        <div class=\"flex items-center gap-2 text-sm font-medium text-gray-200 tracking-tight\">\n                            <iconify-icon icon=\"solar:gallery-linear\" class=\"text-gray-400\"></iconify-icon>\n                            Output Frame\n                        </div>\n                        <div class=\"w-2 h-2 rounded-full bg-[#8b5cf6] shadow-[0_0_8px_#8b5cf6]\"></div> <!-- Purple status dot as in ref -->\n                    </div>\n\n                    <!-- Stacked Cards Container -->\n                    <div class=\"flex-1 relative w-full mt-2 flex items-center justify-center perspective-1000\">\n                        <!-- Card 3 (Back) -->\n                        <div class=\"absolute w-[85%] aspect-[4/5] bg-white/5 rounded-2xl border border-white/5 shadow-xl rotate-[6deg] translate-x-4 opacity-40\"></div>\n                        <!-- Card 2 (Middle) -->\n                        <div class=\"absolute w-[90%] aspect-[4/5] bg-white/10 rounded-2xl border border-white/10 shadow-xl -rotate-[4deg] -translate-x-2 opacity-60\"></div>\n                        <!-- Card 1 (Front - Image) -->\n                        <div class=\"absolute w-full aspect-[4/5] rounded-2xl overflow-hidden border border-white/20 shadow-[0_0_40px_rgba(255,255,255,0.1)] hover:scale-[1.02] hover:shadow-[0_0_50px_rgba(0,229,89,0.2)] transition-all duration-500 cursor-pointer z-10 bg-[#1a1b1e]\">\n                             <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/0d868fef-f560-45ca-ab35-5dad4fc29059_3840w.webp\" alt=\"AI Generated Portrait\" class=\"w-full h-full object-cover\">\n                             <!-- Subtle inner shadow/vignette on image -->\n                             <div class=\"absolute inset-0 shadow-[inset_0_0_40px_rgba(0,0,0,0.4)] pointer-events-none\"></div>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- Floating Bottom Toolbar -->\n        <div class=\"absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 p-1.5 bg-[#121316]/80 backdrop-blur-xl border border-white/[0.08] rounded-full shadow-2xl\">\n            <button class=\"w-10 h-10 rounded-full bg-[#38bdf8]/20 text-[#38bdf8] flex items-center justify-center relative overflow-hidden group\">\n                <div class=\"absolute inset-0 bg-[#38bdf8]/10 group-hover:bg-[#38bdf8]/30 transition-colors\"></div>\n                <iconify-icon icon=\"solar:cursor-linear\" class=\"text-lg relative z-10 rotate-12\"></iconify-icon>\n            </button>\n            <button class=\"w-10 h-10 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/5 transition-colors\">\n                <iconify-icon icon=\"solar:hand-stars-linear\" class=\"text-lg\"></iconify-icon>\n            </button>\n            <button class=\"w-10 h-10 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/5 transition-colors\">\n                <iconify-icon icon=\"solar:bolt-linear\" class=\"text-lg\"></iconify-icon>\n            </button>\n            <button class=\"w-10 h-10 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/5 transition-colors\">\n                <iconify-icon icon=\"solar:cpu-linear\" class=\"text-lg\"></iconify-icon>\n            </button>\n            <button class=\"w-10 h-10 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/5 transition-colors\">\n                <iconify-icon icon=\"solar:magic-stick-3-linear\" class=\"text-lg\"></iconify-icon>\n            </button>\n            <div class=\"w-[1px] h-5 bg-white/10 mx-1\"></div>\n            <button class=\"w-10 h-10 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/5 transition-colors\">\n                <iconify-icon icon=\"solar:chat-line-linear\" class=\"text-lg\"></iconify-icon>\n            </button>\n            <button class=\"w-10 h-10 rounded-full flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/5 transition-colors\">\n                <iconify-icon icon=\"solar:code-square-linear\" class=\"text-lg\"></iconify-icon>\n            </button>\n        </div>\n\n    </main>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", (event) => {\n            gsap.registerPlugin();\n\n            // Skill Directive: Masked Word Reveal for the Prompt text\n            const promptText = document.getElementById('prompt-reveal');\n            if (promptText) {\n                const words = promptText.innerText.split(' ');\n                promptText.innerHTML = '';\n                words.forEach(word => {\n                    // Wrap each word in a span with overflow hidden for the mask effect\n                    const wordContainer = document.createElement('span');\n                    wordContainer.className = 'inline-block overflow-hidden align-top mr-[4px] py-0.5';\n\n                    const wordSpan = document.createElement('span');\n                    wordSpan.innerText = word;\n                    wordSpan.className = 'inline-block text-gray-300 font-light translate-y-[120%]'; // Initial state pushed down\n\n                    wordContainer.appendChild(wordSpan);\n                    promptText.appendChild(wordContainer);\n                });\n\n                // Animate words up\n                gsap.to('#prompt-reveal span > span', {\n                    y: '0%',\n                    duration: 0.8,\n                    stagger: 0.03,\n                    ease: 'power3.out',\n                    delay: 0.5\n                });\n            }\n\n            // Continuous Floating Animation for Nodes (replacing missing CSS keyframes)\n            gsap.to('.gsap-node', {\n                y: '-=8',\n                duration: 4,\n                ease: 'sine.inOut',\n                yoyo: true,\n                repeat: -1,\n                stagger: {\n                    amount: 2,\n                    from: \"random\"\n                }\n            });\n\n            // SVG Line Animation (Energy Flow)\n            const paths = document.querySelectorAll('#animated-paths path');\n            paths.forEach(path => {\n                const length = path.getTotalLength();\n                path.style.strokeDasharray = `15, ${length / 4}`; // Dashed pattern\n\n                // Animate dash offset to create flowing effect\n                gsap.to(path, {\n                    strokeDashoffset: -length,\n                    duration: 8,\n                    ease: \"none\",\n                    repeat: -1\n                });\n            });\n\n            // Initial Draw-in Animation for Lines\n            gsap.from('svg > g:first-child path', {\n                strokeDasharray: (i, target) => {\n                    const l = target.getTotalLength();\n                    return `${l}, ${l}`;\n                },\n                strokeDashoffset: (i, target) => target.getTotalLength(),\n                duration: 1.5,\n                ease: \"power2.inOut\",\n                stagger: 0.2\n            });\n\n            // Subdued pulse for connection points\n            gsap.to('.shadow-\\\\[0_0_10px_\\\\#00e559\\\\]', {\n                boxShadow: '0 0 16px #00e559',\n                duration: 1.5,\n                yoyo: true,\n                repeat: -1,\n                ease: \"sine.inOut\",\n                stagger: 0.1\n            });\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "ai-workflow-interface.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/ai-workflow-interface.jpg", "source_name": "ai-workflow-interface-DESIGN.md", "views": 266, "forks": 9, "private": false, "featured": true, "created_by": "8bd0314a-9525-4a13-996e-2c37cbd9e514", "created_at": "2026-05-01T16:18:09.070118+00:00", "updated_at": "2026-07-03T10:16:51.959566+00:00"}