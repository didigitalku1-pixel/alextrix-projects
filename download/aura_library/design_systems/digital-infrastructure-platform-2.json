-zinc-300 transition-colors font-extralight\">architecture</span>\n        </div>\n\n        <!-- Panel 3 -->\n        <div class=\"bg-[#18181b] flex-1 xl:w-[140px] flex-shrink-0 flex flex-col justify-between p-6 xl:p-8 hover:bg-[#1e1e22] transition-colors duration-300 cursor-pointer group\">\n            <div class=\"border-b border-[#27272a] pb-4 inline-flex items-center gap-2 text-zinc-400 group-hover:text-zinc-200 transition-colors\">\n                <iconify-icon icon=\"solar:arrow-down-linear\" class=\"text-xl group-hover:translate-y-1 transition-transform\" stroke-width=\"1.5\"></iconify-icon>\n                <span class=\"text-3xl font-extralight tracking-tighter\">03</span>\n            </div>\n            <span class=\"text-zinc-500 text-sm tracking-wide mt-12 xl:mt-auto pt-8 group-hover:text-zinc-300 transition-colors font-extralight\">protection</span>\n        </div>\n\n        <!-- Panel 4 -->\n        <div class=\"bg-[#18181b] flex-1 xl:w-[140px] flex-shrink-0 flex flex-col justify-between p-6 xl:p-8 hover:bg-[#1e1e22] transition-colors duration-300 cursor-pointer group\">\n            <div class=\"border-b border-[#27272a] pb-4 inline-flex items-center gap-2 text-zinc-400 group-hover:text-zinc-200 transition-colors\">\n                <iconify-icon icon=\"solar:arrow-down-linear\" class=\"text-xl group-hover:translate-y-1 transition-transform\" stroke-width=\"1.5\"></iconify-icon>\n                <span class=\"text-3xl font-extralight tracking-tighter\">04</span>\n            </div>\n            <span class=\"text-zinc-500 text-sm tracking-wide mt-12 xl:mt-auto pt-8 group-hover:text-zinc-300 transition-colors font-extralight\">growth</span>\n        </div>\n    </div>\n\n    <!-- Panel 5: Main Content Area -->\n    <div class=\"bg-[#18181b] flex-1 flex flex-col p-8 xl:p-14 2xl:p-20 relative overflow-hidden\">\n\n        <!-- Top Navigation Line -->\n        <div class=\"flex items-center gap-4 text-xs font-normal text-zinc-400 w-full max-w-4xl fade-in-up\" style=\"animation-delay: 0.2s;\">\n            <span class=\"whitespace-nowrap\">Core Services</span>\n            <div class=\"flex-1 h-px bg-[#27272a]\"></div>\n            <span class=\"whitespace-nowrap\">4/4</span>\n        </div>\n\n        <!-- Main Typography -->\n        <div class=\"mt-16 xl:mt-24 max-w-3xl fade-in-up\" style=\"animation-delay: 0.4s;\">\n            <h1 class=\"text-4xl md:text-5xl lg:text-6xl font-normal tracking-tight text-zinc-100 leading-[1.1]\">\n                Modular, flexible solutions for modern digital infrastructure\n            </h1>\n            <p class=\"mt-8 text-zinc-400 text-base md:text-lg leading-relaxed max-w-2xl font-extralight\">\n                We create future-proof systems that scale seamlessly and adapt to your business needs. Platform's key capabilities include:\n            </p>\n        </div>\n\n        <!-- Dot Grid Graphic -->\n        <div class=\"mt-16 xl:mt-24 ml-2 grid grid-cols-6 gap-x-12 gap-y-10 w-max fade-in-up\" style=\"animation-delay: 0.6s;\">\n            <!-- Row 1 -->\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n\n            <!-- Row 2 -->\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#6366F1] shadow-[0_0_8px_rgba(99,102,241,0.6)] animate-slow-pulse\" style=\"animation-delay: 0s;\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n\n            <!-- Row 3 -->\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#6366F1] shadow-[0_0_8px_rgba(99,102,241,0.6)] animate-slow-pulse\" style=\"animation-delay: 1s;\"></div>\n\n            <!-- Row 4 -->\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#6366F1] shadow-[0_0_8px_rgba(99,102,241,0.6)] animate-slow-pulse\" style=\"animation-delay: 0.5s;\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#6366F1] shadow-[0_0_8px_rgba(99,102,241,0.6)] animate-slow-pulse\" style=\"animation-delay: 1.5s;\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n\n            <!-- Row 5 -->\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#6366F1] shadow-[0_0_8px_rgba(99,102,241,0.6)] animate-slow-pulse\" style=\"animation-delay: 2s;\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n            <div class=\"w-1.5 h-1.5 rounded-full bg-[#27272a]\"></div>\n        </div>\n\n        <!-- Footer Service Line -->\n        <div class=\"mt-16 xl:mt-auto pt-8 flex items-center gap-4 text-zinc-400 text-sm fade-in-up\" style=\"animation-delay: 0.8s;\">\n            <iconify-icon icon=\"solar:widget-5-linear\" class=\"text-[#6366F1] text-2xl\" stroke-width=\"1.5\"></iconify-icon>\n            <span class=\"font-extralight tracking-wide\">Design, optimize, scale, and secure.</span>\n        </div>\n\n    </div>\n\n    <script>\n        // WebGL Background Grid logic applied specifically to the image container\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            const container = document.getElementById('webgl-container');\n            const canvas = document.getElementById('webgl-canvas');\n            if (!container || !canvas || typeof THREE === 'undefined') return;\n\n            const scene = new THREE.Scene();\n            scene.fog = new THREE.FogExp2(0x000000, 0.08);\n\n            const camera = new THREE.PerspectiveCamera(60, container.clientWidth / container.clientHeight, 0.1, 50);\n            camera.position.set(0, 1.5, 4);\n            camera.lookAt(0, 0, 0);\n\n            const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });\n            renderer.setSize(container.clientWidth, container.clientHeight);\n            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n            // Immersive Grid Layer\n            const gridHelper = new THREE.GridHelper(30, 30, 0x6366F1, 0x6366F1);\n            gridHelper.material.opacity = 0.4;\n            gridHelper.material.transparent = true;\n            gridHelper.position.y = -1;\n            scene.add(gridHelper);\n\n            // Light field of floating particles\n            const particlesGeo = new THREE.BufferGeometry();\n            const particlesCount = 80;\n            const posArray = new Float32Array(particlesCount * 3);\n            for(let i=0; i < particlesCount * 3; i++) {\n                posArray[i] = (Math.random() - 0.5) * 15;\n            }\n            particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n            const particlesMat = new THREE.PointsMaterial({\n                size: 0.04,\n                color: 0xffffff,\n                transparent: true,\n                opacity: 0.4\n            });\n            const particles = new THREE.Points(particlesGeo, particlesMat);\n            scene.add(particles);\n\n            // Responsive handling\n            const observer = new ResizeObserver(entries => {\n                for (let entry of entries) {\n                    const width = entry.contentRect.width;\n                    const height = entry.contentRect.height;\n                    renderer.setSize(width, height);\n                    camera.aspect = width / height;\n                    camera.updateProjectionMatrix();\n                }\n            });\n            observer.observe(container);\n\n            // Animation Loop\n            function animate() {\n                requestAnimationFrame(animate);\n\n                // Forward drift for the grid\n                gridHelper.position.z += 0.015;\n                if (gridHelper.position.z >= 1) {\n                    gridHelper.position.z = 0;\n                }\n\n                // Subtle particle drift\n                particles.rotation.y -= 0.0008;\n                particles.position.y += Math.sin(Date.now() * 0.001) * 0.001;\n\n                renderer.render(scene, camera);\n            }\n            animate();\n        });\n    </script>\n</body>\n</html>", "preview_file_name": "digital-infrastructure-platform-2.html", "thumbnail_url": "https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/design-system-thumbnails/regenerated-2026-05-22-2s/digital-infrastructure-platform-2.jpg", "source_name": "digital-infrastructure-platform-2-DESIGN.md", "views": 104, "forks": 5, "private": false, "featured": true, "created_by": "5bd6211c-bd4c-467c-b442-4312cac4712c", "created_at": "2026-04-29T09:15:30.794547+00:00", "updated_at": "2026-07-03T06:37:32.540262+00:00"}